$sv_G.define("M5_DIO", ["@CONN", "SD"]) { sv_net_area($sv_G["SD"], [[">", 0.0]], 17) }
sv_connect(["M1", "M5_DIO"], "CT1")
sv_rule("AR_5_10_M5", "Max. (M5 area / gate area) is 5000 (without effective diode) Max. (M5 area / gate area) is Ratio Equation (with effective diode)", ["@CONN", "AC4", "GATE", "M1", "M2", "M3", "M4", "M5", "M5_DIO", "PO"]) do |outs|
