  s.define("A5") { sv_nar([s["PO"], s["M1"], s["M2"], s["M3"], s["M4"], s["M5"], s["M5_DIO"], s["GATE"]], ["PO", "M1", "M2", "M3", "M4", "M5", "M5_DIO", "GATE"], lambda { |a, p| a["M5"] / a["GATE"] - (a["M5_DIO"] * 500.0 + ((a["M5_DIO"]) != 0 ? 1.0 : 0.0) * 38000.0) }, [[">", 5000.0]], 18, s["AC4"], [nil, nil, nil, nil, nil, nil, nil, nil]) }
