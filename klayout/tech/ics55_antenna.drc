  s.define("AV4_no_accumulate") { sv_nar([s["PO"], s["M1"], s["M2"], s["M3"], s["M4"], s["VIA4"], s["M4_DIO"], s["GATE"]], ["PO", "M1", "M2", "M3", "M4", "VIA4", "M4_DIO", "GATE"], lambda { |a, p| a["VIA4"] / a["GATE"] - (a["M4_DIO"] * 150.0 + ((a["M4_DIO"]) != 0 ? 1.0 : 0.0) * 980.0) }, [[">", 20.0]], 16, nil, [nil, nil, nil, nil, nil, nil, nil, nil]) }
  outs << proc { s["AV4_no_accumulate"] }
end
sv_rule("AR_6_9_VIA4", "(VIA4 area / gate area) > 50 (without effective diode) (VIA4 area / gate area) > Ratio Equation (with effective diode)", ["@CONN", "AC3_V", "GATE", "M1", "M2", "M3", "M4", "M4_DIO", "PO", "VIA4"]) do |outs|
  s = SvScope.new(self, $sv_G, "AR_6_9_VIA4")
  s.define("AVIA4") { sv_nar([s["PO"], s["M1"], s["M2"], s["M3"], s["M4"], s["VIA4"], s["M4_DIO"], s["GATE"]], ["PO", "M1", "M2", "M3", "M4", "VIA4", "M4_DIO", "GATE"], lambda { |a, p| a["VIA4"] / a["GATE"] - (a["M4_DIO"] * 250.0 + ((a["M4_DIO"]) != 0 ? 1.0 : 0.0) * 850.0) }, [[">", 50.0]], 16, s["AC3_V"], [nil, nil, nil, nil, nil, nil, nil, nil]) }
  outs << proc { s["AVIA4"] }
end
$sv_G.define("AC4", ["@CONN", "AC3", "GATE", "M4"]) { sv_nar([$sv_G["M4"], $sv_G["GATE"]], ["M4", "GATE"], lambda { |a, p| a["M4"] / a["GATE"] }, [[">=", 0.0]], 16, $sv_G["AC3"], [nil, nil]) }
$sv_G.define("AC4_18", ["@CONN", "AC3_18", "GATE18", "M4"]) { sv_nar([$sv_G["M4"], $sv_G["GATE18"]], ["M4", "GATE18"], lambda { |a, p| a["M4"] / a["GATE18"] }, [[">=", 0.0]], 16, $sv_G["AC3_18"], [nil, nil]) }
$sv_G.define("AC4_V", ["@CONN", "AC3_V", "GATE", "VIA4"]) { sv_nar([$sv_G["VIA4"], $sv_G["GATE"]], ["VIA4", "GATE"], lambda { |a, p| a["VIA4"] / a["GATE"] }, [[">=", 0.0]], 16, $sv_G["AC3_V"], [nil, nil]) }
