flat
$sv_flat = true
sv_connect(["PO", "GATE"], nil)
sv_connect(["PO", "GATE18"], nil)
sv_connect(["PO", "GATE1825"], nil)
sv_rule("AR_1", "Max. (Poly area / gate area) is 250") do |outs|
  s = SvScope.new(self, $sv_G, "AR_1")
  outs << proc { sv_nar([s["PO"], s["GATE"]], ["PO", "GATE"], lambda { |a, p| a["PO"] / a["GATE"] }, [[">", 250.0]], 3, nil, [nil, nil]) }
end
sv_rule("AR_2", "Max. (Poly perim*thickness / gate area) is 500") do |outs|
  s = SvScope.new(self, $sv_G, "AR_2")
  outs << proc { sv_nar([s["PO"], s["GATE"]], ["PO", "GATE"], lambda { |a, p| p["PO"] * 0.10 / a["GATE"] }, [[">", 500.0]], 3, nil, [nil, nil]) }
end
sv_connect(["CT1", "PO"], nil)
sv_rule("AR_3", "Max. (contact area / gate area) is 10") do |outs|
  s = SvScope.new(self, $sv_G, "AR_3")
  outs << proc { sv_nar([s["CT1"], s["GATE"]], ["CT1", "GATE"], lambda { |a, p| a["CT1"] / a["GATE"] }, [[">", 10.0]], 4, nil, [nil, nil]) }
end
sv_connect(["M1", "PO", "SD"], "CT1")
$sv_G.define("M1_DIO") { sv_net_area($sv_G["SD"], [[">", 0.0]], 5) }
sv_connect(["M1", "M1_DIO"], "CT1")
sv_rule("AR_5_10_M1", "Max. (M1 area / gate area) is 5000 (without effective diode) Max. (M1 area / gate area) is Ratio Equation (with effective diode)") do |outs|
  s = SvScope.new(self, $sv_G, "AR_5_10_M1")
  s.define("A1") { sv_nar([s["PO"], s["M1"], s["M1_DIO"], s["GATE"]], ["PO", "M1", "M1_DIO", "GATE"], lambda { |a, p| a["M1"] / a["GATE"] - (a["M1_DIO"] * 500.0 + ((a["M1_DIO"]) != 0 ? 1.0 : 0.0) * 38000.0) }, [[">", 5000.0]], 6, true, [nil, nil, nil, nil]) }
  outs << proc { s["A1"] }
end
sv_rule("AR18_5_10_M1", "Max. (M1 area / 1.8v gate area) is 1000 (without effective diode) Max. (M1 area / 1.8v gate area) is Ratio Equation (with effective diode)") do |outs|
  s = SvScope.new(self, $sv_G, "AR18_5_10_M1")
  s.define("A1_18") { sv_nar([s["PO"], s["M1"], s["M1_DIO"], s["GATE18"]], ["PO", "M1", "M1_DIO", "GATE18"], lambda { |a, p| a["M1"] / a["GATE18"] - (a["M1_DIO"] * 500.0 + ((a["M1_DIO"]) != 0 ? 1.0 : 0.0) * 42000.0) }, [[">", 1000.0]], 6, true, [nil, nil, nil, nil]) }
  outs << proc { s["A1_18"] }
end
sv_connect(["VIA1", "M1"], nil)
sv_rule("AR_4_VIA1", "(VIA1 area / gate area) > 20 (without effective diode) (VIA1 area / gate area) > Ratio Equation (with effective diode) single layer Via area to the active poly gate area, no accumulate") do |outs|
  s = SvScope.new(self, $sv_G, "AR_4_VIA1")
  s.define("AVIA1_no_accumulate") { sv_nar([s["PO"], s["M1"], s["VIA1"], s["M1_DIO"], s["GATE"]], ["PO", "M1", "VIA1", "M1_DIO", "GATE"], lambda { |a, p| a["VIA1"] / a["GATE"] - (a["M1_DIO"] * 150.0 + ((a["M1_DIO"]) != 0 ? 1.0 : 0.0) * 980.0) }, [[">", 20.0]], 7, nil, [nil, nil, nil, nil, nil]) }
