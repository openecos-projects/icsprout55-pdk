# frozen_string_literal: false
# ============================================================================
# KLayout DRC deck for ICS55_ANTENNA
#
# AUTOMATICALLY GENERATED by hacking/svrf2klayout/svrf2klayout.py from the
# Calibre SVRF deck ICsprout_CalANT_expanded.svrf
# Do not edit by hand: edit the translator/runtime and regenerate.
# ============================================================================

require 'time'
require 'logger'

$sv_exec_start = Time.now

# -rd jobs=N: the parent splits the selected rules into N groups and runs each in its own
# KLayout process (-rd rules_file=...), then merges their reports (sv_run_jobs). The parent
# reads no layout.
$sv_jobs = ($jobs || "1").to_i
$sv_parent = $sv_jobs > 1 && !$rules_file
$sv_deck = File.expand_path(__FILE__)

if $input && !$sv_parent
  if $topcell
    source($input, $topcell)
  else
    source($input)
  end
end

if $sv_parent
  # the children write the reports, the parent merges them into $report
elsif $report
  report("ICS55_ANTENNA DRC (translated from Calibre)", $report)
else
  report("ICS55_ANTENNA DRC (translated from Calibre)")
end

$sv_flat = ($flat.to_s == "1" || $flat.to_s.downcase == "true")
if $sv_flat
  flat
else
  deep
end

nthr = ($threads || $thr || "4").to_i
$sv_nthr = nthr
threads(nthr)
verbose(false)

# -rd log=<file>: also write the log messages to a file
if $log
  $sv_logf = File.open($log, "w")
  def log(msg, indent = 0)
    puts msg
    $sv_logf.puts(msg)
    $sv_logf.flush
  end
end

$sv_verbose = ($sv_verbose_flag.to_s == "1")
$sv_strict = ($strict.to_s == "1")
$sv_select = $select ? Regexp.new($select) : nil
$sv_unselect = $unselect ? Regexp.new($unselect) : nil
$sv_failed = []

# #DEFINE overrides from the command line (-rd NAME=VALUE)
$sv_defines = {}
$sv_overrides = {}
$sv_switches = {}

# options handed to the child processes of -rd jobs=N
$sv_fwd_vars = %w[input topcell flat densityRules sv_verbose_flag strict break_points release release_check mem_log trim]
if $densityRules && $densityRules.to_s.downcase == "false"
  $sv_overrides["DENSITY_RULES"] = "NO"
end

# ============================================================================
# SVRF runtime for KLayout DRC
#
# Implements Calibre SVRF layer operations on top of the KLayout DRC DSL.
# This file is embedded verbatim into the generated rule deck by
# svrf2klayout.py. All functions are prefixed with "sv_".
# ============================================================================

# ---------------------------------------------------------------------------
# Scopes and lazy layer evaluation
# ---------------------------------------------------------------------------

class SvScope
  attr_reader :name
  def initialize(engine, parent, name)
    @e = engine
    @p = parent
    @name = name
    @defs = {}
    @deps = {}
    @cache = {}
    @busy = {}
    @released = {}
  end
  # deps: the names the definition looks up (generator, global layers only; nil = unknown)
  def define(n, deps = nil, &blk)
    k = n.upcase
    @defs[k] = blk
    @deps[k] = deps
  end
  def defined?(n)
    @defs.has_key?(n.upcase) || (@p && @p.defined?(n))
  end
  def [](n)
    k = n.upcase
    if @defs.has_key?(k)
      SvScope.dep_check(k) if $sv_release_check && @p.nil?
      return @cache[k] if @cache.has_key?(k)
      raise "SVRF: cyclic definition of #{k}" if @busy[k]
      if @released.delete(k)
        # the dependencies of a rule or layer missed k: a wrong release would only cost time
        # here, but it means the static dependency sets are wrong
        msg = "SVRF: layer #{k} used after its release (#{$sv_cur_rule})"
        raise msg if $sv_release_check
        @e.log("WARNING: #{msg}, computed again")
        $sv_late_uses << [$sv_cur_rule, k]
      end
      @busy[k] = true
      t0 = Time.now
      $sv_ctx << SvScope.dep_set(@deps[k]) if $sv_release_check && @p.nil?
      begin
        v = @defs[k].call
      ensure
        @busy[k] = false
        $sv_ctx.pop if $sv_release_check && @p.nil?
      end
      if $sv_verbose && Time.now - t0 > 0.5
        @e.log("SVRF layer #{@name}:#{k}: #{'%.2f' % (Time.now - t0)}s (incl. dependencies)")
      end
      @cache[k] = v
      if $sv_dump_local && $sv_dump_local["#{@name.upcase}:#{k}"]
        begin
          dl = v
          if $sv_flat && dl.data.respond_to?(:flatten)
            d = dl.data.dup; d.flatten; dl = DRC::DRCLayer::new(@e, d)
          end
          dl.output("DUMP_#{@name}:#{k}", "debug dump")
        rescue => ex
          @e.log("dump failed #{k}: #{ex}")
        end
      end
      return v
    end
    return @p[n] if @p
    raise "SVRF: undefined layer #{n}"
  end
  # true if n is evaluated already (here or in a parent scope)
  def cached?(n)
    k = n.upcase
    return @cache.has_key?(k) if @defs.has_key?(k)
    @p ? @p.cached?(n) : false
  end
  def forget
    @cache.clear
  end
  def cached_values
    @cache.values
  end
  def cached_names
    @cache.keys
  end
  # Release the computed layers no rule left to run can need. roots: the names the remaining
  # rules look up directly ("@CONN": the connectivity). A computed layer stops the walk (its
  # own dependencies are not needed for it any more), a layer still to be computed needs its
  # dependencies. Returns the released [name, value] pairs and the needed names.
  def release_unneeded(roots, conn_names)
    need = {}
    work = roots.dup
    while (k = work.pop)
      next if need[k]
      need[k] = true
      if k == "@CONN"
        work.concat(conn_names)
        next
      end
      next if @cache.has_key?(k) || !@defs.has_key?(k)
      d = @deps[k]
      return [[], nil] if d.nil?   # unknown dependencies: keep everything
      work.concat(d)
    end
    rel = []
    @cache.keys.each do |k|
      next if need[k]
      rel << [k, @cache.delete(k)]
      @released[k] = true
    end
    [rel, need]
  end
end

# -rd release=0: keep every computed global layer to the end (the former behaviour; for
# comparisons). -rd release_check=1: check every global lookup against the static dependencies
# of the rule / layer that makes it and stop at a use after release.
$sv_release = !%w[0 false no].include?($release.to_s.downcase)
$sv_release_check = ($release_check.to_s == "1")
$sv_mem_log = ($mem_log.to_s == "1")
$sv_ctx = []
$sv_late_uses = []
$sv_cur_rule = nil
$sv_dep_sets = {}

def sv_conn_names
  $sv_conn_names ||= $sv_connects.collect { |layers, via| layers + [via] }.flatten.compact.collect(&:upcase).uniq
end

class SvScope
  def self.dep_set(deps)
    return nil if deps.nil?
    $sv_dep_sets[deps.object_id] ||= begin
      h = {}
      deps.each { |d| h[d] = true }
      h
    end
  end
  # release_check: a global lookup must be in the dependencies of the rule / global layer that
  # makes it (a CONNECT layer: through "@CONN")
  def self.dep_check(k)
    ctx = $sv_ctx[-1]
    return if ctx.nil?   # outside of any rule (dump)
    return if ctx[k]
    return if ctx["@CONN"] && $sv_conn_names_all.include?(k)
    raise "SVRF: #{$sv_cur_rule} looks up #{k}, which is not in the static dependencies"
  end
end

# ---------------------------------------------------------------------------
# Lazy operands. The generator passes the operands of the operations below as
# SvLazy, so that an operand which makes the result empty when it is empty is
# looked at first and the other one is not computed at all (e.g. M1DUM_S_7:
# an expensive spacing on all of M1, only used next to wide M1 that the
# standard cells do not have). An operand that is a plain layer name and is
# already computed is "ready" and gets probed first.
# ---------------------------------------------------------------------------

class SvLazy
  def initialize(scope = nil, name = nil, &blk)
    @s = scope
    @n = name
    @b = blk
    @done = false
  end
  def ready?
    @done || (!@s.nil? && @s.cached?(@n))
  end
  def value
    unless @done
      @v = @s ? @s[@n] : @b.call
      @done = true
    end
    @v
  end
end

def sv_lz(&blk)
  SvLazy.new(&blk)
end

def sv_lzn(scope, name)
  SvLazy.new(scope, name)
end

def sv_is_empty(l)
  l.data.is_empty?
end

# NOT / AND are empty if the first operand is
def sv_bool_lz(op, a, b)
  av = a.value
  if (op == "NOT" || op == "AND") && sv_is_empty(av)
    return sv_bool(op, av, sv_empty_poly)
  end
  sv_bool(op, av, b.value)
end

# Which operand to probe first: one that is computed already, else b if the
# generator estimated it to be the cheaper one (bfirst).
def sv_lz_bfirst(a, b, bfirst)
  return true if b.ready? && !a.ready?
  return false if a.ready?
  bfirst
end

# Edge selections are empty if the edges selected from are; and, when not
# negated and without a count (OUTSIDE EDGE selects everything on an empty
# second layer), if the selecting layer is empty.
def sv_esel_lz(kind, a, b, cons, neg, bfirst = false)
  b_cuts = !neg && kind != "outside_edge" && (cons.nil? || cons.empty?)
  if b_cuts && sv_lz_bfirst(a, b, bfirst)
    if sv_is_empty(b.value)
      return kind == "with_edge" ? sv_empty_poly : sv_empty_poly.edges
    end
  end
  av = a.value
  return sv_esel(kind, av, sv_empty_poly, cons, neg) if sv_is_empty(av)
  sv_esel(kind, av, b.value, cons, neg)
end

# Two layer EXT / INT / ENC give no pairs if either layer is empty (the result
# type depends on the options only). Not for ENC OUTSIDE ALSO (an empty second
# layer flags all of the first) and not for CONNECTED checks.
def sv_check_lz(kind, a, b, cons, opts = {}, bfirst = false)
  return sv_check(kind, a.value, nil, cons, opts) if b.nil?
  cuts = %w[ext int enc].include?(kind) && !opts[:outside_also] && opts[:connected].nil?
  if cuts
    first, other = sv_lz_bfirst(a, b, bfirst) ? [b, a] : [a, b]
    if sv_is_empty(first.value)
      av = first.equal?(a) ? a.value : sv_empty_poly
      bv = first.equal?(b) ? b.value : sv_empty_poly
      return sv_check(kind, av, bv, cons, opts)
    end
    other.value
  end
  sv_check(kind, a.value, b.value, cons, opts)
end

$sv_rules = []
$sv_dump_local = nil
if $dump
  $sv_dump_local = {}
  $dump.split(",").each { |n| $sv_dump_local[n.upcase] = true if n.include?(":") }
end
$sv_connects = []
$sv_texts = {}

def sv_switch(name, default)
  v = $sv_switches[name.upcase]
  v.nil? ? default : v
end

def sv_ifdef(name, value)
  v = $sv_defines[name.upcase]
  return false if v.nil?
  return true if value.nil?
  v.to_s.upcase == value.to_s.upcase
end

def sv_define(name, value)
  ov = $sv_overrides[name.upcase]
  $sv_defines[name.upcase] = ov.nil? ? value : ov
end

# deps: the global layers the rule may look up (generator; nil = unknown, no release)
def sv_rule(name, desc, deps = nil, &blk)
  $sv_rules << [name, desc, blk, deps]
end

def sv_connect(layers, via)
  $sv_connects << [layers, via]
end

# ---------------------------------------------------------------------------
# Basic helpers
# ---------------------------------------------------------------------------

def sv_w(obj)
  obj.min_coherence = true if obj.is_a?(RBA::Region)
  DRC::DRCLayer::new(self, obj)
end

# Calibre keeps polygons touching at a single point separate
def sv_mc(l)
  d = l.data
  d.min_coherence = true if d.is_a?(RBA::Region) && !d.min_coherence?
  l
end

def sv_kind(l)
  d = l.data
  return :poly if d.is_a?(RBA::Region)
  return :edge if d.is_a?(RBA::Edges)
  return :ep if d.is_a?(RBA::EdgePairs)
  return :text if d.is_a?(RBA::Texts)
  raise "SVRF: unknown layer type #{d.class}"
end

def sv_empty_poly
  polygons
end

# Parts of edges inside / outside a polygon layer; edges on its boundary are outside.
# Deep mode: KLayout 0.30 Edges#inside_part / #outside_part lose the edges of a child cell
# that are covered by a polygon of a parent cell only (tests/deep_edge_parts.rb; LU_S_2_*
# markers inside placed BUFX10/16H7R). The boolean operators are right, so the same result
# is built from them. Flat mode keeps the plain methods.
def sv_ein(e, b)
  $sv_flat ? e.inside_part(b) : (e & b) - b.edges
end

def sv_eout(e, b)
  $sv_flat ? e.outside_part(b) : (e - b) + (e & b.edges)
end

# to region
def sv_p(l)
  case sv_kind(l)
  when :poly then l
  when :ep then l.polygons
  when :edge then l.extended(0, 0, 1.dbu, 1.dbu)  # thin regions
  when :text then l.polygons
  end
end

# to edges
def sv_e(l)
  case sv_kind(l)
  when :poly then l.edges
  when :edge then l
  when :ep then l.edges
  else raise "SVRF: cannot convert text to edges"
  end
end

def sv_dbu_i(v)
  (v / dbu).round
end

# Integer range from constraint list. Returns [min, max) in integer units;
# nil for open ends. scale: integer units per micron (1/dbu for lengths)
def sv_irange(cons, scale)
  lo = nil
  hi = nil
  ne = []
  cons.each do |op, v|
    x = (v * scale).round
    case op
    when "<" then hi = x
    when "<=" then hi = x + 1
    when ">" then lo = x + 1
    when ">=" then lo = x
    when "==" then lo = x; hi = x + 1
    when "!=" then ne << x
    end
  end
  [lo, hi, ne]
end

# Float range [min, max) in microns (inclusive min, exclusive max).
def sv_frange(cons)
  lo, hi, ne = sv_irange(cons, 1.0 / dbu)
  [lo ? lo * dbu : nil, hi ? hi * dbu : nil, ne.collect { |x| x * dbu }]
end

def sv_cons_ok(cons, v)
  cons.all? do |op, c|
    case op
    when "<" then v < c - 1e-9
    when "<=" then v <= c + 1e-9
    when ">" then v > c + 1e-9
    when ">=" then v >= c - 1e-9
    when "==" then (v - c).abs < 1e-9
    when "!=" then (v - c).abs >= 1e-9
    end
  end
end

# count range for interact/enclose etc. (0 is never counted: Calibre
# semantics "INTERACT < 4" means 1..3)
def sv_count_range(cons)
  return [nil, nil] if cons.nil? || cons.empty?
  lo, hi, ne = sv_irange(cons, 1)
  lo = 1 if lo.nil? || lo < 1
  mx = hi ? hi - 1 : nil
  [lo, mx]
end

# call a counting selection method with optional min/max counts
def sv_cnt(a, meth, b, mn, mx)
  if mn.nil? && mx.nil?
    a.send(meth, b)
  elsif mx.nil?
    a.send(meth, b, mn)
  elsif mx < (mn || 1)
    a - a
  else
    a.send(meth, b, mn || 1, mx)
  end
end

# ---------------------------------------------------------------------------
# Input layers
# ---------------------------------------------------------------------------

$sv_input_cache = {}
def sv_input(specs)
  key = specs.inspect
  return $sv_input_cache[key] if $sv_input_cache[key]
  if specs.empty?
    r = polygons
  else
    r = nil
    specs.each do |l, d|
      x = polygons(l, d)
      r = r ? (r + x) : x
    end
  end
  sv_mc(r)
  $sv_input_cache[key] = r
  r
end

$sv_text_cache = {}
def sv_text(specs)
  key = specs.inspect
  return $sv_text_cache[key] if $sv_text_cache[key]
  r = nil
  specs.each do |l, d|
    x = labels(l, d)
    r = r ? (r + x) : x
  end
  r ||= labels(9999, 9999)
  $sv_text_cache[key] = r
  r
end

# ---------------------------------------------------------------------------
# Boolean operations
# ---------------------------------------------------------------------------

def sv_bool(op, a, b)
  ka = sv_kind(a)
  kb = sv_kind(b)
  if ka == :edge && kb == :edge
    case op
    when "AND" then return a & b
    when "OR" then return a + b
    when "NOT" then return a - b
    when "XOR" then return a ^ b
    end
  end
  if ka == :edge && kb == :poly
    # edge AND/NOT polygon: Calibre does not allow it, treat as inside/outside parts
    case op
    when "AND" then return sv_ein(a, b)
    when "NOT" then return sv_eout(a, b)
    when "OR" then return a + b.edges
    end
  end
  a = sv_mc(sv_p(a))
  b = sv_mc(sv_p(b))
  r = case op
  when "AND" then a & b
  when "OR" then a | b
  when "NOT" then a - b
  when "XOR" then a ^ b
  else raise "SVRF: unknown bool #{op}"
  end
  sv_mc(r)
end

def sv_nary(op, *ls)
  r = ls[0]
  ls[1..-1].each { |x| r = sv_bool(op, r, x) }
  r
end

def sv_copy(a)
  a
end

def sv_edge_or(a, b)
  sv_e(a) + sv_e(b)
end

# ---------------------------------------------------------------------------
# Polygon selection (INTERACT, INSIDE, OUTSIDE, TOUCH, ENCLOSE, CUT)
# ---------------------------------------------------------------------------

# Polygons of a (none overlapping b) that share an edge part of positive length
# with b. Calibre INTERACT / TOUCH do not count a contact in a single point
# (corner to corner, or a vertex on an edge); KLayout "interacting" does
# (tests/micro/exp_pttouch: NP_EN_3 missed on XNOR2X0P5H7R, whose PO meets a PP
# notch corner only and was therefore taken for a PO crossing NP / PP).
def sv_edge_touching(a, b)
  cand = a.interacting(b)
  return cand if cand.is_empty?
  bb = b.interacting(cand)
  ce = cand.edges & bb.edges
  cand.interacting(ce)
end

def sv_sel(kind, a, b, cons, neg, opts = {})
  if sv_kind(a) == :edge
    return sv_edge_layer_sel(kind, a, b, neg, opts)
  end
  a = sv_p(a)
  bk = sv_kind(b)
  b = sv_p(b) if bk == :ep || bk == :text
  mn, mx = sv_count_range(cons)
  case kind
  when "interact"
    if mn || mx
      r = sv_cnt(a, :interacting, b, mn, mx)
    elsif bk == :edge
      r = a.interacting(b)
    else
      r = a.overlapping(b) + sv_edge_touching(a.not_overlapping(b), b)
    end
    neg ? a - r : r
  when "inside"
    if bk == :edge
      # polygons inside an edge layer: never
      return neg ? a : sv_empty_poly
    end
    neg ? a.not_inside(b) : a.inside(b)
  when "outside"
    if bk == :edge
      r = a.not_interacting(b)
      return neg ? a - r : r
    end
    neg ? a.not_outside(b) : a.outside(b)
  when "enclose"
    r = sv_cnt(a, :covering, b, mn, mx)
    neg ? a - r : r
  when "touch"
    if bk == :edge
      r = sv_cnt(a, :interacting, b, mn, mx)
    elsif mn || mx
      c = a.not_overlapping(b)
      r = sv_cnt(c, :interacting, b, mn, mx)
    else
      r = sv_edge_touching(a.not_overlapping(b), b)
    end
    neg ? a - r : r
  when "cut"
    if mn || mx
      r = sv_cnt(a, :overlapping, b, mn, mx).not_inside(b)
    else
      r = a.overlapping(b).not_inside(b)
    end
    neg ? a - r : r
  else
    raise "SVRF: unknown selection #{kind}"
  end
end

# selections applied to edge layers (e.g. "X NOT INSIDE NODRC" on edges)
def sv_edge_layer_sel(kind, a, b, neg, opts)
  b = sv_p(b) if sv_kind(b) != :edge
  case kind
  when "inside"
    neg ? a.not_inside(b) : a.inside(b)
  when "outside"
    neg ? a.not_outside(b) : a.outside(b)
  when "interact", "touch"
    neg ? a.not_interacting(b) : a.interacting(b)
  else
    raise "SVRF: unsupported edge selection #{kind}"
  end
end

# selections on edge-pair layers
def sv_ep_sel(kind, a, b, neg)
  b = sv_p(b)
  case kind
  when "inside" then neg ? a.not_inside(b) : a.inside(b)
  when "outside" then neg ? a.not_outside(b) : a.outside(b)
  when "interact" then neg ? a.not_interacting(b) : a.interacting(b)
  else
    raise "SVRF: unsupported edge pair selection #{kind}"
  end
end

def sv_sel_any(kind, a, b, cons, neg, opts = {})
  if sv_kind(a) == :ep
    if kind == "inside" || kind == "outside" || (kind == "interact" && (cons.nil? || cons.empty?))
      return sv_ep_sel(kind, a, b, neg)
    end
    a = a.polygons
  end
  sv_sel(kind, a, b, cons, neg, opts)
end

# ---------------------------------------------------------------------------
# Edge selections
# ---------------------------------------------------------------------------

# center parts of edges (used to test coincidence without endpoint touching)
def sv_mid(e)
  e.centers(0, 0.5)
end

def sv_esel(kind, a, b, cons, neg, opts = {})
  ka = sv_kind(a)
  kb = sv_kind(b)
  if kind == "with_edge"
    # polygons of a which have edges from b
    ap = sv_p(a)
    be = sv_e(b)
    mn, mx = sv_count_range(cons)
    # the coincident edge parts, extended by 1 dbu into their polygon (the polygon edges keep
    # their orientation in the AND): selected by area, so a polygon touching only an end
    # point is not taken. The former test with the edge centres (centers(0, 0.5)) rounded
    # the quarter points of 45 degree edges off the polygon (tests/micro/exp_srck3: one of
    # the four corner triangles of SRCK_3 was not found).
    # The strips stay unmerged: WITH EDGE counts edges (AA_US / AA_OS: "== 1", "== 5"), and
    # merged, the strips of two edges meeting in a corner would count once (ACT_S_4).
    ce = ap.edges.data & be.data
    st = ce.extended_in(1)
    st.merged_semantics = false
    m = sv_w(st)
    r = sv_cnt(ap, :overlapping, m, mn, mx)
    return neg ? ap - r : r
  end
  ea = sv_e(a)
  b = b.polygons if kb == :ep && (kind == "inside_edge" || kind == "outside_edge")
  kb = sv_kind(b)
  case kind
  when "inside_edge"
    bp = sv_p(b)
    r = sv_ein(ea, bp)
    neg ? ea - r : r
  when "outside_edge"
    bp = sv_p(b)
    r = sv_eout(ea, bp)
    neg ? ea - r : r
  when "coin"
    r = ea & sv_e(b)
    neg ? ea - r : r
  when "coin_inside", "coin_outside"
    if ka == :poly && kb == :poly
      c = ea & b.edges
      if kind == "coin_inside"
        r = c & (a & b).edges
      else
        r = c - (a | b).edges
      end
    else
      r = ea & sv_e(b)
    end
    neg ? ea - r : r
  when "touch_edge", "touch_inside_edge", "touch_outside_edge"
    if kind != "touch_edge" && ka == :poly && kb == :poly
      c = ea & b.edges
      if kind == "touch_inside_edge"
        c = c & (a & b).edges
      else
        c = c - (a | b).edges
      end
    elsif kind != "touch_edge" && kb == :poly
      # edge layer a, polygon b: inside -> edge interior side faces b
      c = ea & b.edges
    else
      c = ea & sv_e(b)
    end
    m = sv_mid(c)
    mn, mx = sv_count_range(cons)
    r = ea.interacting(m)
    neg ? ea - r : r
  else
    raise "SVRF: unknown edge selection #{kind}"
  end
end

# ---------------------------------------------------------------------------
# SIZE
# ---------------------------------------------------------------------------

def sv_size(a, d, opts = {})
  a = sv_p(a)
  mode = opts[:mode]
  if opts[:inside_of] || opts[:outside_of]
    # Calibre: R(k+1) = size(R(k), step) clipped to the constraint layer,
    # seeded with a itself (a may be outside, e.g. touching)
    st = opts[:step] || d.abs
    steps = [(d.abs / st).ceil, 1].max
    di = sv_dbu_i(d)
    sti = (di.to_f / steps).round
    c = sv_p(opts[:inside_of] || opts[:outside_of]).data
    inside = !opts[:inside_of].nil?
    r1 = a.data.sized(sti)
    r1 = inside ? (r1 & c) : (r1 - c)
    if steps > 1
      rest = di - sti
      r = inside ? r1.sized_inside(c, rest, steps - 1) : r1.sized_outside(c, rest, steps - 1)
    else
      r = r1
    end
    return sv_w(r)
  end
  if mode == "overunder"
    return a.sized(d).sized(-d)
  elsif mode == "underover"
    return a.sized(-d).sized(d)
  end
  a.sized(d)
end

# ---------------------------------------------------------------------------
# Measurements
# ---------------------------------------------------------------------------

def sv_area(a, cons, neg = false)
  a = sv_p(a)
  lo, hi, ne = sv_irange(cons, 1.0 / (dbu * dbu))
  r = sv_w(a.data.with_area(lo, hi, false))
  ne.each { |x| r = r - sv_w(r.data.with_area(x, x + 1, false)) }
  neg ? a - r : r
end

def sv_perimeter(a, cons, neg = false)
  a = sv_p(a)
  lo, hi, ne = sv_irange(cons, 1.0 / dbu)
  r = sv_w(a.data.with_perimeter(lo, hi, false))
  neg ? a - r : r
end

def sv_length(a, cons, neg = false)
  e = sv_e(a)
  lo, hi, ne = sv_irange(cons, 1.0 / dbu)
  r = sv_w(e.data.with_length(lo, hi, false))
  ne.each { |x| r = r - sv_w(r.data.with_length(x, x + 1, false)) }
  neg ? e - r : r
end

def sv_angle(a, cons, neg = false)
  e = sv_e(a)
  lo = nil
  hi = nil
  incl_hi = false
  incl_lo = true
  ne = []
  cons.each do |op, v|
    case op
    when "<" then hi = v
    when "<=" then hi = v; incl_hi = true
    when ">" then lo = v; incl_lo = false
    when ">=" then lo = v
    when "==" then lo = v; hi = v; incl_hi = true
    when "!=" then ne << v
    end
  end
  lo ||= 0.0
  hi ||= 90.0 + 1e-6
  if lo == hi
    r = sv_w(e.data.with_abs_angle(lo, false))
  else
    r = sv_w(e.data.with_abs_angle(lo, hi, false, incl_lo, incl_hi))
  end
  ne.each { |x| r = r - sv_w(r.data.with_abs_angle(x, false)) }
  neg ? e - r : r
end

def sv_holes(a, opts = {})
  a = sv_p(a)
  h = a.holes
  if opts[:inner]
    # innermost holes: holes that do not contain another hole, i.e. no polygon of the layer
    # that has a hole itself (a hole with a plain polygon inside is still inner). Calibre,
    # tests/micro/exp_holes: the hole of an outer seal ring contains the inner ring and is
    # not inner (SRCK_6 took the outer ring for the inner one).
    # raw holes: with merged semantics a hole nested in an outer hole would vanish in it
    d = h.data.dup
    d.merged_semantics = false
    h = sv_w(d.not_overlapping(a.with_holes(1, nil).data))
  end
  if opts[:empty]
    h = h.not_interacting(a.inside(h)) if false
    h = h - h.covering(a)
  end
  if opts[:cons] && !opts[:cons].empty?
    h = sv_area(h, opts[:cons])
  end
  h
end

def sv_donut(a, cons, neg = false)
  a = sv_p(a)
  if cons.nil? || cons.empty?
    r = a.with_holes(1, nil)
  else
    lo, hi, ne = sv_irange(cons, 1)
    r = sv_w(a.data.with_holes(lo || 1, hi, false))
  end
  neg ? a - r : r
end

$sv_extent = nil
def sv_extent(opts = {})
  if opts[:layers] && !opts[:layers].empty?
    bb = RBA::Box::new
    opts[:layers].each { |l| bb += sv_p(l).data.bbox }
    r = polygons
    r.data.insert(bb) unless bb.empty?
    return r
  end
  $sv_extent ||= extent
  $sv_extent
end

def sv_extents(a)
  sv_p(a).extents
end

# ---------------------------------------------------------------------------
# Edge expansion and convexity
# ---------------------------------------------------------------------------

def sv_expand_edge(a, opts = {})
  e = sv_e(a)
  i = opts[:inside] || 0.0
  o = opts[:outside] || 0.0
  x = opts[:extend] || 0.0
  e.extended(x, x, o, i, opts[:corner_fill] ? true : false)
end

def sv_convex_edge(a, opts = {})
  a = sv_p(a)
  if opts[:count]
    c = opts[:count]
    r = nil
    [0, 1, 2].each do |n|
      if sv_cons_ok(c, n.to_f)
        part = case n
               when 0 then a.edges(concave)
               when 1 then a.edges(step)
               when 2 then a.edges(convex)
               end
        r = r ? r + part : part
      end
    end
    r ||= a.edges(convex) - a.edges
  else
    a1 = opts[:angle1]
    a2 = opts[:angle2]
    cv1 = sv_cons_ok(a1, 90.0)
    cc1 = sv_cons_ok(a1, 270.0)
    cv2 = sv_cons_ok(a2, 90.0)
    cc2 = sv_cons_ok(a2, 270.0)
    r = nil
    add = lambda { |x| r = r ? r + x : x }
    add.call(a.edges(convex)) if cv1 && cv2
    add.call(a.edges(concave)) if cc1 && cc2
    add.call(a.edges(step)) if (cv1 && cc2) || (cc1 && cv2)
    r ||= a.edges - a.edges
  end
  if opts[:length]
    r = sv_length(r, opts[:length])
  end
  r
end

# ---------------------------------------------------------------------------
# WITH WIDTH, RECTANGLE, ENCLOSE RECTANGLE
# ---------------------------------------------------------------------------

# parts of a with width >= wi (dbu): morphological opening computed on a
# 2x scaled copy, so that parts of exactly wi survive
def sv_open(a, wi)
  return a if wi <= 1
  d2 = a.data.scaled_and_snapped(1, 2, 1, 1, 2, 1)
  k = wi - 1
  o = d2.sized(-k).sized(k) & d2
  sv_w(o.scaled_and_snapped(1, 1, 2, 1, 1, 2)) & a
end

def sv_with_width(a, cons, neg = false)
  a = sv_p(a)
  lo, hi, ne = sv_irange(cons, 1.0 / dbu)
  r = lo ? sv_open(a, lo) : a
  r = r - sv_open(a, hi) if hi
  ne.each { |x| r = r - (sv_open(a, x) - sv_open(a, x + 1)) }
  neg ? a - r : r
end

def sv_with_text(a, t, pattern, neg = false)
  a = sv_p(a)
  pat = pattern.gsub("?", "*")
  tx = t.texts(pat)
  r = a.interacting(tx)
  neg ? a - r : r
end

def sv_rectangle(a, opts = {})
  a = sv_p(a)
  r = a.rectangles
  if opts[:w] || opts[:l]
    w = opts[:w] || []
    l = opts[:l] || []
    wl = sv_irange(w, 1.0 / dbu)
    ll = sv_irange(l, 1.0 / dbu)
    d = r.data
    r1 = d.with_bbox_min(wl[0], wl[1], false).with_bbox_max(ll[0], ll[1], false)
    r2 = d.with_bbox_max(wl[0], wl[1], false).with_bbox_min(ll[0], ll[1], false)
    r = sv_w(r1) | sv_w(r2)
  end
  if opts[:aspect]
    c = opts[:aspect]
    sel = nil
    if c.size == 1 && c[0][0] == "=="
      sel = r.data.with_bbox_aspect_ratio(c[0][1], c[0][1] + 1e-6, false)
    elsif c.size == 1 && c[0][0] == "!="
      sel = r.data.with_bbox_aspect_ratio(c[0][1], c[0][1] + 1e-6, true)
    else
      lo = nil; hi = nil
      c.each do |op, v|
        case op
        when "<" then hi = v
        when "<=" then hi = v + 1e-6
        when ">" then lo = v + 1e-6
        when ">=" then lo = v
        end
      end
      sel = r.data.with_bbox_aspect_ratio(lo, hi, false)
    end
    r = sv_w(sel)
  end
  opts[:neg] ? a - r : r
end

def sv_enclose_rect(a, w, l, opts = {})
  a = sv_p(a)
  wi = sv_dbu_i(w)
  li = sv_dbu_i(l)
  r = nil
  [[wi, li], [li, wi]].uniq.each do |x, y|
    kx = (x + 1) / 2 - 1
    ky = (y + 1) / 2 - 1
    kx = 0 if kx < 0
    ky = 0 if ky < 0
    rx = x - 2 * kx
    ry = y - 2 * ky
    s = sv_w(a.data.sized(-kx, -ky, 2))
    s = sv_w(s.data.with_bbox_width(rx, nil, false).with_bbox_height(ry, nil, false))
    sel = a.interacting(s)
    r = r ? r | sel : sel
  end
  opts[:neg] ? a - r : r
end

# ---------------------------------------------------------------------------
# Corner detection (ABUT == 90 INTERSECTING ONLY constructs)
# ---------------------------------------------------------------------------

def sv_corner_boxes_from_edges(e1, e2, d)
  # points where an edge of e1 meets an edge of e2 at 90 degrees
  h1 = e1.with_angle(0)
  v1 = e1.with_angle(90)
  h2 = e2.with_angle(0)
  v2 = e2.with_angle(90)
  x = 1.dbu
  bh1 = h1.extended(x, x, x, x)
  bv1 = v1.extended(x, x, x, x)
  bh2 = h2.extended(x, x, x, x)
  bv2 = v2.extended(x, x, x, x)
  ((bh1 & bv2) | (bv1 & bh2))
end

def sv_corner_check(kind, a, b, d, opts)
  out = opts[:out]
  if b.nil? && sv_kind(a) == :poly
    # single polygon layer: EXT -> concave corners, INT -> convex corners
    ang = (kind == "ext") ? 90 : -90
    c = a.corners(as_boxes, ang)
    if out
      e = a.edges
      return sv_ein(e, c.sized(d))
    end
    # Calibre produces a triangle with legs d in the exterior (EXT) or
    # interior (INT) quadrant of the corner; use the quadrant square
    di = sv_dbu_i(d)
    q = c.sized(d - 1.dbu)
    q = (kind == "ext") ? (q - a) : (q & a)
    # triangle: clip the quadrant square with a diamond |dx|+|dy| <= d
    dia = RBA::Polygon::new([RBA::Point::new(-di, 0), RBA::Point::new(0, di), RBA::Point::new(di, 0),
                             RBA::Point::new(0, -di)])
    pts = a.corners(as_dots, ang)
    cd = pts.data
    cd = cd.dup.tap { |x| x.flatten } if cd.is_deep?
    dr = RBA::Region::new
    cd.each { |e| dr.insert(dia.moved(e.p1.x, e.p1.y)) }
    return q & sv_w(dr)
  end
  e1 = sv_e(a)
  e2 = b.nil? ? e1 : sv_e(b)
  c = sv_corner_boxes_from_edges(e1, e2, d)
  if out
    oe = (out == 2) ? e2 : e1
    ref = (out == 2) ? e1 : e2
    sel = oe.interacting(c) - (oe & ref)
    # the piece of length d from the corner along the edge only (MET1_S_5, H7CR: an edge
    # selected at one corner had output near another corner it does not pass through, the far
    # M1 edge 0.09 from a line end); c are 2 dbu boxes around the corner points, d - 1 dbu
    # reaches d from the point: the length of Calibre's pieces ("INT LINE_SIDE [M1] < 0.11":
    # 0.110, was 0.111)
    dd = d - 1.dbu
    hs = sel.with_angle(0)
    vs = sel.with_angle(90)
    rest = sel - hs - vs
    r = sv_ein(hs, c.sized(dd, 0.0)) + sv_ein(vs, c.sized(0.0, dd))
    r = r + sv_ein(rest, c.sized(dd)) unless rest.is_empty?
    return r.interacting(c)
  end
  c.sized(d * 0.5)
end

# ---------------------------------------------------------------------------
# Dimensional checks: EXT / INT / ENC
# ---------------------------------------------------------------------------

# ANGLED constraint of a dimensional check: keep the edge pairs whose number of non-orthogonal
# edges (0, 1 or 2) satisfies it. The seal ring checks use "ANGLED < 1" so that the 45 degree
# corners are not measured (SRCK_4 / 5 / 6 / 8 / 10: without it, the joints of the straight and
# the 45 degree edges were measured, tests/sealring).
def sv_angled(ep, cons)
  ok = [0, 1, 2].select do |n|
    cons.all? do |op, v|
      case op
      when "<" then n < v
      when "<=" then n <= v
      when ">" then n > v
      when ">=" then n >= v
      when "==" then n == v
      when "!=" then n != v
      else true
      end
    end
  end
  d = ep.data
  ortho = RBA::Edges::OrthoEdges
  # KLayout 0.30: with_angle(ORTHO, false) = at least one edge orthogonal, (.., true) = at
  # least one edge not orthogonal; with_angle_both(ORTHO, false / true) = both edges
  # orthogonal / both not orthogonal
  r = case ok
      when [0, 1, 2] then d
      when [0] then d.with_angle_both(ortho, false)
      when [0, 1] then d.with_angle(ortho, false)
      when [1, 2] then d.with_angle(ortho, true)
      when [2] then d.with_angle_both(ortho, true)
      when [] then RBA::EdgePairs::new
      else
        # [1] / [0, 2]: count per pair (no constraint in the decks uses these)
        f = d.is_deep? ? d.dup.tap { |x| x.flatten } : d
        out = RBA::EdgePairs::new
        f.each do |p|
          n = [p.first, p.second].count { |e| e.dx != 0 && e.dy != 0 }
          out.insert(p) if ok.include?(n)
        end
        out
      end
  sv_w(r)
end

def sv_check(kind, a, b, cons, opts = {})
  # distance limits
  lo = nil
  hi = nil
  cons.each do |op, v|
    case op
    when "<" then hi = v
    when "<=" then hi = v + dbu
    when ">" then lo = v + dbu
    when ">=" then lo = v
    when "==" then lo = v; hi = v + dbu
    end
  end
  abut = opts[:abut]
  abut90 = abut && abut.any? { |op, v| op == "==" && v == 90.0 }
  if abut90 && (opts[:intersecting] == "only" || (hi || 0) <= 0.0101)
    # corner detection idiom
    return sv_corner_check(kind, a, b, hi || dbu, opts)
  end
  if opts[:intersecting] == "only"
    return sv_corner_check(kind, a, b, hi || dbu, opts)
  end
  if hi.nil?
    raise "SVRF: unbounded check"
  end

  ka = sv_kind(a)
  ka = :edge if ka == :ep
  a = sv_e(a) if ka == :edge
  if b
    kb = sv_kind(b)
    kb = :edge if kb == :ep
    b = sv_e(b) if kb == :edge
    if ka == :edge && kb == :poly
      bpoly = b
      b = b.edges
      kb = :edge
    elsif ka == :poly && kb == :edge
      a = a.edges
      ka = :edge
    end
  end
  edge_mode = (ka == :edge)

  args = [hi]
  case opts[:metric]
  when "opposite", "opposite_extended", "opposite_symmetric", "opposite_fsymmetric"
    args << projection
  when "square"
    args << square
  else
    args << euclidian
  end
  if abut
    lim = 90.0
    abut.each { |op, v| lim = v if op == "<" ; lim = v + 1e-3 if op == "<=" }
    lim = 180.0 if abut.any? { |op, v| op == "<" && v >= 180 }
    lim = 91.0 if abut90   # also measure perpendicular edges
    args << angle_limit(lim) if lim != 90.0
  end
  if opts[:projecting]
    pl, ph, _ = sv_frange(opts[:projecting])
    args << projection_limits(pl, ph)
  end
  eargs = args.dup
  unless edge_mode
    args << (opts[:exclude_shielded] ? shielded : transparent)
  end
  nargs = args.dup
  conn = nil
  conn = opts[:connected] if !opts[:connected].nil? && !edge_mode
  run = lambda do |a, b, args|
    ep = nil
    swap = false
    # first: layer a edges; second: layer b edges (if any)
    case kind
    when "ext"
      if b.nil?
        if opts[:notch]
          ep = a.notch(*args)
        elsif opts[:space]
          ep = a.isolated(*args)
        else
          ep = a.space(*args)
        end
        swap = false
      else
        ep = a.separation(b, *args)
        swap = false
      end
    when "int"
      if b.nil?
        ep = a.width(*args)
      else
        ep = a.overlap(b, *args)
      end
      swap = false
    when "enc"
      raise "SVRF: ENC needs two layers" if b.nil?
      if !edge_mode && conn.nil?
        # Calibre only measures layer1 edges inside (or coincident with the
        # inside of) layer2
        ae = a.edges
        be = b.edges
        ain = sv_ein(ae, b) + ((ae & be) & (a & b).edges)
        ep = be.enclosing(ain, *eargs)
        ep = sv_enc_drop_across(ep, b, hi, opts[:metric]) unless ep.is_empty?
      else
        ep = b.enclosing(a, *args)
      end
      swap = true
    end
    [ep, swap]
  end
  if conn.nil?
    ep, swap = run.call(a, b, args)
  else
    # CONNECTED / NOT CONNECTED: the pairs are a subset of the same check without the net
    # condition; when that is empty no net extraction is needed (WP5: DNW_S_2a and the other
    # net aware rules built the connectivity of the whole filled chip for nothing)
    ep, swap = run.call(a, b, nargs)
    unless ep.is_empty?
      # the pairs without the net condition are only this test: freed before the net aware
      # check (PO_S_14: every AA / poly pair at every gate, ~1.6 GB on a 5000 cell block)
      ep.data._destroy if $sv_release
      ep = nil
      args << (conn ? props_eq : props_ne)
      a = sv_nets(a, opts[:netbase_a])
      b = sv_nets(b, opts[:netbase_b]) if b
      ep, swap = run.call(a, b, args)
    end
  end
  if abut.nil?
    # without ABUT, Calibre does not measure abutting/coincident edges
    ep = sv_w(ep.data.with_distance(1, nil, false))
  end
  if lo
    ep = sv_w(ep.data.with_distance(sv_dbu_i(lo), nil, false))
  end
  if kind == "ext" && edge_mode && bpoly && !ep.is_empty?
    # EXT edges polygons: a pair measured through the interior of the polygon the first edge
    # belongs to (a 45 degree M1 edge and the end of a foot of the same polygon behind the bar
    # in between: MET1_S_4, H7CR; Calibre: nothing) is no space. Pairs not outside the polygons
    # are looked at: the shortest connection of their edges must not cross that interior.
    cd = ep.data.not_outside(bpoly.data)
    unless cd.is_empty?
      cdf = cd.is_deep? ? cd.dup.tap { |x| x.flatten } : cd
      bidx = sv_area_index(bpoly.data)
      bad = {}
      cdf.each do |p|
        q1, q2 = sv_closest(p.first, p.second)
        next if q1.sq_distance(q2) < 4
        seg = RBA::Edge::new(q1, q2)
        # through the polygon of the first edge (a connection that only grazes the corner of
        # the other polygon is measured: MET1_S_4, H7CR, a 45 degree edge to an M1 notch corner)
        own = RBA::Region::new
        c, li = bidx
        c.shapes(li).each_touching(p.first.bbox) { |sh| q = sh.polygon; own.insert(q) if q.touches?(p.first) }
        next if own.is_empty?
        bad[p.to_s] = true if (RBA::Edges::new(seg).inside_part(own) - own.edges).length > 2
      end
      unless bad.empty?
        dd = ep.data
        dd = dd.dup.tap { |x| x.flatten } if dd.is_deep?
        keep = RBA::EdgePairs::new
        dd.each { |p| keep.insert(p) unless bad[p.to_s] }
        ep = sv_w(keep)
      end
    end
  end
  if kind == "ext" && !edge_mode && b.nil? && !ep.is_empty?
    # Calibre measures exterior space only: drop pairs measured across the
    # interior of the polygon that owns both edges (e.g. corner to corner
    # across a jog). Pairs between different polygons are kept even if a
    # third shape lies in between.
    cand = ep.polygons.overlapping(a)
    unless cand.is_empty?
      # only pairs whose region overlaps the layer need the (slow) test
      rest = sv_w(ep.data.not_interacting(cand.data))
      sus = sv_w(ep.data.interacting(cand.data))
      ar = a.overlapping(cand).data
      ar = ar.dup.tap { |x| x.flatten } if ar.is_deep?
      epd = sus.data
      epd = epd.dup.tap { |x| x.flatten } if epd.is_deep?
      if epd.count > 200000
        log("SVRF: too many candidate pairs (#{epd.count}) - interior filter skipped")
        epd = RBA::EdgePairs::new
        rest = ep
      end
      keep = RBA::EdgePairs::new
      # spatial index for the candidate owner polygons
      sh = RBA::Shapes::new
      am = ar.dup
      am.min_coherence = true
      am.merged_semantics = true
      am.merge
      am.each { |pp| sh.insert(pp) }
      epd.each do |p|
        q = RBA::Region::new(p.polygon(0))
        drop = false
        if q.area > 0
          loc = RBA::Region::new
          sh.each_touching(q.bbox) { |x| loc.insert(x.polygon) }
          owners = loc.overlapping(q)
          unless owners.is_empty?
            pe = owners.edges
            e1 = RBA::Edges::new(p.first)
            e2 = RBA::Edges::new(p.second)
            drop = (e1 - pe).is_empty? && (e2 - pe).is_empty?
            # the space between the edges is covered by the layer: measured through the interior
            drop ||= (q - owners).is_empty?
          end
        end
        keep.insert(p) unless drop
      end
      ep = rest + sv_w(keep)
    end
    # a pair of the two vertices of a corner to corner measurement (zero area) between two
    # concave corners of one polygon, through its interior (PO_S_1, H7CR: a 0.11 x 0.047
    # diagonal across a poly bar; Calibre: nothing): dropped when the middle of the
    # connection lies inside the layer
    dg = ep.data.with_area(0, 1, false)
    unless dg.is_empty?
      dgf = dg.is_deep? ? dg.dup.tap { |x| x.flatten } : dg
      ic, il = sv_area_index(a.data)
      bad = RBA::EdgePairs::new
      dgf.each do |p|
        c1 = p.first.bbox.center
        c2 = p.second.bbox.center
        next if c1.sq_distance(c2) < 4    # zero distance pairs (abutting edges)
        m = RBA::Point::new(((c1.x + c2.x) / 2.0).round, ((c1.y + c2.y) / 2.0).round)
        inside = false
        ic.shapes(il).each_touching(RBA::Box::new(m, m)) do |sh2|
          q = sh2.polygon
          inside = true if q.inside?(m) && !q.each_edge.any? { |e| e.contains?(m) }
        end
        bad.insert(p) if inside
      end
      unless bad.is_empty?
        ok = ep.data.with_area(1, nil, false)
        keepd = RBA::EdgePairs::new
        bs = {}
        bad.each { |b2| bs[b2.to_s] = true }
        dgf.each { |p| keepd.insert(p) unless bs[p.to_s] }
        ep = sv_w(ok) + sv_w(keepd)
      end
    end
  end
  if opts[:parallel] == "only"
    ep = ep.with_internal_angle(0)
  elsif opts[:parallel] == "not"
    ep = ep.without_internal_angle(0)
  end
  if abut90
    # drop degenerate (point-like) edge pairs
    ep = sv_w(ep.data.with_length_both(1, nil, false))
  end
  if opts[:perp] == "only"
    ep = ep.with_internal_angle(90)
  elsif opts[:perp] == "not"
    ep = ep.without_internal_angle(90)
  end
  if opts[:angled]
    ep = sv_angled(ep, opts[:angled])
  end
  if opts[:not_projecting]
    # keep only pairs with no projection: approximation - corner pairs
    ep = ep.without_internal_angle(0)
  end
  if conn != nil
    ep = sv_w(ep.data.remove_properties) rescue ep
  end

  extra = nil
  if opts[:outside_also] && kind == "enc"
    # parts of a outside b count as violations
    ap = edge_mode ? nil : a
    if ap
      # pieces of a outside b that carry edges of a (holes of b inside a,
      # e.g. metal slots, are not flagged)
      oe = sv_eout(ap.edges, b)
      extra = (ap - b).interacting(oe) unless oe.is_empty?
    end
  end

  ray = nil
  if kind == "enc" && b && !edge_mode && lo.nil? && conn.nil? && opts[:metric].to_s.start_with?("opposite")
    ep, ray = sv_enc_ray(ep, a, b, hi)
  end
  out = opts[:out]
  if out
    if b.nil?
      r = ep.edges
    else
      first = swap ? ep.second_edges : ep.first_edges
      second = swap ? ep.first_edges : ep.second_edges
      r = (out == 1) ? first : second
    end
    if extra && out == 1
      r = r + sv_eout(sv_e(a), b)
    end
    if ray && out == 1
      r = r + ray[0]
    end
    return r
  end
  if opts[:region]
    r = sv_ep_region(ep, swap)
    r = r + ray[1] if ray
    if conn != nil && extra.nil?
      # regions of different nets stay separate polygons in Calibre
      return sv_conn_region(ep, a, b)
    end
    r = r | extra if extra
    # regions that touch in a single point stay separate polygons (Calibre: PO_S_2, H7CR, the
    # regions on two sides of a corner; merged, the polygon with a long edge took the other along)
    return sv_w(r.data.merged(true, 0))
  end
  if extra
    return sv_ep_region(ep, swap) | extra
  end
  ep
end

# REGION output of a CONNECTED / NOT CONNECTED check: one polygon per edge pair, except that
# edge pair polygons that overlap or touch and lie between the same two polygons are merged.
# Calibre writes one region per pair of polygons: the two crossing edge pairs KLayout finds
# between the corners of two contacts (H7CR CT_S_2) are one Calibre polygon, their union.
# Regions of different pairs stay apart. a, b: the net annotated layers (b nil: single layer).
def sv_conn_region(ep, a, b)
  rr = ep.polygons.raw
  d = ep.data
  return rr if d.count < 2
  d = d.dup.tap { |x| x.flatten } if d.is_deep?
  pairs = []
  d.each { |p| pairs << p }
  polys = pairs.collect { |p| p.normalized.polygon(0) }   # as EdgePairs#polygons (no bow ties)
  # candidate pairs: polygons that overlap or share an edge piece (the two edge pairs of a corner
  # pair cross, their common area can be below one dbu; PO_S_14: two pairs of an L-shaped region)
  grid = Hash.new { |h, k| h[k] = [] }
  g = 2000
  polys.each_with_index do |q, i|
    bb = q.bbox
    (bb.left.div(g)..bb.right.div(g)).each { |gx| (bb.bottom.div(g)..bb.top.div(g)).each { |gy| grid[[gx, gy]] << i } }
  end
  cand = {}
  grid.each_value do |l|
    l.combination(2) do |i, j|
      next if cand[[i, j]] || !polys[i].bbox.touches?(polys[j].bbox)
      # overlap or a common edge piece; a single point does not join them (Calibre: PO_S_14,
      # two regions on the corner of an AA notch stay apart)
      rg = RBA::Region::new(polys[i])
      rg.insert(polys[j])
      cand[[i, j]] = rg.merged(true, 0).count == 1
    end
  end
  cand.select! { |_, v| v }
  return rr if cand.empty?
  # nets of the edges of the candidates
  idx = cand.keys.flatten.uniq
  # the polygon an edge lies on: its index in the layer and its net (one pass over the layer;
  # Region#interacting would drop the net properties)
  owners_of = lambda do |l, edges|
    eg = Hash.new { |h, k| h[k] = [] }
    edges.each_with_index do |e, n|
      bb = e.bbox
      (bb.left.div(g)..bb.right.div(g)).each { |gx| (bb.bottom.div(g)..bb.top.div(g)).each { |gy| eg[[gx, gy]] << n } }
    end
    res = {}
    ld = l.data
    ld = ld.dup.tap { |x| x.flatten } if ld.is_deep?
    pi = 0
    ld.each do |p|
      bb = p.bbox
      (bb.left.div(g)..bb.right.div(g)).each do |gx|
        (bb.bottom.div(g)..bb.top.div(g)).each do |gy|
          eg.fetch([gx, gy], []).each { |n| res[n] ||= [pi, p.property(1)] if bb.touches?(edges[n].bbox) && p.touches?(edges[n]) }
        end
      end
      pi += 1
    end
    res
  end
  o1 = owners_of.call(a, idx.collect { |i| pairs[i].first })
  o2 = owners_of.call(b || a, idx.collect { |i| pairs[i].second })
  # key: the pair of polygons (single layer: unordered)
  key = {}
  idx.each_with_index do |i, n|
    k = [o1[n], o2[n]]
    k = k.sort_by(&:to_s) if b.nil?
    key[i] = (o1[n].nil? || o2[n].nil?) ? [:none, i] : k
  end
  parent = {}
  find = lambda { |i| parent[i] ||= i; parent[i] == i ? i : (parent[i] = find.call(parent[i])) }
  merged_any = false
  cand.each_key do |i, j|
    next unless key[i] == key[j]
    ri, rj = find.call(i), find.call(j)
    next if ri == rj
    parent[ri] = rj
    merged_any = true
  end
  return rr unless merged_any
  groups = Hash.new { |h, k| h[k] = RBA::Region::new }
  r = RBA::Region::new
  polys.each_with_index do |q, i|
    if parent.has_key?(i)
      groups[find.call(i)].insert(q)
    else
      r.insert(q)
    end
  end
  # in place: "r += " copied r for every group (PO_S_14: ~2800 groups of a 5000 cell block,
  # 1.6 GB of copies the GC had not freed yet)
  groups.each_value { |gr| gr.merged.each { |q| r.insert(q) } }
  r.merged_semantics = false
  DRC::DRCLayer::new(self, r)
end

# ENC: the edge check also pairs a layer1 edge with a layer2 edge that is shielded from it by
# other layer2 edges: a layer1 edge coincident with the edge of its layer2 polygon and a thin
# layer2 polygon 1 um further (IO filler cells, RV_EN_1_2 / RV_EN_3_4), or the far side of a slot
# in the same polygon. Calibre does not measure those, and does measure a skewed pair at a jog
# whose straight connection cuts the corner (PP_EN_3); KLayout's shielded region check makes the
# same distinction (disc/rvm, disc/ppc). The pairs not inside layer2 are checked one by one with
# it: the layer1 edge as a 1 dbu sliver against the layer2 polygons around the pair.
def sv_enc_drop_across(ep, b, dist, metric)
  d = ep.data
  inside = d.inside(b.data)
  rest = d.not_inside(b.data)
  return ep if rest.is_empty?
  rest = rest.dup.tap { |x| x.flatten } if rest.is_deep?
  c, li = sv_area_index(b.data)
  di = (dist / dbu).round + 2
  m = case metric
      when "opposite", "opposite_extended", "opposite_symmetric", "opposite_fsymmetric" then RBA::Region::Projection
      when "square" then RBA::Region::Square
      else RBA::Region::Euclidian
      end
  keep = RBA::EdgePairs::new
  rest.each do |p|
    eb, ea = p.first, p.second
    lb = RBA::Region::new
    c.shapes(li).each_touching(p.bbox.enlarged(di, di)) { |sh| lb.insert(sh.polygon) }
    sl = RBA::Edges::new(ea).extended_in(1)
    chk = lb.enclosing_check(sl, di, false, m, nil, nil, nil, true)
    ebs = RBA::Edges::new(eb)
    keep.insert(p) if chk.each.any? { |q| !(RBA::Edges::new(q.first) & ebs).is_empty? }
  end
  sv_w(inside) + sv_w(keep)
end

# ENC ... OPPOSITE against a non-orthogonal layer2 edge: Calibre measures the enclosure of each
# point of the layer1 edge along its normal (a 45 degree M1 edge 0.025 from the corner of a contact
# fails "ENC [CT] M1 < 0.04 OPPOSITE" over the first 0.015 of the contact edge: disc/ct4m), the
# projection metric of KLayout projects perpendicular to the other edge (a piece 0.015 - 0.022 up).
# For the axis parallel layer1 edges inside layer2 whose normal of length d leaves layer2 at a
# non-orthogonal boundary, the pairs with a non-parallel layer2 edge are replaced by the parts
# of the edge that fail along the normal and, for REGION output, the area between them and the
# layer2 boundary. Returns [edge pairs, [edges, region]] or [edge pairs, nil].
def sv_enc_ray(ep, a, b, d)
  # "< d": the exterior has to start before d; at exactly d the piece in the box has no area
  di = sv_dbu_i(d)
  return [ep, nil] if di <= 0
  e = sv_ein(a.edges, b).data
  e = e.dup.tap { |x| x.flatten } if e.is_deep?
  e = e.with_angle(0, false) + e.with_angle(90, false)
  return [ep, nil] if e.is_empty?
  bd = b.data
  bd = bd.dup.tap { |x| x.flatten } if bd.is_deep?
  ex = (e.extended_out(di) - bd).non_rectilinear
  return [ep, nil] if ex.is_empty?
  cand = e.interacting(ex.sized(di))
  return [ep, nil] if cand.is_empty?
  idx = sv_area_index(bd)
  oe = RBA::Edges::new
  orr = RBA::Region::new
  cand.each do |ed|
    box = RBA::Edges::new(ed).extended_out(di)
    loc = sv_area_local(idx, box.bbox.enlarged(2, 2))
    pcs = box - loc
    next if pcs.is_empty?
    vert = ed.dx == 0
    lo1, hi1 = vert ? [[ed.y1, ed.y2].min, [ed.y1, ed.y2].max] : [[ed.x1, ed.x2].min, [ed.x1, ed.x2].max]
    bb0 = box.bbox
    pcs.merged.each do |pc|
      bb = pc.bbox
      l, h = vert ? [bb.bottom, bb.top] : [bb.left, bb.right]
      l = [l, lo1].max
      h = [h, hi1].min
      next if h <= l
      if vert
        oe.insert(ed.y1 < ed.y2 ? RBA::Edge::new(ed.x1, l, ed.x1, h) : RBA::Edge::new(ed.x1, h, ed.x1, l))
        (RBA::Region::new(RBA::Box::new(bb0.left, l, bb0.right, h)) & loc).each { |q| orr.insert(q) }   # in place, "orr +=" copied it per piece
      else
        oe.insert(ed.x1 < ed.x2 ? RBA::Edge::new(l, ed.y1, h, ed.y1) : RBA::Edge::new(h, ed.y1, l, ed.y1))
        (RBA::Region::new(RBA::Box::new(l, bb0.bottom, h, bb0.top)) & loc).each { |q| orr.insert(q) }   # in place, "orr +=" copied it per piece
      end
    end
  end
  return [ep, nil] if oe.is_empty?
  # drop the pairs of these edges with non-parallel layer2 edges
  dd = ep.data
  par = dd.with_internal_angle(0, false)
  np = dd.with_internal_angle(0, true)
  unless np.is_empty?
    np = np.dup.tap { |x| x.flatten } if np.is_deep?
    ce = cand.dup
    keep = RBA::EdgePairs::new
    np.each do |p|
      ea = p.second
      ax = ea.dx == 0 || ea.dy == 0
      keep.insert(p) unless ax && !(RBA::Edges::new(ea) & ce).is_empty?
    end
    ep = sv_w(par) + sv_w(keep)
  end
  [ep, [sv_w(oe), sv_w(orr)]]
end

# closest points of two edges
def sv_closest(e1, e2)
  best = nil
  [[e1.p1, e2, true], [e1.p2, e2, true], [e2.p1, e1, false], [e2.p2, e1, false]].each do |pt, e, first|
    dx = (e.p2.x - e.p1.x).to_f
    dy = (e.p2.y - e.p1.y).to_f
    l2 = dx * dx + dy * dy
    t = l2 > 0 ? (((pt.x - e.p1.x) * dx + (pt.y - e.p1.y) * dy) / l2) : 0.0
    t = [[t, 0.0].max, 1.0].min
    q = RBA::Point::new((e.p1.x + t * dx).round, (e.p1.y + t * dy).round)
    d = pt.sq_distance(q)
    best = [d, first ? [pt, q] : [q, pt]] if best.nil? || d < best[0]
  end
  best[1]
end

# edge pairs to regions; zero-distance pairs become thin strips like Calibre
def sv_ep_region(ep, inner_second = false)
  z = sv_w(ep.data.with_distance(0, 1, false))
  nz = sv_w(ep.data.with_distance(1, nil, false))
  r = nz.polygons
  unless z.is_empty?
    if inner_second
      # ENC: strip on the inside of the enclosed edge
      r = r | z.second_edges.extended_in(4.dbu)
    else
      r = r | z.polygons(2.dbu)
    end
  end
  r
end

# ---------------------------------------------------------------------------
# RECTANGLE ENCLOSURE
# ---------------------------------------------------------------------------

# goods: list of specs; each spec is a list of 4 [value, opposite] pairs given
# cyclically around the rectangle.
def sv_rect_enc(a, b, goods, opts = {})
  a = sv_p(a)
  b = sv_p(b)
  rects = a.rectangles
  bad_all = nil
  # parts outside b
  outside = rects.interacting(rects - b)
  cache = {}
  # a value with OPPOSITE is measured in the projection of the side, one without it euclidean:
  # a concave layer2 corner diagonal to the corner of the rectangle counts (Calibre, tests in
  # disc/renc: V1 in M1 with all sides >= 0.03 but a notch corner 0.0255 away fails
  # "0.03 0.03 0.03 0.03 OPPOSITE", the same notch passes "0 0.04 OPPOSITE 0 0.04 OPPOSITE")
  fail_dir = lambda do |t, eu|
    k = [t, eu]
    next cache[k] if cache[k]
    if t <= 0.0
      cache[k] = [outside, outside]
      next cache[k]
    end
    ep = b.enclosing(rects, t, eu ? euclidian : projection, transparent)
    if eu
      # euclidean: an edge of layer2 that only touches the rectangle in a point (a concave
      # layer2 corner on the corner of the rectangle, a collinear edge ending there) is no
      # enclosure of 0 (H7CR CT_EN_4a_4b_4c: a contact with M1 notches at two corners; Calibre:
      # clean); coincident edges are
      z = ep.data.with_distance(0, 1, false)
      unless z.is_empty?
        zf = z.is_deep? ? z.dup.tap { |x| x.flatten } : z
        keep = RBA::EdgePairs::new
        zf.each { |p| keep.insert(p) if (RBA::Edges::new(p.first) & RBA::Edges::new(p.second)).length > 0 }
        ep = sv_w(ep.data.with_distance(1, nil, false)) + sv_w(keep)
      end
    end
    ie = ep.second_edges
    fh = rects.interacting(ie.with_angle(0)) | outside   # bottom/top sides fail
    fv = rects.interacting(ie.with_angle(90)) | outside  # left/right sides fail
    cache[k] = [fh, fv]
  end
  goods.each do |spec|
    vals = spec.collect { |v, o| v }
    opp = spec.collect { |v, o| o }
    vals = vals + [vals[-1]] * (4 - vals.size) if vals.size < 4
    opp = opp + [opp[-1]] * (4 - opp.size) if opp.size < 4
    # sides are given cyclically: s0, s1, s2, s3 ; s0/s2 opposite, s1/s3 opposite
    p = [vals[0], vals[2]].max
    q = [vals[1], vals[3]].max
    # a pair is measured euclidean when one of its values is
    fhp, fvp = fail_dir.call(p, !(opp[0] && opp[2]))
    fhq, fvq = fail_dir.call(q, !(opp[1] && opp[3]))
    # orientation 1: vertical sides (left/right) need p, horizontal sides need q
    bad1 = fvp | fhq
    # orientation 2: vertical sides need q, horizontal need p
    bad2 = fvq | fhp
    bad = bad1 & bad2
    bad_all = bad_all ? (bad_all & bad) : bad
  end
  bad_all ||= rects - rects
  bad_all
end

# ---------------------------------------------------------------------------
# DENSITY
# ---------------------------------------------------------------------------

# Density windows: the merged, flat layer in a box tree (a Shapes container of a scratch
# layout), so each window only clips the polygons that overlap it. The former
# "(whole layer & window).area" per window scanned the whole layer ~1000 times per rule (a
# filled 1.6 mm chip: hours for the density rules alone).
$sv_area_ly = nil
def sv_area_index(region)
  $sv_area_ly ||= RBA::Layout::new.tap { |x| x.dbu = 0.001 }
  ly = $sv_area_ly
  c = ly.create_cell("IDX")
  li = ly.layer
  f = region.dup
  f.flatten if f.is_deep?
  f.merged.each { |p| c.shapes(li).insert(p) }
  [c, li]
end

def sv_area_local(idx, bx)
  c, li = idx
  loc = RBA::Region::new
  c.shapes(li).each_overlapping(bx) { |sh| loc.insert(sh.polygon) }
  loc & RBA::Region::new(bx)
end

def sv_density(layers, cons, opts = {})
  l = sv_p(layers[0])
  layers[1..-1].each { |x| l = l | sv_p(x) } if layers.size > 1
  ext = sv_extent.data.bbox
  bound = nil
  if opts[:inside_of_layer]
    bound = sv_p(opts[:inside_of_layer])
    ext = bound.data.bbox
  end
  return polygons if ext.empty?
  win = opts[:window]
  r = RBA::Region::new
  bflat = nil
  if bound
    bflat = bound.data.dup
    bflat.flatten
  end
  boxes = []
  if win.nil?
    boxes << ext
  else
    wx = sv_dbu_i(win)
    wy = sv_dbu_i(opts[:window_y] || win)
    sx = sv_dbu_i(opts[:step] || win)
    sy = sv_dbu_i(opts[:step_y] || opts[:step] || win)
    x = ext.left
    while true
      y = ext.bottom
      x1 = x
      x2 = x + wx
      if x2 > ext.right
        if opts[:backup]
          x1 = [ext.right - wx, ext.left].max
          x2 = ext.right
        else
          x2 = ext.right
        end
      end
      while true
        y1 = y
        y2 = y + wy
        if y2 > ext.top
          if opts[:backup]
            y1 = [ext.top - wy, ext.bottom].max
            y2 = ext.top
          else
            y2 = ext.top
          end
        end
        boxes << RBA::Box::new(x1, y1, x2, y2)
        break if y + wy >= ext.top
        y += sy
      end
      break if x + wx >= ext.right
      x += sx
    end
  end
  # window densities, cached: the _min / _max rules of a layer measure the same windows
  # (the cache keeps the layer objects alive, so their object ids cannot be reused)
  key = [l.data.object_id, bound ? bound.data.object_id : nil, boxes.size, boxes[0], boxes[-1]]
  $sv_density_cache ||= {}
  hit = $sv_density_cache[key]
  dens = hit ? hit[2] : nil
  unless dens
    lidx = sv_area_index(l.data)
    bidx = bound ? sv_area_index(bound.data) : nil
    dens = {}
    boxes.each do |bx|
      if bidx
        wr = sv_area_local(bidx, bx)
        wa = wr.area
        next if wa <= 0
        a = (sv_area_local(lidx, bx) & wr).area
      else
        wa = bx.area
        next if wa <= 0
        a = sv_area_local(lidx, bx).area
      end
      dens[bx] = a.to_f / wa
    end
    $sv_density_cache[key] = [l.data, bound ? bound.data : nil, dens, [lidx, bidx].compact]
  end
  if opts[:gradient]
    # compare neighbouring windows
    g = opts[:gradient]
    keys = dens.keys
    bad = {}
    keys.each do |k1|
      keys.each do |k2|
        next if k1 == k2
        # neighbours (Calibre, tests in disc/grad_m): the next window of the same row or the
        # same column only; not diagonal ones and not a BACKUP window that overlaps (it is
        # not compared to the window it overlaps, nor to the shifted windows next to it)
        same_row = k1.bottom == k2.bottom && k1.top == k2.top && (k1.left == k2.right || k1.right == k2.left)
        same_col = k1.left == k2.left && k1.right == k2.right && (k1.bottom == k2.top || k1.top == k2.bottom)
        next unless same_row || same_col
        d = (dens[k1] - dens[k2]).abs
        if sv_cons_ok(g, d) && sv_cons_ok(cons, dens[k1])
          bad[k1] = true
        end
      end
    end
    bad.keys.each { |k| r.insert(k) }
  else
    dens.each do |k, v|
      r.insert(k) if sv_cons_ok(cons, v)
    end
  end
  r = r & bflat if bflat
  # one polygon per group of overlapping / abutting windows, as Calibre writes them (IO
  # library: M2_D_1_max 1 polygon of 13 windows, T4M2_D_3 1 of 4)
  sv_w(r.merged)
end

# ---------------------------------------------------------------------------
# DFM operations (subset)
# ---------------------------------------------------------------------------

def sv_dfm_space(args, cons, opts = {})
  a = sv_p(args[0])
  lo, hi, _ = sv_frange(cons)
  if opts[:by] == "int"
    ep = args.size > 1 ? a.overlap(sv_p(args[1]), hi, projection) : a.width(hi, projection)
  elsif opts[:by] == "enc"
    ep = sv_p(args[1]).enclosing(a, hi, projection)
  else
    ep = args.size > 1 ? a.separation(sv_p(args[1]), hi, projection) : a.space(hi, projection)
  end
  ep
end

def sv_dfm_copy(a, mode)
  case mode
  when "edge" then sv_e(a)
  when "region" then sv_p(a)
  else a
  end
end

# Subset: DFM PROPERTY P E1 E2 [NAME = LENGTH(E1)/LENGTH(E2)] cons
# -> polygons of P for which the ratio of summed lengths of interacting
#    E1/E2 edges satisfies cons.
def sv_dfm_property(layers, props)
  p = sv_p(layers[0])
  names = {}
  layers[1..-1].each_with_index { |l, i| names[i] = l }
  props.each do |expr, cons|
    m = expr.gsub(" ", "").match(/=LENGTH\((\w+)\)\/LENGTH\((\w+)\)$/i)
    raise "SVRF: DFM PROPERTY expression not supported: #{expr}" unless m
  end
  expr, cons = props[0]
  e1 = sv_e(layers[1])
  e2 = sv_e(layers[2])
  pf = p.data.dup; pf.flatten
  e1f = e1.data.dup; e1f.flatten
  e2f = e2.data.dup; e2f.flatten
  r = RBA::Region::new
  pf.each do |poly|
    pr = RBA::Region::new(poly)
    l1 = e1f.interacting(pr).length
    l2 = e2f.interacting(pr).length
    next if l2 == 0
    r.insert(poly) if sv_cons_ok(cons, l1.to_f / l2.to_f)
  end
  sv_w(r)
end

# ---------------------------------------------------------------------------
# Connectivity based operations
# ---------------------------------------------------------------------------

$sv_netter_ready = false
# CONNECT l0 l1 .. ln BY v: a via shape joins l0 and lk where it overlaps both (v AND l0 AND
# lk), and then carries their net. A via on one of the layers only, or on lk and lm without
# l0, joins nothing and is a net of its own (settled with Calibre on CT_S_2 / V1_S_3: contacts
# on M1 or on poly only, on M1 and poly in disjoint parts, a contact between poly and N+
# without M1; the former connect(l, v) joined all of them). The via layer is split into its
# polygons that join l0 and lk (one part per lk, a polygon in two parts gets one net through
# l0) and the floating rest; the parts take the place of the via in the connectivity (a via
# layer next to the AND pieces doubled the shapes of the extraction, IO library 63 -> 143 s).
# $sv_via_parts: [via layer, its parts], for sv_nets.
$sv_via_parts = []
def sv_setup_connect
  return if $sv_netter_ready
  $sv_netter_ready = true
  # evaluate all layers before the first connect statement
  $sv_connects.each do |layers, via|
    (layers + [via]).compact.each { |n| sv_p($sv_G[n]) }
  end
  sv_mem_log("connectivity layers computed") if $sv_mem_log
  # parts of the via layers
  parts = {}
  joins = Hash.new { |h, k| h[k] = [] }
  pieces = Hash.new { |h, k| h[k] = [] }
  $sv_connects.each do |layers, via|
    next unless via && layers.size >= 2
    v = sv_p($sv_G[via])
    l0 = sv_p($sv_G[layers[0]])
    vm = v.and(l0)
    (1...layers.size).each do |i|
      lk = sv_p($sv_G[layers[i]])
      t = vm.and(lk)
      pieces[via] << t
      joins[via] << [l0, lk, v.interacting(t)]
    end
  end
  joins.each do |via, js|
    v = sv_p($sv_G[via])
    fl = v.not_interacting(pieces[via].inject { |x, y| x + y })
    parts[via] = js.collect { |_, _, vk| vk } + [fl]
    $sv_via_parts << [v, parts[via]]
  end
  lay = lambda { |n| parts[n] || [sv_p($sv_G[n])] }
  joins.each_value do |js|
    js.each { |l0, lk, vk| connect(l0, vk); connect(lk, vk) }
  end
  parts.each_value { |ps| connect(ps[-1], ps[-1]) }   # floating vias: nets of their own
  $sv_connects.each do |layers, via|
    next if via && layers.size >= 2
    if via
      lay.call(via).each { |v| layers.each { |n| lay.call(n).each { |l| connect(l, v) } } }
    else
      (1...layers.size).each { |i| lay.call(layers[0]).each { |a| lay.call(layers[i]).each { |b| connect(a, b) } } }
    end
  end
end

# nets of a layer of the connectivity (a via layer: of its parts)
def sv_layer_nets(l)
  vp = $sv_via_parts.find { |v, _| v.equal?(l) }
  return l.nets(prop(1)) unless vp
  ps = vp[1]
  ns = ps.collect { |q| q.nets(prop(1)) }
  return ns.inject { |x, y| x + y } if ns[0].data.is_deep?
  # flat: Region#join_with / + / insert(Region) kept only the first net layer (KLayout 0.30)
  r = RBA::Region::new
  ns.each { |n| n.data.each { |p| r.insert(p) } }
  sv_w(r)
end

# net-annotated version of a; a may be derived from a connectivity layer
# "base" (Calibre propagates node ids through derivations)
def sv_nets(a, base = nil)
  sv_setup_connect
  if base.nil? || base.equal?(a)
    r = sv_layer_nets(a)
    sv_mem_log("nets extracted") if $sv_mem_log
    return r
  end
  bn = sv_layer_nets(sv_p(base))
  sv_w(bn.data.and(a.data, RBA::Region::NoPropertyConstraint))
end

def sv_has_props(l)
  return false unless sv_kind(l) == :poly
  l.data.each { |p| return p.properties.size > 0 }
  false
end

def sv_netids(l)
  ids = {}
  d = l.data
  d.each { |p| v = p.property(1); ids[v] = true unless v.nil? }
  ids
end

# Subset: "NET AREA RATIO A B > 0" -> polygons of A on nets which have B
def sv_net_area_ratio(layers, expr, cons, opts = {})
  sv_setup_connect
  bases = opts[:bases] || []
  a = sv_p(layers[0])
  b = sv_p(layers[1])
  if expr.nil? && cons.size == 1 && cons[0][0] == ">" && cons[0][1] == 0.0
    an = sv_has_props(a) ? a : sv_nets(a, bases[0])
    bn = sv_has_props(b) ? b : sv_nets(b, bases[1])
    ids = sv_netids(bn)
    r = RBA::Region::new
    an.data.each { |p| r.insert(p) if ids[p.property(1)] }
    return sv_w(r)
  end
  # general form: [AREA(L2)/const] or [AREA(L2)/AREA(L1)] evaluated per net
  if expr
    e = expr.gsub(" ", "")
    m = e.match(/^AREA\((\w+)\)\/(AREA\((\w+)\)|[0-9.eE+-]+)$/i)
    raise "SVRF: NET AREA RATIO expression not supported: #{expr}" unless m
    an = sv_has_props(a) ? a : sv_nets(a, bases[0])
    bn = sv_has_props(b) ? b : sv_nets(b, bases[1])
    u2 = dbu * dbu
    area_b = Hash.new(0.0)
    bn.data.merged.each { |p| area_b[p.property(1)] += p.area * u2 }   # per net, see sv_nar_all_nets
    area_a = Hash.new(0.0)
    an.data.merged.each { |p| area_a[p.property(1)] += p.area * u2 }
    r = RBA::Region::new
    an.data.each do |p|
      id = p.property(1)
      den = m[3] ? area_a[id] : m[2].to_f
      next if den == 0
      r.insert(p) if sv_cons_ok(cons, area_b[id] / den)
    end
    return sv_w(r)
  end
  raise "SVRF: NET AREA RATIO form not supported"
end

# ---------------------------------------------------------------------------
# DRC INCREMENTAL CONNECT YES (antenna decks): a NET AREA RATIO check only sees
# the CONNECT statements above it. "stage" is their number; the connectivity of
# a stage is set up on demand (clear_connections + the first <stage> connects).
# ---------------------------------------------------------------------------
$sv_incremental = false
$sv_stage_cur = nil

# Very large flat polygons make the net extraction crawl: the guard rings of an abutted IO pad
# ring merge into one ACT / SD polygon of ~43000 points and ~10000 holes, which ~500000
# contacts are tested against (a full-chip antenna run did not get past the first stage in
# hours; broken: 5 s). The connectivity layers are broken in place into pieces of <= 512
# points. Areas per net are unchanged; perimeters of broken polygons would grow, but they are
# only used for PO and RDL, which never reach that size. Deep layers are split by KLayout.
SV_BREAK_POINTS = ($break_points || 512).to_i   # -rd break_points=<n> (tests)
$sv_broken = {}
def sv_break_big(l)
  d = l.data
  return l unless d.is_a?(RBA::Region) && !d.is_deep?
  return l if $sv_broken[d.object_id]
  $sv_broken[d.object_id] = true
  n = 0
  d.each { |p| n += 1 if p.num_points > SV_BREAK_POINTS }
  if n > 0
    d.break(SV_BREAK_POINTS, 0.0)
    log("SVRF: #{n} polygons with > #{SV_BREAK_POINTS} points broken for the connectivity") if $sv_verbose
  end
  l
end

# prune: leave out the polygons that touch no polygon of a layer they are connected to (each
# is a net of its own, without a gate): the floating AA / field poly of the density filler
# cells, ~1.2 M polygons on demo_chip that every stage extracted again. The nets of all other
# polygons are unchanged; only the gate net path of sv_nar uses a pruned stage. Polygons are
# grouped by a merge (corner contacts join, like the polygons sv_break_big cut apart), a
# group is dropped when none of it touches a connected layer. $sv_conn_map: data of a
# layer -> data registered in the connectivity.
$sv_conn_map = {}
$sv_merged_cache = {}
$sv_prune_cache = {}
def sv_prune_isolated(n, l, others)
  key = [n, others.collect { |o| o.data.object_id }.sort]
  return $sv_prune_cache[key] if $sv_prune_cache.has_key?(key)
  d = l.data
  m = ($sv_merged_cache[d.object_id] ||= d.merged)
  ot = RBA::Region::new
  others.each { |o| ot += o.data }
  ot.merged_semantics = false
  iso = m.not_interacting(ot)
  r = l
  unless iso.is_empty?
    # same semantics as the layer itself (the netter takes merged polygons), big ones broken
    # again like sv_break_big did on the layer
    kept = d.not_inside(iso)
    kept.break(SV_BREAK_POINTS, 0.0) if kept.each.any? { |p| p.num_points > SV_BREAK_POINTS }
    log("SVRF: #{n}: #{iso.count} isolated polygons left out of the connectivity") if $sv_verbose
    r = DRC::DRCLayer::new(self, kept)
  end
  $sv_prune_cache[key] = r
end

def sv_stage(stage, prune = false)
  conns = $sv_connects[0...stage]
  # evaluate the layers first: they may need another stage themselves
  conns.each { |layers, via| (layers + [via]).compact.each { |n| sv_p($sv_G[n]) } }
  return if $sv_stage_cur == [stage, prune]
  clear_connections
  names = conns.collect { |layers, via| layers + [via] }.flatten.compact.uniq
  base = {}
  names.each { |n| base[n] = sv_break_big(sv_p($sv_G[n])) }
  use = base
  $sv_conn_map = {}
  if prune
    nb = Hash.new { |h, k| h[k] = [] }
    conns.each do |layers, via|
      if via
        layers.each { |n| nb[n] << via; nb[via] << n }
      else
        (1...layers.size).each { |i| nb[layers[0]] << layers[i]; nb[layers[i]] << layers[0] }
      end
    end
    use = {}
    names.each do |n|
      os = nb[n].uniq.reject { |m| m == n }.collect { |m| base[m] }
      use[n] = sv_prune_isolated(n, base[n], os)
      $sv_conn_map[base[n].data.object_id] = use[n].data
    end
  end
  conns.each do |layers, via|
    ls = layers.collect { |n| use[n] }
    if via
      v = use[via]
      ls.each { |l| connect(l, v) }
    else
      (1...ls.size).each { |i| connect(ls[0], ls[i]) }
    end
  end
  $sv_stage_cur = [stage, prune]
  $sv_netter_ready = true
end

# NET AREA X constraint: polygons of X on nets whose X area meets the constraint
def sv_net_area(x, cons, stage)
  a = sv_p(x)
  if cons.all? { |op, v| (op == ">" || op == ">=") && v <= 0.0 } &&
     $sv_connects[0...stage].any? { |layers, via| (layers + [via]).compact.any? { |n| sv_p($sv_G[n]).equal?(a) } }
    # every polygon of X (the diode layers: NET AREA SD > 0): no extraction needed
    d = sv_break_big(a).data.dup
    return sv_w(d)
  end
  sv_stage(stage)
  an = a.nets(prop(1))
  u2 = dbu * dbu
  area = Hash.new(0.0)
  am = an.data.merged   # per net, see sv_nar_all_nets
  am.each { |p| area[p.property(1)] += p.area * u2 }
  r = RBA::Region::new
  am.each { |p| r.insert(p.to_simple_polygon) if sv_cons_ok(cons, area[p.property(1)]) }
  sv_w(r)
end

# NET AREA RATIO L1 ... Ln constraint [expr] [ACCUMULATE [acc]] at a connectivity stage.
#   names: the layer names as used in expr; fn: lambda(area_hash, perimeter_hash) per net
#   (um2 / um); acc: nil (plain), true (start of an accumulation) or the layer of a
#   previous accumulation. Semantics settled against Calibre (tests/antenna):
#   * the value is evaluated per net; nets where it is not finite (no gate) are skipped;
#   * plain: the result are the L1 polygons of the nets meeting the constraint;
#   * ACCUMULATE: per polygon of the last layer (the gate) the value is the net value
#     plus the value the same gate has in <acc>; the result are those gate polygons,
#     and the accumulated values are kept on the result for later ACCUMULATE <it>.
# Areas / perimeters per net of every layer, the polygons of the first and the last layer
# with their net: the nets of all polygons (nets(prop)).
$sv_nar_check = ($nar_check.to_s == "1")
def sv_nar_all_nets(ls, bs, names)
  u = dbu
  u2 = u * u
  area = Hash.new { |h, k| h[k] = Hash.new(0.0) }
  perim = Hash.new { |h, k| h[k] = Hash.new(0.0) }
  first = []
  last = []
  ls.each_with_index do |l, i|
    n = names[i]
    begin
      ln = l.nets(prop(1))
    rescue => ex
      # not in the connectivity: nets of the layer it is derived from
      raise ex unless bs[i]
      ln = sv_w(bs[i].nets(prop(1)).data.and(l.data, RBA::Region::NoPropertyConstraint))
    end
    # merged per net (property aware): the netter hands out the shapes as stored, which
    # overlap (M1 of demo_chip: 1.6 x its area) and are cut at other layers (perimeters)
    ln.data.merged.each do |p|
      id = p.property(1)
      area[id][n] += p.area * u2
      perim[id][n] += p.perimeter * u
      first << [p, id] if i == 0
      last << [p, id] if i == ls.size - 1
    end
  end
  [area, perim, first, last, false]
end

# True when the value is never finite without the area of layer g (the gate: every antenna
# ratio divides by it), whatever the other areas / perimeters are.
def sv_nar_needs(names, fn, g)
  vals = [0.0, 1.0, 3.7]
  vals.product(vals).all? do |x, y|
    a = Hash.new(0.0)
    p = Hash.new(0.0)
    names.each_with_index do |n, i|
      next if i == g
      a[n] = i.even? ? x : y
      p[n] = i.even? ? y : x
    end
    v = (fn.call(a, p).to_f rescue Float::NAN)
    !v.finite?
  end
end

# The same as sv_nar_all_nets, restricted to the nets that have a polygon of the last
# layer (the gate), when the value needs it (sv_nar_needs; other nets are skipped anyway):
# the nets are probed on the gate polygons and their shapes taken per net from the
# extracted netlist. A chip with density filler cells has ~150 floating poly lines per gate,
# each its own net, which nets(prop) of every layer and the Ruby loop went through (WP5).
# Flat only (probe_net on a flat netlist gives the top level net). nil: not applicable.
def sv_nar_gate_nets(ls, bs, names, fn)
  return nil unless $sv_flat
  g = ls.size - 1
  return nil unless sv_nar_needs(names, fn, g)
  l2n = _netter.l2n_data
  reg = lambda { |l| $sv_conn_map[l.data.object_id] || l.data }
  idx = ls.collect { |l| (l2n.layer_of(reg.call(l)) rescue nil) }
  return nil unless idx[g]
  bidx = bs.collect { |b| b ? (l2n.layer_of(reg.call(b)) rescue nil) : nil }
  ls.each_index { |i| return nil unless idx[i] || bidx[i] }
  nets = {}
  ls[g].data.each do |p|
    tr = p.decompose_trapezoids(0)[0]
    next unless tr
    xs = 0
    ys = 0
    tr.each_point { |q| xs += q.x; ys += q.y }
    pt = RBA::Point::new(xs / tr.num_points, ys / tr.num_points)
    net = l2n.probe_net(reg.call(ls[g]), pt)
    return nil unless net   # point not on the gate polygon: should not happen
    nets[net.cluster_id] ||= net
  end
  u = dbu
  u2 = u * u
  area = Hash.new { |h, k| h[k] = Hash.new(0.0) }
  perim = Hash.new { |h, k| h[k] = Hash.new(0.0) }
  first = []
  last = []
  ls.each_with_index do |l, i|
    n = names[i]
    src = idx[i] || bidx[i]
    nr = RBA::Region::new
    nets.each do |cid, net|
      l2n.polygons_of_net(net, src).each { |p| nr.insert(RBA::PolygonWithProperties::new(p, { 1 => cid })) }
    end
    nr = nr.and(l.data, RBA::Region::NoPropertyConstraint) unless idx[i]
    nr.merged.each do |p|
      id = p.property(1)
      area[id][n] += p.area * u2
      perim[id][n] += p.perimeter * u
      first << [p, id] if i == 0
      last << [p, id] if i == g
    end
  end
  [area, perim, first, last, true]
end

# -rd nar_check=1: values per gate polygon and per first-layer polygon of both paths
def sv_nar_compare(got, ref, names, fn)
  sig = lambda do |x|
    area, perim, first, last = x
    val = {}
    area.each do |id, a|
      v = fn.call(a, perim[id]).to_f
      val[id] = v if v.finite?
    end
    h = {}
    last.each { |p, id| h["G " + p.to_simple_polygon.to_s] = val[id] if val.has_key?(id) }
    first.each { |p, id| h["F " + p.to_simple_polygon.to_s] = val[id] if val.has_key?(id) }
    h
  end
  a = sig.call(got)
  b = sig.call(ref)
  bad = (a.keys | b.keys).select { |k| !a[k] || !b[k] || (a[k] - b[k]).abs > 1e-6 * [1.0, b[k].abs].max }
  log("SVRF nar_check #{names.join(',')}: #{a.size} / #{b.size} values, #{bad.size} differ#{bad.empty? ? '' : ': ' + bad[0, 3].collect { |k| "#{k} #{a[k].inspect} #{b[k].inspect}" }.join('; ')}")
  $sv_nar_bad = ($sv_nar_bad || 0) + bad.size
end

def sv_nar(layers, names, fn, cons, stage, acc = nil, bases = [])
  ls = layers.collect { |l| sv_p(l) }
  bs = bases.collect { |b| b ? sv_p(b) : nil }
  prev = nil
  if acc && acc != true
    al = sv_p(acc)
    prev = al.instance_variable_get(:@sv_acc) || {}
  end
  # gate net path on the pruned connectivity (flat), else all nets on the full one
  sv_stage(stage, $sv_flat && $nar_prune.to_s != "0")
  got = sv_nar_gate_nets(ls, bs, names, fn)
  unless got
    sv_stage(stage)
    got = sv_nar_all_nets(ls, bs, names)
  end
  if $sv_nar_check && got[4]
    # -rd nar_check=1 (tests): the gate net path against the full one, per rule
    sv_stage(stage)
    ref = sv_nar_all_nets(ls, bs, names)
    sv_nar_compare(got, ref, names, fn)
  end
  area, perim, first, last = got
  val = {}
  area.each do |id, a|
    v = fn.call(a, perim[id]).to_f
    val[id] = v if v.finite?
  end
  r = RBA::Region::new
  if acc
    accmap = {}
    last.each do |p, id|
      next unless val.has_key?(id)
      sp = p.to_simple_polygon
      key = sp.to_s
      v = val[id] + (prev ? (prev[key] || 0.0) : 0.0)
      accmap[key] = v
      r.insert(sp) if sv_cons_ok(cons, v)
    end
    out = sv_w(r)
    out.instance_variable_set(:@sv_acc, accmap)
    return out
  end
  first.each { |p, id| r.insert(p.to_simple_polygon) if val.has_key?(id) && sv_cons_ok(cons, val[id]) }
  r.merge   # Calibre reports the merged polygons of the first layer
  sv_w(r)
end

# STAMP A BY B: A polygons get the nets of B
def sv_stamp(a, b, base = nil)
  bn = sv_has_props(b) ? b : sv_nets(b, base)
  sv_w(bn.data.and(sv_p(a).data, RBA::Region::NoPropertyConstraint))
end

# DRAWN SKEW / ANGLED: non-orthogonal edges of all drawn layers
def sv_drawn(kind, layers)
  e = nil
  layers.each do |l|
    x = l.edges.without_angle(0).without_angle(90)
    e = e ? e + x : x
  end
  e ||= polygons.edges
  if kind == "acute" || kind == "offgrid"
    raise "SVRF: DRAWN #{kind} not supported"
  end
  e
end

# ---------------------------------------------------------------------------
# Rule execution and output
# ---------------------------------------------------------------------------

def sv_out_layer(name, desc, l)
  l.output(name, desc)
end

# -rd jobs=N (the IHP sg13g2 runner does the same with its rule tables): the selected rules in
# N KLayout processes, each reading the layout and deriving its own layers, the reports merged.
# The density rules stay in one group (their window cache is shared by the _min / _max rules),
# the others are dealt round-robin in deck order, which spreads the families of heavy rules
# (MnDUM_S_7, LU_S_2_*, ...) over the processes.
def sv_run_jobs(title)
  require 'tmpdir'
  names = sv_selected_rules
  dens, rest = names.partition { |x| x =~ /_D_[0-9]/ }
  njobs = [$sv_jobs, names.size].min
  groups = Array.new(njobs) { [] }
  groups[0].concat(dens)
  rest.each_with_index { |x, i| groups[(i + (dens.empty? ? 0 : 1)) % njobs] << x }
  groups.reject!(&:empty?)
  thr = [($sv_nthr || 4) / groups.size, 1].max
  kl = ENV["KLAYOUT_BIN"] || "klayout"
  dir = Dir.mktmpdir("sv_jobs")
  log("SVRF: #{names.size} rules in #{groups.size} processes (#{thr} threads each), #{dir}")
  jobs = groups.each_with_index.collect do |g, i|
    rf = File.join(dir, "rules_#{i}.txt")
    File.write(rf, g.join("\n") + "\n")
    rep = File.join(dir, "report_#{i}.lyrdb")
    lg = File.join(dir, "log_#{i}.txt")
    args = [kl, "-b", "-r", $sv_deck, "-rd", "rules_file=#{rf}", "-rd", "report=#{rep}",
            "-rd", "threads=#{thr}"]
    $sv_fwd_vars.each do |v|
      val = eval("$#{v}") rescue nil
      args += ["-rd", "#{v}=#{val}"] unless val.nil?
    end
    [Process.spawn(*args, :out => lg, :err => [:child, :out]), rep, lg, g.size]
  end
  failed = []
  jobs.each do |pid, rep, lg, n|
    st = Process.wait2(pid)[1]
    failed << lg unless st.success? && File.exist?(rep)
  end
  jobs.each do |pid, rep, lg, n|
    File.readlines(lg).each do |l|
      $sv_failed << [l.split[3].to_s.chomp(":"), l.strip] if l =~ /SVRF rule .* FAILED/
      log("SVRF process #{File.basename(lg)}: #{l.strip}") if $sv_mem_log && l =~ /SVRF mem end:|layers used after/
    end
  end
  raise "SVRF: #{failed.size} DRC processes failed, see #{failed.join(', ')}" unless failed.empty?
  # merge the reports
  rdb = RBA::ReportDatabase::new(title)
  rdb.description = title
  cells = {}
  cats = {}
  jobs.each do |pid, rep, lg, n|
    c = RBA::ReportDatabase::new("")
    c.load(rep)
    rdb.top_cell_name = c.top_cell_name if rdb.top_cell_name.to_s.empty?
    rdb.original_file = c.original_file if rdb.original_file.to_s.empty?
    rdb.generator = c.generator if rdb.generator.to_s.empty?
    cmap = {}
    c.each_cell do |cc|
      k = [cc.name, cc.variant]
      cells[k] ||= rdb.create_cell(cc.name, cc.variant)
      cmap[cc.rdb_id] = cells[k].rdb_id
    end
    kmap = {}
    c.each_category do |cat|
      unless cats[cat.name]
        nc = rdb.create_category(cat.name)
        nc.description = cat.description
        cats[cat.name] = nc
      end
      kmap[cat.rdb_id] = cats[cat.name].rdb_id
    end
    c.each_item do |it|
      ni = rdb.create_item(cmap[it.cell_id], kmap[it.category_id])
      it.each_value { |v| ni.add_value(v) }
    end
  end
  rdb.save($report) if $report
  log("SVRF: reports of #{groups.size} processes merged")
  require 'fileutils'
  FileUtils.rm_rf(dir)   # kept when a process failed (raised above)
  names.size
end

def sv_selected_rules
  sel = $sv_select
  unsel = $sv_unselect
  $sv_rules.collect { |r| r[0] }.select { |n| !(sel && !(n =~ sel)) && !(unsel && (n =~ unsel)) }
end

def sv_run_rules
  only = nil
  if $rules_file
    # child of -rd jobs=N: exactly the rules of this group
    only = {}
    File.read($rules_file).split("\n").each { |x| only[x.strip] = true unless x.strip.empty? }
  end
  sel = $sv_select
  unsel = $sv_unselect
  run = $sv_rules.select do |name, desc, blk, deps|
    only ? only[name] : !(sel && !(name =~ sel)) && !(unsel && (name =~ unsel))
  end
  # release: how many of the rules still to run look up each name directly
  release = $sv_release && run.all? { |r| r[3] }
  log("SVRF: release of computed layers off (#{$sv_release ? 'a rule without dependencies' : '-rd release=0'})") unless release
  $sv_conn_names_all = sv_conn_names
  left = Hash.new(0)
  run.each { |r| r[3].each { |d| left[d] += 1 } } if release
  sv_mem_log("start (layout read)") if $sv_mem_log
  n = 0
  run.each do |name, desc, blk, deps|
    $sv_cur_rule = name
    t0 = Time.now
    outs = []
    $sv_ctx = [SvScope.dep_set(deps)] if $sv_release_check
    begin
      blk.call(outs)
      # outputs are evaluated after all local layers of the rule are defined
      outs = outs.collect { |o| o.is_a?(Proc) ? o.call : o }
      outs.each_with_index do |o, i|
        if $sv_flat
          d = o.data.dup
          d.flatten
          o = sv_w(d)
        end
        o.output(name, desc)
      end
      n += 1
    rescue => ex
      $sv_failed << [name, ex.to_s]
      log("SVRF rule #{name} FAILED: #{ex}")
      if $sv_strict || ($sv_release_check && ex.to_s =~ /static dependencies|after its release/)
        raise ex
      end
    end
    outs = nil
    $sv_ctx = []
    dt = Time.now - t0
    log("SVRF rule #{name}: #{'%.2f' % dt}s") if $sv_verbose
    if release
      deps.each { |d| left.delete(d) if (left[d] -= 1) <= 0 }
      sv_release_after(left.keys)
    end
    sv_mem_log("rule #{name}") if $sv_mem_log
  end
  $sv_cur_rule = nil
  unless $sv_late_uses.empty?
    log("SVRF: WARNING: #{$sv_late_uses.size} layers used after their release (computed again): " +
        $sv_late_uses.collect { |r, k| "#{r}:#{k}" }.join(" "))
  end
  sv_mem_probe_end if $sv_mem_log
  n
end

# ---------------------------------------------------------------------------
# Release of computed layers (-rd release=0 switches it off)
#
# Global layers are computed on first use and cached. After each rule the layers that no rule
# left to run can look up (static dependencies from the generator, transitively through the
# layers not computed yet) are dropped from the cache, and with them what the runtime caches
# for them: input layers, density windows, merged / broken connectivity layers. The
# connectivity is cleared after the last rule that uses it. A layer only used by one rule is
# so computed and freed around that rule. GC.start then frees the KLayout objects (Ruby does
# not see their size, so without it they stay until a later GC); local layers of the rule go
# the same way. Nothing is _destroy'ed: a layer can be the value of several names (COPY,
# aliases of one input), the GC only frees what nothing refers to any more.
# ---------------------------------------------------------------------------
$sv_malloc_trim = nil
def sv_trim
  return if $trim.to_s == "0"
  if $sv_malloc_trim.nil?
    $sv_malloc_trim = false
    begin
      require 'fiddle'
      $sv_malloc_trim = Fiddle::Function.new(Fiddle.dlopen(nil)['malloc_trim'], [Fiddle::TYPE_SIZE_T], Fiddle::TYPE_INT)
    rescue Exception
    end
  end
  $sv_malloc_trim.call(0) if $sv_malloc_trim
end

def sv_release_after(roots)
  rel, need = $sv_G.release_unneeded(roots, sv_conn_names)
  return if need.nil?
  live = {}
  $sv_G.cached_values.each { |v| live[v.data.object_id] = true if v.respond_to?(:data) }
  conn = need["@CONN"]
  unless conn
    if $sv_netter_ready || $sv_stage_cur
      clear_connections
      $sv_netter_ready = false
      $sv_stage_cur = nil
      $sv_via_parts = []
      $sv_conn_map = {}
      $sv_prune_cache = {}
    end
  end
  # caches keyed by object ids: only for layers still alive (a freed id can be reused)
  $sv_merged_cache.delete_if { |id, _| !live[id] }
  $sv_broken.delete_if { |id, _| !live[id] }
  $sv_prune_cache.delete_if { |key, r| !key[1].all? { |id| live[id] } }
  unless need["@INPUTS"]
    $sv_input_cache.delete_if { |_, r| !live[r.data.object_id] }
  end
  if $sv_density_cache
    $sv_density_cache.delete_if do |_, e|
      keep = live[e[0].object_id] && (e[1].nil? || live[e[1].object_id])
      e[3].each { |c, li| $sv_area_ly.delete_cell(c.cell_index) } unless keep
      !keep
    end
  end
  # GC (~15 ms with the deck loaded) when the time since the last one is 10 x its own cost:
  # after every rule on a large layout, every few rules on a small one
  now = Time.now
  $sv_gc_last ||= now
  if now - $sv_gc_last >= 10 * ($sv_gc_cost || 0.0)
    GC.start
    sv_trim
    $sv_gc_cost = Time.now - now
    $sv_gc_last = Time.now
  end
  if $sv_verbose && !rel.empty?
    log("SVRF: released #{rel.collect { |k, _| k }.join(' ')}")
  end
end

def sv_rss
  h = {}
  File.readlines("/proc/self/status").each { |l| h[$1] = $2.to_i / 1024 if l =~ /^(VmRSS|VmHWM):\s+(\d+)/ }
  h
rescue
  {}
end

def sv_layer_size(v)
  d = v.respond_to?(:data) ? v.data : nil
  return 0 if d.nil?
  d.respond_to?(:is_deep?) && d.is_deep? ? d.hier_count : d.count
rescue
  0
end

# -rd mem_log=1: resident memory after each rule and the layers held
def sv_mem_log(what)
  m = sv_rss
  names = $sv_G.cached_names
  tot = 0
  big = names.collect { |k| [k, sv_layer_size($sv_G.instance_variable_get(:@cache)[k])] }
  big.each { |_, c| tot += c }
  top = big.sort_by { |_, c| -c }[0, 3].collect { |k, c| "#{k}=#{c}" }.join(" ")
  log("SVRF mem #{what}: rss #{m['VmRSS']} MB peak #{m['VmHWM']} MB, #{names.size} global layers " +
      "(#{tot} shapes; #{top}), #{$sv_input_cache.size} inputs")
end

# mem_log: at the end, what the remaining caches held
def sv_mem_probe_end
  sv_mem_log("end")
  $sv_G.forget
  $sv_input_cache.clear
  $sv_density_cache = {} if $sv_density_cache
  $sv_merged_cache.clear
  $sv_prune_cache = {}
  clear_connections
  $sv_netter_ready = false
  $sv_stage_cur = nil
  $sv_via_parts = []
  GC.start
  sv_trim
  sv_mem_log("end, all caches dropped")
end

