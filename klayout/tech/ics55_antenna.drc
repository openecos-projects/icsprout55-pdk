$sv_G.define("RDL_DIO", ["@CONN", "SD"]) { sv_net_area($sv_G["SD"], [[">", 0.0]], 23) }
sv_rule("AR_8_12", "Max. (RDL side-wall area / gate area) is 1000 (without effective diode) Max. (RDL side-wall area / gate area) is Ratio Equation (with effective diode)", ["@CONN", "GATE", "M1", "M2", "M3", "M4", "M5", "PO", "RDL", "RDL_DIO", "SD", "T4M2"]) do |outs|
  s = SvScope.new(self, $sv_G, "AR_8_12")
  outs << proc { sv_nar([s["PO"], s["M1"], s["M2"], s["M3"], s["M4"], s["M5"], s["T4M2"], s["RDL"], s["RDL_DIO"], s["GATE"]], ["PO", "M1", "M2", "M3", "M4", "M5", "T4M2", "RDL", "RDL_DIO", "GATE"], lambda { |a, p| p["RDL"] * 1.595 / a["GATE"] - (a["RDL_DIO"] * 8000.0 + ((a["RDL_DIO"]) != 0 ? 1.0 : 0.0) * 29000.0) }, [[">", 1000.0]], 23, nil, [nil, nil, nil, nil, nil, nil, nil, nil, s["SD"], nil]) }
