if FEOL
  #================================================
  #------------------ DNW - Deep N-Well -----------
  #================================================

  logger.info('Starting DNW rules')

  # DNW_W_1: OUTLAYER (INT DNW < 3.0 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
  logger.info('Executing rule DNW_W_1')
  report_rule(dnw.width(3.0.um, euclidian).not_inside(excl_nodrc),
              'DNW_W_1', 'DNW_W_1 : DNW width >= 3.00um')

  # DNW_S_1: OUTLAYER (EXT DNW < 3.5 ABUT<90 SINGULAR REGION) NOT INSIDE NODRC
  logger.info('Executing rule DNW_S_1')
  report_rule(dnw.space(3.5.um, euclidian).not_inside(excl_nodrc),
              'DNW_S_1', 'DNW_S_1 : Space between two DNWs >= 3.50um')

  # TODO: DNW_S_2a (needs connectivity), DNW_S_3..5, DNW_EN_1/2, DNW_O_1, DNW_R_1/3
end
