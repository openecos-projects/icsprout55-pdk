$sv_G.define("POR_SA") { sv_bool("AND", $sv_G["POR"], $sv_G["SAB"]) }
$sv_G.define("POR_NS") { sv_sel_any("interact", $sv_G["POR"], $sv_G["SAB"], [], true, {}) }
sv_rule("POLYres_W_1", "Width of non-silicide poly resistor >= 0.4um Suggest the Nsq >= 1 for stable Resistivity >= 1") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_W_1")
  s.define("X") { sv_bool("AND", sv_bool("AND", s["PORES"], s["PO"]), s["SAB"]) }
  s.define("L") { sv_esel("inside_edge", s["X"], s["PO"], [], false) }
  outs << proc { sv_esel("inside_edge", sv_length(s["L"], [["<", 0.4]], false), s["NODRC"], [], true) }
  s.define("X1") { sv_bool("AND", s["PORES"], s["SAB"]) }
  s.define("Y1") { sv_bool("AND", sv_bool("AND", s["PO"], s["PORES"]), s["SAB"]) }
  s.define("L1") { sv_edge_or(sv_esel("inside_edge", s["PO"], s["X1"], [], false), sv_esel("coin", s["PO"], s["X1"], [], false)) }
  s.define("W1") { sv_esel("inside_edge", s["Y1"], s["PO"], [], false) }
  outs << proc { sv_sel_any("inside", sv_dfm_property([s["Y1"], s["L1"], s["W1"]], [["SQUARES = LENGTH ( L1 ) / LENGTH ( W1 )", [["<", 1.0]]]]), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_S_1a:PP", "Space between N type PO resistors and NP, PP, NPR, HRP, ESD  >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_S_1a:PP")
