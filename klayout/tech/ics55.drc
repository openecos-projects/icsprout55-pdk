  outs << proc { sv_sel_any("inside", sv_check("int", s["SDN"], s["AA"], [["<", 0.12]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
