sv_rule("MET1_W_3", "Minimum M1 width adjoining a huge non-metal region {[} area > 2000000 um2\\], non-metal region is defined as (NOT (Mx OR MxDUM)) >= 0.35um") do |outs|
  s = SvScope.new(self, $sv_G, "MET1_W_3")
