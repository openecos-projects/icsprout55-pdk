$sv_G.define("CTN") { sv_bool("AND", $sv_G["CT"], sv_rectangle($sv_G["CT"], {:neg => false, :aspect => [["==", 1.0]]})) }
sv_rule("CT_W_1", "Fixed CT width (square shape) exclude SRAMALL(177;4) FUSEALL, and GRID DRC waive rectangular CT in SRAM and EFUSEALL area, and waive protection ring purpose non-rectangular CT in GRID area =0.09um") do |outs|
  s = SvScope.new(self, $sv_G, "CT_W_1")
  s.define("X") { sv_rectangle(sv_bool("NOT", sv_bool("NOT", s["CT"], s["RCT"]), s["GCT"]), {:neg => true, :w => [["==", 0.09]], :l => [["==", 0.09]]}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], sv_bool("OR", sv_bool("OR", s["GRID"], s["SRAMALL"]), s["EFUSEALL"]), [], true, {}), sv_bool("OR", s["SRINGBLK"], s["NODRC"]), [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_rectangle(sv_rectangle(sv_bool("AND", s["CT"], s["GRID"]), {:neg => false}), {:neg => true, :w => [["==", 0.09]], :l => [["==", 0.09]]}), sv_bool("OR", s["SRINGBLK"], s["NODRC"]), [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_rectangle(sv_rectangle(sv_bool("AND", s["CT"], s["EFUSEALL"]), {:neg => false, :aspect => [["==", 1.0]]}), {:neg => true, :w => [["==", 0.09]], :l => [["==", 0.09]]}), sv_bool("OR", s["SRINGBLK"], s["NODRC"]), [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_rectangle(sv_rectangle(sv_bool("AND", s["CT"], s["SRAMALL"]), {:neg => false, :aspect => [["==", 1.0]]}), {:neg => true, :w => [["==", 0.09]], :l => [["==", 0.09]]}), sv_bool("OR", s["SRINGBLK"], s["NODRC"]), [], true, {}) }
end
sv_rule("CT_W_2", "Fixed CT bar width, except rectangular CT in SRAMALL (177;4) FUSEALL region = 0.09um") do |outs|
  s = SvScope.new(self, $sv_G, "CT_W_2")
  outs << proc { sv_sel_any("inside", sv_with_width(s["CTbar"], [["<", 0.09]], false), sv_nary("OR", s["SRAMALL"], s["EFUSEALL"]), [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_with_width(s["CTbar"], [[">", 0.09]], false), sv_nary("OR", s["SRAMALL"], s["EFUSEALL"]), [], true, {}) }
end
