end
sv_rule("NWresAA_S_4", "Space between NW resistor and NP = 0") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_S_4")
  outs << proc { sv_esel("touch_edge", sv_esel("inside_edge", s["NW1res"], sv_sel_any("interact", s["NW"], sv_sel_any("enclose", s["AA"], sv_bool("AND", s["NW"], s["NW1res"]), [], false, {}), [], false, {}), [], false), s["SDN"], [], true) }
end
sv_rule("NWresAA_EN_1", "AA enclosure of NW-Resistor >= 0.90um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_EN_1")
  s.define("X") { sv_bool("AND", sv_bool("AND", sv_bool("AND", s["NW1res"], s["AA"]), s["NW"]), s["SAB"]) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X"], sv_sel_any("enclose", s["AA"], s["X"], [], false, {}), [["<", 0.9]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NWresAA_EN_2", "SAB enclosure of AA >= 0.20um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_EN_2")
  s.define("X") { sv_bool("AND", sv_bool("AND", sv_bool("AND", s["NW1res"], s["AA"]), s["NW"]), s["SAB"]) }
  s.define("Y1") { sv_sel_any("enclose", s["AA"], s["X"], [], false, {}) }
  s.define("Y2") { sv_esel("coin", s["SAB"], sv_holes(s["SAB"], {}), [], true) }
  outs << proc { sv_esel("inside_edge", sv_check("enc", s["Y1"], s["Y2"], [["<", 0.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true) }
end
sv_rule("NWresAA_EN_3", "Enclosure of SAB and related NW >= 0.28um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_EN_3")
  s.define("X1") { sv_holes(s["SAB"], {}) }
  s.define("X2") { sv_sel_any("touch", s["SAB"], s["X1"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["NWR"], s["X1"], [["<", 0.28]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["NWR"], s["X2"], [["<", 0.28]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", sv_sel_any("interact", s["NWR"], s["X1"], [], false, {}), s["X1"]), s["SAB"]), s["NODRC"], [], true, {}) }
end
sv_rule("NWresAA_EN_4", "NW enclosure of CT >= 0.28um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_EN_4")
  s.define("X") { sv_bool("AND", sv_bool("AND", sv_bool("AND", s["NW1res"], s["AA"]), s["NW"]), s["SAB"]) }
  outs << proc { sv_sel_any("inside", sv_check("enc", sv_bool("AND", s["CT"], sv_holes(s["SAB"], {})), sv_sel_any("enclose", s["NW"], s["X"], [], false, {}), [["<", 0.28]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NWresAA_EX_1", "Extension of NW1res outside of AA >= 0.20um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_EX_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["AA"], sv_sel_any("interact", s["NW1res"], s["SAB"], [], false, {}), [["<", 0.2]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NWresAA_O_1", "Overlap of a NP and SAB (SAB INTERACT NW1res) >= 0.38um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_O_1")
  s.define("X") { sv_bool("AND", s["SAB"], sv_bool("AND", sv_sel_any("enclose", s["AA"], s["NW1res"], [], false, {}), s["NW"])) }
  s.define("Y") { sv_holes(sv_sel_any("interact", s["SAB"], s["X"], [], false, {}), {}) }
  s.define("SDN_1") { sv_bool("AND", sv_sel_any("interact", s["SDN"], s["X"], [], false, {}), s["SAB"]) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["SDN_1"], nil, [["<", 0.38]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NWresAA_R_1", "NW resistor must be covered by SAB except CT area") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_R_1")
  s.define("X") { sv_sel_any("enclose", s["NW1res"], sv_bool("AND", s["NW1res"], s["AA"]), [], false, {}) }
  s.define("Y") { sv_sel_any("interact", sv_bool("OR", s["SAB"], sv_holes(s["SAB"], {})), s["X"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("enclose", s["Y"], sv_bool("AND", s["NW1res"], s["NW"]), [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("NWresAA_R_2", "recommanded to use rectangle shape resistor for the spice simulation accuracy. DRC flag (NW resistor AND NW) not a rectangle") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_R_2")
  s.define("X") { sv_bool("AND", s["NW1res"], s["NW"]) }
  outs << proc { sv_rectangle(s["X"], {:neg => true}) }
end
sv_rule("NWresAA_R_4", "In one NW resistor 1. There is only one NW is allowed in same AA 2. There is only two NPs are allowed in same AA 3. There is only two SAB holes allowed in same AA") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_R_4")
  s.define("RESNWAA_CHECK") { sv_sel_any("enclose", s["AA"], sv_bool("AND", sv_bool("AND", s["NW1res"], s["NW"]), s["SAB"]), [], false, {}) }
  outs << proc { sv_sel_any("interact", s["RESNWAA_CHECK"], s["NW"], [[">", 1.0]], false, {}) }
  outs << proc { sv_sel_any("interact", s["RESNWAA_CHECK"], s["SDN"], [[">", 2.0]], false, {}) }
  outs << proc { sv_sel_any("interact", s["RESNWAA_CHECK"], s["SDN"], [["==", 1.0]], false, {}) }
  outs << proc { sv_sel_any("interact", s["RESNWAA_CHECK"], sv_sel_any("interact", sv_holes(s["SAB"], {}), s["RESNWAA_CHECK"], [], false, {}), [[">", 2.0]], false, {}) }
end
$sv_G.define("NWRSTI") { sv_sel_any("interact", $sv_G["NWR"], $sv_G["SAB"], [], true, {}) }
$sv_G.define("NWRSTI_L") { sv_esel("inside_edge", $sv_G["NWRSTI"], $sv_G["NW1res"], [], false) }
$sv_G.define("NWRSTI_W") { sv_esel("inside_edge", sv_sel_any("interact", sv_bool("AND", $sv_G["NW1res"], $sv_G["NW"]), $sv_G["SAB"], [], true, {}), $sv_G["NW"], [], false) }
sv_rule("NWresSTI_W_1", "NW-Resistor width and suggest NW resistor length/width ratio > 5,length >= 20um for SPICE simulation accuracy >= 1.8um") do |outs|
