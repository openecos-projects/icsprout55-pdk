$sv_G.define("ESD") { sv_bool("AND", $sv_G["ESD1"], $sv_G["ESDIOE"]) }
$sv_G.define("ENACT") { sv_bool("AND", $sv_G["NACT"], $sv_G["ESDIOE"]) }
$sv_G.define("EPACT") { sv_bool("AND", $sv_G["PACT"], $sv_G["ESDIOE"]) }
$sv_G.define("ENTAP") { sv_bool("AND", $sv_G["ENACT"], $sv_G["NW"]) }
$sv_G.define("EPTAP") { sv_bool("NOT", $sv_G["EPACT"], $sv_G["NW"]) }
$sv_G.define("EGATE") { sv_bool("AND", sv_bool("AND", $sv_G["AA"], $sv_G["PO"]), $sv_G["ESDIOE"]) }
$sv_G.define("ENGATE") { sv_bool("AND", $sv_G["EGATE"], $sv_G["ENACT"]) }
$sv_G.define("EPGATE") { sv_bool("AND", $sv_G["EGATE"], $sv_G["EPACT"]) }
$sv_G.define("EGATEHV") { sv_bool("AND", sv_bool("NOT", $sv_G["EGATE"], $sv_G["DG"]), $sv_G["TG"]) }
$sv_G.define("EGATEMV") { sv_bool("NOT", sv_bool("AND", $sv_G["EGATE"], $sv_G["DG"]), $sv_G["TG"]) }
$sv_G.define("EGATELV") { sv_bool("NOT", $sv_G["EGATE"], $sv_G["DG"]) }
$sv_G.define("EGATE_CASCODED") { sv_bool("AND", sv_bool("AND", $sv_G["EGATE"], $sv_G["ESDIOE"]), $sv_G["ESDIOT"]) }
$sv_G.define("EGATE_CASCODED_OVLAP") { sv_sel_any("cut", $sv_G["EGATE_CASCODED"], $sv_G["ESAB"], [], false, {}) }
$sv_G.define("EGATE_CASCODED_INSID") { sv_sel_any("inside", $sv_G["EGATE_CASCODED"], $sv_G["ESAB"], [], false, {}) }
$sv_G.define("EGATE_W") { sv_esel("coin", $sv_G["EGATE"], $sv_G["PO"], [], false) }
$sv_G.define("EGATE_L") { sv_esel("coin", $sv_G["EGATE"], $sv_G["AA"], [], false) }
$sv_G.define("EGATE_POLY") { sv_sel_any("enclose", $sv_G["PO"], $sv_G["EGATE"], [], false, {}) }
$sv_G.define("ENGATE_POLY") { sv_sel_any("enclose", $sv_G["PO"], $sv_G["ENGATE"], [], false, {}) }
$sv_G.define("EPGATE_POLY") { sv_sel_any("enclose", $sv_G["PO"], $sv_G["EPGATE"], [], false, {}) }
$sv_G.define("ECT") { sv_bool("AND", $sv_G["CT"], $sv_G["ESDIOE"]) }
$sv_G.define("ESAB") { sv_bool("AND", $sv_G["SAB"], $sv_G["ESDIOE"]) }
$sv_G.define("ESAB_HO_RAW") { sv_holes($sv_G["ESAB"], {:inner => true, :empty => true}) }
$sv_G.define("ESAB_HO") { sv_bool("OR", $sv_G["ESAB_HO_RAW"], $sv_G["EMOS_D"]) }
$sv_G.define("ECT_S") { sv_sel_any("outside", $sv_G["ECT"], $sv_G["ESAB_HO"], [], false, {}) }
$sv_G.define("ECT_D") { sv_sel_any("inside", $sv_G["ECT"], $sv_G["ESAB_HO"], [], false, {}) }
$sv_G.define("ENMOS") { sv_sel_any("enclose", $sv_G["ENACT"], $sv_G["EGATE"], [], false, {}) }
$sv_G.define("EPMOS") { sv_sel_any("enclose", $sv_G["EPACT"], $sv_G["EGATE"], [], false, {}) }
$sv_G.define("ENMOS_SD") { sv_bool("NOT", $sv_G["ENMOS"], $sv_G["EGATE"]) }
$sv_G.define("EPMOS_SD") { sv_bool("NOT", $sv_G["EPMOS"], $sv_G["EGATE"]) }
$sv_G.define("ENMOS_S") { sv_sel_any("touch", sv_bool("NOT", $sv_G["ENMOS_SD"], $sv_G["ESAB"]), $sv_G["EGATE"], [], false, {}) }
$sv_G.define("ENMOS_D") { sv_sel_any("touch", sv_bool("NOT", $sv_G["ENMOS_SD"], $sv_G["ESAB"]), $sv_G["EGATE"], [], true, {}) }
$sv_G.define("ENMOS_DRAIN") { sv_sel_any("interact", sv_sel_any("interact", $sv_G["ENMOS_SD"], $sv_G["ENMOS_D"], [], false, {}), $sv_G["ECT"], [], false, {}) }
$sv_G.define("EPMOS_S") { sv_sel_any("touch", sv_bool("NOT", $sv_G["EPMOS_SD"], $sv_G["ESAB"]), $sv_G["EGATE"], [], false, {}) }
$sv_G.define("EPMOS_D") { sv_sel_any("touch", sv_bool("NOT", $sv_G["EPMOS_SD"], $sv_G["ESAB"]), $sv_G["EGATE"], [], true, {}) }
$sv_G.define("EPMOS_DRAIN") { sv_sel_any("interact", sv_sel_any("interact", $sv_G["EPMOS_SD"], $sv_G["EPMOS_D"], [], false, {}), $sv_G["ECT"], [], false, {}) }
$sv_G.define("EMOS_D") { sv_bool("OR", $sv_G["ENMOS_D"], $sv_G["EPMOS_D"]) }
$sv_G.define("EMOS_S") { sv_bool("OR", $sv_G["ENMOS_S"], $sv_G["EPMOS_S"]) }
$sv_G.define("ENGUARDRING") { sv_holes($sv_G["ENTAP"], {:inner => true, :empty => true}) }
$sv_G.define("EPGUARDRING") { sv_holes($sv_G["EPTAP"], {:inner => true, :empty => true}) }
$sv_G.define("ENGUARDHOLE_2") { sv_sel_any("enclose", sv_holes($sv_G["ENTAP"], {:inner => true}), $sv_G["EPGUARDRING"], [], false, {}) }
$sv_G.define("EPGUARDHOLE_2") { sv_sel_any("enclose", sv_holes($sv_G["EPTAP"], {:inner => true}), $sv_G["ENGUARDRING"], [], false, {}) }
$sv_G.define("NESDCLP_NOSAB") { sv_sel_any("interact", sv_bool("AND", $sv_G["NACT"], $sv_G["ESDIOE"]), $sv_G["SAB"], [], true, {}) }
$sv_G.define("NESDCLP_SAB") { sv_sel_any("interact", sv_bool("AND", $sv_G["NACT"], $sv_G["ESDIOE"]), $sv_G["SAB"], [], false, {}) }
$sv_G.define("PESDCLP_NOSAB") { sv_sel_any("interact", sv_bool("AND", $sv_G["PACT"], $sv_G["ESDIOE"]), $sv_G["SAB"], [], true, {}) }
$sv_G.define("PESDCLP_SAB") { sv_sel_any("interact", sv_bool("AND", $sv_G["PACT"], $sv_G["ESDIOE"]), $sv_G["SAB"], [], false, {}) }
$sv_G.define("ENGATE_NOSAB") { sv_bool("AND", $sv_G["GATE"], $sv_G["NESDCLP_NOSAB"]) }
$sv_G.define("ENGATE_SAB") { sv_bool("AND", $sv_G["GATE"], $sv_G["NESDCLP_SAB"]) }
$sv_G.define("EPGATE_NOSAB") { sv_bool("AND", $sv_G["GATE"], $sv_G["PESDCLP_NOSAB"]) }
$sv_G.define("EPGATE_SAB") { sv_bool("AND", $sv_G["GATE"], $sv_G["PESDCLP_SAB"]) }
$sv_G.define("EGATE_NOSAB") { sv_bool("OR", $sv_G["ENGATE_NOSAB"], $sv_G["EPGATE_NOSAB"]) }
$sv_G.define("EGATE_SAB") { sv_bool("OR", $sv_G["ENGATE_SAB"], $sv_G["EPGATE_SAB"]) }
$sv_G.define("ESD3C_1") { sv_expand_edge(sv_esel("inside_edge", sv_bool("NOT", $sv_G["EGATE"], $sv_G["EGATE_CASCODED"]), $sv_G["AA"], [], false), {:inside => 0.001}) }
$sv_G.define("ESD3C_2") { sv_expand_edge(sv_esel("inside_edge", sv_sel_any("inside", $sv_G["EGATE_CASCODED"], $sv_G["SAB"], [], true, {}), $sv_G["AA"], [], false), {:inside => 0.001}) }
$sv_G.define("ESD3C") { sv_bool("OR", $sv_G["ESD3C_1"], $sv_G["ESD3C_2"]) }
$sv_G.define("ENACT_D") { sv_sel_any("interact", sv_sel_any("interact", sv_bool("NOT", $sv_G["ENACT"], $sv_G["PO"]), $sv_G["PO"], [], false, {}), $sv_G["SAB"], [[">=", 1.0]], false, {}) }
$sv_G.define("EPACT_D") { sv_sel_any("interact", sv_sel_any("interact", sv_bool("NOT", $sv_G["EPACT"], $sv_G["PO"]), $sv_G["PO"], [], false, {}), $sv_G["SAB"], [[">=", 1.0]], false, {}) }
$sv_G.define("EACT_D") { sv_bool("OR", $sv_G["ENACT_D"], $sv_G["EPACT_D"]) }
$sv_G.define("ENGATE_D_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], sv_bool("AND", $sv_G["ESDIOE"], $sv_G["ENMOS_DRAIN"])) }
$sv_G.define("EPGATE_D_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], sv_bool("AND", $sv_G["ESDIOE"], $sv_G["EPMOS_DRAIN"])) }
$sv_G.define("ESD3C_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], $sv_G["ESD3C"]) }
$sv_G.define("ECT_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], $sv_G["ECT"]) }
sv_connect(["ENGATE_D_EMPTY", "ESD3C_EMPTY"], nil)
sv_connect(["EPGATE_D_EMPTY", "ESD3C_EMPTY"], nil)
