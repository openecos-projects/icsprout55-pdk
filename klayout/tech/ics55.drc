if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("SAB_EX_4_R", "Extension on unsilicided AA/POLY when SAB width is > 10um DRC waive if > 5 poly fingers interact with the SAB. >= 0.30um") do |outs|
    s = SvScope.new(self, $sv_G, "SAB_EX_4_R")
