end
sv_rule("AAres_S_1_PVT1", "Space between non-silicide AA resistors area and other implant region >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_S_1_PVT1")
  s.define("X") { sv_sel_any("interact", s["LVTP"], s["AARES"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["AAR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_S_1_ESD", "Space between non-silicide AA resistors area and other implant region >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_S_1_ESD")
  s.define("X") { sv_sel_any("interact", s["ESD1"], s["AARES"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["AAR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_S_1_HRP", "Space between non-silicide AA resistors area and other implant region >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_S_1_HRP")
  s.define("X") { sv_sel_any("interact", s["HRP"], s["AARES"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["AAR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_S_2", "Space between SAB and CT for non-silicide AA resistor = 0.21um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_S_2")
  s.define("X") { sv_bool("AND", s["AAR"], s["SAB"]) }
  s.define("Y") { sv_bool("AND", s["CT"], sv_sel_any("interact", s["AAR"], s["SAB"], [], false, {})) }
  outs << proc { sv_sel_any("inside", sv_sel_any("touch", sv_size(s["Y"], 0.21, {}), s["AAR_SA"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_EN_1", "PP/NP enclosure of resistor AA >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_EN_1")
  s.define("X") { sv_bool("OR", s["SDP"], s["SDN"]) }
  outs << proc { sv_sel_any("inside", sv_check("enc", sv_bool("AND", s["AA"], s["AARES"]), s["X"], [["<", 0.18]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_EX_1", "Extension of AARES outside of non-silicide AA resistor area >= 0.2um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_EX_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["AAR_SA"], s["AARES"], [["<", 0.2]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_R_1", "Non-silicide AA resistor region should be covered by SAB and implanted by NP or PP") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_R_1")
  s.define("X") { sv_sel_any("interact", s["AAR"], s["SAB"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", s["X"], sv_nary("OR", s["SDN"], s["SDP"])), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_R_2", "Non-silicide AA resistor with PP must be inside NW") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_R_2")
  s.define("AARES_SAB") { sv_bool("AND", sv_bool("AND", s["AARES"], s["AA"]), s["SAB"]) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("AND", s["AARES_SAB"], s["SDP"]), s["NW"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_R_3", "It is not allowed dog-bone design at the end of AA resistor for contact pick-up") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_R_3")
  s.define("X") { sv_sel_any("interact", s["AAR"], s["SAB"], [], false, {}) }
  outs << proc { sv_esel("inside_edge", sv_convex_edge(s["X"], {:count => [["==", 1.0]]}), s["NODRC"], [], true) }
end
sv_rule("AAres_R_4", "For Silicide AA resistor, two sides of AARES must be along the CT edge") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_R_4")
  s.define("X") { sv_bool("AND", s["CT"], s["AAR_NS"]) }
  s.define("Y") { sv_esel("inside_edge", sv_sel_any("interact", s["AARES"], s["SAB"], [], true, {}), s["AA"], [], false) }
  outs << proc { sv_esel("inside_edge", sv_esel("touch_edge", s["Y"], s["X"], [], true), s["NODRC"], [], true) }
end
sv_rule("NWresAA_W_1", "NW-Resistor width,and suggest NW resistor length/width ratio > 5,length >= 20um for SPICE simulation accuracy >= 1.8 um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_W_1")
  s.define("X") { sv_bool("AND", sv_bool("AND", sv_bool("AND", s["NW1res"], s["AA"]), s["NW"]), s["SAB"]) }
  outs << proc { sv_esel("inside_edge", sv_length(sv_esel("inside_edge", s["X"], s["NW"], [], false), [["<", 1.8]], false), s["NODRC"], [], true) }
end
sv_rule("NWresAA_S_1", "Space between NW of NW resistors and un-related implant region >= 0.60um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_S_1")
  s.define("X") { sv_sel_any("interact", s["NWR"], sv_holes(s["SAB"], {}), [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["NW"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["HVTN"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["HVTP"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["LVTN"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["LVTP"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["SDN"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["SDP"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["NPR"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["ESD1"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("interact", s["HRP"], s["NWR"], [], true, {}), [["<", 0.6]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NWresAA_S_2", "Space between SAB and CT for NW ressitor = 0.28 um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_S_2")
  s.define("X") { sv_size(sv_bool("AND", s["CT"], sv_sel_any("interact", s["AA"], s["NW1res"], [], false, {})), 0.28, {}) }
  s.define("Y") { sv_esel("inside_edge", s["SAB"], sv_sel_any("interact", s["NW"], s["NW1res"], [], false, {}), [], false) }
  outs << proc { sv_esel("touch_edge", s["Y"], s["X"], [], true) }
end
sv_rule("NWresAA_S_3", "Space between NW resistor and (NW resistor OR NW) >= 1.2um") do |outs|
  s = SvScope.new(self, $sv_G, "NWresAA_S_3")
  s.define("X") { sv_sel_any("interact", s["NW"], s["NW1res"], [], false, {}) }
