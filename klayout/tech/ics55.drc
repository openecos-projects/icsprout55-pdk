sv_rule("MET1_S_5", "Minimum Space at metal1 line-end(W<0.11um) in a dense-line-end configuration: if metal1 has parallel run length with opposite metal1 along 2 adjacent edge metal1 (any one edge < 0.11um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.11 (except for small jog with edge length < 0.09um)") do |outs|
  s = SvScope.new(self, $sv_G, "MET1_S_5")
  s.define("LINE_END") { sv_convex_edge(s["M1"], {:angle1 => [["==", 90.0]], :angle2 => [["==", 90.0]], :length => [["<", 0.11]]}) }
  s.define("LINE_END_SP") { sv_check("ext", s["LINE_END"], s["M1"], [["<", 0.11]], {:abut => [["<", 90.0]], :metric => "opposite", :out => 1.0}) }
  s.define("LINE_SIDE") { sv_esel("touch_inside_edge", s["LINE_END"], s["LINE_END_SP"], [], false) }
  s.define("LINE_END_M1") { sv_check("int", s["LINE_SIDE"], s["M1"], [["<", 0.11]], {:abut => [["==", 90.0]], :intersecting => "only", :out => 2.0}) }
  s.define("LINE_END_M1_009") { sv_length(s["LINE_END_M1"], [[">=", 0.09]], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["LINE_END_M1_009"], s["M1"], [["<", 0.11]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["MOMTER"]), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
