sv_connect(["ALPA_1", "MD_1"], nil)
$sv_G.define("NMOS_PAD") { sv_sel_any("interact", $sv_G["NMOS"], sv_net_area_ratio([$sv_G["NACT_1"], $sv_G["MD_IO_PAD"]], nil, [[">", 0.0]], {:bases => [$sv_G["NACT_1"], $sv_G["MD_1"]]}), [], false, {}) }
$sv_G.define("PMOS_PAD") { sv_sel_any("interact", $sv_G["PMOS"], sv_net_area_ratio([$sv_G["PACT_1"], $sv_G["MD_IO_PAD"]], nil, [[">", 0.0]], {:bases => [$sv_G["PACT_1"], $sv_G["MD_1"]]}), [], false, {}) }
$sv_G.define("NACT_PAD") { sv_net_area_ratio([$sv_G["NACT_1"], $sv_G["MD_IO_PAD"]], nil, [[">", 0.0]], {:bases => [$sv_G["NACT_1"], $sv_G["MD_1"]]}) }
$sv_G.define("PACT_PAD") { sv_net_area_ratio([$sv_G["PACT_1"], $sv_G["MD_IO_PAD"]], nil, [[">", 0.0]], {:bases => [$sv_G["PACT_1"], $sv_G["MD_1"]]}) }
$sv_G.define("PMOS1") { sv_sel_any("enclose", $sv_G["PACT"], $sv_G["GATE"], [], false, {}) }
$sv_G.define("NMOS1") { sv_sel_any("enclose", $sv_G["NACT"], $sv_G["GATE"], [], false, {}) }
$sv_G.define("NGUARDRING") { sv_holes($sv_G["NTAP"], {:inner => true}) }
$sv_G.define("PGUARDRING") { sv_holes($sv_G["PTAP"], {:inner => true}) }
$sv_G.define("NGUARDHOLE_2") { sv_sel_any("enclose", sv_holes($sv_G["NTAP"], {:inner => true}), $sv_G["PGUARDRING"], [], false, {}) }
$sv_G.define("PGUARDHOLE_2") { sv_sel_any("enclose", sv_holes($sv_G["PTAP"], {:inner => true}), $sv_G["NGUARDRING"], [], false, {}) }
$sv_G.define("GATEHV") { sv_bool("AND", $sv_G["GATE"], $sv_G["TG"]) }
$sv_G.define("NGATEHV") { sv_bool("AND", $sv_G["NGATE"], $sv_G["TG"]) }
$sv_G.define("PGATEHV") { sv_bool("AND", $sv_G["PGATE"], $sv_G["TG"]) }
$sv_G.define("GATEMV") { sv_bool("AND", $sv_G["GATE"], $sv_G["DG"]) }
$sv_G.define("GATELV") { sv_sel_any("inside", $sv_G["GATE"], sv_bool("OR", $sv_G["DG"], $sv_G["TG"]), [], true, {}) }
if sv_ifdef("LATCH_UP_CHECK", "YES")
  sv_rule("LU_R_2", "Guard ring should be used to surround AA injector or a group of AA injectors which are connected to an I/O pad N+ injector must be surrounded by a P+ guard-ring P+ injector must be surrounded by a N+ guard-ring NW/PW pickups rings can be used as guard rings. DRC check the nearest guard-ring which surrounds AA injector or a group of AA injector") do |outs|
    s = SvScope.new(self, $sv_G, "LU_R_2")
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("NOT", sv_sel_any("touch", s["NACT_IO_PAD"], s["PO"], [], false, {}), s["PGUARDRING"]), sv_bool("OR", s["LATCHUP"], s["SRINGBLK"]), [], true, {}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("NOT", sv_sel_any("touch", s["PACT_IO_PAD"], s["PO"], [], false, {}), s["NGUARDRING"]), sv_bool("OR", s["LATCHUP"], s["SRINGBLK"]), [], true, {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("LU_W_1", "Guard-ring width for AA injector connected to an I/O pad Guard-ring definition please refers to LU.1. >= 0.12um") do |outs|
    s = SvScope.new(self, $sv_G, "LU_W_1")
    outs << proc { sv_sel_any("inside", sv_check("int", sv_sel_any("touch", sv_donut(s["NTAP"], [], false), sv_sel_any("enclose", sv_holes(s["NTAP"], {:inner => true}), s["PACT_IO_PAD"], [], false, {}), [], false, {}), nil, [["<", 0.12]], {:abut => [["<", 90.0]], :singular => true, :region => true}), sv_nary("OR", s["SRINGBLK"], s["LATCHUP"], s["NODRC"]), [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("int", sv_sel_any("touch", sv_donut(s["PTAP"], [], false), sv_sel_any("enclose", sv_holes(s["PTAP"], {:inner => true}), s["NACT_IO_PAD"], [], false, {}), [], false, {}), nil, [["<", 0.12]], {:abut => [["<", 90.0]], :singular => true, :region => true}), sv_nary("OR", s["SRINGBLK"], s["LATCHUP"], s["NODRC"]), [], true, {}) }
  end
  if sv_ifdef("LU_3_CHECK", "FAST")
    sv_rule("LU_S_1a", "For 0.9/1.2V core N/PMOS AA connected to an I/O pad Spacing between NMOS and PMOS >= 2.0um") do |outs|
      s = SvScope.new(self, $sv_G, "LU_S_1a")
      s.define("X") { sv_bool("NOT", sv_sel_any("enclose", s["NMOS_IO_PAD"], s["GATELV"], [], false, {}), s["SRINGBLK"]) }
      s.define("Y") { sv_bool("NOT", sv_sel_any("enclose", s["PMOS_IO_PAD"], s["GATELV"], [], false, {}), s["SRINGBLK"]) }
      s.define("M") { sv_bool("NOT", sv_sel_any("enclose", s["NMOS"], s["GATELV"], [], false, {}), s["SRINGBLK"]) }
      s.define("N") { sv_bool("NOT", sv_sel_any("enclose", s["PMOS"], s["GATELV"], [], false, {}), s["SRINGBLK"]) }
      s.define("Z1") { sv_size(s["X"], 1.036, {:bevel => 3.0}) }
      s.define("Z2") { sv_size(s["N"], 1.036, {:bevel => 3.0}) }
      outs << proc { sv_sel_any("inside", sv_bool("AND", s["Z1"], s["Z2"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
      s.define("Z3") { sv_size(s["M"], 1.036, {:bevel => 3.0}) }
      s.define("Z4") { sv_size(s["Y"], 1.036, {:bevel => 3.0}) }
      outs << proc { sv_sel_any("inside", sv_bool("AND", s["Z3"], s["Z4"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
    end
    sv_rule("LU_S_1b", "LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1). For 1.8V N/PMOS AA connected to an I/O pad Spacing between 1.8V NMOS and 1.8V PMOS and Spacing between 1.8V PMOS and 1.8V/Core NMOS. >= 2.3um") do |outs|
      s = SvScope.new(self, $sv_G, "LU_S_1b")
      s.define("X") { sv_sel_any("enclose", s["NMOS_IO_PAD"], s["GATEMV"], [], false, {}) }
      s.define("Y") { sv_sel_any("enclose", s["PMOS_IO_PAD"], s["GATEMV"], [], false, {}) }
      s.define("M") { sv_sel_any("enclose", s["NMOS"], sv_bool("OR", s["GATELV"], s["GATEMV"]), [], false, {}) }
      s.define("N") { sv_sel_any("enclose", s["PMOS"], sv_bool("OR", s["GATELV"], s["GATEMV"]), [], false, {}) }
      s.define("Z1") { sv_size(s["X"], 1.191, {:bevel => 3.0}) }
      s.define("Z2") { sv_size(s["N"], 1.191, {:bevel => 3.0}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("AND", s["Z1"], s["Z2"]), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
      s.define("Z3") { sv_size(s["M"], 1.191, {:bevel => 3.0}) }
      s.define("Z4") { sv_size(s["Y"], 1.191, {:bevel => 3.0}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("AND", s["Z3"], s["Z4"]), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
    end
    sv_rule("LU_S_1c", "LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1). For 2.5V N/PMOS AA connected to an I/O pad Spacing between 2.5V NMOS and 2.5V PMOS and Spacing between 2.5V PMOS and 2.5V/Core NMOS. >= 3.2um") do |outs|
      s = SvScope.new(self, $sv_G, "LU_S_1c")
      s.define("X") { sv_sel_any("enclose", s["NMOS_IO_PAD"], s["GATEHV"], [], false, {}) }
      s.define("Y") { sv_sel_any("enclose", s["PMOS_IO_PAD"], s["GATEHV"], [], false, {}) }
      s.define("M") { sv_sel_any("enclose", s["NMOS"], sv_bool("OR", s["GATELV"], s["GATEHV"]), [], false, {}) }
      s.define("N") { sv_sel_any("enclose", s["PMOS"], sv_bool("OR", s["GATELV"], s["GATEHV"]), [], false, {}) }
      s.define("Z1") { sv_size(s["X"], 1.657, {:bevel => 3.0}) }
      s.define("Z2") { sv_size(s["N"], 1.657, {:bevel => 3.0}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("AND", s["Z1"], s["Z2"]), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
      s.define("Z3") { sv_size(s["M"], 1.657, {:bevel => 3.0}) }
      s.define("Z4") { sv_size(s["Y"], 1.657, {:bevel => 3.0}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("AND", s["Z3"], s["Z4"]), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
    end
    sv_rule("LU_S_1d", "For 3.3 V N/PMOS (or 2.5V overdrive 3.3V) AA connected to an I/O pad Spacing between 3.3V NMOS and 3.3V/0.9V/1.2V PMOS and Spacing between 3.3V PMOS and 3.3V/0.9V/1.2V NMOS. >= 5um") do |outs|
      s = SvScope.new(self, $sv_G, "LU_S_1d")
      s.define("X") { sv_sel_any("enclose", s["NMOS_IO_PAD"], s["GATEHV"], [], false, {}) }
      s.define("Y") { sv_sel_any("enclose", s["PMOS_IO_PAD"], s["GATEHV"], [], false, {}) }
      s.define("M") { sv_sel_any("enclose", s["NMOS"], sv_bool("OR", s["GATELV"], s["GATEHV"]), [], false, {}) }
      s.define("N") { sv_sel_any("enclose", s["PMOS"], sv_bool("OR", s["GATELV"], s["GATEHV"]), [], false, {}) }
      s.define("Z1") { sv_size(s["X"], 2.589, {:bevel => 3.0}) }
      s.define("Z2") { sv_size(s["N"], 2.589, {:bevel => 3.0}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("AND", s["Z1"], s["Z2"]), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
      s.define("Z3") { sv_size(s["M"], 2.589, {:bevel => 3.0}) }
      s.define("Z4") { sv_size(s["Y"], 2.589, {:bevel => 3.0}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("AND", s["Z3"], s["Z4"]), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
    end
  end
  if sv_ifdef("LU_3_CHECK", "ACCURATE")
    sv_rule("LU_S_1a", "LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1). For core N/PMOS connected to an I/O pad Spacing between NMOS and PMOS. >= 2um") do |outs|
      s = SvScope.new(self, $sv_G, "LU_S_1a")
      s.define("X") { sv_sel_any("enclose", s["NMOS_IO_PAD"], s["GATELV"], [], false, {}) }
      s.define("Y") { sv_sel_any("enclose", s["PMOS_IO_PAD"], s["GATELV"], [], false, {}) }
      s.define("M") { sv_sel_any("enclose", s["NMOS"], s["GATELV"], [], false, {}) }
      s.define("N") { sv_sel_any("enclose", s["PMOS"], s["GATELV"], [], false, {}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["X"], s["N"], [["<", 2.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M"], s["Y"], [["<", 2.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
    end
    sv_rule("LU_S_1b", "LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1). For 1.8V N/PMOS AA connected to an I/O pad Spacing between 1.8V NMOS and 1.8V/Core PMOS and Spacing between 1.8V PMOS and 1.8V/Core NMOS. >= 2.3um") do |outs|
      s = SvScope.new(self, $sv_G, "LU_S_1b")
      s.define("X") { sv_sel_any("enclose", s["NMOS_IO_PAD"], s["GATEMV"], [], false, {}) }
      s.define("Y") { sv_sel_any("enclose", s["PMOS_IO_PAD"], s["GATEMV"], [], false, {}) }
      s.define("M") { sv_sel_any("enclose", s["NMOS"], sv_bool("OR", s["GATELV"], s["GATEMV"]), [], false, {}) }
      s.define("N") { sv_sel_any("enclose", s["PMOS"], sv_bool("OR", s["GATELV"], s["GATEMV"]), [], false, {}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M"], s["Y"], [["<", 2.3]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["X"], s["N"], [["<", 2.3]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
    end
    sv_rule("LU_S_1c", "LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1). For 2.5V N/PMOS AA connected to an I/O pad Spacing between 2.5V NMOS and 2.5V/Core PMOS and Spacing between 2.5V PMOS and 2.5V/Core NMOS. >= 3.2um") do |outs|
      s = SvScope.new(self, $sv_G, "LU_S_1c")
      s.define("X") { sv_sel_any("enclose", s["NMOS_IO_PAD"], s["GATEHV"], [], false, {}) }
      s.define("Y") { sv_sel_any("enclose", s["PMOS_IO_PAD"], s["GATEHV"], [], false, {}) }
      s.define("M") { sv_sel_any("enclose", s["NMOS"], sv_bool("OR", s["GATELV"], s["GATEHV"]), [], false, {}) }
      s.define("N") { sv_sel_any("enclose", s["PMOS"], sv_bool("OR", s["GATELV"], s["GATEHV"]), [], false, {}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M"], s["Y"], [["<", 3.2]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["X"], s["N"], [["<", 3.2]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
    end
    sv_rule("LU_S_1d", "LU.3a-LU.3d define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad. (Fig.1). For 3.3 V N/PMOS AA (2.5V overdrive) connected to an I/O pad Spacing between 3.3V NMOS and 3.3V/Core PMOS and Spacing between 3.3V PMOS and 3.3V/Core NMOS >= 5.0um.") do |outs|
      s = SvScope.new(self, $sv_G, "LU_S_1d")
      s.define("X") { sv_sel_any("enclose", s["NMOS_IO_PAD"], s["GATEHV"], [], false, {}) }
      s.define("Y") { sv_sel_any("enclose", s["PMOS_IO_PAD"], s["GATEHV"], [], false, {}) }
      s.define("M") { sv_sel_any("enclose", s["NMOS"], sv_bool("OR", s["GATELV"], s["GATEHV"]), [], false, {}) }
      s.define("N") { sv_sel_any("enclose", s["PMOS"], sv_bool("OR", s["GATELV"], s["GATEHV"]), [], false, {}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["X"], s["N"], [["<", 5.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
      outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["Y"], s["M"], [["<", 5.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"]), sv_nary("OR", s["LATCHUP"], s["NODRC"]), [], true, {}) }
    end
  end
  sv_rule("LU_S_2_NTAP", "Space (S2) from any point within the Source/Drain region to the nearest pickup AA region inside the same well for I/O and internal circuits. (Fig.2). For native device, DRC check the pickup AA inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted. <= 35um") do |outs|
    s = SvScope.new(self, $sv_G, "LU_S_2_NTAP")
    s.define("NW_MINUS_NTAP_0") { sv_size(s["NTAP"], 5.0, {:inside_of => s["NW"], :step => 0.38, :bevel => 4.0}) }
    s.define("MAYBE_BAD_b") { sv_bool("NOT", s["NW"], s["NW_MINUS_NTAP_0"]) }
    s.define("NW_FILTER") { sv_sel_any("interact", s["NW"], s["MAYBE_BAD_b"], [], false, {}) }
    s.define("NW_MINUS_NTAP_1") { sv_bool("AND", s["NW_MINUS_NTAP_0"], s["NW_FILTER"]) }
    s.define("NW_MINUS_NTAP") { sv_size(s["NW_MINUS_NTAP_1"], 30.0, {:inside_of => s["NW_FILTER"], :step => 0.38, :bevel => 4.0}) }
    s.define("X") { sv_bool("AND", s["PMOS1"], s["NW_FILTER"]) }
    outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_esel("outside_edge", s["X"], s["NW_MINUS_NTAP"], [], false), s["SRINGBLK"], [], true), s["NODRC"], [], true) }
  end
  sv_rule("LU_S_2_PTAP", "Space (S2) from any point within the Source/Drain region to the nearest pickup AA region inside the same well for I/O and internal circuits.(Fig. 7.3.14-2) For native device, DRC check the pickup AA inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted. <= 35um") do |outs|
    s = SvScope.new(self, $sv_G, "LU_S_2_PTAP")
    s.define("PW_MINUS_PTAP_0") { sv_size(s["PTAP"], 5.0, {:inside_of => s["PW"], :step => 0.38, :bevel => 4.0}) }
    s.define("MAYBE_BAD_b") { sv_bool("NOT", s["PW"], s["PW_MINUS_PTAP_0"]) }
    s.define("PW_FILTER") { sv_sel_any("interact", s["PW"], s["MAYBE_BAD_b"], [], false, {}) }
    s.define("PW_MINUS_PTAP_1") { sv_bool("AND", s["PW_MINUS_PTAP_0"], s["PW_FILTER"]) }
    s.define("PW_MINUS_PTAP") { sv_size(s["PW_MINUS_PTAP_1"], 30.0, {:inside_of => s["PW_FILTER"], :step => 0.38, :bevel => 4.0}) }
    s.define("X") { sv_bool("AND", s["NMOS1"], s["PW_FILTER"]) }
    outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_esel("outside_edge", s["X"], s["PW_MINUS_PTAP"], [], false), s["SRINGBLK"], [], true), s["NODRC"], [], true) }
    s.define("SIZE_REGION") { sv_nary("OR", s["PW"], s["PSUB"], s["NW"]) }
    s.define("SIZE_PTAP_NOT_DNW") { sv_bool("NOT", s["PTAP"], sv_sel_any("interact", s["DNW"], s["PSUB"], [], true, {})) }
    s.define("PW_SIZE_a") { sv_size(s["SIZE_PTAP_NOT_DNW"], 5.0, {:inside_of => s["SIZE_REGION"], :step => 0.38, :bevel => 4.0}) }
    s.define("MAYBE_BAD_PSUB_a") { sv_bool("NOT", s["SIZE_REGION"], s["PW_SIZE_a"]) }
    s.define("PW_FILTER_PSUB_a") { sv_sel_any("interact", s["SIZE_REGION"], s["MAYBE_BAD_PSUB_a"], [], false, {}) }
    s.define("PW_MINUS_PTAP_PSUB_a") { sv_bool("AND", s["PW_SIZE_a"], s["PW_FILTER_PSUB_a"]) }
    s.define("PW_SIZE_1") { sv_size(s["PW_MINUS_PTAP_PSUB_a"], 30.0, {:inside_of => s["PW_FILTER_PSUB_a"], :step => 0.38, :bevel => 4.0}) }
    s.define("NMOS_PSUB_a") { sv_bool("AND", sv_sel_any("interact", sv_bool("AND", s["NMOS1"], s["PSUB"]), s["DNW"], [], true, {}), s["PW_FILTER_PSUB_a"]) }
    outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_esel("outside_edge", s["NMOS_PSUB_a"], s["PW_SIZE_1"], [], false), s["SRINGBLK"], [], true), s["NODRC"], [], true) }
    s.define("SIZE_PTAP_AND_DNW") { sv_sel_any("interact", sv_bool("AND", s["PTAP"], sv_sel_any("interact", s["PW"], s["PSUB"], [], false, {})), s["DNW"], [], false, {}) }
    s.define("PW_SIZE_b") { sv_size(s["SIZE_PTAP_AND_DNW"], 5.0, {:inside_of => s["SIZE_REGION"], :step => 0.38, :bevel => 4.0}) }
    s.define("MAYBE_BAD_PSUB_b") { sv_bool("NOT", s["SIZE_REGION"], s["PW_SIZE_b"]) }
    s.define("PW_FILTER_PSUB_b") { sv_sel_any("interact", s["SIZE_REGION"], s["MAYBE_BAD_PSUB_b"], [], false, {}) }
    s.define("PW_MINUS_PTAP_PSUB_b") { sv_bool("AND", s["PW_SIZE_b"], s["PW_FILTER_PSUB_b"]) }
    s.define("PW_SIZE_2") { sv_size(s["PW_MINUS_PTAP_PSUB_b"], 30.0, {:inside_of => s["PW_FILTER_PSUB_b"], :step => 0.38, :bevel => 4.0}) }
    s.define("NMOS_PSUB_b") { sv_bool("AND", sv_sel_any("interact", sv_bool("AND", s["NMOS1"], s["PSUB"]), s["DNW"], [], false, {}), s["PW_FILTER_PSUB_b"]) }
    outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_esel("outside_edge", s["NMOS_PSUB_b"], s["PW_SIZE_2"], [], false), s["SRINGBLK"], [], true), s["NODRC"], [], true) }
  end
end
if sv_ifdef("MOM_CHECK", "YES")
  sv_rule("MOM_R_1", "It is not allowed: 1) V1 in M1MOM 2) Vn/Vn-1 in MOMMKn (n = 2~8), whereVn-1 is the via underneath Mn, and Vn is the via above Mn. Vn can be inter-via or T4V1/T2V1 or T4V2/T2V2") do |outs|
    s = SvScope.new(self, $sv_G, "MOM_R_1")
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["V1"], s["M1MOM"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["V1"], s["M2MOM"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["V2"], s["M2MOM"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["V2"], s["M3MOM"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["V3"], s["M3MOM"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["V3"], s["M4MOM"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["V4"], s["M4MOM"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["V4"], s["M5MOM"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["T4V2"], s["M5MOM"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("MOM_S_1", "The space between (Mn AND MOMMKn AND MOMLVS1) and Vn/Vn-1 (n = 1~8) outside of MOMLVS1, whereVn-1 is the via underneath Mn, and Vn is the via above Mn. Vn can be inter-via or T4V1 or T4V2. >= 0.11um") do |outs|
    s = SvScope.new(self, $sv_G, "MOM_S_1")
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["V1"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M1"], s["M1MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["V1"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M2"], s["M2MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["V2"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M2"], s["M2MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["V2"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M3"], s["M3MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["V3"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M3"], s["M3MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["V3"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M4"], s["M4MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["V4"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M4"], s["M4MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["V4"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M5"], s["M5MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", sv_sel_any("outside", s["T4V2"], s["MOMLVS1"], [], false, {}), sv_bool("AND", sv_bool("AND", s["M5"], s["M5MOM"]), s["MOMLVS1"]), [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  end
  sv_rule("MOM_R_2", "MOMLVS1 and MOMMKn layers are must for MOM device. DRC checking is based on the label text by MOMLVS1 layer. Possible label texts and related MOMMKn follow the Table-1. DRC need flag the stacked MOM structure") do |outs|
    s = SvScope.new(self, $sv_G, "MOM_R_2")
    s.define("M1MOM_12") { sv_sel_any("interact", s["M1MOM"], sv_with_text(s["MOMLVS1"], sv_text([[323, 12]]), "momcap12", false), [], false, {}) }
