sv_rule("V2_EN_5a_5b", "Vn must be fully enclosed by Mn+1 Min M3 enclsoure of V2 is 0.005 Min M3 enclosure of V2 is 0.02 when M3 enclosure on one or both perpendicular directions<0.02um") do |outs|
  s = SvScope.new(self, $sv_G, "V2_EN_5a_5b")
  s.define("X") { sv_rect_enc(s["V2"], s["M3"], [[[0.005, true], [0.02, true], [0.005, true], [0.02, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X"], s["M3"], [["<", 0.005]], {:abut => [["<", 90.0]], :singular => true, :region => true, :overlap => true, :outside_also => true}), s["NODRC"], [], true, {}) }
  s.define("Y") { sv_check("enc", s["X"], s["M3"], [["<", 0.02]], {:metric => "opposite", :out => 1.0}) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["Y"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :intersecting => "only", :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", s["V2"], s["M3"]), s["NODRC"], [], true, {}) }
