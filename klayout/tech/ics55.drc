sv_rule("M2_S_5", "Minimum Space at metalX line-end(W<0.12um) in a dense-line-end configuration:if metalx has parallel run length with opposite metalx along 2 adjacent edge metalx (any one edge < 0.12um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.12 (except for small jog with edge length < 0.10um)") do |outs|
  s = SvScope.new(self, $sv_G, "M2_S_5")
  s.define("LINE_END") { sv_convex_edge(s["M2"], {:angle1 => [["==", 90.0]], :angle2 => [["==", 90.0]], :length => [["<", 0.12]]}) }
  s.define("LINE_END_SP") { sv_check("ext", s["LINE_END"], s["M2"], [["<", 0.12]], {:abut => [["<", 90.0]], :metric => "opposite", :out => 1.0}) }
  s.define("LINE_SIDE") { sv_esel("touch_inside_edge", s["LINE_END"], s["LINE_END_SP"], [], false) }
  s.define("LINE_END_Mn") { sv_check("int", s["LINE_SIDE"], s["M2"], [["<", 0.12]], {:abut => [["==", 90.0]], :intersecting => "only", :out => 2.0}) }
  s.define("LINE_END_Mn_010") { sv_length(s["LINE_END_Mn"], [[">=", 0.1]], false) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["LINE_END_Mn_010"], s["M2"], [["<", 0.12]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["MOMTER"]), s["NODRC"], [], true, {}) }
end
