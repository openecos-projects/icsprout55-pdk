sv_rule("SRCK_3_M1", "Space between outer ring metal and window edge = 2") do |outs|
  s = SvScope.new(self, $sv_G, "SRCK_3_M1")
  outs << proc { sv_check("enc", s["M1S_OUTER"], s["DRC1_S"], [["<", 2.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  s.define("X") { sv_bool("NOT", s["DRC1_S"], sv_bool("OR", s["M1S_OUTER"], sv_holes(s["M1S_OUTER"], {}))) }
  s.define("Y") { sv_size(s["X"], -1.0, {}) }
  s.define("Z") { sv_esel("with_edge", s["Y"], sv_angle(s["Y"], [["==", 45.0]], false), [], false) }
  outs << proc { sv_sel_any("interact", s["X"], sv_bool("NOT", s["Y"], s["Z"]), [], false, {}) }
end
sv_rule("SRCK_3_M2", "Space between outer ring metal and window edge = 2") do |outs|
  s = SvScope.new(self, $sv_G, "SRCK_3_M2")
  outs << proc { sv_check("enc", s["M2S_OUTER"], s["DRC1_S"], [["<", 2.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  s.define("X") { sv_bool("NOT", s["DRC1_S"], sv_bool("OR", s["M2S_OUTER"], sv_holes(s["M2S_OUTER"], {}))) }
  s.define("Y") { sv_size(s["X"], -1.0, {}) }
  s.define("Z") { sv_esel("with_edge", s["Y"], sv_angle(s["Y"], [["==", 45.0]], false), [], false) }
  outs << proc { sv_sel_any("interact", s["X"], sv_bool("NOT", s["Y"], s["Z"]), [], false, {}) }
