end
sv_rule("AAres_S_1_NVT1", "Space between non-silicide AA resistors area and other implant region >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_S_1_NVT1")
  s.define("X") { sv_sel_any("interact", s["LVTN"], s["AARES"], [], true, {}) }
