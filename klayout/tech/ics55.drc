end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("V2_2a_R_2b_R", "Vn must be fully enclosed by Mn >= 0.04 Min M2 enclosure of V2 for two opposite sides >=0.07") do |outs|
    s = SvScope.new(self, $sv_G, "V2_2a_R_2b_R")
    s.define("X") { sv_rect_enc(s["V2"], s["M2"], [[[0.04, false], [0.07, true], [0.04, false], [0.07, true]], [[0.04, false], [0.04, false], [0.04, false], [0.04, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
    outs << proc { sv_sel_any("inside", s["X"], sv_nary("OR", s["NODRC"], s["SRINGBLK"], s["SRAMALL"]), [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("NOT", s["V2"], s["M2"]), s["NODRC"], [], true, {}) }
  end
