  outs << proc { sv_sel_any("inside", sv_check("enc", s["X1"], s["ULLD"], [["<", 0.18]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("ULLD_EX_3a", "ULLD extention outside of N+ AA along GATE poly length direction >= 0.15um. if the distance to the related poly is less than or qual to 0.20um.") do |outs|
  s = SvScope.new(self, $sv_G, "ULLD_EX_3a")
  s.define("LAY_POLY") { s["POLYi"] }
  s.define("AA") { sv_bool("OR", s["PACT"], s["NACT"]) }
  s.define("X1") { sv_esel("inside_edge", s["AA"], s["LAY_POLY"], [], false) }
  s.define("X2") { sv_esel("touch_edge", s["AA"], s["X1"], [], false) }
  s.define("X3") { sv_expand_edge(s["X1"], {:outside => 0.001, :extend => 0.2}) }
  s.define("X4") { sv_esel("coin", s["X2"], s["X3"], [], false) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X4"], s["ULLD"], [["<", 0.15]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("ULLD_EX_3b", "ULLD extention outside of N+ AA along GATE poly length direction >= 0.12um. if the distance to the related poly is larger than 0.20um.") do |outs|
  s = SvScope.new(self, $sv_G, "ULLD_EX_3b")
  s.define("LAY_POLY") { s["POLYi"] }
  s.define("AA") { sv_bool("OR", s["PACT"], s["NACT"]) }
  s.define("X1") { sv_esel("inside_edge", s["AA"], s["LAY_POLY"], [], false) }
  s.define("X2") { sv_esel("touch_edge", s["AA"], s["X1"], [], false) }
  s.define("X3") { sv_expand_edge(s["X1"], {:outside => 0.001, :extend => 0.2}) }
  s.define("X4") { sv_esel("coin", s["X2"], s["X3"], [], true) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X4"], s["ULLD"], [["<", 0.12]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("ULLD_A_1", "ULLD area >= 0.18um2") do |outs|
  s = SvScope.new(self, $sv_G, "ULLD_A_1")
  outs << proc { sv_sel_any("inside", sv_area(s["ULLD"], [["<", 0.18]], false), s["NODRC"], [], true, {}) }
end
sv_rule("ULLD_A_2", "ULLD area >= 0.18um2") do |outs|
  s = SvScope.new(self, $sv_G, "ULLD_A_2")
  outs << proc { sv_sel_any("inside", sv_area(sv_holes(s["ULLD"], {:inner => true}), [["<", 0.18]], false), s["NODRC"], [], true, {}) }
end
sv_rule("ULLD_R_1", "It is not alloweded ULLD overlap with (PSUB, DG OR TG)") do |outs|
  s = SvScope.new(self, $sv_G, "ULLD_R_1")
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["ULLD"], s["PSUB"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["ULLD"], s["DG"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["ULLD"], s["TG"]), s["NODRC"], [], true, {}) }
end
sv_rule("ULLD_R_2", "ULLD must interact NVT3 or PVT3") do |outs|
  s = SvScope.new(self, $sv_G, "ULLD_R_2")
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["ULLD"], s["HVTN"], [], true, {}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["ULLD"], s["HVTP"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("DG_W_1", "DG width >= 0.47 um") do |outs|
  s = SvScope.new(self, $sv_G, "DG_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["DG"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DG_S_1", "Space between two DGs >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "DG_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["DG"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DG_S_2", "Space between DG and MOS AA, overlap is not allowed  >= 0.25um") do |outs|
