end
sv_rule("V2_S_3", "Minimum Space between two neighbor V2s (different net and run length>0) >= 0.13um.") do |outs|
  s = SvScope.new(self, $sv_G, "V2_S_3")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["V2"], nil, [["<", 0.13]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :connected => false, :netbase_a => s["V2"]}), s["NODRC"], [], true, {}) }
end
sv_rule("V2_EN_2a_2b_2c", "Vn must be fully enclosed by Mn >= 0 Min M2 enclosure of V2 for two opposite sides >=0.04 Vn must be fully enclosed by Mn/Mn+1 all sides >=0.03") do |outs|
  s = SvScope.new(self, $sv_G, "V2_EN_2a_2b_2c")
  s.define("X") { sv_rect_enc(s["V2"], s["M2"], [[[0.0, false], [0.04, true], [0.0, false], [0.04, true]], [[0.03, false], [0.03, false], [0.03, false], [0.03, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
  outs << proc { sv_sel_any("inside", s["X"], sv_nary("OR", s["NODRC"], s["SRAMALL"], s["SRINGBLK"]), [], true, {}) }
