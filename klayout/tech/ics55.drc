  outs << proc { sv_sel_any("inside", sv_check("int", s["CHECK_MAL"], nil, [["<", 0.35]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("M5_S_1", "Space between two Mns,") do |outs|
  s = SvScope.new(self, $sv_G, "M5_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["M5"], nil, [["<", 0.1]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("M5_S_1_R", "Recommended Space between two Mns,") do |outs|
    s = SvScope.new(self, $sv_G, "M5_S_1_R")
    outs << proc { sv_sel_any("inside", sv_check("ext", s["M5"], nil, [["<", 0.13]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("M5_S_2", "Space between two Mns when one or both Mn width >=0.42um, and the parallel run length of two Mns is >= 0.42um.>=0.15um") do |outs|
  s = SvScope.new(self, $sv_G, "M5_S_2")
  s.define("span_edge_0") { sv_dfm_copy(sv_dfm_space([s["M5ALL"]], [["<", 0.42]], {:by => "int"}), "edge") }
  s.define("span_edge_1") { sv_esel("coin", s["M5ALL"], s["span_edge_0"], [], true) }
  s.define("span_edge") { sv_check("ext", s["span_edge_1"], s["M5ALL"], [["<", 0.15]], {:abut => [["<", 90.0]], :metric => "opposite", :out => 1.0}) }
  outs << proc { sv_esel("inside_edge", sv_length(s["span_edge"], [[">=", 0.42]], false), s["NODRC"], [], true) }
end
sv_rule("M5_S_3", "Space between two Mns when one or both Mn width >=1.5um, and the parallel run length of two Mns is >= 1.5um.>=0.5um") do |outs|
  s = SvScope.new(self, $sv_G, "M5_S_3")
  s.define("span_edge_0") { sv_dfm_copy(sv_dfm_space([s["M5ALL"]], [["<", 1.5]], {:by => "int"}), "edge") }
  s.define("span_edge_1") { sv_esel("coin", s["M5ALL"], s["span_edge_0"], [], true) }
  s.define("span_edge") { sv_check("ext", s["span_edge_1"], s["M5ALL"], [["<", 0.5]], {:abut => [["<", 90.0]], :metric => "opposite", :out => 1.0}) }
  outs << proc { sv_esel("inside_edge", sv_length(s["span_edge"], [[">=", 1.5]], false), s["NODRC"], [], true) }
end
sv_rule("M5_S_4", "Space between metal lines with one or both is 45 degree (the area with 0.1um distance from bending point need not follow this rule) >= 0.19um") do |outs|
  s = SvScope.new(self, $sv_G, "M5_S_4")
  s.define("X") { sv_angle(s["M5"], [["==", 45.0]], false) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], nil, [["<", 0.19]], {:region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["M5"], s["X"], [["<", 0.19]], {:region => true, :corner_to_edge => true}), s["NODRC"], [], true, {}) }
end
sv_rule("M5_S_5", "Minimum Space at metalX line-end(W<0.12um) in a dense-line-end configuration:if metalx has parallel run length with opposite metalx along 2 adjacent edge metalx (any one edge < 0.12um distance from the conner of the two edge), the one of the space(sp1 or sp2) need to be at least 0.12 (except for small jog with edge length < 0.10um)") do |outs|
  s = SvScope.new(self, $sv_G, "M5_S_5")
  s.define("LINE_END") { sv_convex_edge(s["M5"], {:angle1 => [["==", 90.0]], :angle2 => [["==", 90.0]], :length => [["<", 0.12]]}) }
  s.define("LINE_END_SP") { sv_check("ext", s["LINE_END"], s["M5"], [["<", 0.12]], {:abut => [["<", 90.0]], :metric => "opposite", :out => 1.0}) }
  s.define("LINE_SIDE") { sv_esel("touch_inside_edge", s["LINE_END"], s["LINE_END_SP"], [], false) }
  s.define("LINE_END_Mn") { sv_check("int", s["LINE_SIDE"], s["M5"], [["<", 0.12]], {:abut => [["==", 90.0]], :intersecting => "only", :out => 2.0}) }
  s.define("LINE_END_Mn_010") { sv_length(s["LINE_END_Mn"], [[">=", 0.1]], false) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["LINE_END_Mn_010"], s["M5"], [["<", 0.12]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["MOMTER"]), s["NODRC"], [], true, {}) }
end
sv_rule("M5_A_1", "Mn area >= 0.052um2") do |outs|
  s = SvScope.new(self, $sv_G, "M5_A_1")
  outs << proc { sv_sel_any("inside", sv_area(s["M5"], [["<", 0.052]], false), s["NODRC"], [], true, {}) }
end
sv_rule("M5_A_2", "Enclosed dielectric area by Mn >= 0.18um2") do |outs|
  s = SvScope.new(self, $sv_G, "M5_A_2")
  s.define("X") { sv_bool("NOT", sv_holes(s["M5"], {:inner => true}), s["M5"]) }
  outs << proc { sv_sel_any("inside", sv_area(s["X"], [["<", 0.18]], false), s["NODRC"], [], true, {}) }
end
if sv_ifdef("Density_rules", "YES")
  sv_rule("M5_D_1_min", "Mn density (including dummy) in 100umX100um window with step size 50um. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking >= 10%") do |outs|
    s = SvScope.new(self, $sv_G, "M5_D_1_min")
    s.define("check_region_1") { sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", sv_bool("NOT", s["DRC:1"], s["GRID"]), s["SRINGBLK"]), s["INDALL"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_density([s["M5ALLi"]], [["<", 0.1]], {:window => 100.0, :step => 50.0, :backup => true, :inside_of_layer => s["check_region_1"]}) }
  end
  sv_rule("M5_D_1_max", "Mn density (including dummy) in 100umX100um window with step size 50um. INDALL/FUTR/GRID/SRINGBLK covered areas are excluded for this rule checking <= 80%") do |outs|
    s = SvScope.new(self, $sv_G, "M5_D_1_max")
    s.define("check_region_1") { sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", sv_bool("NOT", s["DRC:1"], s["GRID"]), s["SRINGBLK"]), s["INDALL"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_density([s["M5ALLi"]], [[">", 0.8]], {:window => 100.0, :step => 50.0, :backup => true, :inside_of_layer => s["check_region_1"]}) }
  end
  sv_rule("M5_D_2", "Average density for Mn inside the dummy block area size 2.5um in 100umX100um window with step size 50um >= 10%") do |outs|
    s = SvScope.new(self, $sv_G, "M5_D_2")
    s.define("X") { sv_density([s["M5ALLi"]], [["<", 0.1]], {:window => 100.0, :step => 50.0, :backup => true}) }
    s.define("Y") { sv_size(s["M5DUMB"], 2.5, {}) }
    s.define("Z") { sv_size(s["Y"], 12.5, {:mode => "underover"}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["X"], s["Z"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("M5_D_3", "The difference between Mn density in 100umX100um those of the adjacent checking windows (including dummy) INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking <= 20%") do |outs|
    s = SvScope.new(self, $sv_G, "M5_D_3")
    s.define("X") { sv_density([s["M5ALLi"]], [[">=", 0.0]], {:window => 100.0, :gradient => [[">", 0.2]], :absolute => true, :backup => true, :inside_of_layer => s["density_checkarea"]}) }
    outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", sv_bool("NOT", s["X"], s["GRID"]), s["SRINGBLK"]), s["INDALL"]), s["NODRC"], [], true, {}) }
  end
end
sv_rule("V1_W_1", "Fixed V1 size (square shape) is 0.09,exclude GRING OR SRINGBLK area") do |outs|
  s = SvScope.new(self, $sv_G, "V1_W_1")
  outs << proc { sv_sel_any("inside", sv_rectangle(s["V1"], {:neg => true, :w => [["==", 0.09]], :l => [["==", 0.09]]}), sv_nary("OR", s["GRID"], s["SRINGBLK"], s["NODRC"]), [], true, {}) }
end
sv_rule("V1_W_2", "Fixed V1 width(datatype 13) is 0.09,exclude EFUSEALL OR SRAMALL OR FUSEALL area") do |outs|
  s = SvScope.new(self, $sv_G, "V1_W_2")
  outs << proc { sv_sel_any("inside", sv_with_width(s["V1bar"], [["<", 0.09]], false), sv_nary("OR", s["SRAMALL"], s["EFUSEALL"], s["FUSEALL"]), [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_with_width(s["V1bar"], [[">", 0.09]], false), sv_nary("OR", s["SRAMALL"], s["EFUSEALL"], s["FUSEALL"]), [], false, {}) }
end
sv_rule("V1_S_1", "Space between two V1 is 0.11") do |outs|
  s = SvScope.new(self, $sv_G, "V1_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["V1"], nil, [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("V1_S_2", "Space between V1s between V and 3-neighboring Vs whose space is < 0.14um. >= 0.13.") do |outs|
  s = SvScope.new(self, $sv_G, "V1_S_2")
  s.define("X") { sv_size(s["V1"], 0.07, {:mode => "overunder"}) }
  s.define("Y") { sv_size(s["X"], 0.24, {:mode => "underover"}) }
  s.define("Z") { sv_sel_any("inside", s["V1"], s["Y"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["Z"], nil, [["<", 0.13]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("V1_S_3", "Minimum Space between two neighbor V1s (different net and run length>0) >= 0.13um.") do |outs|
  s = SvScope.new(self, $sv_G, "V1_S_3")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["V1"], nil, [["<", 0.13]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :connected => false, :netbase_a => s["V1"]}), s["NODRC"], [], true, {}) }
end
sv_rule("V1_EN_2a_2b_2c", "Vn must be fully enclosed by Mn >= 0 Min M1 enclosure of V1 for two opposite sides >=0.04 Vn must be fully enclosed by Mn/Mn+1 all sides >=0.03") do |outs|
  s = SvScope.new(self, $sv_G, "V1_EN_2a_2b_2c")
  s.define("X") { sv_rect_enc(s["V1"], s["M1"], [[[0.0, false], [0.04, true], [0.0, false], [0.04, true]], [[0.03, false], [0.03, false], [0.03, false], [0.03, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
  outs << proc { sv_sel_any("inside", s["X"], sv_nary("OR", s["NODRC"], s["SRAMALL"], s["SRINGBLK"]), [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", s["V1"], s["M1"]), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("V1_2a_R_2b_R", "Vn must be fully enclosed by Mn >= 0.04 Min M1 enclosure of V1 for two opposite sides >=0.07") do |outs|
    s = SvScope.new(self, $sv_G, "V1_2a_R_2b_R")
    s.define("X") { sv_rect_enc(s["V1"], s["M1"], [[[0.04, false], [0.07, true], [0.04, false], [0.07, true]], [[0.04, false], [0.04, false], [0.04, false], [0.04, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
    outs << proc { sv_sel_any("inside", s["X"], sv_nary("OR", s["NODRC"], s["SRINGBLK"], s["SRAMALL"]), [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("NOT", s["V1"], s["M1"]), s["NODRC"], [], true, {}) }
  end
end
sv_rule("V1_EN_5a_5b", "Vn must be fully enclosed by Mn+1 Min M2 enclsoure of V1 is 0.005 Min M2 enclosure of V1 is 0.02 when M2 enclosure on one or both perpendicular directions<0.02um") do |outs|
  s = SvScope.new(self, $sv_G, "V1_EN_5a_5b")
  s.define("X") { sv_rect_enc(s["V1"], s["M2"], [[[0.005, true], [0.02, true], [0.005, true], [0.02, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X"], s["M2"], [["<", 0.005]], {:abut => [["<", 90.0]], :singular => true, :region => true, :overlap => true, :outside_also => true}), s["NODRC"], [], true, {}) }
  s.define("Y") { sv_check("enc", s["X"], s["M2"], [["<", 0.02]], {:metric => "opposite", :out => 1.0}) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["Y"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :intersecting => "only", :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", s["V1"], s["M2"]), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("V1_R_2a_2b", "There should be at least 2(Via with space <= 0.2um) or 4(Via with space <= 0.25um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.3um There should be at least 4(Via with space <= 0.2um) or 9(Via with space <= 0.55um) at the intersection of Mn and Mn+1, when either Mn or Mn+1 width > 0.7um") do |outs|
    s = SvScope.new(self, $sv_G, "V1_R_2a_2b")
    s.define("w03b") { sv_with_width(s["M1"], [[">", 0.3]], false) }
    s.define("w03u") { sv_with_width(s["M2"], [[">", 0.3]], false) }
    s.define("w03") { sv_bool("AND", s["M1"], s["M2"]) }
    s.define("wide03") { sv_bool("NOT", sv_bool("OR", sv_sel_any("enclose", s["w03"], sv_sel_any("outside", s["V1"], s["w03b"], [], true, {}), [], false, {}), sv_sel_any("enclose", s["w03"], sv_sel_any("outside", s["V1"], s["w03u"], [], true, {}), [], false, {})), s["wide07"]) }
    s.define("wide03v2s") { sv_size(sv_sel_any("interact", s["V1"], s["wide03"], [], false, {}), 0.1, {:inside_of => s["wide03"], :step => 0.05}) }
    s.define("wide03v4s") { sv_size(sv_sel_any("interact", s["V1"], s["wide03"], [], false, {}), 0.125, {:inside_of => s["wide03"], :step => 0.05}) }
    s.define("wide03v2") { sv_sel_any("interact", s["wide03v2s"], s["V1"], [[">=", 2.0]], false, {}) }
    s.define("wide03v4") { sv_sel_any("interact", s["wide03v4s"], s["V1"], [[">=", 4.0]], false, {}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["wide03"], sv_bool("OR", s["wide03v2"], s["wide03v4"]), [], true, {}), s["NODRC"], [], true, {}) }
    s.define("w07b") { sv_with_width(s["M1"], [[">", 0.7]], false) }
    s.define("w07u") { sv_with_width(s["M2"], [[">", 0.7]], false) }
    s.define("w07") { sv_bool("AND", s["M1"], s["M2"]) }
    s.define("wide07") { sv_bool("OR", sv_sel_any("enclose", s["w07"], sv_sel_any("outside", s["V1"], s["w07b"], [], true, {}), [], false, {}), sv_sel_any("enclose", s["w07"], sv_sel_any("outside", s["V1"], s["w07u"], [], true, {}), [], false, {})) }
    s.define("wide07v4s") { sv_size(sv_sel_any("interact", s["V1"], s["wide07"], [], false, {}), 0.1, {:inside_of => s["wide07"], :step => 0.05}) }
    s.define("wide07v9s") { sv_size(sv_sel_any("interact", s["V1"], s["wide07"], [], false, {}), 0.275, {:inside_of => s["wide07"], :step => 0.05}) }
    s.define("wide07v4") { sv_sel_any("interact", s["wide07v4s"], s["V1"], [[">=", 4.0]], false, {}) }
    s.define("wide07v9") { sv_sel_any("interact", s["wide07v9s"], s["V1"], [[">=", 9.0]], false, {}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["wide07"], sv_bool("OR", s["wide07v4"], s["wide07v9"]), [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("V1_R_5", "45-dgree rotated via is not allowed") do |outs|
