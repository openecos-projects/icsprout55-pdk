  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("ext", s["SAB"], s["PO_CHECK"], [["<", 0.3]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["ESDIOE"], [], true, {}), s["NODRC"], [], true, {}) }
end
