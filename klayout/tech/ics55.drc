  outs << proc { sv_check("ext", s["SPACE_074_V1S_SL"], s["V1S_SQ"], [["<", 0.6]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :angled => [["<", 1.0]]}) }
  s.define("SPACE_074_V2S_SL") { sv_sel_any("interact", s["V2S_SL"], sv_check("ext", s["V2S_SL"], s["V2S_SQ"], [["<", 0.74]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :angled => [["<", 1.0]]}), [], false, {}) }
  outs << proc { sv_check("ext", s["SPACE_074_V2S_SL"], s["V2S_SQ"], [["<", 0.6]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :angled => [["<", 1.0]]}) }
  s.define("SPACE_074_V3S_SL") { sv_sel_any("interact", s["V3S_SL"], sv_check("ext", s["V3S_SL"], s["V3S_SQ"], [["<", 0.74]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :angled => [["<", 1.0]]}), [], false, {}) }
  outs << proc { sv_check("ext", s["SPACE_074_V3S_SL"], s["V3S_SQ"], [["<", 0.6]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :angled => [["<", 1.0]]}) }
  s.define("SPACE_074_V4S_SL") { sv_sel_any("interact", s["V4S_SL"], sv_check("ext", s["V4S_SL"], s["V4S_SQ"], [["<", 0.74]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :angled => [["<", 1.0]]}), [], false, {}) }
  outs << proc { sv_check("ext", s["SPACE_074_V4S_SL"], s["V4S_SQ"], [["<", 0.6]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true, :angled => [["<", 1.0]]}) }
end
