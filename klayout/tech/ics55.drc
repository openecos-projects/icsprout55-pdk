  s.define("X1") { sv_esel("with_edge", s["X0"], sv_length(s["X0"], [[">", 5.0]], false), [], true) }
  s.define("Y") { sv_esel("coin", s["M4"], s["X1"], [], false) }
  s.define("Y1") { sv_bool("NOT", sv_check("ext", s["Y"], nil, [["<=", 3.0]], {:metric => "opposite", :region => true}), s["M4"]) }
  s.define("Z0") { sv_sel_any("interact", s["M4"], s["Y1"], [["==", 2.0]], false, {}) }
  s.define("Z1") { sv_length(sv_esel("coin", s["M4"], s["Z0"], [], false), [["<=", 1.0]], false) }
  s.define("Z") { sv_esel("with_edge", s["Z0"], s["Z1"], [], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["Z"], s["V3N"], [["==", 1.0]], false, {}), s["NODRC"], [], true, {}) }
end
$sv_G.define("V4N_M") { sv_sel_any("interact", $sv_G["V4N"], $sv_G["st_4"], [], false, {}) }
$sv_G.define("st_4") { sv_sel_any("enclose", sv_bool("AND", $sv_G["M4"], $sv_G["M5"]), $sv_G["V4"], [["==", 1.0]], false, {}) }
$sv_G.define("V4N") { sv_bool("AND", $sv_G["V4"], sv_rectangle($sv_G["V4"], {:neg => false, :w => [["==", 0.09]], :l => [["==", 0.09]]})) }
$sv_G.define("RV4") { sv_bool("AND", $sv_G["V4"], sv_rectangle($sv_G["V4"], {:neg => false, :aspect => [["!=", 1.0]]})) }
sv_rule("V4_R_3", "Single Vn is not allowed in H-shape Mn+1 when: 1) The Mn+1 has H-shape metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2. 2) The Vn overlaps on the center metal bar of this H-shape Mn+1 3) The center metal bar has the length (L) <= 1um and the width <= 3um") do |outs|
  s = SvScope.new(self, $sv_G, "V4_R_3")
  s.define("X0") { sv_area(sv_rectangle(sv_holes(s["M5"], {:inner => true}), {:neg => false}), [["<=", 5.0]], false) }
  s.define("X1") { sv_esel("with_edge", s["X0"], sv_length(s["X0"], [[">", 5.0]], false), [], true) }
  s.define("Y") { sv_esel("coin", s["M5"], s["X1"], [], false) }
  s.define("Y1") { sv_bool("NOT", sv_check("ext", s["Y"], nil, [["<=", 3.0]], {:metric => "opposite", :region => true}), s["M5"]) }
  s.define("Z0") { sv_sel_any("interact", s["M5"], s["Y1"], [["==", 2.0]], false, {}) }
  s.define("Z1") { sv_length(sv_esel("coin", s["M5"], s["Z0"], [], false), [["<=", 1.0]], false) }
  s.define("Z") { sv_esel("with_edge", s["Z0"], s["Z1"], [], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["Z"], s["V4N"], [["==", 1.0]], false, {}), s["NODRC"], [], true, {}) }
end
sv_rule("T4V2_W_1", "Fixed T4V2 size (square shape),exclude SRINGBLK and GRBLK region. = 0.36,") do |outs|
  s = SvScope.new(self, $sv_G, "T4V2_W_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_rectangle(sv_bool("NOT", s["T4V2"], s["GT4V2"]), {:neg => true, :w => [["==", 0.36]], :l => [["==", 0.36]]}), s["GRID"]), sv_bool("OR", s["SRINGBLK"], s["NODRC"]), [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_rectangle(sv_rectangle(sv_bool("AND", s["T4V2"], s["GRID"]), {:neg => false}), {:neg => true, :w => [["==", 0.36]], :l => [["==", 0.36]]}), sv_bool("OR", s["SRINGBLK"], s["NODRC"]), [], true, {}) }
end
sv_rule("T4V2_W_2", "Fixed T4V2bar width = 0.36,") do |outs|
  s = SvScope.new(self, $sv_G, "T4V2_W_2")
  outs << proc { sv_with_width(s["T4V2bar"], [["<", 0.36]], false) }
  outs << proc { sv_with_width(s["T4V2bar"], [[">", 0.36]], false) }
end
sv_rule("T4V2_S_1", "Space between two T4V2s >= 0.34") do |outs|
  s = SvScope.new(self, $sv_G, "T4V2_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["T4V2"], nil, [["<", 0.34]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("T4V2_S_2", "Space between T4V2s within array greater or equal to 3x3 (Two via regions whose space is <=0.56um are considered to be in the same array) is >= 0.5 NOTICE: It is a recommended rule.") do |outs|
  s = SvScope.new(self, $sv_G, "T4V2_S_2")
  s.define("X") { sv_size(s["T4V2"], 0.28, {:mode => "overunder"}) }
  s.define("Y") { sv_size(s["X"], 0.855, {:mode => "underover"}) }
  s.define("Z") { sv_sel_any("inside", s["T4V2"], s["Y"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["Z"], nil, [["<", 0.5]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("T4V2_EN_2_EN_3", "Min M5 fully enclosure of T4V2 >= 0.01 Min M5 enclosure of T4V2 when T4M1 enclosure on one or both perpendicular directions < 0.05um. >= 0.05") do |outs|
  s = SvScope.new(self, $sv_G, "T4V2_EN_2_EN_3")
  s.define("X") { sv_rect_enc(s["T4V2"], s["M5"], [[[0.01, true], [0.05, true], [0.01, true], [0.05, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X"], s["M5"], [["<", 0.01]], {:abut => [["<", 90.0]], :singular => true, :region => true, :overlap => true, :outside_also => true}), s["NODRC"], [], true, {}) }
  s.define("Y") { sv_check("enc", s["X"], s["M5"], [["<", 0.05]], {:metric => "opposite", :out => 1.0}) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["Y"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :intersecting => "only", :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", s["T4V2"], s["M5"]), s["NODRC"], [], true, {}) }
end
sv_rule("T4V2_EN_5_EN_6", "Min T4V2 fully enclosure by T4M2 >= 0.02") do |outs|
  s = SvScope.new(self, $sv_G, "T4V2_EN_5_EN_6")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["T4V2"], s["T4M2"], [["<", 0.02]], {:abut => [["<", 90.0]], :singular => true, :region => true, :outside_also => true}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("T4V2_R_1_R", "There should be at least two square T4V2s at the intersection of Mn/T4M1/T2M1 and T4M2 when either metal width >= 0.5um,exclude SRINGBLK and GRBLK region.") do |outs|
    s = SvScope.new(self, $sv_G, "T4V2_R_1_R")
    s.define("T4V2_SQ") { sv_rectangle(s["T4V2"], {:neg => false, :aspect => [["==", 1.0]]}) }
    s.define("X1_M5") { sv_sel_any("enclose", s["M5"], sv_with_width(s["M5"], [[">=", 0.5]], false), [], false, {}) }
    s.define("X1_T4M2") { sv_sel_any("enclose", s["T4M2"], sv_with_width(s["T4M2"], [[">=", 0.5]], false), [], false, {}) }
    s.define("M5T4M2") { sv_bool("AND", s["M5"], s["T4M2"]) }
    s.define("X1") { sv_bool("OR", s["X1_M5"], s["X1_T4M2"]) }
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", sv_sel_any("interact", s["M5T4M2"], s["T4V2_SQ"], [["==", 1.0]], false, {}), s["X1"], [], false, {}), sv_nary("OR", s["SRINGBLK"], s["GRBLK"], s["NODRC"]), [], true, {}) }
  end
end
sv_rule("T4V2_R_3", "45-dgree T4V2 is not allowed") do |outs|
  s = SvScope.new(self, $sv_G, "T4V2_R_3")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_esel("with_edge", s["T4V2"], sv_angle(s["T4V2"], [["==", 45.0]], false), [], false), s["SRINGBLK"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("T4V2_R_4_R", "Recommended us redundant T4V2s as possible, DRC can help to flag single T4V2") do |outs|
    s = SvScope.new(self, $sv_G, "T4V2_R_4_R")
    outs << proc { sv_sel_any("interact", sv_bool("AND", s["M5"], s["T4M2"]), s["T4V2"], [["==", 1.0]], false, {}) }
  end
end
sv_rule("T4M2_W_1", "T4M2 width ,DRC waive check 89 to 90 degree widths in the INDALL and DEUPAD region >= 0.40 T4M2 width <= 20") do |outs|
  s = SvScope.new(self, $sv_G, "T4M2_W_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("int", s["T4M2"], nil, [["<", 0.4]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("int", s["T4M2"], nil, [["<", 0.4]], {:abut => [["<", 89.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  s.define("X") { sv_with_width(sv_bool("NOT", s["T4M2"], s["DEUPAD"]), [[">", 20.0]], false) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_sel_any("interact", s["X"], s["PA"], [], true, {}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("T4M2_S_1", "Space between T4M2s DRC waive check 89 to 90 degree spaces in the INDALL region. >= 0.40,") do |outs|
  s = SvScope.new(self, $sv_G, "T4M2_S_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["T4M2"], nil, [["<", 0.4]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("ext", s["T4M2"], nil, [["<", 0.4]], {:abut => [["<", 89.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("T4M2_S_2", "Space between two T4M2s when one or both T4M2 width or length >= 2um, and the run length of two T4M2s is >= 2um. >= 0.5") do |outs|
  s = SvScope.new(self, $sv_G, "T4M2_S_2")
  s.define("span_edge_0") { sv_dfm_copy(sv_dfm_space([s["T4M2ALL"]], [["<", 2.0]], {:by => "int"}), "edge") }
  s.define("span_edge_1") { sv_esel("coin", s["T4M2ALL"], s["span_edge_0"], [], true) }
  s.define("span_edge") { sv_check("ext", s["span_edge_1"], s["T4M2ALL"], [["<", 0.5]], {:abut => [["<", 90.0]], :metric => "opposite", :out => 1.0}) }
  outs << proc { sv_esel("inside_edge", sv_length(s["span_edge"], [[">=", 2.0]], false), s["NODRC"], [], true) }
end
sv_rule("T4M2_A_1", "T4M2 area >= 0.40") do |outs|
  s = SvScope.new(self, $sv_G, "T4M2_A_1")
  outs << proc { sv_sel_any("inside", sv_area(s["T4M2"], [["<", 0.4]], false), s["NODRC"], [], true, {}) }
end
sv_rule("T4M2_A_2", "Enclosed area by T4M2 >= 0.6") do |outs|
  s = SvScope.new(self, $sv_G, "T4M2_A_2")
  s.define("X") { sv_bool("NOT", sv_holes(s["T4M2"], {:inner => true}), s["T4M2"]) }
  outs << proc { sv_sel_any("inside", sv_area(s["X"], [["<", 0.6]], false), s["NODRC"], [], true, {}) }
end
if sv_ifdef("Density_rules", "YES")
  sv_rule("T4M2_D_1_min", "T4M2 density (including dummy) in 100umX100um window with step size 50um is >= 20% and <= 85%. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking.") do |outs|
    s = SvScope.new(self, $sv_G, "T4M2_D_1_min")
    s.define("X") { sv_density([s["T4M2ALLi"]], [["<", 0.2]], {:window => 100.0, :step => 50.0, :backup => true, :inside_of_layer => s["density_checkarea"]}) }
    s.define("Y") { sv_nary("OR", s["GRID"], s["SRINGBLK"], s["INDALL"]) }
    outs << proc { sv_sel_any("inside", sv_bool("NOT", s["X"], s["Y"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("T4M2_D_1_max", "T4M2 density (including dummy) in 100umX100um window with step size 50um is >= 20% and <= 85%. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking.") do |outs|
    s = SvScope.new(self, $sv_G, "T4M2_D_1_max")
    s.define("X") { sv_density([s["T4M2ALLi"]], [[">", 0.85]], {:window => 100.0, :step => 50.0, :backup => true, :inside_of_layer => s["density_checkarea"]}) }
    s.define("Y") { sv_nary("OR", s["GRID"], s["SRINGBLK"], s["INDALL"]) }
    outs << proc { sv_sel_any("inside", sv_bool("NOT", s["X"], s["Y"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("T4M2_D_2", "T4M2 density inside (T4M2dumb sizing up 2.5um) in 100umX100um window with step size 50um >= 10%") do |outs|
    s = SvScope.new(self, $sv_G, "T4M2_D_2")
    s.define("CHECK_AREA") { sv_size(s["T4M2DUMB"], 2.5, {}) }
    s.define("X") { sv_density([s["T4M2ALLi"]], [["<", 0.1]], {:window => 100.0, :step => 50.0, :backup => true, :inside_of_layer => s["CHECK_AREA"]}) }
    outs << proc { sv_sel_any("inside", s["X"], s["NODRC"], [], true, {}) }
  end
  sv_rule("T4M2_D_3", "T4M2 density difference in 100umX100um window <= 20%. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking.") do |outs|
    s = SvScope.new(self, $sv_G, "T4M2_D_3")
    s.define("X") { sv_density([s["T4M2ALLi"]], [[">", 0.0]], {:window => 100.0, :gradient => [[">", 0.2]], :absolute => true, :backup => true, :inside_of_layer => s["density_checkarea"]}) }
    s.define("Y") { sv_nary("OR", s["GRID"], s["SRINGBLK"], s["INDALL"]) }
    outs << proc { sv_sel_any("inside", sv_bool("NOT", s["X"], s["Y"]), s["NODRC"], [], true, {}) }
  end
end
sv_rule("CB_W_1", "CB width >= 3.0um") do |outs|
  s = SvScope.new(self, $sv_G, "CB_W_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("int", s["PA"], nil, [["<", 2.999]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("int", s["PA"], nil, [["<", 2.999]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("CB_S_1", "Space between two CBs >= 5.0um") do |outs|
  s = SvScope.new(self, $sv_G, "CB_S_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["PA"], nil, [["<", 5.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("ext", s["PA"], nil, [["<", 4.998]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("CB_EN_1_EN_2", "CB edge fully enclosure by T4M1 or T2M1 or T8M1, T4M2 or T2M2 or T8M2 directly underneath PA >= 1.5um") do |outs|
  s = SvScope.new(self, $sv_G, "CB_EN_1_EN_2")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("enc", s["PA"], sv_nary("OR", s["T2M1"], s["T4M1"], s["T8M1"], s["T4M2"], s["T2M2"], s["T8M2"]), [["<", 1.5]], {:abut => [["<", 90.0]], :singular => true, :region => true, :outside_also => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("enc", s["PA"], sv_nary("OR", s["T2M1"], s["T4M1"], s["T8M1"], s["T4M2"], s["T2M2"], s["T8M2"]), [["<", 1.498]], {:abut => [["<", 90.0]], :singular => true, :region => true, :outside_also => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
$sv_G.define("RDV_Fuse") { sv_bool("OR", $sv_G["RDLVF"], $sv_G["GRDLV"]) }
sv_rule("RV_W_1", "Fixed RDL Via width and length = 3.0um") do |outs|
  s = SvScope.new(self, $sv_G, "RV_W_1")
  outs << proc { sv_rectangle(sv_bool("NOT", sv_bool("NOT", s["RDLV"], s["RDV_Fuse"]), s["GRID"]), {:neg => true, :w => [["==", 3.0]], :l => [["==", 3.0]]}) }
end
sv_rule("RV_S_1", "Space between two RDL vias >= 3.0um") do |outs|
  s = SvScope.new(self, $sv_G, "RV_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", sv_bool("NOT", s["RDLV"], s["RDV_Fuse"]), nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("RV_S_2", "Space between RDL via and CB >= 6.0um") do |outs|
  s = SvScope.new(self, $sv_G, "RV_S_2")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["RDLV"], s["PA"], [["<", 6.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("RV_EN_1_2", "RDL via enclosure by T4M2 or other metal layer directly underneath RV >= 1.5um") do |outs|
  s = SvScope.new(self, $sv_G, "RV_EN_1_2")
  s.define("X11") { sv_check("enc", sv_bool("NOT", s["RDLV"], s["RDV_Fuse"]), sv_nary("OR", s["T4M2"], s["T2M2"], s["T8M2"]), [["<", 1.5]], {:abut => [["<", 90.0]], :singular => true, :region => true, :overlap => true, :outside_also => true}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", s["X11"], s["LOGO"]), s["GRID"]), s["NODRC"], [], true, {}) }
end
sv_rule("RV_EN_3_4", "RDL via enclosure by RDL >= 1.5um") do |outs|
  s = SvScope.new(self, $sv_G, "RV_EN_3_4")
  s.define("X11") { sv_check("enc", sv_bool("NOT", s["RDLV"], s["RDV_Fuse"]), s["RDL"], [["<", 1.5]], {:abut => [["<", 90.0]], :singular => true, :region => true, :overlap => true, :outside_also => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("NOT", s["X11"], s["LOGO"]), sv_nary("OR", s["SRINGBLK"], s["FUTR"], s["GRID"]), [], true, {}), s["NODRC"], [], true, {}) }
  outs << proc { sv_bool("NOT", s["RDLV"], s["RDL"]) }
end
sv_rule("RV_R_1", "Recommended us redundant RVs as possible, DRC can help to flag single RV") do |outs|
  s = SvScope.new(self, $sv_G, "RV_R_1")
  outs << proc { sv_sel_any("interact", sv_bool("NOT", sv_bool("AND", sv_nary("OR", s["T4M2"], s["T2M2"], s["T8M2"]), s["RDL"]), s["SRINGBLK"]), s["RDLV"], [["==", 1.0]], false, {}) }
end
sv_rule("RDL_W_1", "RDL Width >= 3.0um RDL width <= 35um") do |outs|
  s = SvScope.new(self, $sv_G, "RDL_W_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("int", s["RDL"], nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("int", s["RDL"], nil, [["<", 2.998]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_with_width(s["RDL"], [[">", 35.0]], false), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("RDL_S_1", "Space between two (RDL OR ALPAD) >= 2.0um") do |outs|
  s = SvScope.new(self, $sv_G, "RDL_S_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["ALPA"], nil, [["<", 2.0]], {:abut => [["<", 89.9]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("ext", s["ALPA"], nil, [["<", 1.998]], {:abut => [["<", 89.9]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("RDL_S_2", "Space between (RDL OR ALPAD) with one or both (RDL OR ALPAD) width larger than 10um >= 3.0um") do |outs|
  s = SvScope.new(self, $sv_G, "RDL_S_2")
  s.define("X1") { sv_esel("coin", sv_with_width(s["ALPA"], [[">", 10.0]], false), s["ALPA"], [], false) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["X1"], s["ALPA"], [["<", 3.0]], {:region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  s.define("X2") { sv_esel("coin", sv_with_width(s["ALPA"], [[">", 10.0]], false), s["ALPA"], [], false) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("ext", s["X2"], s["ALPA"], [["<", 2.998]], {:region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("RDL_S_3", "Space between (RDL OR ALPAD) with one or both (RDL OR ALPAD) width larger than 35um >= 5.0um") do |outs|
  s = SvScope.new(self, $sv_G, "RDL_S_3")
  s.define("X1") { sv_esel("coin", sv_with_width(s["ALPA"], [[">", 35.0]], false), s["ALPA"], [], false) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["X1"], s["ALPA"], [["<", 5.0]], {:region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  s.define("X2") { sv_esel("coin", sv_with_width(s["ALPA"], [[">", 35.0]], false), s["ALPA"], [], false) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("ext", s["X2"], s["ALPA"], [["<", 4.998]], {:region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("RDL_EN_1", "ALPAD must fully enclosure of Cover") do |outs|
  s = SvScope.new(self, $sv_G, "RDL_EN_1")
  outs << proc { sv_bool("NOT", s["RDLPA2"], s["ALPA"]) }
end
sv_rule("RDL_EN_2", "ALPAD must fully enclosure of CB") do |outs|
  s = SvScope.new(self, $sv_G, "RDL_EN_2")
  outs << proc { sv_bool("NOT", s["CBi"], s["ALPAD"]) }
end
$sv_G.define("M1SL") { sv_sel_any("interact", sv_holes($sv_G["MET1o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("M2SL") { sv_sel_any("interact", sv_holes($sv_G["MET2o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("M3SL") { sv_sel_any("interact", sv_holes($sv_G["MET3o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
