sv_rule("M4DUM_S_7", "Space between two (MnDUM or Mn) having run length >=1.5um with one or both M1DUM width >=1.5um is 0.60um") do |outs|
  s = SvScope.new(self, $sv_G, "M4DUM_S_7")
  s.define("X0_a") { sv_with_width(s["M4ALL"], [[">=", 1.5]], false) }
  s.define("X0") { sv_enclose_rect(s["X0_a"], 1.5, 1.5, {:neg => false}) }
  s.define("X1") { sv_check("ext", s["M4ALL"], nil, [["<", 0.6]], {:metric => "opposite", :region => true, :parallel => "only"}) }
  s.define("X2") { sv_length(s["X1"], [[">=", 1.5]], false) }
  s.define("X3") { sv_esel("touch_edge", s["X2"], s["X0"], [], false) }
  s.define("X4_near") { sv_expand_edge(s["X3"], {:outside => 1.5}) }
  s.define("X4_far") { sv_bool("NOT", sv_expand_edge(s["X3"], {:outside => 1.51}), s["X4_near"]) }
  s.define("X5") { sv_bool("NOT", s["X4_near"], s["M4ALL"]) }
  s.define("X6_near") { sv_check("ext", s["X1"], s["X5"], [["<", 1.5]], {:metric => "opposite", :region => true}) }
  s.define("X6_far") { sv_check("ext", s["X4_far"], s["X5"], [["<", 1.5]], {:metric => "opposite", :region => true}) }
  s.define("X7") { sv_bool("NOT", sv_bool("NOT", s["X4_near"], s["X5"]), sv_bool("OR", s["X6_near"], s["X6_far"])) }
  s.define("X7_edge") { sv_length(sv_esel("coin", s["X7"], s["X1"], [], false), [[">=", 1.5]], false) }
  s.define("X7_expand") { sv_expand_edge(s["X7_edge"], {:outside => 0.6}) }
  s.define("X8") { sv_bool("NOT", sv_bool("AND", s["X7_expand"], s["X1"]), s["X5"]) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["X8"], s["M4DUM"], [], false, {}), s["NODRC"], [], true, {}) }
end
