    outs << proc { sv_sel_any("inside", sv_check("enc", sv_sel_any("interact", sv_bool("OR", s["AA"], s["PO"]), s["SAB"], [], false, {}), s["SAB_CHECK"], [["<", 0.3]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  end
end
