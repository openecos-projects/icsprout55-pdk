end
sv_rule("SAB_EX_1", "AA extension outside of SAB >= 0.21um") do |outs|
  s = SvScope.new(self, $sv_G, "SAB_EX_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["SAB"], s["AA"], [["<", 0.21]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
