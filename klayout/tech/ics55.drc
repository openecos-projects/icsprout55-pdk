sv_rule("NWresSTI_R_1", "NW Resistor must be fully covered by SAB except for CT area") do |outs|
  s = SvScope.new(self, $sv_G, "NWresSTI_R_1")
  s.define("X") { sv_sel_any("interact", sv_bool("AND", s["NW1res"], s["NW"]), s["SAB"], [], true, {}) }
