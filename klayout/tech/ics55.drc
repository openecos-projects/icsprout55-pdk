if sv_ifdef("Metal_Slot_CHECK", "YES")
  sv_rule("SL_W_1_L_1", "Width of metal lot >= 2um Length of metal lot >= 4.5um") do |outs|
    s = SvScope.new(self, $sv_G, "SL_W_1_L_1")
    outs << proc { sv_sel_any("inside", sv_rectangle(s["M1slot"], {:neg => true, :w => [[">=", 2.0]], :l => [[">=", 4.5]]}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_rectangle(s["M2slot"], {:neg => true, :w => [[">=", 2.0]], :l => [[">=", 4.5]]}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_rectangle(s["M3slot"], {:neg => true, :w => [[">=", 2.0]], :l => [[">=", 4.5]]}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_rectangle(s["M4slot"], {:neg => true, :w => [[">=", 2.0]], :l => [[">=", 4.5]]}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_rectangle(s["M5slot"], {:neg => true, :w => [[">=", 2.0]], :l => [[">=", 4.5]]}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_rectangle(s["T4M2slot"], {:neg => true, :w => [[">=", 2.0]], :l => [[">=", 4.5]]}), s["NODRC"], [], true, {}) }
  end
  sv_rule("SL_S_1", "Space of metal lot >= 3um") do |outs|
    s = SvScope.new(self, $sv_G, "SL_S_1")
    outs << proc { sv_sel_any("inside", sv_check("ext", s["M1slot"], nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", s["M2slot"], nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", s["M3slot"], nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", s["M4slot"], nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", s["M5slot"], nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_check("ext", s["T4M2slot"], nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  end
  sv_rule("SL_R_1", "The top-metal slot overlap CB is not allowed") do |outs|
    s = SvScope.new(self, $sv_G, "SL_R_1")
    outs << proc { sv_bool("AND", s["M1slot"], s["PA"]) }
    outs << proc { sv_bool("AND", s["M2slot"], s["PA"]) }
    outs << proc { sv_bool("AND", s["M3slot"], s["PA"]) }
    outs << proc { sv_bool("AND", s["M4slot"], s["PA"]) }
    outs << proc { sv_bool("AND", s["M5slot"], s["PA"]) }
    outs << proc { sv_bool("AND", s["T4M2slot"], s["PA"]) }
  end
end
