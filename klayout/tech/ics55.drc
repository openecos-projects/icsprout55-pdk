sv_rule("PP_EX_1_EX_1a", "PP extension outside of PMOS GATE along source/drain direction. >= 0.16um PP extension of PMOS gate poly when PP edge on AA. >= 0.3um") do |outs|
  s = SvScope.new(self, $sv_G, "PP_EX_1_EX_1a")
  s.define("SDP_S") { sv_sel_any("inside", s["SDP"], s["SRAMALL"], [], true, {}) }
