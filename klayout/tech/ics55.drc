  s.define("X") { sv_sel_any("interact", s["SDN"], s["PORES"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["POR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_S_1:ESD", "Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_S_1:ESD")
  s.define("X") { sv_sel_any("interact", s["ESD1"], s["PORES"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["POR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_S_1:HRP", "Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_S_1:HRP")
  s.define("X") { sv_sel_any("interact", s["HRP"], s["PORES"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["POR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_S_1:NPR", "Space between N/P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_S_1:NPR")
  s.define("X") { sv_sel_any("interact", s["NPR"], s["PORES"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["POR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_S_2", "Space between SAB and CT for non-silicide poly resistor = 0.21um") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_S_2")
  s.define("X") { sv_sel_any("interact", s["POR"], s["SAB"], [], false, {}) }
  s.define("Y") { sv_bool("AND", s["CT"], s["X"]) }
  outs << proc { sv_sel_any("inside", sv_sel_any("touch", sv_size(s["Y"], 0.21, {}), s["POR_SA"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_EN_1", "Enclosure of PP/NP outside of a Poly resistor area >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_EN_1")
  s.define("X") { sv_bool("AND", s["PORES"], s["PO"]) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X"], s["SDN"], [["<", 0.18]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X"], s["SDP"], [["<", 0.18]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_EX_1", "PORES extention outside of PO resistor >= 0.2um") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_EX_1")
  s.define("X") { sv_esel("coin", s["POR_SA"], s["PO"], [], false) }
  outs << proc { sv_esel("inside_edge", sv_check("enc", s["X"], s["PORES"], [["<", 0.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true) }
end
sv_rule("POLYres_EX_2", "Extension of SAB outside of non-silicide poly resistor area(follow SAB.6 rule) >= 0.2um") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_EX_2")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["POR"], s["SAB"], [["<", 0.2]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_R_1", "Non-silicide PO resistor must be covered by SAB and implanted by either NP or PP") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_R_1")
  s.define("X") { sv_sel_any("interact", s["POR"], s["SAB"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", s["X"], sv_bool("OR", s["SDN"], s["SDP"])), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_R_3", "For silicide Poly resistor, two sides of PORES must be along the CT edge") do |outs|
  s = SvScope.new(self, $sv_G, "POLYres_R_3")
  s.define("X") { sv_bool("AND", s["CT"], s["POR_NS"]) }
  s.define("Y") { sv_esel("inside_edge", sv_sel_any("interact", s["PORES"], s["SAB"], [], true, {}), s["PO"], [], false) }
  outs << proc { sv_esel("inside_edge", sv_esel("touch_edge", s["Y"], s["X"], [], true), s["NODRC"], [], true) }
end
if sv_ifdef("Poly_EFuse_CHECK", "YES")
  sv_rule("EFU_1b_G", "FUSEALL (292;12) must interact with EFUSEALL (293;12) region") do |outs|
    s = SvScope.new(self, $sv_G, "EFU_1b_G")
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["FUSEALL"], s["EFUSEALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("EFU_1c_G", "FUSEALL (292;12) must fully cover EFUSEALL (293;12) region") do |outs|
    s = SvScope.new(self, $sv_G, "EFU_1c_G")
    outs << proc { sv_sel_any("inside", sv_bool("NOT", s["EFUSEALL"], s["FUSEALL"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("EFU_2b_G", "EFUSEALL (293;12) must interact with POEFUSEBLK(294;12)") do |outs|
    s = SvScope.new(self, $sv_G, "EFU_2b_G")
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["EFUSEALL"], s["POEFUSEBLK"], [], true, {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("EFU_2c_G", "EFUSE (293;12) must fully cover POEFUSEBLK(294;12)") do |outs|
    s = SvScope.new(self, $sv_G, "EFU_2c_G")
    outs << proc { sv_sel_any("inside", sv_bool("NOT", s["POEFUSEBLK"], s["EFUSEALL"]), s["NODRC"], [], true, {}) }
  end
end
sv_rule("HRP_W_1", "Width of HRP >= 0.21um It is strongly suggested that the resistor square number (length/width ratio) >= 5 for precise Rs. >= 5") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["HRP"], nil, [["<", 0.21]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("HRP_W_2", "Width of high resistance poly >= 2.00um") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_W_2")
  s.define("X") { sv_esel("coin", sv_sel_any("interact", s["PO"], s["PO_HRP"], [], false, {}), s["SDP"], [], true) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["X"], nil, [["<", 2.0]], {:metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("HRP_S_1", "Space between two HRP >= 0.21um") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["HRP"], nil, [["<", 0.21]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("HRP_S_2", "Space between HRP region and NMOS poly >= 0.16um Space between HRP region and PMOS poly >= 0.16um") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_S_2")
  s.define("PO_MOS") { sv_sel_any("interact", s["PO"], s["GATE"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["HRP"], s["PO_MOS"], [["<", 0.16]], {:abut => [["<", 180.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("HRP_S_3", "Fixed Space between SAB and CT in HRP region is 0.21um") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_S_3")
  s.define("X") { sv_sel_any("interact", s["HRP"], s["SAB"], [], false, {}) }
  s.define("Y") { sv_bool("AND", s["CT"], s["X"]) }
  outs << proc { sv_sel_any("touch", sv_size(s["Y"], 0.21, {}), sv_sel_any("interact", s["SAB"], s["HRP"], [], false, {}), [], true, {}) }
end
sv_rule("HRP_EN_1", "HRP enclosure of high resistance poly >= 0.20um") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_EN_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["PO_HRP"], s["HRP"], [["<", 0.2]], {:abut => [["<", 180.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("HRP_EX_1", "SAB extension outside of high resistance poly >= 0.22um") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_EX_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", sv_sel_any("interact", s["PO"], s["PO_HRP"], [], false, {}), s["SAB"], [["<", 0.22]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("HRP_O_1", "PP overlap with SAB = 0.30um") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_O_1")
  s.define("RES_HRP") { sv_bool("AND", sv_bool("AND", sv_bool("AND", s["HPR"], s["HRP"]), s["PO"]), s["SAB"]) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("int", sv_sel_any("interact", s["SAB"], s["RES_HRP"], [], false, {}), s["SDP"], [["<", 0.3]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"], [], true, {}), s["SRAMALL"], [], true, {}) }
  s.define("SDP_CK") { sv_esel("inside_edge", s["SDP"], sv_sel_any("interact", s["PO"], s["RES_HRP"], [], false, {}), [], false) }
  outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_check("int", s["SDP_CK"], sv_sel_any("interact", s["SAB"], s["RES_HRP"], [], false, {}), [["<=", 0.3]], {:abut => [["<", 90.0]]}), s["SRINGBLK"], [], true), s["SRAMALL"], [], true) }
end
sv_rule("HRP_R_1", "It is not allowed (NP,PP) overlap HPR region (when checking the rule, size down the HPR by 0.3um along the current direction)") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_R_1")
  s.define("HRPR") { sv_sel_any("interact", s["PO"], s["HRP"], [], false, {}) }
  s.define("HRP_END") { sv_size(sv_bool("NOT", s["HRPR"], s["HPR"]), 0.3, {}) }
  s.define("HRP_MID") { sv_bool("NOT", s["HRPR"], s["HRP_END"]) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_bool("OR", s["SDN"], s["SDP"]), s["HRP_MID"]), s["NODRC"], [], true, {}) }
end
sv_rule("HRP_R_2", "HPR edge should align with SAB edge") do |outs|
  s = SvScope.new(self, $sv_G, "HRP_R_2")
  s.define("SAB_AND_HRP") { sv_bool("AND", sv_sel_any("interact", s["SAB"], s["HRP"], [], false, {}), s["PO"]) }
  s.define("DMY_AND_HRP") { sv_bool("AND", s["HPR"], s["PO"]) }
  outs << proc { sv_sel_any("inside", sv_bool("XOR", s["SAB_AND_HRP"], s["DMY_AND_HRP"]), s["NODRC"], [], true, {}) }
end
$sv_G.define("LDAA") { sv_bool("AND", $sv_G["AA"], $sv_G["LDMOS"]) }
$sv_G.define("LDPACT") { sv_bool("AND", $sv_G["LDAA"], $sv_G["SDP"]) }
$sv_G.define("LDNACT") { sv_bool("AND", $sv_G["LDAA"], $sv_G["SDN"]) }
$sv_G.define("LDPGATE") { sv_bool("AND", $sv_G["LDPACT"], $sv_G["PO"]) }
$sv_G.define("LDNGATE") { sv_bool("AND", $sv_G["LDNACT"], $sv_G["PO"]) }
$sv_G.define("LDPD") { sv_sel_any("touch", sv_sel_any("interact", $sv_G["LDPACT"], $sv_G["PO"], [], true, {}), $sv_G["LDMOSSTI"], [], false, {}) }
$sv_G.define("LDND") { sv_sel_any("touch", sv_sel_any("interact", $sv_G["LDNACT"], $sv_G["PO"], [], true, {}), $sv_G["LDMOSSTI"], [], false, {}) }
$sv_G.define("LDPS") { sv_bool("NOT", sv_sel_any("interact", $sv_G["LDPACT"], $sv_G["PO"], [], false, {}), $sv_G["LDPGATE"]) }
$sv_G.define("LDNS") { sv_bool("NOT", sv_sel_any("interact", $sv_G["LDNACT"], $sv_G["PO"], [], false, {}), $sv_G["LDNGATE"]) }
$sv_G.define("SD_LDMOS") { sv_nary("OR", $sv_G["LDPD"], $sv_G["LDND"], $sv_G["LDPS"], $sv_G["LDNS"]) }
$sv_G.define("PO_LDMOS") { sv_bool("OR", $sv_G["LDPGATE"], $sv_G["LDNGATE"]) }
$sv_G.define("AA_LDMOS") { sv_bool("OR", $sv_G["SD_LDMOS"], $sv_G["PO_LDMOS"]) }
if sv_ifdef("DUP_CHECK", "YES")
  $sv_G.define("padarea") { sv_bool("AND", $sv_G["DEUPAD"], $sv_G["MD"]) }
  sv_rule("DEUPAD_R_2", "DEUPAD must fully enclose COVER") do |outs|
    s = SvScope.new(self, $sv_G, "DEUPAD_R_2")
    outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_sel_any("interact", s["MD"], s["DEUPAD"], [], false, {}), s["DEUPAD"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("DEUPAD_R_3", "Two top metal layers (TM and TM-1) are needed between DEUPAD and device, where the metal design must be solid.") do |outs|
    s = SvScope.new(self, $sv_G, "DEUPAD_R_3")
    outs << proc { sv_sel_any("inside", sv_sel_any("enclose", s["padarea"], sv_bool("NOT", s["padarea"], s["T4M2"]), [], false, {}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("enclose", s["padarea"], sv_bool("NOT", s["padarea"], s["M5"]), [], false, {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("DEUPAD_R_5", "ALPADres, MOMLVS1, INDALL, Resistor of TM or TM-1 must be outside of DEUPAD area.") do |outs|
    s = SvScope.new(self, $sv_G, "DEUPAD_R_5")
    s.define("X1") { sv_bool("OR", sv_bool("OR", s["ALPAR"], s["MOMLVS1"]), s["INDALL"]) }
    s.define("X2") { sv_bool("OR", sv_bool("AND", s["T4M2R"], s["T4M2"]), sv_bool("AND", s["M5R"], s["M5"])) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", sv_bool("OR", s["X1"], s["X2"]), s["padarea"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("DEUPAD_R_6", "For one top metal process: TV-1 pattern is not allowed under the DEUPAD opening area For two top metal process: T4V1 patterns are not allowed under the DEUPAD opening area") do |outs|
    s = SvScope.new(self, $sv_G, "DEUPAD_R_6")
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["padarea"], s["V4"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("DEUPAD_R_7", "DEUPAD area must have top via array between (top metal and the top metal directly underneath top metal) two vias which space is within 0.51um are considerd to be same array") do |outs|
    s = SvScope.new(self, $sv_G, "DEUPAD_R_7")
    s.define("V_ARRAY_S_REG") { sv_check("ext", s["T4V2"], nil, [["<=", 0.51]], {:singular => true, :region => true}) }
    s.define("V_ARRAY") { sv_sel_any("interact", s["T4V2"], s["V_ARRAY_S_REG"], [], false, {}) }
    outs << proc { sv_sel_any("interact", s["padarea"], s["V_ARRAY"], [], true, {}) }
  end
end
