$sv_G.define("ERDL_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], $sv_G["RDLi"]) }
$sv_G.define("ERDLVIA_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], $sv_G["RV"]) }
$sv_G.define("EALPA_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], $sv_G["ALPAi"]) }
$sv_G.define("EMD_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], $sv_G["MDi"]) }
$sv_G.define("ERDLPA2_EMPTY") { sv_bool("OR", $sv_G["EMPTY1"], $sv_G["COVER"]) }
sv_connect(["ET4M2i_EMPTY", "EPA_EMPTY"], nil)
sv_connect(["ET4M2i_EMPTY", "ERDL_EMPTY"], "ERDLVIA_EMPTY")
sv_connect(["ERDL_EMPTY", "ERDLPA2_EMPTY"], nil)
sv_connect(["EPA_EMPTY", "EALPA_EMPTY"], nil)
sv_connect(["ERDL_EMPTY", "EALPA_EMPTY"], nil)
sv_connect(["EALPA_EMPTY", "EMD_EMPTY"], nil)
if sv_ifdef("ESD_CHECK", "YES")
  sv_rule("ESDN_1_SEDP_1", "Minimum ACT extnsion of CT on SOURCE >= 0.15") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_1_SEDP_1")
    outs << proc { sv_esel("inside_edge", sv_check("enc", s["ECT_S"], s["EMOS_S"], [["<", 0.15]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_2_ESDP_2", "Minimum CT to Poly space on SOURCE >= 0.15") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_2_ESDP_2")
    outs << proc { sv_esel("inside_edge", sv_check("ext", s["ECT_S"], s["EGATE"], [["<", 0.15]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_4_ESDP_4", "Minimum SAB overlap Poly on Drain >= 0.05") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_4_ESDP_4")
    outs << proc { sv_sel_any("inside", sv_check("int", s["ESAB"], s["EGATE"], [["<", 0.05]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  end
  sv_rule("ESDN_5_ESDP_5", "Minimum SAB to Poly on Drain space >= 1.29") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_5_ESDP_5")
    outs << proc { sv_esel("inside_edge", sv_check("ext", s["ESAB_HO_RAW"], s["EGATE"], [["<", 1.29]], {:metric => "opposite", :region => true}), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_6_ESDP_6", "Minimum SAB to CT on Drain space >= 0.21") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_6_ESDP_6")
    outs << proc { sv_esel("inside_edge", sv_check("enc", s["ECT_D"], s["ESAB_HO_RAW"], [["<", 0.21]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_7_ESDP_7", "Minimum SAB to ACT space >= 0.21") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_7_ESDP_7")
    outs << proc { sv_esel("inside_edge", sv_check("enc", sv_esel("coin", s["ENMOS_DRAIN"], s["EGATE"], [], true), sv_bool("OR", s["ESAB"], s["ESAB_HO_RAW"]), [["<", 0.21]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true) }
    outs << proc { sv_esel("inside_edge", sv_check("enc", sv_esel("coin", s["EPMOS_DRAIN"], s["EGATE"], [], true), sv_bool("OR", s["ESAB"], s["ESAB_HO_RAW"]), [["<", 0.21]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_8_ESDP_8", "Minimum SAB overlap ACT >= 1") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_8_ESDP_8")
    outs << proc { sv_esel("inside_edge", sv_check("enc", s["ESAB_HO_RAW"], s["ENMOS_DRAIN"], [["<", 1.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true) }
    outs << proc { sv_esel("inside_edge", sv_check("enc", s["ESAB_HO_RAW"], s["EPMOS_DRAIN"], [["<", 1.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_9", "Minimum ESD implant to Poly space >= 0.4") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_9")
    outs << proc { sv_esel("inside_edge", sv_check("ext", s["ESD1"], s["EGATE"], [["<", 0.4]], {:metric => "opposite", :region => true}), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_10", "Minimum ESD implant to ACT space >= 0.4") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_10")
    outs << proc { sv_esel("inside_edge", sv_check("enc", s["ESD1"], s["ENMOS_DRAIN"], [["<", 0.4]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_11", "ESD implant can't overlap Poly") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_11")
    outs << proc { sv_esel("inside_edge", sv_bool("AND", s["ESD1"], s["EGATE_POLY"]), s["NODRC"], [], true) }
  end
  sv_rule("ESDN_12", "Unit finger width (F) of NMOS for ESD protection device >= 30um <= 40um") do |outs|
    s = SvScope.new(self, $sv_G, "ESDN_12")
    outs << proc { sv_esel("inside_edge", sv_length(sv_esel("inside_edge", s["EGATE_W"], s["ENMOS"], [], false), [["<", 30.0]], false), s["NODRC"], [], true) }
    outs << proc { sv_esel("inside_edge", sv_length(sv_esel("inside_edge", s["EGATE_W"], s["ENMOS"], [], false), [[">", 40.0]], false), s["NODRC"], [], true) }
  end
  sv_rule("ESDP_9", "Unit finger width (F) of PMOS for ESD protection device >= 30um <= 40um") do |outs|
    s = SvScope.new(self, $sv_G, "ESDP_9")
    outs << proc { sv_esel("inside_edge", sv_length(sv_esel("inside_edge", s["EGATE_W"], s["EPMOS"], [], false), [["<", 30.0]], false), s["NODRC"], [], true) }
    outs << proc { sv_esel("inside_edge", sv_length(sv_esel("inside_edge", s["EGATE_W"], s["EPMOS"], [], false), [[">", 40.0]], false), s["NODRC"], [], true) }
  end
  if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
    sv_rule("ESDN_13_R", "Total channel width of ESD NMOS. The total channel width is calculated by the ESD MOS in the same Drain connection. The connectivity can be formed by all metal, via, ALPA, PA and MD but not broken by resistors. SAB is used for drain recognition in DRC runset Channel width (W) of NMOS for ESD protection device (Channel width = Finger width x Finger No.) >= 150um") do |outs|
      s = SvScope.new(self, $sv_G, "ESDN_13_R")
      s.define("X") { sv_net_area_ratio([s["ENGATE_D_EMPTY"], s["ESD3C_EMPTY"]], "AREA ( ESD3C_EMPTY ) / 0.001", [["<", 150.0]], {:bases => [s["ENGATE_D_EMPTY"], s["ESD3C_EMPTY"]]}) }
      outs << proc { sv_sel_any("inside", sv_sel_any("interact", sv_sel_any("interact", s["X"], s["ENGATE"], [], false, {}), s["EGATE_NOSAB"], [], true, {}), s["NODRC"], [], true, {}) }
    end
    sv_rule("ESDP_10_R", "Total channel width of ESD PMOS. The total channel width is calculated by the ESD MOS in the same Drain connection. The connectivity can be formed by all metal, via, ALPA, PA and MD but not broken by resistors. SAB is used for drain recognition in DRC runset Channel width (W) of PMOS for ESD protection device (Channel width = Finger width x Finger No.) >= 300um") do |outs|
      s = SvScope.new(self, $sv_G, "ESDP_10_R")
      s.define("X") { sv_net_area_ratio([s["EPGATE_D_EMPTY"], s["ESD3C_EMPTY"]], "AREA ( ESD3C_EMPTY ) / 0.001", [["<", 300.0]], {:bases => [s["EPGATE_D_EMPTY"], s["ESD3C_EMPTY"]]}) }
      outs << proc { sv_sel_any("inside", sv_sel_any("interact", sv_sel_any("interact", s["X"], s["EPGATE"], [], false, {}), s["EGATE_NOSAB"], [], true, {}), s["NODRC"], [], true, {}) }
    end
  end
  if sv_ifdef("IO", "1833")
    sv_rule("ESDN_3", "Channel length of 3.3V I/O NMOS for protection device. >= 0.5um") do |outs|
      s = SvScope.new(self, $sv_G, "ESDN_3")
      s.define("X") { sv_esel("coin", sv_bool("AND", s["EGATEHV"], s["ENGATE"]), s["EGATE_L"], [], false) }
      outs << proc { sv_esel("inside_edge", sv_length(s["X"], [["<", 0.5]], false), s["NODRC"], [], true) }
    end
    sv_rule("ESDP_3", "Channel length of 3.3V I/O PMOS for protection device. >= 0.4um, <=0.5") do |outs|
      s = SvScope.new(self, $sv_G, "ESDP_3")
      s.define("X") { sv_esel("coin", sv_bool("AND", s["EGATEHV"], s["EPGATE"]), s["EGATE_L"], [], false) }
      s.define("GOOD") { sv_esel("inside_edge", sv_length(s["X"], [[">=", 0.4], ["<=", 0.5]], false), s["NODRC"], [], true) }
      outs << proc { sv_esel("inside_edge", sv_esel("with_edge", sv_bool("AND", s["EGATEHV"], s["EPGATE"]), s["GOOD"], [], true), s["NODRC"], [], true) }
    end
  end
  if sv_ifdef("IO", "1825")
    sv_rule("ESDN_3", "Channel length of 3.3V I/O NMOS for protection device. >= 0.5um") do |outs|
      s = SvScope.new(self, $sv_G, "ESDN_3")
      s.define("X") { sv_esel("coin", sv_bool("AND", s["EGATEHV"], s["ENGATE"]), s["EGATE_L"], [], false) }
      outs << proc { sv_esel("inside_edge", sv_length(s["X"], [["<", 0.5]], false), s["NODRC"], [], true) }
    end
    sv_rule("ESDP_3", "Channel length of 3.3V I/O PMOS for protection device. >= 0.4um, <=0.5") do |outs|
      s = SvScope.new(self, $sv_G, "ESDP_3")
      s.define("X") { sv_esel("coin", sv_bool("AND", s["EGATEHV"], s["EPGATE"]), s["EGATE_L"], [], false) }
      s.define("GOOD") { sv_esel("inside_edge", sv_length(s["X"], [[">=", 0.4], ["<=", 0.5]], false), s["NODRC"], [], true) }
      outs << proc { sv_esel("inside_edge", sv_esel("with_edge", sv_bool("AND", s["EGATEHV"], s["EPGATE"]), s["GOOD"], [], true), s["NODRC"], [], true) }
    end
  end
end
sv_rule("ESD_W_1", "ESD1 width >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "ESD_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["ESD1"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("ESD_S_1", "Space between two ESD1s. Merge if space is less than this value. >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "ESD_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["ESD1"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("ESD_A_1", "ESD1 area >= 0.6um2") do |outs|
  s = SvScope.new(self, $sv_G, "ESD_A_1")
  outs << proc { sv_sel_any("inside", sv_area(s["ESD1"], [["<", 0.6]], false), s["NODRC"], [], true, {}) }
end
sv_rule("ESD_A_2", "ESD1 enclosed area >= 0.6um2") do |outs|
  s = SvScope.new(self, $sv_G, "ESD_A_2")
  outs << proc { sv_sel_any("inside", sv_area(sv_bool("NOT", sv_holes(s["ESD1"], {:inner => true}), s["ESD1"]), [["<", 0.6]], false), s["NODRC"], [], true, {}) }
end
