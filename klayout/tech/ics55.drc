  s = SvScope.new(self, $sv_G, "TG_S_4")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["NW"], s["TG"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
