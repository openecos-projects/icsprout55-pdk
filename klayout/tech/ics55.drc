  outs << proc { sv_sel_any("inside", sv_check("int", s["DG"], s["PSUB"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
