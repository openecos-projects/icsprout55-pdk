  outs << proc { sv_sel_any("inside", sv_check("ext", s["Z"], nil, [["<", 0.14]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("CT_S_2", "CT space at different nets, except SRAMALL region. >= 0.12um") do |outs|
