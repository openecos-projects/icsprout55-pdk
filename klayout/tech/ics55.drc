$sv_G.define("V1N") { sv_bool("AND", $sv_G["V1"], sv_rectangle($sv_G["V1"], {:neg => false, :w => [["==", 0.09]], :l => [["==", 0.09]]})) }
$sv_G.define("RV1") { sv_bool("AND", $sv_G["V1"], sv_rectangle($sv_G["V1"], {:neg => false, :aspect => [["!=", 1.0]]})) }
sv_rule("V1_R_3", "Single Vn is not allowed in H-shape Mn+1 when: 1) The Mn+1 has H-shape metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2. 2) The Vn overlaps on the center metal bar of this H-shape Mn+1 3) The center metal bar has the length (L) <= 1um and the width <= 3um") do |outs|
  s = SvScope.new(self, $sv_G, "V1_R_3")
  s.define("X0") { sv_area(sv_rectangle(sv_holes(s["M2"], {:inner => true}), {:neg => false}), [["<=", 5.0]], false) }
  s.define("X1") { sv_esel("with_edge", s["X0"], sv_length(s["X0"], [[">", 5.0]], false), [], true) }
  s.define("Y") { sv_esel("coin", s["M2"], s["X1"], [], false) }
  s.define("Y1") { sv_bool("NOT", sv_check("ext", s["Y"], nil, [["<=", 3.0]], {:metric => "opposite", :region => true}), s["M2"]) }
  s.define("Z0") { sv_sel_any("interact", s["M2"], s["Y1"], [["==", 2.0]], false, {}) }
  s.define("Z1") { sv_length(sv_esel("coin", s["M2"], s["Z0"], [], false), [["<=", 1.0]], false) }
  s.define("Z") { sv_esel("with_edge", s["Z0"], s["Z1"], [], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["Z"], s["V1N"], [["==", 1.0]], false, {}), s["NODRC"], [], true, {}) }
end
$sv_G.define("V2N_M") { sv_sel_any("interact", $sv_G["V2N"], $sv_G["st_2"], [], false, {}) }
$sv_G.define("st_2") { sv_sel_any("enclose", sv_bool("AND", $sv_G["M2"], $sv_G["M3"]), $sv_G["V2"], [["==", 1.0]], false, {}) }
$sv_G.define("V2N") { sv_bool("AND", $sv_G["V2"], sv_rectangle($sv_G["V2"], {:neg => false, :w => [["==", 0.09]], :l => [["==", 0.09]]})) }
$sv_G.define("RV2") { sv_bool("AND", $sv_G["V2"], sv_rectangle($sv_G["V2"], {:neg => false, :aspect => [["!=", 1.0]]})) }
sv_rule("V2_R_3", "Single Vn is not allowed in H-shape Mn+1 when: 1) The Mn+1 has H-shape metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2. 2) The Vn overlaps on the center metal bar of this H-shape Mn+1 3) The center metal bar has the length (L) <= 1um and the width <= 3um") do |outs|
  s = SvScope.new(self, $sv_G, "V2_R_3")
  s.define("X0") { sv_area(sv_rectangle(sv_holes(s["M3"], {:inner => true}), {:neg => false}), [["<=", 5.0]], false) }
  s.define("X1") { sv_esel("with_edge", s["X0"], sv_length(s["X0"], [[">", 5.0]], false), [], true) }
  s.define("Y") { sv_esel("coin", s["M3"], s["X1"], [], false) }
  s.define("Y1") { sv_bool("NOT", sv_check("ext", s["Y"], nil, [["<=", 3.0]], {:metric => "opposite", :region => true}), s["M3"]) }
  s.define("Z0") { sv_sel_any("interact", s["M3"], s["Y1"], [["==", 2.0]], false, {}) }
  s.define("Z1") { sv_length(sv_esel("coin", s["M3"], s["Z0"], [], false), [["<=", 1.0]], false) }
  s.define("Z") { sv_esel("with_edge", s["Z0"], s["Z1"], [], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["Z"], s["V2N"], [["==", 1.0]], false, {}), s["NODRC"], [], true, {}) }
end
$sv_G.define("V3N_M") { sv_sel_any("interact", $sv_G["V3N"], $sv_G["st_3"], [], false, {}) }
$sv_G.define("st_3") { sv_sel_any("enclose", sv_bool("AND", $sv_G["M3"], $sv_G["M4"]), $sv_G["V3"], [["==", 1.0]], false, {}) }
$sv_G.define("V3N") { sv_bool("AND", $sv_G["V3"], sv_rectangle($sv_G["V3"], {:neg => false, :w => [["==", 0.09]], :l => [["==", 0.09]]})) }
$sv_G.define("RV3") { sv_bool("AND", $sv_G["V3"], sv_rectangle($sv_G["V3"], {:neg => false, :aspect => [["!=", 1.0]]})) }
sv_rule("V3_R_3", "Single Vn is not allowed in H-shape Mn+1 when: 1) The Mn+1 has H-shape metal interact with two metal holes: both two metal holes' length (L2) <= 5um and area <= 5um2. 2) The Vn overlaps on the center metal bar of this H-shape Mn+1 3) The center metal bar has the length (L) <= 1um and the width <= 3um") do |outs|
  s = SvScope.new(self, $sv_G, "V3_R_3")
