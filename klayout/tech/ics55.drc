$sv_G.define("Stack_Vn") { sv_sel_any("interact", $sv_G["V1FUSE"], sv_sel_any("interact", $sv_G["V2FUSE"], sv_sel_any("interact", $sv_G["V3FUSE"], sv_sel_any("interact", $sv_G["V4FUSE"], sv_sel_any("interact", $sv_G["T4V2FUSE"], $sv_G["RDLVF"], [], false, {}), [], false, {}), [], false, {}), [], false, {}), [], false, {}) }
$sv_G.define("Stack_MR") { sv_bool("OR", $sv_G["GM1"], sv_bool("OR", $sv_G["GM2"], sv_bool("OR", $sv_G["GM3"], sv_bool("OR", $sv_G["GM4"], sv_bool("OR", $sv_G["GM5"], sv_bool("OR", $sv_G["GT4M2"], $sv_G["GRDL"])))))) }
$sv_G.define("LMARK") { sv_bool("AND", sv_bool("AND", $sv_G["RDL"], $sv_G["FUSE"]), $sv_G["LOGO"]) }
$sv_G.define("PO_VEX_0") { sv_convex_edge($sv_G["PO"], {:count => [["==", 0.0]]}) }
$sv_G.define("PO_VEX_1") { sv_convex_edge($sv_G["PO"], {:count => [["==", 1.0]]}) }
$sv_G.define("PO_VEX_2") { sv_convex_edge($sv_G["PO"], {:count => [["==", 2.0]]}) }
$sv_G.define("PO_LS") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["PO"], $sv_G["PO_VEX_0"], [], true), $sv_G["PO_VEX_1"], [["==", 2.0]], false), $sv_G["PO_VEX_2"], [["==", 4.0]], false) }
$sv_G.define("PO_TS1") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["PO"], $sv_G["PO_VEX_0"], [], true), $sv_G["PO_VEX_1"], [["==", 4.0]], false), $sv_G["PO_VEX_2"], [["==", 4.0]], false) }
$sv_G.define("PO_TS2") { sv_expand_edge(sv_esel("coin", $sv_G["PO_VEX_2"], $sv_G["PO_TS1"], [], false), {:outside => 0.005, :corner_fill => true}) }
$sv_G.define("PO_TS3") { sv_esel("with_edge", $sv_G["PO_TS2"], $sv_G["PO_VEX_2"], [["==", 3.0]], false) }
$sv_G.define("PO_TS") { sv_sel_any("interact", $sv_G["PO_TS1"], $sv_G["PO_TS3"], [["==", 1.0]], false, {}) }
$sv_G.define("PO_US") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["PO"], $sv_G["PO_VEX_0"], [["==", 1.0]], false), $sv_G["PO_VEX_1"], [["==", 2.0]], false), $sv_G["PO_VEX_2"], [["==", 5.0]], false) }
$sv_G.define("PO_OS") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["PO"], $sv_G["PO_VEX_0"], [["==", 4.0]], false), $sv_G["PO_VEX_1"], [], true), $sv_G["PO_VEX_2"], [["==", 4.0]], false) }
$sv_G.define("PO_HS") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["PO"], $sv_G["PO_VEX_0"], [["==", 2.0]], false), $sv_G["PO_VEX_1"], [["==", 4.0]], false), $sv_G["PO_VEX_2"], [["==", 6.0]], false) }
$sv_G.define("AA_VEX_0") { sv_convex_edge($sv_G["AA"], {:count => [["==", 0.0]]}) }
$sv_G.define("AA_VEX_1") { sv_convex_edge($sv_G["AA"], {:count => [["==", 1.0]]}) }
$sv_G.define("AA_VEX_2") { sv_convex_edge($sv_G["AA"], {:count => [["==", 2.0]]}) }
$sv_G.define("AA_LS") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["AA"], $sv_G["AA_VEX_0"], [], true), $sv_G["AA_VEX_1"], [["==", 2.0]], false), $sv_G["AA_VEX_2"], [["==", 4.0]], false) }
$sv_G.define("AA_TS1") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["AA"], $sv_G["AA_VEX_0"], [], true), $sv_G["AA_VEX_1"], [["==", 4.0]], false), $sv_G["AA_VEX_2"], [["==", 4.0]], false) }
$sv_G.define("AA_TS2") { sv_expand_edge(sv_esel("coin", $sv_G["AA_VEX_2"], $sv_G["AA_TS1"], [], false), {:outside => 0.005, :corner_fill => true}) }
$sv_G.define("AA_TS3") { sv_esel("with_edge", $sv_G["AA_TS2"], $sv_G["AA_VEX_2"], [["==", 3.0]], false) }
$sv_G.define("AA_TS") { sv_sel_any("interact", $sv_G["AA_TS1"], $sv_G["AA_TS3"], [["==", 1.0]], false, {}) }
$sv_G.define("AA_US") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["AA"], $sv_G["AA_VEX_0"], [["==", 1.0]], false), $sv_G["AA_VEX_1"], [["==", 2.0]], false), $sv_G["AA_VEX_2"], [["==", 5.0]], false) }
$sv_G.define("AA_OS") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["AA"], $sv_G["AA_VEX_0"], [["==", 4.0]], false), $sv_G["AA_VEX_1"], [], true), $sv_G["AA_VEX_2"], [["==", 4.0]], false) }
$sv_G.define("AA_HS") { sv_esel("with_edge", sv_esel("with_edge", sv_esel("with_edge", $sv_G["AA"], $sv_G["AA_VEX_0"], [["==", 2.0]], false), $sv_G["AA_VEX_1"], [["==", 4.0]], false), $sv_G["AA_VEX_2"], [["==", 6.0]], false) }
sv_rule("DNW_W_1", "DNW width >= 3.00um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["DNW"], nil, [["<", 3.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DNW_S_1", "Space between two DNWs >= 3.50um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["DNW"], nil, [["<", 3.5]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DNW_S_2a", "Space between DNW and NW at different net >= 2.35um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_S_2a")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["DNW"], s["NW"], [["<", 2.35]], {:singular => true, :region => true, :measure_all => true, :connected => false, :netbase_a => s["DNW"], :netbase_b => s["NW"]}), s["NODRC"], [], true, {}) }
end
sv_rule("DNW_S_3", "Space between TPW and (TPW OR PW1) >= 0.80um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_S_3")
  s.define("X") { sv_sel_any("inside", s["PW"], s["DNW"], [], false, {}) }
  s.define("Y") { sv_bool("OR", s["PW"], s["X"]) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("ext", s["X"], s["Y"], [["<", 0.8]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["LDMOS"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("DNW_S_4", "Space between TPW and (TPW OR PW) when at least one TPW OR PW interact DG >= 1.20um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_S_4")
  s.define("TPWDTG") { sv_bool("AND", sv_sel_any("inside", s["PW"], s["DNW"], [], false, {}), sv_bool("OR", s["DG"], s["TG"])) }
  s.define("PWDTG") { sv_bool("AND", s["PW"], sv_bool("OR", s["DG"], s["TG"])) }
  s.define("TPW") { sv_sel_any("inside", s["PW"], s["DNW"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("ext", s["TPWDTG"], s["TPW"], [["<", 1.2]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["LDMOS"], [], true, {}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("ext", s["PWDTG"], s["TPW"], [["<", 1.2]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["LDMOS"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("DNW_S_5", "Space between DNW and N+AA >= 1.60um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_S_5")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["DNW"], s["NSDi"], [["<", 1.6]], {:singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DNW_EN_1", "NW Enclosure of DNW >= 1.00um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_EN_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["DNW"], s["NW"], [["<", 1.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_esel("inside_edge", sv_esel("coin", s["DNW"], s["NW"], [], false), s["NODRC"], [], true) }
  outs << proc { sv_esel("inside_edge", sv_esel("outside_edge", s["DNW"], s["NW"], [], false), s["NODRC"], [], true) }
end
sv_rule("DNW_EN_2", "Enclosure of N+ AA >= 0.55um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_EN_2")
  outs << proc { sv_sel_any("inside", sv_check("enc", sv_bool("NOT", s["NACT"], sv_bool("OR", s["NTAP"], s["PTAP"])), s["DNW"], [["<", 0.55]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DNW_O_1", "Overlap of NW and DNW. >= 0.40um") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_O_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["NW"], s["DNW"], [["<", 0.4]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DNW_R_1", "It is recommanded DNW be enclosed by NW") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_R_1")
  outs << proc { sv_esel("inside_edge", sv_esel("coin", sv_esel("inside_edge", s["DNW"], s["NW_DNW"], [], true), s["NW_DNW"], [], true), s["NODRC"], [], true) }
end
sv_rule("DNW_R_3", "Floating TPW is not allowed. DRC flags TPW not TOUCH CT in P+ pickup AA") do |outs|
  s = SvScope.new(self, $sv_G, "DNW_R_3")
  s.define("X") { sv_sel_any("inside", s["PW"], s["DNW"], [], false, {}) }
  outs << proc { sv_sel_any("interact", s["X"], sv_sel_any("interact", s["CT"], s["PTAP"], [], false, {}), [], true, {}) }
end
sv_rule("ACT_W_1", "AA width >= 0.08um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["AA"], nil, [["<", 0.08]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_W_2", "Width of 45 degree bent AA >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_W_2")
  s.define("X") { sv_angle(s["AA"], [["==", 45.0]], false) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["X"], nil, [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_W_3a", "Channel width for 0.9/1.2V NMOS/PMOS transistors >= 0.12um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_W_3a")
  s.define("Y") { sv_length(s["GATE_core_W"], [["<", 0.12]], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_expand_edge(s["Y"], {:inside => 0.001}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_W_3b", "Channel width for 1.8/2.5V/3.3V NMOS/PMOS transistors >= 0.21um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_W_3b")
  s.define("Y") { sv_length(s["GATE_io1_W"], [["<", 0.21]], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_expand_edge(s["Y"], {:inside => 0.001}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  s.define("Z") { sv_length(s["GATE_io2_W"], [["<", 0.21]], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_expand_edge(s["Z"], {:inside => 0.001}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("ACT_W_3a_R", "Recommended Channel width for 0.9/1.2V NMOS/PMOS transistors >= 0.15um") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_W_3a_R")
    s.define("Y") { sv_length(s["GATE_core_W"], [["<", 0.15]], false) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_expand_edge(s["Y"], {:inside => 0.001}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("ACT_L_1", "Maximum AA length between two contacts, or between one contact and AA line end when AA width < 0.15um <= 25.00um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_L_1")
  s.define("AA_1") { sv_sel_any("interact", s["AA"], s["CT"], [], false, {}) }
  s.define("AA_CHECK") { sv_with_width(s["AA_1"], [["<", 0.15]], false) }
  s.define("Z0") { sv_size(s["CT"], 12.5, {:inside_of => s["AA_CHECK"], :step => 0.02}) }
  s.define("Z1") { sv_sel_any("interact", s["Z0"], s["CT"], [["<", 2.0]], false, {}) }
  s.define("Z2") { sv_bool("NOT", sv_sel_any("interact", s["AA_CHECK"], s["Z1"], [], false, {}), sv_sel_any("interact", s["AA_CHECK"], s["CT"], [["==", 1.0]], false, {})) }
  outs << proc { sv_sel_any("inside", s["Z2"], s["NODRC"], [], true, {}) }
  s.define("AA_CHECK_2") { sv_check("int", s["AA_1"], nil, [["<", 0.15]], {:metric => "opposite", :region => true}) }
  s.define("Z4") { sv_sel_any("interact", s["AA_CHECK_2"], s["CT"], [], true, {}) }
  s.define("Z6") { sv_length(s["Z4"], [[">", 25.0]], false) }
  outs << proc { sv_esel("inside_edge", s["Z6"], s["NODRC"], [], true) }
  s.define("X") { sv_convex_edge(s["AA"], {:angle1 => [[">=", 89.9], ["<=", 90.1]], :angle2 => [[">=", 89.9], ["<=", 90.1]], :length => [["<", 0.15]]}) }
  s.define("Y") { sv_sel_any("interact", sv_with_width(s["AA"], [["<", 0.15]], false), s["CT"], [], false, {}) }
  s.define("Z") { sv_esel("touch_edge", s["Y"], s["X"], [], false) }
  s.define("Z3") { sv_size(s["CT"], 25.0, {:inside_of => s["Y"], :step => 0.02}) }
  outs << proc { sv_esel("inside_edge", sv_esel("touch_edge", sv_esel("inside_edge", s["Z"], s["Z3"], [], true), s["Z3"], [], true), s["NODRC"], [], true) }
end
sv_rule("ACT_L_2", "Maximum AA length of Source Active (without CT, width <= 0.15um) which butted with tap <= 0.5um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_L_2")
  s.define("AA_1") { sv_sel_any("interact", s["ALL_SDi"], s["CT"], [], true, {}) }
  s.define("AA_2") { sv_with_width(s["AA_1"], [["<", 0.15]], false) }
  s.define("AA_3") { sv_sel_any("interact", s["AA_2"], s["ALL_TAPi"], [], false, {}) }
  s.define("AA_4") { sv_length(s["AA_3"], [[">", 0.5]], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_esel("with_edge", s["ALL_SDi"], s["AA_4"], [], false), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_S_1", "Space between two AAs > = 0.11um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["AA"], nil, [["<", 0.11]], {:abut => [["<", 90.0]], :singular => true, :region => true}), sv_bool("OR", s["NODRC"], s["SRAMALL"]), [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("ACT_S_1_R", "Recommended Space between two AAs > = 0.16um") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_S_1_R")
    outs << proc { sv_sel_any("inside", sv_check("ext", s["AA"], nil, [["<", 0.16]], {:abut => [["<", 90.0]], :singular => true, :region => true}), sv_bool("OR", s["NODRC"], s["SRAMALL"]), [], true, {}) }
  end
  sv_rule("ACT_S_2a_R", "Recommended Space between AA and huge AA(area> 2000000um2) is 0.35um") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_S_2a_R")
    s.define("AA_huge") { sv_area(s["AA"], [[">", 2000000.0]], false) }
    outs << proc { sv_sel_any("inside", sv_check("ext", s["AA"], s["AA_huge"], [["<", 0.35]], {:abut => [["<", 90.0]], :singular => true, :region => true}), sv_bool("OR", s["NODRC"], s["SRAMALL"]), [], true, {}) }
  end
  sv_rule("ACT_R_3", "N+ AA is not allowed to be straddle on the boundary of NW1, except NW resistor/LDMOS region") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_R_3")
    s.define("X") { s["NACT"] }
    outs << proc { sv_sel_any("inside", sv_sel_any("cut", s["X"], sv_sel_any("interact", s["NW"], sv_bool("OR", s["LDMOS"], s["NW1res"]), [], true, {}), [], false, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("ACT_S_1a", "Space between two AAs at least one AA inside by TG") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_1a")
  s.define("AA_TG") { sv_sel_any("inside", s["AA"], s["TG"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["AA"], s["AA_TG"], [["<", 0.16]], {:abut => [["<", 90.0]], :singular => true, :region => true}), sv_bool("OR", s["NODRC"], s["SRAMALL"]), [], true, {}) }
end
sv_rule("ACT_S_2", "Space between AAs when one or both AA width greater than 0.2um parallel length >= 0.3, >= 0.125") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_2")
  s.define("X") { sv_with_width(s["AA"], [[">", 0.2]], false) }
  s.define("Y") { sv_check("ext", s["X"], s["AA"], [["<", 0.125]], {:metric => "opposite", :region => true}) }
  outs << proc { sv_sel_any("inside", sv_enclose_rect(s["Y"], 0.3, 0.08, {:neg => false, :ortho => true}), sv_bool("OR", s["NODRC"], s["SRAMALL"]), [], true, {}) }
end
sv_rule("ACT_S_3", "Space to 45 degree bent AA >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_3")
  s.define("X") { sv_angle(s["AA"], [["==", 45.0]], false) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["AA"], [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_S_4", "Space between U-shape (or O-shape) AA inner edges >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_4")
  outs << proc { sv_esel("inside_edge", sv_convex_edge(s["AA_OS"], {:count => [["==", 0.0]], :length => [["<", 0.18]]}), s["NODRC"], [], true) }
  outs << proc { sv_esel("inside_edge", sv_convex_edge(s["AA_US"], {:count => [["==", 0.0]], :length => [["<", 0.18]]}), s["NODRC"], [], true) }
end
sv_rule("ACT_S_5", "Space between NW and N+AA inside PW except NW resistor region >= 0.15um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_5")
  s.define("X") { sv_check("ext", sv_sel_any("interact", s["NW"], s["NW1res"], [], true, {}), sv_sel_any("inside", s["NACT"], s["PW"], [], false, {}), [["<", 0.15]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_S_6", "Space between NW and N+AA inside TG >= 0.31um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_6")
  s.define("X") { sv_check("ext", sv_sel_any("interact", s["NW"], s["NW1res"], [], true, {}), sv_sel_any("inside", s["NACT"], s["TG"], [], false, {}), [["<", 0.31]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_S_7", "Space between N+AA, which is not enclosed by DNW, and NW which encloses a DNW >= 0.32um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_7")
  s.define("X") { sv_check("ext", s["NACT"], s["NW_DNW"], [["<", 0.32]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", s["X"], s["DNW"]), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_S_8", "Space between NW and P+ pickup AA except LDMOS region >= 0.15um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_S_8")
  s.define("X") { sv_check("ext", s["NW"], sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", s["PACT"], s["NW"]), s["PSUB"]), s["LDMOS"], [], true, {}), [["<", 0.15]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_EN_1", "Enclosure of N+AA by NW (excluding NW interacting with NW1res) >= 0.15um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_EN_1")
  s.define("X") { sv_check("enc", s["NACT"], sv_sel_any("interact", s["NW"], s["NW1res"], [], true, {}), [["<", 0.15]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_EN_2", "Enclosure P+AA by NW >= 0.15um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_EN_2")
  s.define("X") { sv_check("enc", s["PACT"], s["NW"], [["<", 0.15]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_EN_2a", "Enclosure P+AA by (NW INTERACT TG) >= 0.31um") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_EN_2a")
  s.define("X") { sv_check("enc", s["PACT"], sv_sel_any("interact", s["NW"], s["TG"], [], false, {}), [["<", 0.31]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_A_1", "AA area >= 0.0384um2") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_A_1")
  s.define("X") { sv_area(s["AA"], [["<", 0.0384]], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("ACT_A_2", "Enclosed area >= 0.08um2") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_A_2")
  outs << proc { sv_sel_any("inside", sv_area(sv_bool("NOT", sv_holes(s["AA"], {:inner => true}), s["AA"]), [["<", 0.08]], false), s["NODRC"], [], true, {}) }
end
if sv_ifdef("Density_rules", "YES")
  sv_rule("ACT_D_1_min", "AA density (including dummy AA) in 100umX100um window with step size 50um >= 20% <= 80%") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_D_1_min")
    outs << proc { sv_sel_any("inside", sv_density([s["AA_all"]], [["<", 0.2]], {:window => 100.0, :step => 50.0, :backup => true}), s["NODRC"], [], true, {}) }
  end
  sv_rule("ACT_D_1_max", "AA density (including dummy AA) in 100umX100um window with step size 50um >= 20% <= 80%") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_D_1_max")
    outs << proc { sv_sel_any("inside", sv_density([s["AA_all"]], [[">", 0.8]], {:window => 100.0, :step => 50.0, :backup => true}), s["NODRC"], [], true, {}) }
  end
  sv_rule("ACT_D_2", "AA density inside of dummy block area size up 2.5um, >= 10%") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_D_2")
    s.define("X1") { sv_size(s["AADUMB"], 2.5, {}) }
    outs << proc { sv_sel_any("inside", sv_density([s["AA_all"]], [["<", 0.1]], {:window => 20.0, :step => 10.0, :backup => true, :inside_of_layer => s["X1"]}), s["NODRC"], [], true, {}) }
  end
  sv_rule("ACT_D_3", "AA density gradienct <= 20%") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_D_3")
    outs << proc { sv_sel_any("inside", sv_density([s["AA_all"]], [[">=", 0.0]], {:window => 100.0, :gradient => [[">", 0.2]], :absolute => true, :backup => true, :inside_of_layer => s["BULK"]}), s["NODRC"], [], true, {}) }
  end
  sv_rule("ACT_D_4_min", "Global AA density for fully chip (including dummy AA) >= 25% <= 75%") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_D_4_min")
    outs << proc { sv_sel_any("inside", sv_density([s["AA_all"]], [["<", 0.25]], {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("ACT_D_4_max", "Global AA density for fully chip (including dummy AA) >= 25% <= 75%") do |outs|
    s = SvScope.new(self, $sv_G, "ACT_D_4_max")
    outs << proc { sv_sel_any("inside", sv_density([s["AA_all"]], [[">", 0.75]], {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("ACT_R_1", "AA must be fully covered by (NP OR PP), except NW resistor region") do |outs|
  s = SvScope.new(self, $sv_G, "ACT_R_1")
  outs << proc { sv_sel_any("interact", sv_bool("NOT", s["AA"], sv_bool("OR", s["SDN"], s["SDP"])), s["NW1res"], [], true, {}) }
end
$sv_G.define("NW_RE") { sv_esel("outside_edge", $sv_G["NW"], $sv_G["NW1res"], [], true) }
$sv_G.define("LVNW_RE") { sv_esel("coin", $sv_G["NW_RE"], $sv_G["LVNW"], [], false) }
$sv_G.define("MVNW_RE") { sv_esel("coin", $sv_G["NW_RE"], $sv_G["MVNW"], [], false) }
$sv_G.define("HVNW_RE") { sv_esel("coin", $sv_G["NW_RE"], $sv_G["HVNW"], [], false) }
$sv_G.define("NWRES") { sv_bool("AND", $sv_G["NW"], $sv_G["NW1res"]) }
sv_rule("NW1_W_1", "NW1 width >= 0. 47um") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_W_1")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("int", s["NW"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("NW1_S_1", "Space between NW1s >= 0. 47um") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_S_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["LVNW0"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NWRES"]), s["NODRC"], [], true, {}) }
end
sv_rule("NW1_S_2", "Space between 0.9/1.2V NW1s at different nets >= 1.0um") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_S_2")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["LVNW0"], nil, [["<", 1.0]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => false, :netbase_a => s["NW"]}), s["NWRES"]), s["NODRC"], [], true, {}) }
end
sv_rule("NW1_S_3", "Space between 0.9/1.2V NW1 and 1.8/2.5/3.3V NW1 at different nets. >= 1.20um") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_S_3")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["LVNW0"], s["HVNW0"], [["<", 1.2]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => false, :netbase_a => s["NW"], :netbase_b => s["NW"]}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["LVNW0"], s["MVNW0"], [["<", 1.2]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => false, :netbase_a => s["NW"], :netbase_b => s["NW"]}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["LVNW_RE"], s["MVNW"], [["<", 1.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["LVNW_RE"], s["HVNW"], [["<", 1.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["MVNW_RE"], s["LVNW"], [["<", 1.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["HVNW_RE"], s["LVNW"], [["<", 1.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NW1_S_4", "Space between 1.8/2.5/3.3V NW1s at same nets. >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_S_4")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("ext", s["MVNW0"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => true, :netbase_a => s["NW"]}), s["NWRES"], [], true, {}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("ext", s["HVNW0"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => true, :netbase_a => s["NW"]}), s["NWRES"], [], true, {}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["MVNW0"], s["HVNW0"], [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => true, :netbase_a => s["NW"], :netbase_b => s["NW"]}), s["NODRC"], [], true, {}) }
end
sv_rule("NW1_S_5", "Space between 1.8/2.5/3.3V NW1s at different nets. >= 1.2 um") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_S_5")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["MVNW0"], nil, [["<", 1.2]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => false, :netbase_a => s["NW"]}), s["NWRES"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["HVNW0"], nil, [["<", 1.2]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => false, :netbase_a => s["NW"]}), s["NWRES"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["MVNW0"], s["HVNW0"], [["<", 1.2]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => false, :netbase_a => s["NW"], :netbase_b => s["NW"]}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["MVNW_RE"], s["MVNW"], [["<", 1.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["HVNW_RE"], s["HVNW"], [["<", 1.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["MVNW_RE"], s["HVNW"], [["<", 1.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["HVNW_RE"], s["MVNW"], [["<", 1.2]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NW1_A_1", "NW1 area >= 0.30um2") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_A_1")
  outs << proc { sv_sel_any("inside", sv_area(s["NW"], [["<", 0.3]], false), s["NODRC"], [], true, {}) }
end
sv_rule("NW1_A_2", "Enclosed area >= 0.3um2") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_A_2")
  outs << proc { sv_sel_any("inside", sv_area(sv_bool("NOT", sv_holes(s["NW"], {:inner => true}), s["NW"]), [["<", 0.3]], false), s["NODRC"], [], true, {}) }
end
sv_rule("NW1_R_1", "Floating NW1 is not allowed.") do |outs|
  s = SvScope.new(self, $sv_G, "NW1_R_1")
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["NW"], sv_sel_any("enclose", s["NTAP"], s["CT"], [], false, {}), [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_W_1", "PSUB width >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["PSUB"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_W_2", "0.9/1.2/1.8/2.5/3.3V native NMOS channel width >= 0.50um 0.9/1.2/1.8/2.5/3.3V native NMOS channel width <= 100um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_W_2")
  s.define("X") { sv_length(s["GATE_W"], [["<", 0.5]], false) }
  s.define("Y") { sv_length(s["GATE_W"], [[">", 100.0]], false) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_expand_edge(s["X"], {:inside => 0.005}), s["PSUB"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_expand_edge(s["Y"], {:inside => 0.005}), s["PSUB"]), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_W_3a", "1.2V native NMOS channel length >= 0.20um 1.2V native NMOS channel length <= 100um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_W_3a")
  s.define("X") { sv_esel("inside_edge", sv_esel("inside_edge", s["PBPO"], s["PBAA"], [], false), sv_nary("OR", s["DG"], s["TG"]), [], true) }
  s.define("Y") { sv_length(s["GATE_core_L"], [[">", 100.0]], false) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["X"], nil, [["<", 0.2]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_expand_edge(s["Y"], {:inside => 0.005}), s["PSUB"]), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_W_3b", "1.8V native NMOS channel length >= 0.8um 1.8V native NMOS channel length <= 20um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_W_3b")
  s.define("X") { sv_esel("inside_edge", s["PBPO"], sv_bool("AND", s["PBAA"], s["DG"]), [], false) }
  s.define("Y") { sv_length(s["GATE_io1_L"], [[">", 20.0]], false) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["X"], nil, [["<", 0.8]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_expand_edge(s["Y"], {:inside => 0.005}), s["PSUB"]), s["NODRC"], [], true, {}) }
end
if sv_ifdef("IO", "1825")
  sv_rule("PSUB_W_3c", "2.5V (or overdrive to 3.3V and underdrive to 1.8V) native NMOS channel length >= 1.0um 2.5V (or overdrive to 3.3V and underdrive to 1.8V) native NMOS channel length <= 20.0um") do |outs|
    s = SvScope.new(self, $sv_G, "PSUB_W_3c")
    s.define("X") { sv_esel("inside_edge", s["PBPO"], sv_bool("AND", s["PBAA"], s["TG"]), [], false) }
    s.define("Y") { sv_length(s["GATE_io2_L"], [[">", 20.0]], false) }
    outs << proc { sv_sel_any("inside", sv_check("int", s["X"], nil, [["<", 1.0]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
  end
end
if sv_ifdef("IO", "1833")
  sv_rule("PSUB_W_3d", "3.3V native NMOS channel length >= 1.0um") do |outs|
    s = SvScope.new(self, $sv_G, "PSUB_W_3d")
    s.define("X") { sv_esel("inside_edge", s["PBPO"], sv_bool("AND", s["PBAA"], s["TG"]), [], false) }
    outs << proc { sv_sel_any("inside", sv_check("int", s["X"], nil, [["<", 1.0]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PSUB_S_1", "Space between two PSUBs >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["PSUB"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_S_2", "Space between PSUB and native MOS AA >= 0.36um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_S_2")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["PSUB"], s["MOS"], [["<", 0.36]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["PSUB"], s["AA_LDMOS"], [["<", 0.36]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_S_3", "Space between PSUB and NW >= 1.15um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_S_3")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["PSUB"], s["NW"], [["<", 1.15]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_EN_1", "Native NMOS AA enclosure by PSUB = 0.285um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_EN_1")
  s.define("X") { sv_size(s["PBMOS"], 0.285, {}) }
  s.define("Y") { sv_sel_any("interact", s["PSUB"], s["PBMOS"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_nary("XOR", s["X"], s["Y"]), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_EX_1", "Extension of native NMOS poly GATE outside of AA DRC doesn't flag INDALL covered regions. >= 0.32um") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_EX_1")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("enc", s["PBAA"], s["PBPO"], [["<", 0.32]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}), s["INDALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_R_1", "PSUB inside, overlapping with, or crossing over a DNW area is not allowed") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_R_1")
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["PSUB"], s["DNW"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_esel("inside_edge", sv_esel("coin_outside", s["PSUB"], s["DNW"], [], false), s["NODRC"], [], true) }
end
sv_rule("PSUB_R_2", "It is not allowed PSUB overlap PP ,DRC waive check INDALL covered region, and P+ pickup can be waived.") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_R_2")
  s.define("X") { sv_sel_any("inside", sv_bool("AND", s["SDP"], s["PSUB"]), s["INDALL"], [], true, {}) }
  s.define("Y") { sv_bool("AND", sv_sel_any("interact", sv_bool("OR", s["AA"], s["PO"]), s["GATE"], [], false, {}), s["PSUB"]) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["X"], s["Y"], [], false, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_R_3", "Only one AA pattern is allowed in o PSUB region, except for NMOS capacitors") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_R_3")
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["PSUB"], sv_sel_any("interact", s["AA"], s["INDALL"], [], true, {}), [[">", 1.0]], false, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_A_1", "PSUB area >= 0.60um2") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_A_1")
  outs << proc { sv_sel_any("inside", sv_area(s["PSUB"], [["<", 0.6]], false), s["NODRC"], [], true, {}) }
end
sv_rule("PSUB_A_2", "Enclosed area >= 0.60um2") do |outs|
  s = SvScope.new(self, $sv_G, "PSUB_A_2")
  outs << proc { sv_sel_any("inside", sv_area(sv_bool("NOT", sv_holes(s["PSUB"], {:inner => true}), s["PSUB"]), [["<", 0.6]], false), s["NODRC"], [], true, {}) }
end
sv_rule("NVT3_W_1", "NVT3 width. Single-point-interaction is allowed. >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "NVT3_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["HVTN"], nil, [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NVT3_S_1", "Space between two NVT3s >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "NVT3_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["HVTN"], nil, [["<", 0.18]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NVT3_S_2", "Space between NVT3 and GATE along source/drain direction >= 0.180um") do |outs|
  s = SvScope.new(self, $sv_G, "NVT3_S_2")
  s.define("X") { sv_esel("coin", sv_esel("inside_edge", s["PO"], sv_bool("NOT", s["AA"], s["HVTN"]), [], false), s["GATE"], [], false) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["HVTN"], [["<", 0.18]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}), s["NODRC"], [], true, {}) }
end
sv_rule("NVT3_S_3", "Space between NVT3 and AA along GATE poly direction, excluding SRAM region >= 0.15um") do |outs|
