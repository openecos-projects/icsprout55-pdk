  s = SvScope.new(self, $sv_G, "DG_EN_3")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["GATE_W"], s["DG"], [["<", 0.32]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}), s["NODRC"], [], true, {}) }
end
