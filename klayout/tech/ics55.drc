if sv_ifdef("Density_rules", "YES")
  sv_rule("MET1_D_1_min", "M1 density (including dummy) in 100umX100um window with step size 50um. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking >= 10%") do |outs|
    s = SvScope.new(self, $sv_G, "MET1_D_1_min")
    s.define("check_region_1") { sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", sv_bool("NOT", s["DRC:1"], s["GRID"]), s["SRINGBLK"]), s["INDALL"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_density([s["M1ALLi"]], [["<", 0.1]], {:window => 100.0, :step => 50.0, :backup => true, :inside_of_layer => s["check_region_1"]}) }
  end
  sv_rule("MET1_D_1_max", "M1 density (including dummy) in 100umX100um window with step size 50um. INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking <= 80%") do |outs|
    s = SvScope.new(self, $sv_G, "MET1_D_1_max")
    s.define("check_region_1") { sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", sv_bool("NOT", s["DRC:1"], s["GRID"]), s["SRINGBLK"]), s["INDALL"]), s["NODRC"], [], true, {}) }
    outs << proc { sv_density([s["M1ALLi"]], [[">", 0.8]], {:window => 100.0, :step => 50.0, :backup => true, :inside_of_layer => s["check_region_1"]}) }
  end
  sv_rule("MET1_D_2", "M1 average density inside the {SIZE dummy block BY 2.5um} area in 100umX100um window with step size 50um >= 10%") do |outs|
    s = SvScope.new(self, $sv_G, "MET1_D_2")
    s.define("X") { sv_density([s["M1ALLi"]], [["<", 0.1]], {:window => 100.0, :step => 50.0, :backup => true}) }
    s.define("Y") { sv_size(s["M1DUMB"], 2.5, {}) }
    s.define("Z") { sv_size(s["Y"], 12.5, {:mode => "underover"}) }
    outs << proc { sv_sel_any("inside", sv_bool("AND", s["X"], s["Z"]), s["NODRC"], [], true, {}) }
  end
  sv_rule("MET1_D_3", "The difference between M1 density in 100x100 window (including dummy) INDALL/GRID/SRINGBLK covered areas are excluded for this rule checking <= 20%") do |outs|
    s = SvScope.new(self, $sv_G, "MET1_D_3")
    s.define("X") { sv_density([s["M1ALLi"]], [[">=", 0.0]], {:window => 100.0, :gradient => [[">", 0.2]], :absolute => true, :backup => true, :inside_of_layer => s["density_checkarea"]}) }
    outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_bool("NOT", sv_bool("NOT", s["X"], s["GRID"]), s["SRINGBLK"]), s["INDALL"]), s["NODRC"], [], true, {}) }
  end
end
