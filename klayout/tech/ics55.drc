  s.define("BUTSDN_1") { sv_esel("with_edge", sv_sel_any("interact", s["NACT"], s["NW"], [], false, {}), s["BUTNA_ED_1"], [], false) }
  s.define("POSDP_1") { sv_esel("coin", sv_esel("inside_edge", s["PO"], sv_sel_any("touch", s["PACT"], s["NACT"], [], false, {}), [], false), s["PGATE"], [], false) }
  s.define("POSDP") { sv_esel("touch_edge", sv_esel("with_edge", s["PO"], s["POSDP_1"], [], false), s["PGATE"], [], false) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["BUTSDN_1"], s["POSDP"], [["<", 0.3]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
