  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["POR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("POLYres_S_1b:NP", "Space between P type PO resistors and NP, PP, NPR, HRP, ESD (follow GT.10 rule) >= 0.18um") do |outs|
