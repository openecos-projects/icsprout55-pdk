  outs << proc { sv_sel_any("inside", sv_check("enc", s["NW"], s["NW1res"], [["<", 0.2]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NWresSTI_EX_2", "AA extention outside of NW resistor >= 0.28um") do |outs|
