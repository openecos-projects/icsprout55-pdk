  s = SvScope.new(self, $sv_G, "TG_S_5")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["TG"], s["PSUB"], [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_S_6", "Space between TG and DG >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_S_6")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["TG"], s["DG"], [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true, :inside_also => true}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_EN_1", "Enclosure of AA by TG(except pickup AA) >= 0.25um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_EN_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["MOS"], s["TG"], [["<", 0.25]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_EN_2", "Enclosure of GATE along GATE poly direction >= 0.25um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_EN_2")
  s.define("X") { sv_esel("touch_edge", s["MOS"], sv_sel_any("inside", s["GATE"], s["TG"], [], false, {}), [], false) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["X"], s["TG"], [["<", 0.25]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_EN_3", "Enclosure of GATE by TG, along source/drain direction >= 0.32um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_EN_3")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["GATE_W"], s["TG"], [["<", 0.32]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_EX_1", "NW extention on TG, Extention = 0 is allowed >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_EX_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["TG"], s["NW"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_EX_2", "TG extension on NW, Extention = 0 is allowed >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_EX_2")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["NW"], s["TG"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_EX_3", "TG extension of PSUB, Extention = 0 is allowed >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_EX_3")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["PSUB"], s["TG"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_O_1", "Overlap of TG and NW, overlap = 0 is allowed >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_O_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["TG"], s["NW"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("TG_O_2", "Overlap of TG and PSUB, overlap = 0 is allowed >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "TG_O_2")
  outs << proc { sv_sel_any("inside", sv_check("int", s["TG"], s["PSUB"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_W_1", "PO width >=0.06 um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["PO"], nil, [["<", 0.06]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_W_2a", "Channel length for 0.9/1.2V NMOS/PMOS transistors >= 0.06um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_W_2a")
  s.define("X") { sv_esel("inside_edge", s["PO"], sv_bool("NOT", s["AA"], sv_bool("OR", s["DG"], s["TG"])), [], false) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["X"], nil, [["<", 0.06]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_W_2b", "Channel length for 1.8V NMOS/PMOS transistors >= 0.20um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_W_2b")
  s.define("X") { sv_esel("inside_edge", s["PO"], sv_bool("AND", s["AA"], s["DG"]), [], false) }
  s.define("Y") { sv_check("int", s["X"], nil, [["<", 0.2]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("IO", "1825")
  sv_rule("PO_W_2c", "Channel length for 2.5V NMOS/PMOS transistors >= 0.28um") do |outs|
    s = SvScope.new(self, $sv_G, "PO_W_2c")
    s.define("X") { sv_esel("inside_edge", s["PO"], sv_sel_any("interact", sv_bool("AND", s["AA"], s["TG"]), s["UD"], [], true, {}), [], false) }
    s.define("Y") { sv_check("int", s["X"], nil, [["<", 0.28]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
if sv_ifdef("IO", "1833")
  sv_rule("PO_W_2d", "Min Channel length for 3.3V NMOS transistors is 0.38 Min Channel length for 3.3V PMOS transistors is 0.38") do |outs|
    s = SvScope.new(self, $sv_G, "PO_W_2d")
    s.define("X") { sv_esel("inside_edge", sv_bool("AND", s["PO"], s["SDN"]), sv_bool("AND", s["AA"], s["TG"]), [], false) }
    s.define("Y") { sv_check("int", s["X"], nil, [["<", 0.38]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
    s.define("X1") { sv_esel("inside_edge", sv_bool("AND", s["PO"], s["SDP"]), sv_bool("AND", s["AA"], s["TG"]), [], false) }
    s.define("Y1") { sv_check("int", s["X1"], nil, [["<", 0.38]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y1"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
if sv_ifdef("IO", "1825")
  sv_rule("PO_W_2f", "Channel length for 2.5V NMOS/PMOS transistors (over drive to 3.3V and 4.1V) >= 0.50(NMOS)um >= 0.40(PMOS)um") do |outs|
    s = SvScope.new(self, $sv_G, "PO_W_2f")
    s.define("X") { sv_esel("inside_edge", s["PO"], sv_bool("AND", sv_bool("AND", s["NACT"], s["TG"]), s["OD"]), [], false) }
    s.define("Y") { sv_esel("inside_edge", s["PO"], sv_bool("AND", sv_bool("AND", s["PACT"], s["TG"]), s["OD"]), [], false) }
    s.define("Z1") { sv_check("int", s["X"], nil, [["<", 0.5]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
    s.define("Z2") { sv_check("int", s["Y"], nil, [["<", 0.4]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Z1"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Z2"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("PO_W_2e", "Channel length for 2.5V NMOS/PMOS transistors (under drive to 1.8V) >= 0.22um") do |outs|
    s = SvScope.new(self, $sv_G, "PO_W_2e")
    s.define("X") { sv_esel("inside_edge", s["PO"], sv_bool("AND", sv_bool("AND", s["AA"], s["TG"]), s["UD"]), [], false) }
    s.define("Y") { sv_check("int", s["X"], nil, [["<", 0.22]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_W_3", "Width of 45 degree PO >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_W_3")
  s.define("PO_CHECK") { sv_sel_any("inside", s["PO"], sv_bool("OR", s["AA"], s["AADUM"]), [], true, {}) }
  s.define("X") { sv_angle(s["PO_CHECK"], [["==", 45.0]], false) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["X"], nil, [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_S_1", "Space between two POs DRC waive check the INDALL covered region. >= 0.12um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_1")
  s.define("X") { sv_check("ext", s["PO"], nil, [["<", 0.12]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["X"], sv_bool("OR", s["SRAMALL"], s["INDALL"]), [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_S_2", "Space between two POs when one or both PO width is > 0.13um, and the run length of two POs is > 0.18um. >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_2")
  s.define("PO_W") { sv_with_width(s["PO"], [[">", 0.13]], false) }
  s.define("PO_S") { sv_check("ext", s["PO_W"], s["PO"], [["<", 0.18]], {:metric => "opposite", :region => true, :parallel => "only"}) }
  s.define("PO_LS") { sv_length(s["PO_S"], [[">", 0.18]], false) }
  outs << proc { sv_esel("inside_edge", sv_esel("with_edge", s["PO_S"], s["PO_LS"], [], false), s["NODRC"], [], true) }
end
sv_rule("PO_S_3", "Space between two POs on AA DRC waive check the INDALL covered region. >= 0.13um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_3")
  s.define("X") { sv_esel("coin", sv_bool("AND", s["AA"], s["PO"]), s["PO"], [], false) }
  s.define("Y") { sv_check("ext", s["X"], nil, [["<", 0.13]], {:abut => [["<", 90.0]], :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["INDALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
$sv_G.define("EMPTY") { sv_input([[999, 1111]]) }
$sv_G.define("PO_EMPTY") { sv_bool("OR", $sv_G["EMPTY"], sv_bool("AND", $sv_G["PO"], $sv_G["AA"])) }
$sv_G.define("AA_EMPTY") { sv_bool("OR", $sv_G["EMPTY"], $sv_G["AA"]) }
sv_connect(["PO_EMPTY", "AA_EMPTY"], nil)
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_S_4_R", "Recommended Space between POs on the same AA DRC waive check if no contacts between two POs, and waive check the INDALL covered region. >= 0.2um") do |outs|
    s = SvScope.new(self, $sv_G, "PO_S_4_R")
    s.define("X") { sv_check("ext", s["PO_EMPTY"], nil, [["<", 0.2]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => true, :netbase_a => s["PO_EMPTY"]}) }
    s.define("Y") { sv_sel_any("interact", s["X"], s["CT"], [], false, {}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], sv_bool("OR", s["INDALL"], s["SRAMALL"]), [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_S_5", "Space between POs on the same AA inside TG DRC waive check if no contacts between two POs, and waive check the INDALL covered region. >= 0.24um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_5")
  s.define("X") { sv_check("ext", sv_bool("AND", s["PO_EMPTY"], s["TG"]), nil, [["<", 0.24]], {:abut => [["<", 90.0]], :singular => true, :region => true, :connected => true, :netbase_a => s["PO_EMPTY"]}) }
  s.define("Y") { sv_sel_any("interact", s["X"], s["CT"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], sv_bool("OR", s["INDALL"], s["SRAMALL"]), [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_S_6", "Space to 45-degree PO, except EFUSEALL and FUSEALL region. >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_6")
  s.define("PO_CHECK") { sv_sel_any("inside", s["PO"], sv_nary("OR", s["EFUSEALL"], s["AA"], s["AADUM"]), [], true, {}) }
  s.define("X") { sv_esel("inside_edge", sv_angle(s["PO_CHECK"], [["==", 45.0]], false), s["EFUSEALL"], [], true) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("inside", sv_check("ext", s["X"], sv_sel_any("inside", s["PO"], s["EFUSEALL"], [], true, {}), [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["EFUSEALL"], [], true, {}), s["FUSEALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_S_7", "GATE space when L-shape AA and L-shape PO enclosed area is < 0.012um2 >= 0.15um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_7")
  s.define("X") { sv_bool("OR", s["AA_LS"], s["PO_LS"]) }
  s.define("Y") { sv_area(sv_holes(s["X"], {:inner => true}), [["<", 0.012]], false) }
  s.define("Z") { sv_sel_any("interact", s["GATE"], s["Y"], [], false, {:singular => "only"}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", sv_check("ext", s["Z"], nil, [["<", 0.15]], {:abut => [["<", 90.0]], :region => true}), s["Y"], [], false, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_S_7a_R", "Recommended GATE space when L-shape AA and L-shape PO enclosed area is < 0.0196um2 >= 0.2um") do |outs|
    s = SvScope.new(self, $sv_G, "PO_S_7a_R")
    s.define("X") { sv_bool("OR", s["AA_LS"], s["PO_LS"]) }
    s.define("Y") { sv_area(sv_holes(s["X"], {:inner => true}), [["<", 0.0196]], false) }
    s.define("Z") { sv_sel_any("interact", s["GATE"], s["Y"], [], false, {:singular => "only"}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", sv_check("ext", s["Z"], nil, [["<", 0.2]], {:abut => [["<", 90.0]], :region => true}), s["Y"], [], false, {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("PO_S_8_R", "Recommended space of GATE (channel length <= 0.08um) to neighboring poly for thr CDU control <= 1.0") do |outs|
    s = SvScope.new(self, $sv_G, "PO_S_8_R")
    s.define("X") { sv_length(s["GATE_L"], [["<=", 0.08]], false) }
    s.define("Y") { sv_sel_any("inside", sv_sel_any("interact", s["GATE"], sv_expand_edge(s["X"], {:outside => 0.001}), [], false, {}), s["SRAMALL"], [], true, {}) }
    s.define("Z") { sv_esel("inside_edge", s["Y"], s["AA"], [], false) }
    s.define("A") { sv_expand_edge(s["Z"], {:outside => 1.0}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["A"], s["PO"], [[">", 1.0]], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_S_9", "Space at PO line end(PO width <0.09um), in the dense line end configuration: if PO has parallel run length with opposite PO along 2 adjacent edge of PO(any one edge < 0.09um distance from the conner of the 2 edges), then one of the space need to bigger than 0.14") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_9")
  s.define("LINE_END") { sv_convex_edge(s["PO"], {:angle1 => [["==", 90.0]], :angle2 => [["==", 90.0]], :length => [["<", 0.09]]}) }
  s.define("LINE_END_SP") { sv_check("ext", s["LINE_END"], s["PO"], [["<", 0.14]], {:abut => [["<", 90.0]], :metric => "opposite", :out => 1.0}) }
  s.define("LINE_SIDE") { sv_esel("touch_inside_edge", s["LINE_END"], s["LINE_END_SP"], [], false) }
  s.define("LINE_END_PO") { sv_check("int", s["LINE_SIDE"], s["PO"], [["<", 0.09]], {:abut => [["==", 90.0]], :intersecting => "only", :out => 2.0}) }
  s.define("LINE_END_PO_006") { sv_length(s["LINE_END_PO"], [[">=", 0.06]], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("ext", s["LINE_END_PO_006"], s["PO"], [["<", 0.14]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_S_11", "Space between AA and PO on STI >= 0.05um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_11")
  s.define("X") { sv_check("ext", s["AA"], s["PO"], [["<", 0.05]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("inside", s["X"], sv_bool("OR", s["AA"], s["AADUM"]), [], true, {}), sv_bool("OR", s["SRAMALL"], s["INDALL"]), [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("PO_S_12", "Minimum space of PO within SAB >=0.25") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_12")
  s.define("PO_SAB") { sv_sel_any("outside", s["PO"], s["SAB"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["PO_SAB"], nil, [["<", 0.25]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
end
$sv_G.define("AAconer") { sv_check("ext", $sv_G["AA"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :intersecting => "only", :region => true}) }
$sv_G.define("POconer") { sv_check("ext", $sv_G["PO"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :intersecting => "only", :region => true}) }
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_S_13_R", "Strongly suggest the minimum space of GATE to neighboring poly for sensitive circuit with minimum PO width = 0.06um, >=0.19") do |outs|
    s = SvScope.new(self, $sv_G, "PO_S_13_R")
    s.define("X") { sv_with_width(s["GATE"], [["==", 0.06]], false) }
    outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["PO"], [["<", 0.19]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_S_14", "Min space between L-shape AA to PO in the same MOS when channel width <0.15um is 0.1.") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_14")
  s.define("A") { sv_check("ext", s["AA_CP"], s["PO_CP"], [["<", 0.1]], {:metric => "opposite", :region => true, :connected => true, :netbase_a => s["AA_CP"], :netbase_b => s["PO_CP"]}) }
  outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_sel_any("interact", sv_sel_any("interact", s["A"], s["AAcorner"], [], false, {}), s["GATE_WIDTH_D15"], [], false, {}), s["SRAMALL"], [], true), s["NODRC"], [], true) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_S_14a_R", "Min space between L-shape AA to PO in the same MOS when channel width >= 0.15um is 0.1.") do |outs|
    s = SvScope.new(self, $sv_G, "PO_S_14a_R")
    s.define("A") { sv_check("ext", s["AA_CP"], s["PO_CP"], [["<", 0.1]], {:metric => "opposite", :region => true, :connected => true, :netbase_a => s["AA_CP"], :netbase_b => s["PO_CP"]}) }
    outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_sel_any("interact", sv_sel_any("interact", s["A"], s["AAcorner"], [], false, {}), s["GATE_WIDTH_U15"], [], false, {}), s["SRAMALL"], [], true), s["NODRC"], [], true) }
  end
end
sv_rule("PO_S_15", "Min space between L-shape PO to AA in the same MOSwhen channel width < 0.15um is 0.1.") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_15")
  s.define("A") { sv_check("ext", s["PO015"], s["AAintPO015"], [["<", 0.1]], {:metric => "opposite", :region => true, :connected => true, :netbase_a => s["PO015"], :netbase_b => s["AAintPO015"]}) }
  outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_sel_any("interact", sv_sel_any("interact", s["A"], s["POcorner"], [], false, {}), s["GATE_WIDTH_D15"], [], false, {}), s["SRAMALL"], [], true), s["NODRC"], [], true) }
end
sv_rule("PO_S_16", "Space between large PO and GATE with narrow channel length <= 0.08um The large PO definition: PO area >= 630um2 and within regions of density > 70% in window 30um x 30um, stepping 15um. Dummy poly isnBFt included in the density check. >= 1.00um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_S_16")
  s.define("Density_region") { sv_density([s["POLYi"]], [[">", 0.7]], {:window => 30.0, :step => 15.0}) }
  s.define("Large_PO") { sv_sel_any("inside", sv_area(s["POLYi"], [[">=", 630.0]], false), s["Density_region"], [], false, {}) }
  s.define("GATE_check") { sv_esel("with_edge", s["GATE"], sv_length(s["GATE_LE"], [["<=", 0.08]], false), [], false) }
  s.define("GATE_LE") { sv_esel("coin", sv_esel("touch_edge", s["GATE"], sv_check("int", s["GATE_W"], s["GATE"], [["<", 0.005]], {:abut => [["<", 180.0]], :intersecting => "only", :out => 2.0}), [], false), s["GATE_W"], [], true) }
  outs << proc { sv_check("ext", s["Large_PO"], s["GATE_check"], [["<", 1.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_S_18_R", "Recommended core nmos gate space to (TG OR (NW OR PSUB), >=1.0") do |outs|
    s = SvScope.new(self, $sv_G, "PO_S_18_R")
    s.define("CHECK_GATE") { sv_bool("AND", s["GATE_core"], s["SDN"]) }
    s.define("CHECK_WELL") { sv_nary("OR", s["TG"], s["NW"], s["PSUB"]) }
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", sv_check("ext", s["CHECK_GATE"], s["CHECK_WELL"], [["<", 1.0]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_EN_1_R", "Recommended core pmos gate enclose by (NW NOT TG), >=1.0") do |outs|
    s = SvScope.new(self, $sv_G, "PO_EN_1_R")
    s.define("CHECK_GATE") { sv_bool("NOT", sv_bool("AND", s["GATE_core"], s["SDP"]), s["TG"]) }
    s.define("CHECK_WELL") { sv_bool("NOT", s["NW"], s["TG"]) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("enc", s["CHECK_GATE"], s["CHECK_WELL"], [["<", 1.0]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("PO_EN_2_R", "Recommended IO nmos gate enclose by (TG NOT (NW OR PSUB)), >=2.0") do |outs|
    s = SvScope.new(self, $sv_G, "PO_EN_2_R")
    s.define("CHECK_GATE") { sv_bool("AND", sv_bool("AND", s["GATE"], s["SDN"]), s["TG"]) }
    s.define("CHECK_WELL") { sv_bool("NOT", s["TG"], s["NW"]) }
    outs << proc { sv_sel_any("inside", sv_check("enc", s["CHECK_GATE"], s["CHECK_WELL"], [["<", 2.0]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}), s["NODRC"], [], true, {}) }
  end
  sv_rule("PO_EN_3_R", "Recommended IO pmos gate enclose by (TG AND NW), >=2.0") do |outs|
    s = SvScope.new(self, $sv_G, "PO_EN_3_R")
    s.define("CHECK_GATE") { sv_bool("AND", sv_bool("AND", s["GATE"], s["SDP"]), s["TG"]) }
    s.define("CHECK_WELL") { sv_bool("AND", s["TG"], s["NW"]) }
    outs << proc { sv_sel_any("inside", sv_check("enc", s["CHECK_GATE"], s["CHECK_WELL"], [["<", 2.0]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_EX_1", "Extension of AA outside of PO >= 0.11um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_EX_1")
  s.define("X") { sv_check("enc", s["PO"], sv_esel("coin", s["AA"], s["LDMOSSTI"], [], true), [["<", 0.11]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["INDALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_EX_1_R", "Recommended Extension of AA outside of PO(when channel width >1 um) >= 0.18um") do |outs|
    s = SvScope.new(self, $sv_G, "PO_EX_1_R")
    s.define("X") { sv_length(sv_esel("inside_edge", s["GATE"], s["AA"], [], false), [[">=", 1.0]], false) }
    s.define("Y") { sv_esel("with_edge", s["PO"], s["X"], [], false) }
    s.define("Z") { sv_check("enc", s["Y"], sv_sel_any("touch", s["AA"], s["LDMOSSTI"], [], true, {}), [["<", 0.18]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("inside", s["Z"], s["SRAMALL"], [], true, {}), s["INDALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_EX_2", "Extension of GATE poly outside of AA >= 0.14um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_EX_2")
  s.define("Y") { sv_check("enc", s["AA"], s["PO"], [["<", 0.14]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
  s.define("Z") { sv_check("ext", s["PO"], nil, [["<", 0.002]], {:abut => [["==", 90.0]], :region => true, :intersecting => "only"}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("touch", s["Y"], s["Z"], [], true, {}), s["SRAMALL"], [], true, {}), s["LDMOS"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_EX_3_R", "PO end-cap extension of AA when: 1. PO space to L-shape AA in the same MOS is < 0.14um 2. GATE channel width (W) is >= 0.15um DRC only check the L-shape opposite side PO end-cap. >= 0.16um") do |outs|
    s = SvScope.new(self, $sv_G, "PO_EX_3_R")
    s.define("A") { sv_check("enc", s["AA"], s["PO"], [["<", 0.16]], {:metric => "opposite", :region => true}) }
    s.define("X") { sv_length(s["GATE_W"], [[">=", 0.15]], false) }
    s.define("Y") { sv_esel("with_edge", s["GATE"], s["X"], [], false) }
    s.define("B") { sv_check("ext", s["Y"], s["AA"], [["<", 0.14]], {:abut => [["==", 90.0]], :perp => "only", :region => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_esel("with_edge", s["A"], sv_esel("touch_edge", s["A"], s["B"], [], false), [], false), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_L_1", "PO length between two CTs without GATE, and the length from any point inside GATE to nearest CT, when the PO width is < 0.13um This rule is for voltage drop concern. DRC waive check ESDIOE covered region. <= 25.00um") do |outs|
  s = SvScope.new(self, $sv_G, "PO_L_1")
  s.define("PO_CHECK") { sv_sel_any("interact", sv_bool("NOT", sv_with_width(s["PO"], [["<", 0.13]], false), s["GATE"]), s["CT"], [], false, {}) }
  s.define("Z0") { sv_size(s["CT"], 12.5, {:inside_of => s["PO_CHECK"], :step => 0.02}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("interact", s["PO_CHECK"], s["Z0"], [[">", 1.0]], false, {}), s["ESDIOE"], [], true, {}), s["NODRC"], [], true, {}) }
  s.define("PO_CHECK1") { sv_bool("NOT", sv_sel_any("interact", s["PO"], s["CT"], [], false, {}), s["GATE"]) }
  s.define("Z4") { sv_sel_any("interact", sv_bool("NOT", sv_check("int", s["PO_CHECK1"], nil, [["<", 0.13]], {:metric => "opposite", :region => true}), s["GATE"]), s["CT"], [], true, {}) }
  s.define("Z6") { sv_length(s["Z4"], [[">", 25.0]], false) }
  outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", s["Z6"], s["ESDIOE"], [], true), s["NODRC"], [], true) }
  s.define("X") { sv_esel("with_edge", s["GATE"], sv_length(s["GATE_L"], [["<", 0.13]], false), [], false) }
  s.define("Y") { sv_sel_any("interact", sv_sel_any("interact", s["PO"], s["X"], [], false, {}), s["CT"], [], false, {}) }
  s.define("Z") { sv_size(s["CT"], 25.0, {:inside_of => s["Y"], :step => 0.02}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("interact", s["GATE"], s["Y"], [], false, {}), s["Z"], [], true, {}), s["ESDIOE"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_L_2_R", "Recommanded maximum L shape length of L-shape AA which space to PO (in the same MOS with width >= 0.15um) <= 0.1 is <=0.21") do |outs|
    s = SvScope.new(self, $sv_G, "PO_L_2_R")
    s.define("PO_CHECK") { sv_expand_edge(sv_length(s["GATE_W"], [[">=", 0.15]], false), {:inside => 0.001}) }
    s.define("POmergeAA") { sv_sel_any("interact", sv_bool("OR", s["PO"], s["AA"]), s["PO_CHECK"], [], false, {}) }
    s.define("L_edge") { sv_convex_edge(s["POmergeAA"], {:angle1 => [["==", 90.0]], :angle2 => [["==", 270.0]]}) }
    s.define("L_edge_") { sv_expand_edge(s["L_edge"], {:inside => 0.001}) }
    s.define("LAA_") { sv_sel_any("touch", s["L_edge_"], s["AAconer"], [["==", 1.0]], false, {}) }
    s.define("LAA") { sv_esel("coin", s["L_edge"], s["LAA_"], [], false) }
    s.define("X") { sv_length(s["LAA"], [[">", 0.21]], false) }
    s.define("Y") { sv_check("ext", s["X"], s["PO"], [["<", 0.1]], {:region => true}) }
    outs << proc { sv_esel("inside_edge", sv_esel("coin", s["X"], s["Y"], [], false), s["NODRC"], [], true) }
  end
end
if sv_ifdef("Density_rules", "YES")
  sv_rule("PO_D_1_min", "Global PO density for fully chip (including dummy) >= 14%") do |outs|
    s = SvScope.new(self, $sv_G, "PO_D_1_min")
    outs << proc { sv_sel_any("inside", sv_density([s["PO_all"]], [["<", 0.14]], {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("PO_D_1_max", "Global PO density for fully chip (including dummy) <= 40%") do |outs|
    s = SvScope.new(self, $sv_G, "PO_D_1_max")
    outs << proc { sv_sel_any("inside", sv_density([s["PO_all"]], [[">", 0.4]], {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("PO_D_2_min", "Local PO density (including dummy) in 100um*100um window with step size: 50um >= 20%") do |outs|
    s = SvScope.new(self, $sv_G, "PO_D_2_min")
    outs << proc { sv_sel_any("inside", sv_density([s["PO_all"]], [["<", 0.2]], {:window => 100.0, :step => 50.0, :backup => true}), s["NODRC"], [], true, {}) }
  end
  sv_rule("PO_D_2_max", "Local PO density (including dummy) in 100um*100um window with step size: 50um <= 65%") do |outs|
    s = SvScope.new(self, $sv_G, "PO_D_2_max")
    outs << proc { sv_sel_any("inside", sv_density([s["PO_all"]], [[">", 0.65]], {:window => 100.0, :step => 50.0, :backup => true}), s["NODRC"], [], true, {}) }
  end
  sv_rule("PO_D_3", "The poly density difference between any two neighboring checking windows <= 20%") do |outs|
    s = SvScope.new(self, $sv_G, "PO_D_3")
    outs << proc { sv_sel_any("inside", sv_density([s["PO_all"]], [[">=", 0.0]], {:window => 100.0, :gradient => [[">", 0.2]], :absolute => true, :backup => true, :inside_of_layer => s["BULK"]}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_A_1", "PO area >= 0.04um2") do |outs|
  s = SvScope.new(self, $sv_G, "PO_A_1")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_area(s["PO"], [["<", 0.04]], false), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("PO_A_1_R", "PO area when PO is not GATE poly. >= 0.05um2") do |outs|
    s = SvScope.new(self, $sv_G, "PO_A_1_R")
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_area(sv_sel_any("interact", s["PO"], s["GATE"], [], true, {}), [["<", 0.05]], false), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("PO_A_2", "PO enclosed area >= 0.09um2") do |outs|
  s = SvScope.new(self, $sv_G, "PO_A_2")
  outs << proc { sv_sel_any("inside", sv_area(sv_bool("NOT", sv_holes(s["PO"], {:inner => true}), s["PO"]), [["<", 0.09]], false), s["NODRC"], [], true, {}) }
end
sv_rule("PO_R_1", "No bent PO on AA is allowed.All PO patterns on AA have to be orthogonal to AA edage. DRC waive check the INDALL and SRAMALL covered region, and waive check (AA AND PO) width <= 0.01um pattern.") do |outs|
  s = SvScope.new(self, $sv_G, "PO_R_1")
  s.define("POEIAA1") { sv_with_width(sv_bool("AND", s["PO"], s["AA"]), [[">", 0.01]], false) }
  outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", sv_convex_edge(s["POEIAA1"], {:count => [["<", 2.0]]}), sv_bool("OR", s["INDALL"], s["SRAMALL"]), [], true), s["NODRC"], [], true) }
end
sv_rule("PO_R_2", "PO must be enclosed by NP and/or PP.") do |outs|
  s = SvScope.new(self, $sv_G, "PO_R_2")
  s.define("HRPR") { sv_sel_any("interact", s["PO"], s["HPR"], [], false, {}) }
  s.define("HRP_END") { sv_size(sv_bool("NOT", s["HRPR"], s["HPR"]), 0.3, {}) }
  s.define("PO_MID") { sv_bool("NOT", sv_sel_any("interact", s["PO"], sv_bool("OR", s["HPR"], s["HRP"]), [], false, {}), s["HRP_END"]) }
  s.define("Y") { sv_sel_any("interact", sv_bool("NOT", sv_bool("NOT", sv_bool("NOT", sv_sel_any("interact", s["PO"], s["CT"], [], false, {}), s["PO_MID"]), s["SDP"]), s["SDN"]), s["MOMLVS1"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_W_1", "NP width. Single-point-interaction is allowed. >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "NP_W_1")
  outs << proc { sv_sel_any("inside", sv_check("int", s["SDN"], nil, [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_S_1", "Space between two NPs. >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "NP_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["SDN"], nil, [["<", 0.18]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_S_2", "Space between NP and P+ AA inside NW >= 0.12um") do |outs|
  s = SvScope.new(self, $sv_G, "NP_S_2")
  s.define("X") { sv_esel("touch_edge", sv_bool("NOT", s["PACT"], s["PTAP"]), s["SDN"], [], true) }
  s.define("Y") { sv_check("ext", s["SDN"], s["X"], [["<", 0.12]], {:abut => [["<", 90.0]], :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_S_3", "Space between NP and P+ pick-up AA inside PW >= 0.02um") do |outs|
