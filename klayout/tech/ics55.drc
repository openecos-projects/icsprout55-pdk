$sv_G.define("M7SL") { sv_sel_any("interact", sv_holes($sv_G["MET7o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("M8SL") { sv_sel_any("interact", sv_holes($sv_G["MET8o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("T2M1SL") { sv_sel_any("interact", sv_holes($sv_G["T2M1o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("T2M2SL") { sv_sel_any("interact", sv_holes($sv_G["T2M2o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("T4M1SL") { sv_sel_any("interact", sv_holes($sv_G["T4M1o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("T4M2SL") { sv_sel_any("interact", sv_holes($sv_G["T4M2o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("T8M1SL") { sv_sel_any("interact", sv_holes($sv_G["T8M1o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("T8M2SL") { sv_sel_any("interact", sv_holes($sv_G["T8M2o"], {:empty => true}), $sv_G["COVER"], [], false, {}) }
$sv_G.define("M1PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["MET1o"], $sv_G["COVER"], [], false, {}), $sv_G["M1SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("M2PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["MET2o"], $sv_G["COVER"], [], false, {}), $sv_G["M2SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("M3PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["MET3o"], $sv_G["COVER"], [], false, {}), $sv_G["M3SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("M4PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["MET4o"], $sv_G["COVER"], [], false, {}), $sv_G["M4SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("M5PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["MET5o"], $sv_G["COVER"], [], false, {}), $sv_G["M5SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("M6PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["MET6o"], $sv_G["COVER"], [], false, {}), $sv_G["M6SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("M7PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["MET7o"], $sv_G["COVER"], [], false, {}), $sv_G["M7SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("M8PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["MET8o"], $sv_G["COVER"], [], false, {}), $sv_G["M8SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("T2M1PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["T2M1"], $sv_G["COVER"], [], false, {}), $sv_G["T2M1SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("T2M2PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["T2M2"], $sv_G["COVER"], [], false, {}), $sv_G["T2M2SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("T4M1PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["T4M1"], $sv_G["COVER"], [], false, {}), $sv_G["T4M1SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("T4M2PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["T4M2"], $sv_G["COVER"], [], false, {}), $sv_G["T4M2SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("T8M1PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["T8M1"], $sv_G["COVER"], [], false, {}), $sv_G["T8M1SL"]), 21.499, {:mode => "underover"}) }
$sv_G.define("T8M2PAD") { sv_size(sv_bool("OR", sv_sel_any("interact", $sv_G["T8M2"], $sv_G["COVER"], [], false, {}), $sv_G["T8M2SL"]), 21.499, {:mode => "underover"}) }
sv_rule("COVER_W_1", "COVER width (suggest to consult with package vendor) >= 40.0um") do |outs|
  s = SvScope.new(self, $sv_G, "COVER_W_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("int", s["RDLPA2"], nil, [["<", 39.998]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), sv_nary("OR", s["SRBLK"], s["SRINGBLK"], s["NODRC"]), [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("int", s["RDLPA2"], nil, [["<", 39.998]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), sv_nary("OR", s["SRBLK"], s["SRINGBLK"], s["NODRC"]), [], true, {}) }
end
sv_rule("COVER_L_1", "COVER length (suggest to consult with package vendor) >= 65.0um") do |outs|
  s = SvScope.new(self, $sv_G, "COVER_L_1")
  outs << proc { sv_sel_any("inside", sv_enclose_rect(s["RDLPA2"], 40.0, 65.0, {:neg => true}), sv_nary("OR", s["SRBLK"], s["SRINGBLK"], s["NODRC"]), [], true, {}) }
end
sv_rule("COVER_S_1", "Covers space (suggest to consult with package vendor) >= 5.0um") do |outs|
  s = SvScope.new(self, $sv_G, "COVER_S_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["RDLPA2"], nil, [["<", 4.998]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), sv_nary("OR", s["SRBLK"], s["SRINGBLK"], s["NODRC"]), [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("ext", s["RDLPA2"], nil, [["<", 4.998]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), sv_nary("OR", s["SRBLK"], s["SRINGBLK"], s["NODRC"]), [], true, {}) }
end
sv_rule("COVER_S_2", "Space between metal pad and metal line >= 2.5um") do |outs|
  s = SvScope.new(self, $sv_G, "COVER_S_2")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["T8M2PAD"], s["T8M2o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["T8M1PAD"], s["T8M1o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["T4M2PAD"], s["T4M2o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["T4M1PAD"], s["T4M1o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["T2M2PAD"], s["T8M2o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["T2M1PAD"], s["T8M1o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M1PAD"], s["MET1o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M2PAD"], s["MET2o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M3PAD"], s["MET3o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M4PAD"], s["MET4o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M5PAD"], s["MET5o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M6PAD"], s["MET6o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M7PAD"], s["MET7o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("ext", s["M8PAD"], s["MET8o"], [["<", 2.5]], {:abut => [[">", 0.0], ["<", 90.0]], :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
sv_rule("COVER_EN_1", "Cover enclosed by ALPAD >= 1.5um") do |outs|
  s = SvScope.new(self, $sv_G, "COVER_EN_1")
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_check("enc", s["RDLPA2"], s["ALPA"], [["<", 1.5]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_check("enc", s["RDLPA2"], s["ALPA"], [["<", 1.498]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["INDALL"]), s["NODRC"], [], true, {}) }
end
