  outs << proc { sv_sel_any("inside", sv_check("ext", s["SDN"], s["Y"], [["<", 0.02]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_S_4", "Space between NP and butted P+AA (except SRAM area). = 0.00um") do |outs|
