  outs << proc { sv_sel_any("inside", sv_check("ext", s["DG"], s["AA_LDMOS"], [["<", 0.25]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DG_S_3", "Space between DG and GATE, overlap is not allowed >= 0.32um") do |outs|
  s = SvScope.new(self, $sv_G, "DG_S_3")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["DG"], s["GATE"], [["<", 0.32]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DG_S_4", "Space between DG and NW >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "DG_S_4")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["NW"], s["DG"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DG_S_5", "Space between DG and PSUB >= 0.47um") do |outs|
  s = SvScope.new(self, $sv_G, "DG_S_5")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["PSUB"], s["DG"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DG_EN_1", "Enclosure of AA by DG(Except pick-up AA) >= 0.25um") do |outs|
  s = SvScope.new(self, $sv_G, "DG_EN_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", sv_bool("NOT", s["AA"], sv_bool("OR", s["NTAP"], s["PTAP"])), s["DG"], [["<", 0.25]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("DG_EN_2", "Enclosure of AA by DG along GATE poly direction >= 0.25um") do |outs|
