  s.define("Y") { sv_check("ext", s["X"], s["SDN"], [["<", 0.3]], {:abut => [["<", 90.0]], :metric => "opposite", :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_S_6", "Butted P+ pick-up AA space to PO in the same AA (the butted N+AA extending <0.16um) is 0.3") do |outs|
  s = SvScope.new(self, $sv_G, "NP_S_6")
  s.define("NACTL") { sv_esel("touch_inside_edge", s["NACT"], s["NGATE"], [], false) }
  s.define("NACTL_EP") { sv_expand_edge(s["NACTL"], {:outside => 0.16, :extend => 0.01}) }
  s.define("BUTNA_ED") { sv_esel("coin", s["PACT"], sv_bool("NOT", s["NACT"], s["NTAP"]), [], false) }
  s.define("BUTNA_ED_1") { sv_esel("inside_edge", s["BUTNA_ED"], s["NACTL_EP"], [], false) }
  s.define("BUTSDN_1") { sv_esel("with_edge", sv_sel_any("interact", s["PACT"], s["PW"], [], false, {}), s["BUTNA_ED_1"], [], false) }
  s.define("POSDN_1") { sv_esel("coin", sv_esel("inside_edge", s["PO"], sv_sel_any("touch", sv_bool("NOT", s["NACT"], s["NTAP"]), s["PACT"], [], false, {}), [], false), s["NGATE"], [], false) }
  s.define("POSDN") { sv_esel("touch_edge", sv_esel("with_edge", s["PO"], s["POSDN_1"], [], false), s["NGATE"], [], false) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["BUTSDN_1"], s["POSDN"], [["<", 0.3]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_EN_1", "AA enclosure by NP, except the SRAMALL region. >= 0.02um") do |outs|
  s = SvScope.new(self, $sv_G, "NP_EN_1")
  s.define("X") { sv_esel("coin", sv_esel("coin", sv_bool("NOT", s["AA"], s["SDNNR"]), s["PACT"], [], true), s["SDP"], [], true) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("enc", s["X"], s["SDN"], [["<", 0.02]], {:abut => [["<", 90.0]], :region => true}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_EN_2", "N+AA enclosure by NP, except the SRAMALL region. >= 0.12um") do |outs|
  s = SvScope.new(self, $sv_G, "NP_EN_2")
  s.define("X") { sv_esel("inside_edge", sv_esel("coin", sv_esel("coin", sv_sel_any("interact", s["NACT"], s["NWR"], [], true, {}), s["PACT"], [], true), s["SDP"], [], true), s["PW"], [], false) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("enc", s["X"], sv_bool("AND", s["SDN"], s["PW"]), [["<", 0.12]], {:abut => [["<", 90.0]], :region => true}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_EN_3", "Minimum NP Enclosure PO >= 0.15um") do |outs|
  s = SvScope.new(self, $sv_G, "NP_EN_3")
  s.define("PO_inter") { sv_bool("NOT", s["POLYi"], sv_nary("OR", s["AA"], s["POLYres"], s["HPR"])) }
  s.define("PO_CUT") { sv_sel_any("interact", sv_sel_any("interact", s["PO_inter"], s["SDN"], [], false, {}), s["SDP"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_check("enc", sv_bool("NOT", s["PO_inter"], s["PO_CUT"]), s["SDN"], [["<", 0.15]], {:abut => [["<", 90.0]], :region => true}), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("NP_EX_1_EX_1a", "NP extension outside of NMOS GATE poly when NP edge is on AA . >= 0.3um NP extension outside of GATE >= 0.16um") do |outs|
  s = SvScope.new(self, $sv_G, "NP_EX_1_EX_1a")
  s.define("SDN_S") { sv_sel_any("inside", s["SDN"], s["SRAMALL"], [], true, {}) }
  s.define("NACT_S") { sv_sel_any("inside", s["NACT"], s["SRAMALL"], [], true, {}) }
  s.define("X") { sv_esel("inside_edge", s["PO"], s["NACT_S"], [], false) }
  s.define("A") { sv_expand_edge(s["X"], {:inside => 0.2, :outside => 0.2, :corner_fill => true}) }
  s.define("Y") { sv_esel("coin", sv_bool("AND", s["PO"], s["NACT_S"]), s["NACT_S"], [], false) }
  s.define("B") { sv_expand_edge(s["Y"], {:outside => 0.16, :extend => 0.2}) }
  s.define("C") { sv_bool("OR", s["A"], s["B"]) }
  s.define("D") { sv_check("enc", s["NACT_S"], sv_esel("inside_edge", s["SDN_S"], s["C"], [], false), [["<", 0.16]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["D"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  s.define("E") { sv_check("enc", s["X"], s["SDN_S"], [["<", 0.3]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["E"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
