  s.define("D") { sv_check("enc", s["PACT_S"], sv_esel("inside_edge", s["SDP_S"], s["C"], [], false), [["<", 0.16]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["D"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  s.define("E") { sv_check("enc", s["X"], s["SDP_S"], [["<", 0.3]], {:abut => [["<", 90.0]], :region => true, :metric => "opposite"}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["E"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
