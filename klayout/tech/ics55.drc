sv_rule("SAB_S_1", "Space between two SABs >= 0.42um") do |outs|
  s = SvScope.new(self, $sv_G, "SAB_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["SAB"], nil, [["<", 0.42]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("SAB_S_2", "Space between two SABs when one or both SABs interact with PO. DRC waive if no (PO OR AA) exists in the space region. >= 0.44um") do |outs|
  s = SvScope.new(self, $sv_G, "SAB_S_2")
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", sv_check("ext", sv_sel_any("interact", s["SAB"], s["PO"], [], false, {}), s["SAB"], [["<", 0.44]], {:abut => [["<", 90.0]], :singular => true, :region => true}), sv_bool("OR", s["PO"], s["AA"]), [], false, {}), s["NODRC"], [], true, {}) }
end
sv_rule("SAB_S_3", "Space between SAB and AA >= 0.21um") do |outs|
  s = SvScope.new(self, $sv_G, "SAB_S_3")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["SAB"], s["AA"], [["<", 0.21]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("SAB_S_4", "Space between SAB and GATE SAB overlap with GATE is forbidden, DRC waive ESDIOE regions and waive the total SAB which overlaps GATE 60nm. >= 0.36um") do |outs|
  s = SvScope.new(self, $sv_G, "SAB_S_4")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["SAB"], s["GATE"], [["<", 0.36]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  s.define("ESD_REGION") { sv_check("int", s["GATE_W"], s["SAB"], [["==", 0.06]], {:metric => "opposite", :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("AND", sv_sel_any("interact", s["SAB"], s["ESD_REGION"], [], true, {}), s["GATE"]), s["ESDIOE"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("SAB_S_5", "Space between SAB and poly on field oxide. >= 0.3um") do |outs|
  s = SvScope.new(self, $sv_G, "SAB_S_5")
