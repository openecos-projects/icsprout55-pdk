  s = SvScope.new(self, $sv_G, "DG_EX_1")
  outs << proc { sv_sel_any("inside", sv_check("enc", s["DG"], s["NW"], [[">", 0.0], ["<", 0.47]], {:abut => [[">", 0.0], ["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
