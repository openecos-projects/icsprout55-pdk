  s = SvScope.new(self, $sv_G, "TG_S_2")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["TG"], s["MOS"], [["<", 0.25]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
