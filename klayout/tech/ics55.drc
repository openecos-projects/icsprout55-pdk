MOMLVS4"], $sv_G["MOMLVS5"], $sv_G["MOMLVS6"], $sv_G["RES3TPOLY"], $sv_G["SRBLK"], $sv_G["GRBLK"], $sv_G["SRINGBLK"], $sv_G["LOGO"], $sv_G["NOSHRINK"], $sv_G["NODRC"], $sv_G["OPCBLKALL"], $sv_G["DMYBLK"], $sv_G["NOEBBLK"], $sv_G["METBLK"], $sv_G["DEUPADI"], $sv_G["PVDD"], $sv_G["PVSS"], $sv_G["NPR"], $sv_G["HPR"], $sv_G["TTXT"], $sv_G["NW1CAP"], $sv_G["EMPTY"]]}) }
  $sv_G.define("BD_OTHER_OUTSIDE") { sv_bool("NOT", $sv_G["BD_EXTENT_OTHER"], $sv_G["CHIPEDGE"]) }
  $sv_G.define("MS_OUT_TEMP1") { sv_bool("OR", sv_bool("OR", sv_bool("OR", sv_bool("OR", sv_bool("OR", sv_bool("OR", sv_bool("OR", sv_bool("AND", $sv_G["M1i"], $sv_G["SRINGBLK"]), sv_bool("AND", $sv_G["M2i"], $sv_G["SRINGBLK"])), sv_bool("AND", $sv_G["M3i"], $sv_G["SRINGBLK"])), sv_bool("AND", $sv_G["M4i"], $sv_G["SRINGBLK"])), sv_bool("AND", $sv_G["M5i"], $sv_G["SRINGBLK"])), sv_bool("AND", $sv_G["M6i"], $sv_G["SRINGBLK"])), sv_bool("AND", $sv_G["M7i"], $sv_G["SRINGBLK"])), sv_bool("AND", $sv_G["M8i"], $sv_G["SRINGBLK"])) }
  $sv_G.define("MS_OUT_TEMP2") { sv_bool("OR", sv_bool("OR", sv_bool("AND", $sv_G["T4M1i"], $sv_G["SRINGBLK"]), sv_bool("AND", $sv_G["T4M2i"], $sv_G["SRINGBLK"])), sv_bool("AND", $sv_G["RDLi"], $sv_G["SRINGBLK"])) }
  $sv_G.define("MS_OUT") { sv_bool("OR", $sv_G["MS_OUT_TEMP1"], $sv_G["MS_OUT_TEMP2"]) }
  sv_rule("CHIPEDGE_EN_1", "Border layer must enclose all chip layout patterns (all chip design, excluding SRINGBLK, SRBLK marking layer) This rule is not applicable if customers insert seal ring by themselves This rule checking layer are DNW, AA, NW, PSUB, NVT3, PVT3, NVT1, PVT1, DG, TG, PO, NP, PP, NPR, HRP, ESD1, SAB, CT, Mn(n = 1-8), Vn(n = 1-7), T4V1, T4V2, T4M1, T4M2, T2V1, T2V2, T2M1, T2M2, CB, RV, COVER, RDL, FUSE, AADUM, PODUM, MnDUM(n = 1-8), T4M1DUM, T4M2DUM, T2M1DUM, T2M2DUM. >= 0.37um") do |outs|
    s = SvScope.new(self, $sv_G, "CHIPEDGE_EN_1")
    s.define("BD_EXTENT_OTHER_temp") { sv_extent({:layers => [s["DNWi"], s["ACTi"], s["NW1i"], s["PSUBi"], s["NVT3"], s["PVT3"], s["NVT1"], s["PVT1"], s["DGOX"], s["TGOX"], s["POLYi"], s["NPi"], s["PPi"], s["NPR"], s["HRPi"], s["ESD1"], s["SABi"], s["CTi"], s["CTbar"], s["MET1o"], s["MET2o"], s["MET3o"], s["MET4o"], s["MET5o"], s["MET6o"], s["MET7o"], s["MET8o"], s["VIA1i"], s["VIA2i"], s["VIA3i"], s["VIA4i"], s["VIA5i"], s["VIA6i"], s["VIA7i"], s["VIA1bar"], s["VIA2bar"], s["VIA3bar"], s["VIA4bar"], s["VIA5bar"], s["VIA6bar"], s["VIA7bar"], s["T4V1i"], s["T4V2i"], s["T4V1bar"], s["T4V2bar"], s["T4M1o"], s["T4M2o"], s["T2V1i"], s["T2V2i"], s["T2V1bar"], s["T2V2bar"], s["T2M1o"], s["T2M2o"], s["T8V1i"], s["T8V2i"], s["T8V1bar"], s["T8V2bar"], s["T8M1o"], s["T8M2o"], s["CBi"], s["RV"], s["COVER"], s["RDLi"], s["FUTR"], s["ACTdmi"], s["POLYdmi"], s["MET1dmi"], s["MET2dmi"], s["MET3dmi"], s["MET4dmi"], s["MET5dmi"], s["MET6dmi"], s["MET7dmi"], s["MET8dmi"], s["T4M1dmi"], s["T4M2dmi"], s["T2M1dmi"], s["T2M2dmi"], s["T8M1dmi"], s["T8M2dmi"]]}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("interact", sv_check("enc", s["BD_EXTENT_OTHER_temp"], s["CHIPEDGE"], [["<", 0.37]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["SRINGBLK"], [], true, {}), s["NODRC"], [], true, {}) }
  end
  sv_rule("CHIPEDGE_EN_2", "Enclosure of DNW by the chip edge (CHIPEDGE layer) if it need ICsprout to add seal ring. >= 6.0um") do |outs|
    s = SvScope.new(self, $sv_G, "CHIPEDGE_EN_2")
    outs << proc { sv_sel_any("inside", sv_check("enc", s["DNW"], s["CHIPEDGE"], [["<", 6.0]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  end
  sv_rule("CHIPEDGE_EN_3", "Enclosure of seal ring outer ring outline edge by CHIPEDGE layer if seal ring has been added by designers. >= 1.5") do |outs|
    s = SvScope.new(self, $sv_G, "CHIPEDGE_EN_3")
    outs << proc { sv_sel_any("inside", sv_check("enc", s["MS_OUT"], s["CHIPEDGE"], [["<", 1.5]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
  end
end
$sv_G.define("AAR_SA") { sv_bool("AND", $sv_G["AAR"], $sv_G["SAB"]) }
$sv_G.define("AAR_NS") { sv_sel_any("interact", $sv_G["AAR"], $sv_G["SAB"], [], true, {}) }
sv_rule("AAres_W_1", "Non-silicide AA resistor width, and it is suggest that AA resistor length/width ratio >1 for stable Rs  >= 0.4um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_W_1")
  s.define("X") { sv_bool("AND", sv_bool("AND", s["AARES"], s["AA"]), s["SAB"]) }
  s.define("L") { sv_esel("inside_edge", s["X"], s["AA"], [], false) }
  outs << proc { sv_esel("inside_edge", sv_length(s["L"], [["<", 0.4]], false), s["NODRC"], [], true) }
end
sv_rule("AAres_S_1_NP", "Space between non-silicide AA resistors area and other implant region >= 0.18um") do |outs|
  s = SvScope.new(self, $sv_G, "AAres_S_1_NP")
  s.define("X") { sv_sel_any("interact", s["SDN"], s["AARES"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("ext", s["X"], s["AAR_SA"], [["<", 0.18]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("AAres_S_1_PP", "Space between non-silicide AA resistors area and other implant region >= 0.18um") do |outs|
