  s.define("CHECK_REGION") { sv_enclose_rect(s["NON_MAL_REG"], 10.0, 0.35, {:neg => false}) }
  s.define("CHECK_MAL") { sv_sel_any("interact", s["M1"], s["CHECK_REGION"], [], false, {}) }
  outs << proc { sv_sel_any("inside", sv_check("int", s["CHECK_MAL"], nil, [["<", 0.35]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("MET1_S_1", "Space between two M1s, DRC donBFt flag 89 to 90 degree spaces in the INDALL region. >= 0.09um") do |outs|
  s = SvScope.new(self, $sv_G, "MET1_S_1")
  s.define("X") { sv_check("ext", s["M1"], nil, [["<", 0.09]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("NOT", s["X"], s["INDALL"]), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  s.define("Y") { sv_check("ext", s["M1"], nil, [["<", 0.09]], {:abut => [["<", 89.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("AND", s["Y"], s["INDALL"]), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("MET1_S_1_R", "Recomended pace between two M1s. >= 0.12um") do |outs|
