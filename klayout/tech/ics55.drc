sv_rule("CT_S_5", "Space between GATE and contact on AA for 1.8/2.5/3.3V >= 0.09um") do |outs|
  s = SvScope.new(self, $sv_G, "CT_S_5")
  s.define("X1") { sv_check("ext", s["GATE_io1"], sv_bool("AND", s["AA_CT"], s["DG"]), [["<", 0.09]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  s.define("X2") { sv_check("ext", s["GATE_io2"], sv_bool("AND", s["AA_CT"], s["TG"]), [["<", 0.09]], {:abut => [["<", 90.0]], :singular => true, :region => true}) }
  outs << proc { sv_sel_any("inside", sv_bool("OR", s["X1"], s["X2"]), s["NODRC"], [], true, {}) }
end
sv_rule("CT_S_6", "Space to butted SDN/SDP edge on AA (overlap of NP/PP boundary on AA is not allowed) >= 0.06um") do |outs|
  s = SvScope.new(self, $sv_G, "CT_S_6")
  s.define("X") { sv_esel("outside_edge", sv_esel("coin", s["SDN"], s["SDP"], [], false), s["AA"], [], true) }
  s.define("Y") { sv_esel("outside_edge", sv_esel("coin", s["SDP"], s["SDN"], [], false), s["AA"], [], true) }
  outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", s["X"], s["CT"], [], false), s["NODRC"], [], true) }
  outs << proc { sv_esel("inside_edge", sv_esel("inside_edge", s["Y"], s["CT"], [], false), s["NODRC"], [], true) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["CT"], s["X"], [["<", 0.06]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["CT"], s["Y"], [["<", 0.06]], {:abut => [["<", 90.0]], :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("CT_EN_1", "CT must be fully covered by M1 and (AA OR POLY), except SRAMALL region.") do |outs|
  s = SvScope.new(self, $sv_G, "CT_EN_1")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("NOT", s["CT"], sv_bool("AND", s["M1"], sv_bool("OR", s["PO"], s["AA"]))), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("CT_EN_2a", "CT enclosure by AA for CT >= 0.015um") do |outs|
  s = SvScope.new(self, $sv_G, "CT_EN_2a")
  s.define("X") { sv_sel_any("interact", s["CT"], s["AA"], [], false, {}) }
  s.define("Y") { sv_check("enc", s["X"], s["AA"], [["<", 0.015]], {:abut => [["<", 90.0]], :singular => true, :region => true, :outside_also => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("CT_EN_2b", "CT enclosure by AA for at least two opposite sides >= 0.03um") do |outs|
  s = SvScope.new(self, $sv_G, "CT_EN_2b")
  s.define("X") { sv_rect_enc(sv_sel_any("interact", s["CT"], s["AA"], [], false, {}), s["AA"], [[[0.015, true], [0.03, true], [0.015, true], [0.03, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
  s.define("A") { sv_check("enc", s["X"], s["AA"], [["<", 0.03]], {:metric => "opposite", :out => 1.0}) }
  s.define("D2") { sv_check("int", s["A"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :intersecting => "only", :region => true}) }
  outs << proc { sv_sel_any("inside", s["D2"], s["SRAMALL"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_sel_any("interact", s["CT"], s["AA"], [], false, {}), s["AA"]), s["SRAMALL"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("CT_EN_2_R", "Recomended CT enclosure by AA for all sides >= 0.04um") do |outs|
    s = SvScope.new(self, $sv_G, "CT_EN_2_R")
    s.define("X") { sv_sel_any("interact", s["CT"], s["AA"], [], false, {}) }
    s.define("Y") { sv_check("enc", s["X"], s["AA"], [["<", 0.04]], {:abut => [["<", 90.0]], :singular => true, :region => true, :outside_also => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("CT_EN_3a_3b_3c", "Min CT enclosure by poly is 0.01 Min CT enclosure by poly when one or both perpendicular directions <0.04um is 0.04um Min CT enclosure by poly all side is 0.025") do |outs|
  s = SvScope.new(self, $sv_G, "CT_EN_3a_3b_3c")
  s.define("X") { sv_rect_enc(sv_sel_any("interact", s["CT"], s["PO"], [], false, {}), s["PO"], [[[0.01, true], [0.04, true], [0.01, true], [0.04, true]], [[0.025, false], [0.025, false], [0.025, false], [0.025, false]]], {:abut => [["<", 90.0]], :outside_also => true}) }
  s.define("D1") { sv_check("enc", s["X"], s["PO"], [["<", 0.01]], {:abut => [["<", 90.0]], :singular => true, :region => true, :overlap => true, :outside_also => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["D1"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  s.define("A") { sv_check("enc", s["X"], s["PO"], [["<", 0.04]], {:metric => "opposite", :out => 1.0}) }
  s.define("D2") { sv_check("int", s["A"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :intersecting => "only", :region => true}) }
  outs << proc { sv_sel_any("inside", s["D2"], s["SRAMALL"], [], true, {}) }
  s.define("B") { sv_check("enc", s["X"], s["PO"], [["<", 0.025]], {:abut => [["<", 90.0]], :singular => true, :region => true, :overlap => true, :outside_also => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["B"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_sel_any("interact", s["CT"], s["PO"], [], false, {}), s["PO"]), s["SRAMALL"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("CT_EN_3_R", "Recommended CT enclosure by poly for all sides to avoid high RC >= 0.06um") do |outs|
    s = SvScope.new(self, $sv_G, "CT_EN_3_R")
    s.define("X") { sv_sel_any("interact", s["CT"], s["PO"], [], false, {}) }
    s.define("Y") { sv_check("enc", s["X"], s["PO"], [["<", 0.06]], {:abut => [["<", 90.0]], :singular => true, :region => true, :outside_also => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["Y"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  end
end
sv_rule("CT_EN_4a_4b_4c", "Enclosure by M1 >= 0 um Enclosure by M1 at least two opposite sides < 0.04um >= 0.04um Enclosure by M1 for all sides >= 0.025 um") do |outs|
  s = SvScope.new(self, $sv_G, "CT_EN_4a_4b_4c")
  s.define("X") { sv_rect_enc(sv_sel_any("touch", s["CT"], s["M1"], [], true, {}), s["M1"], [[[0.0, false], [0.04, true], [0.0, false], [0.04, true]], [[0.025, false], [0.025, false], [0.025, false], [0.025, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
  s.define("A") { sv_check("enc", s["X"], s["M1"], [["<", 0.04]], {:metric => "opposite", :out => 1.0}) }
  s.define("D1") { sv_check("int", s["A"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :intersecting => "only", :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["D1"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  s.define("B") { sv_esel("coin", s["CT"], s["M1"], [], false) }
  s.define("D2") { sv_check("int", s["B"], nil, [["<", 0.01]], {:abut => [["==", 90.0]], :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["D2"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  s.define("Y") { sv_check("enc", s["CT"], s["M1"], [["<", 0.04]], {:metric => "opposite", :region => true}) }
  s.define("C1") { sv_esel("coin", s["CT"], s["M1"], [], false) }
  s.define("C2") { sv_esel("coin", s["CT"], s["Y"], [], false) }
  s.define("D3") { sv_check("int", s["C1"], s["C2"], [["<", 0.01]], {:abut => [["==", 90.0]], :region => true}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", s["D3"], s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_bool("NOT", s["CT"], s["M1"]), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_sel_any("interact", s["CT"], s["M1"], [], true, {}), s["NODRC"], [], true, {}) }
end
if sv_ifdef("OPEN_RECOMMENDED_ON", "YES")
  sv_rule("CT_EN_4a_R_4b_R", "Recomended M1 enclosure of CT to avoide high RC >= 0.04 um Recommended Minimum M1 enclosure of CT in line end region (at least two opposite sides) >=0.06") do |outs|
    s = SvScope.new(self, $sv_G, "CT_EN_4a_R_4b_R")
    s.define("X") { sv_rect_enc(sv_sel_any("interact", s["CT"], s["M1"], [], false, {}), s["M1"], [[[0.04, false], [0.06, true], [0.04, false], [0.06, true]]], {:abut => [["<", 90.0]], :outside_also => true}) }
    outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("inside", s["X"], s["SRAMALL"], [], true, {}), s["SRINGBLK"], [], true, {}), s["NODRC"], [], true, {}) }
    s.define("A") { sv_check("enc", s["X"], s["M1"], [["<", 0.06]], {:metric => "opposite", :region => true}) }
    outs << proc { sv_sel_any("inside", s["A"], s["SRAMALL"], [], true, {}) }
    outs << proc { sv_sel_any("inside", sv_bool("NOT", sv_sel_any("interact", s["CT"], s["M1"], [], false, {}), s["M1"]), s["SRAMALL"], [], true, {}) }
  end
  sv_rule("CT_R_4", "Recomended at least two CTs for connection except Reserved area, DRC help to mark single CT") do |outs|
    s = SvScope.new(self, $sv_G, "CT_R_4")
    s.define("X1") { sv_sel_any("interact", sv_bool("OR", s["NSD"], s["NTAP"]), s["CT"], [["==", 1.0]], false, {}) }
    outs << proc { sv_bool("NOT", sv_bool("AND", s["CT"], s["X1"]), sv_bool("OR", s["NODRC"], s["SRAMALL"])) }
    s.define("X2") { sv_sel_any("interact", sv_bool("OR", s["PSD"], s["PTAP"]), s["CT"], [["==", 1.0]], false, {}) }
    outs << proc { sv_bool("NOT", sv_bool("AND", s["CT"], s["X2"]), sv_bool("OR", s["NODRC"], s["SRAMALL"])) }
    s.define("X3") { sv_sel_any("interact", s["PO"], s["CT"], [["==", 1.0]], false, {}) }
    outs << proc { sv_bool("NOT", sv_bool("AND", s["CT"], s["X3"]), sv_bool("OR", s["NODRC"], s["SRAMALL"])) }
  end
end
sv_rule("CT_EN_4d", "Enclosure by M1, when M1 width is > 1um. >= 0.04um") do |outs|
  s = SvScope.new(self, $sv_G, "CT_EN_4d")
  s.define("M1_CHECK") { sv_with_width(s["M1"], [[">", 1.0]], false) }
  s.define("CT_CHECK") { sv_sel_any("outside", s["CT"], s["M1_CHECK"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_check("enc", s["CT_CHECK"], s["M1"], [["<", 0.04]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
end
sv_rule("CT_R_1", "CT is not allowed to land on GATE") do |outs|
  s = SvScope.new(self, $sv_G, "CT_R_1")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_nary("AND", s["GATE"], s["CT"]), s["SRAMALL"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("CT_R_2", "CT is not allowed to interact SAB Waive the CT cutting AA in SRAM area.") do |outs|
  s = SvScope.new(self, $sv_G, "CT_R_2")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_sel_any("interact", s["CT"], s["SAB"], [], false, {}), sv_bool("OR", s["SRAMALL"], s["EFUSEALL"]), [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("CT_R_3", "45 degree CT is not allowed") do |outs|
  s = SvScope.new(self, $sv_G, "CT_R_3")
  outs << proc { sv_sel_any("inside", sv_sel_any("inside", sv_esel("with_edge", s["CT"], sv_angle(s["CT"], [["==", 45.0]], false), [], false), s["SRINGBLK"], [], true, {}), s["NODRC"], [], true, {}) }
end
sv_rule("CT_R_5", "Recomended to put CTs at both source side and butted well tap side. DRC can flag if the tap is butted on source and the tap or source region without CT") do |outs|
  s = SvScope.new(self, $sv_G, "CT_R_5")
  s.define("X1") { sv_sel_any("interact", sv_sel_any("touch", s["NTAP"], s["NSDi"], [], false, {}), s["CT"], [], true, {}) }
  s.define("X2") { sv_sel_any("interact", sv_sel_any("touch", s["PTAP"], s["PSDi"], [], false, {}), s["CT"], [], true, {}) }
  s.define("X3") { sv_sel_any("interact", sv_sel_any("touch", s["NTAP"], s["PSDi"], [], false, {}), s["CT"], [], true, {}) }
  s.define("X4") { sv_sel_any("interact", sv_sel_any("touch", s["PTAP"], s["NSDi"], [], false, {}), s["CT"], [], true, {}) }
  outs << proc { sv_bool("NOT", sv_nary("OR", s["X1"], s["X2"], s["X3"], s["X4"]), s["NODRC"]) }
end
$sv_G.define("density_checkarea") { sv_bool("NOT", $sv_G["DRC:1"], $sv_G["INDALL"]) }
sv_rule("MET1_W_1", "M1 width >= 0.09um M1 width <= 12.00um") do |outs|
  s = SvScope.new(self, $sv_G, "MET1_W_1")
