  s.define("X") { sv_esel("touch_edge", s["MOS"], sv_sel_any("inside", s["GATE"], s["DG"], [], false, {}), [], false) }
  outs << proc { sv_check("enc", s["X"], s["DG"], [["<", 0.25]], {:abut => [["<", 90.0]], :region => true}) }
end
