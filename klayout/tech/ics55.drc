sv_rule("MET1_S_2", "Min Space between two M1 is 0.15 um when one or both M1 width >= 0.42um, and the parallel run length of two M1s is >= 0.42um") do |outs|
  s = SvScope.new(self, $sv_G, "MET1_S_2")
  s.define("span_edge_0") { sv_dfm_copy(sv_dfm_space([s["M1ALL"]], [["<", 0.42]], {:by => "int"}), "edge") }
  s.define("span_edge_1") { sv_esel("coin", s["M1ALL"], s["span_edge_0"], [], true) }
  s.define("span_edge") { sv_check("ext", s["span_edge_1"], s["M1ALL"], [["<", 0.15]], {:abut => [["<", 90.0]], :metric => "opposite", :out => 1.0}) }
  outs << proc { sv_esel("inside_edge", sv_length(s["span_edge"], [[">=", 0.42]], false), s["NODRC"], [], true) }
end
sv_rule("MET1_S_3", "Min Space between two M1 is 0.5 um when one or both M1 width >= 1.5um, and the parallel run length of two M1s is >= 1.5um") do |outs|
