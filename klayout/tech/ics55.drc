sv_rule("NWresSTI_R_2", "NW1res(ineract with NP) must not overlap with AAdm,POLYdm,PP,ULLD,PVT3,NVT3,PVT1,NVT1,NPR,HRP and ESD") do |outs|
  s = SvScope.new(self, $sv_G, "NWresSTI_R_2")
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_sel_any("interact", s["NW1res"], s["SDN"], [], false, {}), s["AADUM"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", sv_sel_any("interact", s["NW1res"], s["SDN"], [], false, {}), s["PODUM"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["HVTN"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["ULLD"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["HVTP"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["LVTN"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["LVTP"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["SDP"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["NPR"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["ESD1"]), s["NODRC"], [], true, {}) }
  outs << proc { sv_sel_any("inside", sv_bool("AND", s["NW1res"], s["HRP"]), s["NODRC"], [], true, {}) }
end
sv_rule("NWresSTI_R_3", "recommanded to use rectangle shape resistor for the spice simulation accuracy. DRC flag (NW resistor AND NW) not a rectangle") do |outs|
  s = SvScope.new(self, $sv_G, "NWresSTI_R_3")
  s.define("X") { sv_bool("AND", s["NW1res"], s["NW"]) }
  outs << proc { sv_rectangle(s["X"], {:neg => true}) }
