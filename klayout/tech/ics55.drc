  s = SvScope.new(self, $sv_G, "TG_S_1")
  outs << proc { sv_sel_any("inside", sv_check("ext", s["TG"], nil, [["<", 0.47]], {:abut => [["<", 90.0]], :singular => true, :region => true}), s["NODRC"], [], true, {}) }
