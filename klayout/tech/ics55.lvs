# ============================================================================
# SVRF runtime for KLayout DRC
#
# Implements Calibre SVRF layer operations on top of the KLayout DRC DSL.
# This file is embedded verbatim into the generated rule deck by
# svrf2klayout.py. All functions are prefixed with "sv_".
# ============================================================================

# ---------------------------------------------------------------------------
# Scopes and lazy layer evaluation
# ---------------------------------------------------------------------------

class SvScope
  attr_reader :name
  def initialize(engine, parent, name)
    @e = engine
    @p = parent
    @name = name
    @defs = {}
    @cache = {}
    @busy = {}
  end
  def define(n, &blk)
    @defs[n.upcase] = blk
  end
  def defined?(n)
    @defs.has_key?(n.upcase) || (@p && @p.defined?(n))
  end
  def [](n)
    k = n.upcase
    if @defs.has_key?(k)
      return @cache[k] if @cache.has_key?(k)
      raise "SVRF: cyclic definition of #{k}" if @busy[k]
      @busy[k] = true
      t0 = Time.now
      begin
        v = @defs[k].call
      ensure
        @busy[k] = false
      end
      if $sv_verbose && Time.now - t0 > 0.5
        @e.log("SVRF layer #{@name}:#{k}: #{'%.2f' % (Time.now - t0)}s (incl. dependencies)")
      end
      @cache[k] = v
      if $sv_dump_local && $sv_dump_local["#{@name.upcase}:#{k}"]
        begin
          dl = v
          if $sv_flat && dl.data.respond_to?(:flatten)
            d = dl.data.dup; d.flatten; dl = DRC::DRCLayer::new(@e, d)
          end
          dl.output("DUMP_#{@name}:#{k}", "debug dump")
        rescue => ex
          @e.log("dump failed #{k}: #{ex}")
        end
      end
      return v
    end
    return @p[n] if @p
    raise "SVRF: undefined layer #{n}"
  end
  def forget
    @cache.clear
  end
end

$sv_rules = []
$sv_dump_local = nil
if $dump
  $sv_dump_local = {}
  $dump.split(",").each { |n| $sv_dump_local[n.upcase] = true if n.include?(":") }
end
$sv_connects = []
$sv_texts = {}

def sv_switch(name, default)
  v = $sv_switches[name.upcase]
  v.nil? ? default : v
end

def sv_ifdef(name, value)
  v = $sv_defines[name.upcase]
  return false if v.nil?
  return true if value.nil?
  v.to_s.upcase == value.to_s.upcase
end

def sv_define(name, value)
  ov = $sv_overrides[name.upcase]
  $sv_defines[name.upcase] = ov.nil? ? value : ov
end

def sv_rule(name, desc, groups = [], &blk)
  $sv_rules << [name, desc, blk]
end

def sv_connect(layers, via)
  $sv_connects << [layers, via]
end

# ---------------------------------------------------------------------------
# Basic helpers
# ---------------------------------------------------------------------------

def sv_w(obj)
  obj.min_coherence = true if obj.is_a?(RBA::Region)
  DRC::DRCLayer::new(self, obj)
end

# Calibre keeps polygons touching at a single point separate
def sv_mc(l)
  d = l.data
  d.min_coherence = true if d.is_a?(RBA::Region) && !d.min_coherence?
  l
end

def sv_kind(l)
  d = l.data
  return :poly if d.is_a?(RBA::Region)
  return :edge if d.is_a?(RBA::Edges)
  return :ep if d.is_a?(RBA::EdgePairs)
  return :text if d.is_a?(RBA::Texts)
  raise "SVRF: unknown layer type #{d.class}"
end

def sv_empty_poly
  polygons
end

# to region
def sv_p(l)
  case sv_kind(l)
  when :poly then l
  when :ep then l.polygons
  when :edge then l.extended(0, 0, 1.dbu, 1.dbu)  # thin regions
  when :text then l.polygons
  end
end

# to edges
def sv_e(l)
  case sv_kind(l)
  when :poly then l.edges
  when :edge then l
  when :ep then l.edges
  else raise "SVRF: cannot convert text to edges"
  end
end

def sv_dbu_i(v)
  (v / dbu).round
end

# Integer range from constraint list. Returns [min, max) in integer units;
# nil for open ends. scale: integer units per micron (1/dbu for lengths)
def sv_irange(cons, scale)
  lo = nil
  hi = nil
  ne = []
  cons.each do |op, v|
    x = (v * scale).round
    case op
    when "<" then hi = x
    when "<=" then hi = x + 1
    when ">" then lo = x + 1
    when ">=" then lo = x
    when "==" then lo = x; hi = x + 1
    when "!=" then ne << x
    end
  end
  [lo, hi, ne]
end

# Float range [min, max) in microns (inclusive min, exclusive max).
def sv_frange(cons)
  lo, hi, ne = sv_irange(cons, 1.0 / dbu)
  [lo ? lo * dbu : nil, hi ? hi * dbu : nil, ne.collect { |x| x * dbu }]
end

def sv_cons_ok(cons, v)
  cons.all? do |op, c|
    case op
    when "<" then v < c - 1e-9
    when "<=" then v <= c + 1e-9
    when ">" then v > c + 1e-9
    when ">=" then v >= c - 1e-9
    when "==" then (v - c).abs < 1e-9
    when "!=" then (v - c).abs >= 1e-9
    end
  end
end

# count range for interact/enclose etc. (0 is never counted: Calibre
# semantics "INTERACT < 4" means 1..3)
def sv_count_range(cons)
  return [nil, nil] if cons.nil? || cons.empty?
  lo, hi, ne = sv_irange(cons, 1)
  lo = 1 if lo.nil? || lo < 1
  mx = hi ? hi - 1 : nil
  [lo, mx]
end

# call a counting selection method with optional min/max counts
def sv_cnt(a, meth, b, mn, mx)
  if mn.nil? && mx.nil?
    a.send(meth, b)
  elsif mx.nil?
    a.send(meth, b, mn)
  elsif mx < (mn || 1)
    a - a
  else
    a.send(meth, b, mn || 1, mx)
  end
end

# ---------------------------------------------------------------------------
# Input layers
# ---------------------------------------------------------------------------

$sv_input_cache = {}
def sv_input(specs)
  key = specs.inspect
  return $sv_input_cache[key] if $sv_input_cache[key]
  if specs.empty?
    r = polygons
  else
    r = nil
    specs.each do |l, d|
      x = polygons(l, d)
      r = r ? (r + x) : x
    end
  end
  sv_mc(r)
  $sv_input_cache[key] = r
  r
end

$sv_text_cache = {}
def sv_text(specs)
  key = specs.inspect
  return $sv_text_cache[key] if $sv_text_cache[key]
  r = nil
  specs.each do |l, d|
    x = labels(l, d)
    r = r ? (r + x) : x
  end
  r ||= labels(9999, 9999)
  $sv_text_cache[key] = r
  r
end

# ---------------------------------------------------------------------------
# Boolean operations
# ---------------------------------------------------------------------------

def sv_bool(op, a, b)
  ka = sv_kind(a)
  kb = sv_kind(b)
  if ka == :edge && kb == :edge
    case op
    when "AND" then return a & b
    when "OR" then return a + b
    when "NOT" then return a - b
    when "XOR" then return a ^ b
    end
  end
  if ka == :edge && kb == :poly
    # edge AND/NOT polygon: Calibre does not allow it, treat as inside/outside parts
    case op
    when "AND" then return a.inside_part(b)
    when "NOT" then return a.outside_part(b)
    when "OR" then return a + b.edges
    end
  end
  a = sv_mc(sv_p(a))
  b = sv_mc(sv_p(b))
  r = case op
  when "AND" then a & b
  when "OR" then a | b
  when "NOT" then a - b
  when "XOR" then a ^ b
  else raise "SVRF: unknown bool #{op}"
  end
  sv_mc(r)
end

def sv_nary(op, *ls)
  r = ls[0]
  ls[1..-1].each { |x| r = sv_bool(op, r, x) }
  r
end

def sv_copy(a)
  a
end

def sv_edge_or(a, b)
  sv_e(a) + sv_e(b)
end

# ---------------------------------------------------------------------------
# Polygon selection (INTERACT, INSIDE, OUTSIDE, TOUCH, ENCLOSE, CUT)
# ---------------------------------------------------------------------------

def sv_sel(kind, a, b, cons, neg, opts = {})
  if sv_kind(a) == :edge
    return sv_edge_layer_sel(kind, a, b, neg, opts)
  end
  a = sv_p(a)
  bk = sv_kind(b)
  b = sv_p(b) if bk == :ep || bk == :text
  mn, mx = sv_count_range(cons)
  case kind
  when "interact"
    if mn || mx
      r = sv_cnt(a, :interacting, b, mn, mx)
    else
      r = a.interacting(b)
    end
    neg ? a - r : r
  when "inside"
    if bk == :edge
      # polygons inside an edge layer: never
      return neg ? a : sv_empty_poly
    end
    neg ? a.not_inside(b) : a.inside(b)
  when "outside"
    if bk == :edge
      r = a.not_interacting(b)
      return neg ? a - r : r
    end
    neg ? a.not_outside(b) : a.outside(b)
  when "enclose"
    r = sv_cnt(a, :covering, b, mn, mx)
    neg ? a - r : r
  when "touch"
    if bk == :edge
      r = sv_cnt(a, :interacting, b, mn, mx)
    else
      c = a.not_overlapping(b)
      r = sv_cnt(c, :interacting, b, mn, mx)
    end
    neg ? a - r : r
  when "cut"
    if mn || mx
      r = sv_cnt(a, :overlapping, b, mn, mx).not_inside(b)
    else
      r = a.overlapping(b).not_inside(b)
    end
    neg ? a - r : r
  else
    raise "SVRF: unknown selection #{kind}"
  end
end

# selections applied to edge layers (e.g. "X NOT INSIDE NODRC" on edges)
def sv_edge_layer_sel(kind, a, b, neg, opts)
  b = sv_p(b) if sv_kind(b) != :edge
  case kind
  when "inside"
    neg ? a.not_inside(b) : a.inside(b)
  when "outside"
    neg ? a.not_outside(b) : a.outside(b)
  when "interact", "touch"
    neg ? a.not_interacting(b) : a.interacting(b)
  else
    raise "SVRF: unsupported edge selection #{kind}"
  end
end

# selections on edge-pair layers
def sv_ep_sel(kind, a, b, neg)
  b = sv_p(b)
  case kind
  when "inside" then neg ? a.not_inside(b) : a.inside(b)
  when "outside" then neg ? a.not_outside(b) : a.outside(b)
  when "interact" then neg ? a.not_interacting(b) : a.interacting(b)
  else
    raise "SVRF: unsupported edge pair selection #{kind}"
  end
end

def sv_sel_any(kind, a, b, cons, neg, opts = {})
  if sv_kind(a) == :ep
    if kind == "inside" || kind == "outside" || (kind == "interact" && (cons.nil? || cons.empty?))
      return sv_ep_sel(kind, a, b, neg)
    end
    a = a.polygons
  end
  sv_sel(kind, a, b, cons, neg, opts)
end

# ---------------------------------------------------------------------------
# Edge selections
# ---------------------------------------------------------------------------

# center parts of edges (used to test coincidence without endpoint touching)
def sv_mid(e)
  e.centers(0, 0.5)
end

def sv_esel(kind, a, b, cons, neg, opts = {})
  ka = sv_kind(a)
  kb = sv_kind(b)
  if kind == "with_edge"
    # polygons of a which have edges from b
    ap = sv_p(a)
    be = sv_e(b)
    mn, mx = sv_count_range(cons)
    m = sv_mid(be)
    r = sv_cnt(ap, :interacting, m, mn, mx)
    return neg ? ap - r : r
  end
  ea = sv_e(a)
  b = b.polygons if kb == :ep && (kind == "inside_edge" || kind == "outside_edge")
  kb = sv_kind(b)
  case kind
  when "inside_edge"
    bp = sv_p(b)
    r = ea.inside_part(bp)
    neg ? ea - r : r
  when "outside_edge"
    bp = sv_p(b)
    r = ea.outside_part(bp)
    neg ? ea - r : r
  when "coin"
    r = ea & sv_e(b)
    neg ? ea - r : r
  when "coin_inside", "coin_outside"
    if ka == :poly && kb == :poly
      c = ea & b.edges
      if kind == "coin_inside"
        r = c & (a & b).edges
      else
        r = c - (a | b).edges
      end
    else
      r = ea & sv_e(b)
    end
    neg ? ea - r : r
  when "touch_edge", "touch_inside_edge", "touch_outside_edge"
    if kind != "touch_edge" && ka == :poly && kb == :poly
      c = ea & b.edges
      if kind == "touch_inside_edge"
        c = c & (a & b).edges
      else
        c = c - (a | b).edges
      end
    elsif kind != "touch_edge" && kb == :poly
      # edge layer a, polygon b: inside -> edge interior side faces b
      c = ea & b.edges
    else
      c = ea & sv_e(b)
    end
    m = sv_mid(c)
    mn, mx = sv_count_range(cons)
    r = ea.interacting(m)
    neg ? ea - r : r
  else
    raise "SVRF: unknown edge selection #{kind}"
  end
end

# ---------------------------------------------------------------------------
# SIZE
# ---------------------------------------------------------------------------

def sv_size(a, d, opts = {})
  a = sv_p(a)
  mode = opts[:mode]
  if opts[:inside_of] || opts[:outside_of]
    # Calibre: R(k+1) = size(R(k), step) clipped to the constraint layer,
    # seeded with a itself (a may be outside, e.g. touching)
    st = opts[:step] || d.abs
    steps = [(d.abs / st).ceil, 1].max
    di = sv_dbu_i(d)
    sti = (di.to_f / steps).round
    c = sv_p(opts[:inside_of] || opts[:outside_of]).data
    inside = !opts[:inside_of].nil?
    r1 = a.data.sized(sti)
    r1 = inside ? (r1 & c) : (r1 - c)
    if steps > 1
      rest = di - sti
      r = inside ? r1.sized_inside(c, rest, steps - 1) : r1.sized_outside(c, rest, steps - 1)
    else
      r = r1
    end
    return sv_w(r)
  end
  if mode == "overunder"
    return a.sized(d).sized(-d)
  elsif mode == "underover"
    return a.sized(-d).sized(d)
  end
  a.sized(d)
end

# ---------------------------------------------------------------------------
# Measurements
# ---------------------------------------------------------------------------

def sv_area(a, cons, neg = false)
  a = sv_p(a)
  lo, hi, ne = sv_irange(cons, 1.0 / (dbu * dbu))
  r = sv_w(a.data.with_area(lo, hi, false))
  ne.each { |x| r = r - sv_w(r.data.with_area(x, x + 1, false)) }
  neg ? a - r : r
end

def sv_perimeter(a, cons, neg = false)
  a = sv_p(a)
  lo, hi, ne = sv_irange(cons, 1.0 / dbu)
  r = sv_w(a.data.with_perimeter(lo, hi, false))
  neg ? a - r : r
end

def sv_length(a, cons, neg = false)
  e = sv_e(a)
  lo, hi, ne = sv_irange(cons, 1.0 / dbu)
  r = sv_w(e.data.with_length(lo, hi, false))
  ne.each { |x| r = r - sv_w(r.data.with_length(x, x + 1, false)) }
  neg ? e - r : r
end

def sv_angle(a, cons, neg = false)
  e = sv_e(a)
  lo = nil
  hi = nil
  incl_hi = false
  incl_lo = true
  ne = []
  cons.each do |op, v|
    case op
    when "<" then hi = v
    when "<=" then hi = v; incl_hi = true
    when ">" then lo = v; incl_lo = false
    when ">=" then lo = v
    when "==" then lo = v; hi = v; incl_hi = true
    when "!=" then ne << v
    end
  end
  lo ||= 0.0
  hi ||= 90.0 + 1e-6
  if lo == hi
    r = sv_w(e.data.with_abs_angle(lo, false))
  else
    r = sv_w(e.data.with_abs_angle(lo, hi, false, incl_lo, incl_hi))
  end
  ne.each { |x| r = r - sv_w(r.data.with_abs_angle(x, false)) }
  neg ? e - r : r
end

def sv_holes(a, opts = {})
  a = sv_p(a)
  h = a.holes
  if opts[:inner]
    # innermost holes: holes that do not contain other holes
    h = h.not_covering(h.holes) if false
  end
  if opts[:empty]
    h = h.not_interacting(a.inside(h)) if false
    h = h - h.covering(a)
  end
  if opts[:cons] && !opts[:cons].empty?
    h = sv_area(h, opts[:cons])
  end
  h
end

def sv_donut(a, cons, neg = false)
  a = sv_p(a)
  if cons.nil? || cons.empty?
    r = a.with_holes(1, nil)
  else
    lo, hi, ne = sv_irange(cons, 1)
    r = sv_w(a.data.with_holes(lo || 1, hi, false))
  end
  neg ? a - r : r
end

$sv_extent = nil
def sv_extent(opts = {})
  if opts[:layers] && !opts[:layers].empty?
    bb = RBA::Box::new
    opts[:layers].each { |l| bb += sv_p(l).data.bbox }
    r = polygons
    r.data.insert(bb) unless bb.empty?
    return r
  end
  $sv_extent ||= extent
  $sv_extent
end

def sv_extents(a)
  sv_p(a).extents
end

# ---------------------------------------------------------------------------
# Edge expansion and convexity
# ---------------------------------------------------------------------------

def sv_expand_edge(a, opts = {})
  e = sv_e(a)
  i = opts[:inside] || 0.0
  o = opts[:outside] || 0.0
  x = opts[:extend] || 0.0
  e.extended(x, x, o, i, opts[:corner_fill] ? true : false)
end

def sv_convex_edge(a, opts = {})
  a = sv_p(a)
  if opts[:count]
    c = opts[:count]
    r = nil
    [0, 1, 2].each do |n|
      if sv_cons_ok(c, n.to_f)
        part = case n
               when 0 then a.edges(concave)
               when 1 then a.edges(step)
               when 2 then a.edges(convex)
               end
        r = r ? r + part : part
      end
    end
    r ||= a.edges(convex) - a.edges
  else
    a1 = opts[:angle1]
    a2 = opts[:angle2]
    cv1 = sv_cons_ok(a1, 90.0)
    cc1 = sv_cons_ok(a1, 270.0)
    cv2 = sv_cons_ok(a2, 90.0)
    cc2 = sv_cons_ok(a2, 270.0)
    r = nil
    add = lambda { |x| r = r ? r + x : x }
    add.call(a.edges(convex)) if cv1 && cv2
    add.call(a.edges(concave)) if cc1 && cc2
    add.call(a.edges(step)) if (cv1 && cc2) || (cc1 && cv2)
    r ||= a.edges - a.edges
  end
  if opts[:length]
    r = sv_length(r, opts[:length])
  end
  r
end

# ---------------------------------------------------------------------------
# WITH WIDTH, RECTANGLE, ENCLOSE RECTANGLE
# ---------------------------------------------------------------------------

# parts of a with width >= wi (dbu): morphological opening computed on a
# 2x scaled copy, so that parts of exactly wi survive
def sv_open(a, wi)
  return a if wi <= 1
  d2 = a.data.scaled_and_snapped(1, 2, 1, 1, 2, 1)
  k = wi - 1
  o = d2.sized(-k).sized(k) & d2
  sv_w(o.scaled_and_snapped(1, 1, 2, 1, 1, 2)) & a
end

def sv_with_width(a, cons, neg = false)
  a = sv_p(a)
  lo, hi, ne = sv_irange(cons, 1.0 / dbu)
  r = lo ? sv_open(a, lo) : a
  r = r - sv_open(a, hi) if hi
  ne.each { |x| r = r - (sv_open(a, x) - sv_open(a, x + 1)) }
  neg ? a - r : r
end

def sv_with_text(a, t, pattern, neg = false)
  a = sv_p(a)
  pat = pattern.gsub("?", "*")
  tx = t.texts(pat)
  r = a.interacting(tx)
  neg ? a - r : r
end

def sv_rectangle(a, opts = {})
  a = sv_p(a)
  r = a.rectangles
  if opts[:w] || opts[:l]
    w = opts[:w] || []
    l = opts[:l] || []
    wl = sv_irange(w, 1.0 / dbu)
    ll = sv_irange(l, 1.0 / dbu)
    d = r.data
    r1 = d.with_bbox_min(wl[0], wl[1], false).with_bbox_max(ll[0], ll[1], false)
    r2 = d.with_bbox_max(wl[0], wl[1], false).with_bbox_min(ll[0], ll[1], false)
    r = sv_w(r1) | sv_w(r2)
  end
  if opts[:aspect]
    c = opts[:aspect]
    sel = nil
    if c.size == 1 && c[0][0] == "=="
      sel = r.data.with_bbox_aspect_ratio(c[0][1], c[0][1] + 1e-6, false)
    elsif c.size == 1 && c[0][0] == "!="
      sel = r.data.with_bbox_aspect_ratio(c[0][1], c[0][1] + 1e-6, true)
    else
      lo = nil; hi = nil
      c.each do |op, v|
        case op
        when "<" then hi = v
        when "<=" then hi = v + 1e-6
        when ">" then lo = v + 1e-6
        when ">=" then lo = v
        end
      end
      sel = r.data.with_bbox_aspect_ratio(lo, hi, false)
    end
    r = sv_w(sel)
  end
  opts[:neg] ? a - r : r
end

def sv_enclose_rect(a, w, l, opts = {})
  a = sv_p(a)
  wi = sv_dbu_i(w)
  li = sv_dbu_i(l)
  r = nil
  [[wi, li], [li, wi]].uniq.each do |x, y|
    kx = (x + 1) / 2 - 1
    ky = (y + 1) / 2 - 1
    kx = 0 if kx < 0
    ky = 0 if ky < 0
    rx = x - 2 * kx
    ry = y - 2 * ky
    s = sv_w(a.data.sized(-kx, -ky, 2))
    s = sv_w(s.data.with_bbox_width(rx, nil, false).with_bbox_height(ry, nil, false))
    sel = a.interacting(s)
    r = r ? r | sel : sel
  end
  opts[:neg] ? a - r : r
end

# ---------------------------------------------------------------------------
# Corner detection (ABUT == 90 INTERSECTING ONLY constructs)
# ---------------------------------------------------------------------------

def sv_corner_boxes_from_edges(e1, e2, d)
  # points where an edge of e1 meets an edge of e2 at 90 degrees
  h1 = e1.with_angle(0)
  v1 = e1.with_angle(90)
  h2 = e2.with_angle(0)
  v2 = e2.with_angle(90)
  x = 1.dbu
  bh1 = h1.extended(x, x, x, x)
  bv1 = v1.extended(x, x, x, x)
  bh2 = h2.extended(x, x, x, x)
  bv2 = v2.extended(x, x, x, x)
  ((bh1 & bv2) | (bv1 & bh2))
end

def sv_corner_check(kind, a, b, d, opts)
  out = opts[:out]
  if b.nil? && sv_kind(a) == :poly
    # single polygon layer: EXT -> concave corners, INT -> convex corners
    ang = (kind == "ext") ? 90 : -90
    c = a.corners(as_boxes, ang)
    if out
      e = a.edges
      return e.inside_part(c.sized(d))
    end
    # Calibre produces a triangle with legs d in the exterior (EXT) or
    # interior (INT) quadrant of the corner; use the quadrant square
    di = sv_dbu_i(d)
    q = c.sized(d - 1.dbu)
    q = (kind == "ext") ? (q - a) : (q & a)
    # triangle: clip the quadrant square with a diamond |dx|+|dy| <= d
    dia = RBA::Polygon::new([RBA::Point::new(-di, 0), RBA::Point::new(0, di), RBA::Point::new(di, 0),
                             RBA::Point::new(0, -di)])
    pts = a.corners(as_dots, ang)
    cd = pts.data
    cd = cd.dup.tap { |x| x.flatten } if cd.is_deep?
    dr = RBA::Region::new
    cd.each { |e| dr.insert(dia.moved(e.p1.x, e.p1.y)) }
    return q & sv_w(dr)
  end
  e1 = sv_e(a)
  e2 = b.nil? ? e1 : sv_e(b)
  c = sv_corner_boxes_from_edges(e1, e2, d)
  if out
    oe = (out == 2) ? e2 : e1
    ref = (out == 2) ? e1 : e2
    sel = oe.interacting(c) - (oe & ref)
    return sel.inside_part(c.sized(d))
  end
  c.sized(d * 0.5)
end

# ---------------------------------------------------------------------------
# Dimensional checks: EXT / INT / ENC
# ---------------------------------------------------------------------------

def sv_check(kind, a, b, cons, opts = {})
  # distance limits
  lo = nil
  hi = nil
  cons.each do |op, v|
    case op
    when "<" then hi = v
    when "<=" then hi = v + dbu
    when ">" then lo = v + dbu
    when ">=" then lo = v
    when "==" then lo = v; hi = v + dbu
    end
  end
  abut = opts[:abut]
  abut90 = abut && abut.any? { |op, v| op == "==" && v == 90.0 }
  if abut90 && (opts[:intersecting] == "only" || (hi || 0) <= 0.0101)
    # corner detection idiom
    return sv_corner_check(kind, a, b, hi || dbu, opts)
  end
  if opts[:intersecting] == "only"
    return sv_corner_check(kind, a, b, hi || dbu, opts)
  end
  if hi.nil?
    raise "SVRF: unbounded check"
  end

  ka = sv_kind(a)
  ka = :edge if ka == :ep
  a = sv_e(a) if ka == :edge
  if b
    kb = sv_kind(b)
    kb = :edge if kb == :ep
    b = sv_e(b) if kb == :edge
    if ka == :edge && kb == :poly
      b = b.edges
      kb = :edge
    elsif ka == :poly && kb == :edge
      a = a.edges
      ka = :edge
    end
  end
  edge_mode = (ka == :edge)

  args = [hi]
  case opts[:metric]
  when "opposite", "opposite_extended", "opposite_symmetric", "opposite_fsymmetric"
    args << projection
  when "square"
    args << square
  else
    args << euclidian
  end
  if abut
    lim = 90.0
    abut.each { |op, v| lim = v if op == "<" ; lim = v + 1e-3 if op == "<=" }
    lim = 180.0 if abut.any? { |op, v| op == "<" && v >= 180 }
    lim = 91.0 if abut90   # also measure perpendicular edges
    args << angle_limit(lim) if lim != 90.0
  end
  if opts[:projecting]
    pl, ph, _ = sv_frange(opts[:projecting])
    args << projection_limits(pl, ph)
  end
  eargs = args.dup
  unless edge_mode
    args << (opts[:exclude_shielded] ? shielded : transparent)
  end
  nargs = args.dup
  conn = nil
  if !opts[:connected].nil? && !edge_mode
    conn = opts[:connected]
    args << (conn ? props_eq : props_ne)
    a = sv_nets(a, opts[:netbase_a])
    b = sv_nets(b, opts[:netbase_b]) if b
  end

  # first: layer a edges; second: layer b edges (if any)
  case kind
  when "ext"
    if b.nil?
      if opts[:notch]
        ep = a.notch(*args)
      elsif opts[:space]
        ep = a.isolated(*args)
      else
        ep = a.space(*args)
      end
      swap = false
    else
      ep = a.separation(b, *args)
      swap = false
    end
  when "int"
    if b.nil?
      ep = a.width(*args)
    else
      ep = a.overlap(b, *args)
    end
    swap = false
  when "enc"
    raise "SVRF: ENC needs two layers" if b.nil?
    if !edge_mode && conn.nil?
      # Calibre only measures layer1 edges inside (or coincident with the
      # inside of) layer2
      ae = a.edges
      be = b.edges
      ain = ae.inside_part(b) + ((ae & be) & (a & b).edges)
      ep = be.enclosing(ain, *eargs)
    else
      ep = b.enclosing(a, *args)
    end
    swap = true
  end
  if abut.nil?
    # without ABUT, Calibre does not measure abutting/coincident edges
    ep = sv_w(ep.data.with_distance(1, nil, false))
  end
  if lo
    ep = sv_w(ep.data.with_distance(sv_dbu_i(lo), nil, false))
  end
  if kind == "ext" && !edge_mode && b.nil? && !ep.is_empty?
    # Calibre measures exterior space only: drop pairs measured across the
    # interior of the polygon that owns both edges (e.g. corner to corner
    # across a jog). Pairs between different polygons are kept even if a
    # third shape lies in between.
    cand = ep.polygons.overlapping(a)
    unless cand.is_empty?
      # only pairs whose region overlaps the layer need the (slow) test
      rest = sv_w(ep.data.not_interacting(cand.data))
      sus = sv_w(ep.data.interacting(cand.data))
      ar = a.overlapping(cand).data
      ar = ar.dup.tap { |x| x.flatten } if ar.is_deep?
      epd = sus.data
      epd = epd.dup.tap { |x| x.flatten } if epd.is_deep?
      if epd.count > 200000
        log("SVRF: too many candidate pairs (#{epd.count}) - interior filter skipped")
        epd = RBA::EdgePairs::new
        rest = ep
      end
      keep = RBA::EdgePairs::new
      # spatial index for the candidate owner polygons
      sh = RBA::Shapes::new
      am = ar.dup
      am.min_coherence = true
      am.merged_semantics = true
      am.merge
      am.each { |pp| sh.insert(pp) }
      epd.each do |p|
        q = RBA::Region::new(p.polygon(0))
        drop = false
        if q.area > 0
          loc = RBA::Region::new
          sh.each_touching(q.bbox) { |x| loc.insert(x.polygon) }
          owners = loc.overlapping(q)
          unless owners.is_empty?
            pe = owners.edges
            e1 = RBA::Edges::new(p.first)
            e2 = RBA::Edges::new(p.second)
            drop = (e1 - pe).is_empty? && (e2 - pe).is_empty?
          end
        end
        keep.insert(p) unless drop
      end
      ep = rest + sv_w(keep)
    end
  end
  if opts[:parallel] == "only"
    ep = ep.with_internal_angle(0)
  elsif opts[:parallel] == "not"
    ep = ep.without_internal_angle(0)
  end
  if abut90
    # drop degenerate (point-like) edge pairs
    ep = sv_w(ep.data.with_length_both(1, nil, false))
  end
  if opts[:perp] == "only"
    ep = ep.with_internal_angle(90)
  elsif opts[:perp] == "not"
    ep = ep.without_internal_angle(90)
  end
  if opts[:not_projecting]
    # keep only pairs with no projection: approximation - corner pairs
    ep = ep.without_internal_angle(0)
  end
  if conn != nil
    ep = sv_w(ep.data.remove_properties) rescue ep
  end

  extra = nil
  if opts[:outside_also] && kind == "enc"
    # parts of a outside b count as violations
    ap = edge_mode ? nil : a
    if ap
      # pieces of a outside b that carry edges of a (holes of b inside a,
      # e.g. metal slots, are not flagged)
      oe = ap.edges.outside_part(b)
      extra = (ap - b).interacting(oe) unless oe.is_empty?
    end
  end

  out = opts[:out]
  if out
    if b.nil?
      r = ep.edges
    else
      first = swap ? ep.second_edges : ep.first_edges
      second = swap ? ep.first_edges : ep.second_edges
      r = (out == 1) ? first : second
    end
    if extra && out == 1
      r = r + (sv_e(a).outside_part(b))
    end
    return r
  end
  if opts[:region]
    r = sv_ep_region(ep, swap)
    if conn != nil && extra.nil?
      # regions of different nets stay separate polygons in Calibre
      rr = ep.polygons.raw
      return rr
    end
    r = r | extra if extra
    return r.merged
  end
  if extra
    return sv_ep_region(ep, swap) | extra
  end
  ep
end

# edge pairs to regions; zero-distance pairs become thin strips like Calibre
def sv_ep_region(ep, inner_second = false)
  z = sv_w(ep.data.with_distance(0, 1, false))
  nz = sv_w(ep.data.with_distance(1, nil, false))
  r = nz.polygons
  unless z.is_empty?
    if inner_second
      # ENC: strip on the inside of the enclosed edge
      r = r | z.second_edges.extended_in(4.dbu)
    else
      r = r | z.polygons(2.dbu)
    end
  end
  r
end

# ---------------------------------------------------------------------------
# RECTANGLE ENCLOSURE
# ---------------------------------------------------------------------------

# goods: list of specs; each spec is a list of 4 [value, opposite] pairs given
# cyclically around the rectangle.
def sv_rect_enc(a, b, goods, opts = {})
  a = sv_p(a)
  b = sv_p(b)
  rects = a.rectangles
  bad_all = nil
  # parts outside b
  outside = rects.interacting(rects - b)
  cache = {}
  fail_dir = lambda do |t|
    k = t
    next cache[k] if cache[k]
    if t <= 0.0
      cache[k] = [outside, outside]
      next cache[k]
    end
    ep = b.enclosing(rects, t, projection, transparent)
    ie = ep.second_edges
    fh = rects.interacting(ie.with_angle(0)) | outside   # bottom/top sides fail
    fv = rects.interacting(ie.with_angle(90)) | outside  # left/right sides fail
    cache[k] = [fh, fv]
  end
  goods.each do |spec|
    vals = spec.collect { |v, o| v }
    vals = vals + [vals[-1]] * (4 - vals.size) if vals.size < 4
    # sides are given cyclically: s0, s1, s2, s3 ; s0/s2 opposite, s1/s3 opposite
    p = [vals[0], vals[2]].max
    q = [vals[1], vals[3]].max
    fhp, fvp = fail_dir.call(p)
    fhq, fvq = fail_dir.call(q)
    # orientation 1: vertical sides (left/right) need p, horizontal sides need q
    bad1 = fvp | fhq
    # orientation 2: vertical sides need q, horizontal need p
    bad2 = fvq | fhp
    bad = bad1 & bad2
    bad_all = bad_all ? (bad_all & bad) : bad
  end
  bad_all ||= rects - rects
  bad_all
end

# ---------------------------------------------------------------------------
# DENSITY
# ---------------------------------------------------------------------------

def sv_density(layers, cons, opts = {})
  l = sv_p(layers[0])
  layers[1..-1].each { |x| l = l | sv_p(x) } if layers.size > 1
  ext = sv_extent.data.bbox
  bound = nil
  if opts[:inside_of_layer]
    bound = sv_p(opts[:inside_of_layer])
    ext = bound.data.bbox
  end
  return polygons if ext.empty?
  win = opts[:window]
  r = RBA::Region::new
  lflat = l.data.dup
  lflat.flatten
  bflat = nil
  if bound
    bflat = bound.data.dup
    bflat.flatten
  end
  boxes = []
  if win.nil?
    boxes << ext
  else
    wx = sv_dbu_i(win)
    wy = sv_dbu_i(opts[:window_y] || win)
    sx = sv_dbu_i(opts[:step] || win)
    sy = sv_dbu_i(opts[:step_y] || opts[:step] || win)
    x = ext.left
    while true
      y = ext.bottom
      x1 = x
      x2 = x + wx
      if x2 > ext.right
        if opts[:backup]
          x1 = [ext.right - wx, ext.left].max
          x2 = ext.right
        else
          x2 = ext.right
        end
      end
      while true
        y1 = y
        y2 = y + wy
        if y2 > ext.top
          if opts[:backup]
            y1 = [ext.top - wy, ext.bottom].max
            y2 = ext.top
          else
            y2 = ext.top
          end
        end
        boxes << RBA::Box::new(x1, y1, x2, y2)
        break if y + wy >= ext.top
        y += sy
      end
      break if x + wx >= ext.right
      x += sx
    end
  end
  dens = {}
  boxes.each do |bx|
    wr = RBA::Region::new(bx)
    wr = wr & bflat if bflat
    wa = wr.area
    next if wa <= 0
    a = (lflat & wr).area
    dens[bx] = a.to_f / wa
  end
  if opts[:gradient]
    # compare neighbouring windows
    g = opts[:gradient]
    keys = dens.keys
    bad = {}
    keys.each do |k1|
      keys.each do |k2|
        next if k1 == k2
        next unless k1.touches?(k2) && !(k1 & k2).area > 0 rescue nil
        next unless (k1.left == k2.right || k1.right == k2.left || k1.top == k2.bottom || k1.bottom == k2.top)
        d = (dens[k1] - dens[k2]).abs
        if sv_cons_ok(g, d) && sv_cons_ok(cons, dens[k1])
          bad[k1] = true
        end
      end
    end
    bad.keys.each { |k| r.insert(k) }
  else
    dens.each do |k, v|
      r.insert(k) if sv_cons_ok(cons, v)
    end
  end
  r = r & bflat if bflat
  sv_w(r)
end

# ---------------------------------------------------------------------------
# DFM operations (subset)
# ---------------------------------------------------------------------------

def sv_dfm_space(args, cons, opts = {})
  a = sv_p(args[0])
  lo, hi, _ = sv_frange(cons)
  if opts[:by] == "int"
    ep = args.size > 1 ? a.overlap(sv_p(args[1]), hi, projection) : a.width(hi, projection)
  elsif opts[:by] == "enc"
    ep = sv_p(args[1]).enclosing(a, hi, projection)
  else
    ep = args.size > 1 ? a.separation(sv_p(args[1]), hi, projection) : a.space(hi, projection)
  end
  ep
end

def sv_dfm_copy(a, mode)
  case mode
  when "edge" then sv_e(a)
  when "region" then sv_p(a)
  else a
  end
end

# Subset: DFM PROPERTY P E1 E2 [NAME = LENGTH(E1)/LENGTH(E2)] cons
# -> polygons of P for which the ratio of summed lengths of interacting
#    E1/E2 edges satisfies cons.
def sv_dfm_property(layers, props)
  p = sv_p(layers[0])
  names = {}
  layers[1..-1].each_with_index { |l, i| names[i] = l }
  props.each do |expr, cons|
    m = expr.gsub(" ", "").match(/=LENGTH\((\w+)\)\/LENGTH\((\w+)\)$/i)
    raise "SVRF: DFM PROPERTY expression not supported: #{expr}" unless m
  end
  expr, cons = props[0]
  e1 = sv_e(layers[1])
  e2 = sv_e(layers[2])
  pf = p.data.dup; pf.flatten
  e1f = e1.data.dup; e1f.flatten
  e2f = e2.data.dup; e2f.flatten
  r = RBA::Region::new
  pf.each do |poly|
    pr = RBA::Region::new(poly)
    l1 = e1f.interacting(pr).length
    l2 = e2f.interacting(pr).length
    next if l2 == 0
    r.insert(poly) if sv_cons_ok(cons, l1.to_f / l2.to_f)
  end
  sv_w(r)
end

# ---------------------------------------------------------------------------
# Connectivity based operations
# ---------------------------------------------------------------------------

$sv_netter_ready = false
def sv_setup_connect
  return if $sv_netter_ready
  $sv_netter_ready = true
  # evaluate all layers before the first connect statement
  $sv_connects.each do |layers, via|
    (layers + [via]).compact.each { |n| sv_p($sv_G[n]) }
  end
  $sv_connects.each do |layers, via|
    ls = layers.collect { |n| sv_p($sv_G[n]) }
    if via
      v = sv_p($sv_G[via])
      ls.each { |l| connect(l, v) }
    else
      (1...ls.size).each { |i| connect(ls[0], ls[i]) }
    end
  end
end

# net-annotated version of a; a may be derived from a connectivity layer
# "base" (Calibre propagates node ids through derivations)
def sv_nets(a, base = nil)
  sv_setup_connect
  if base.nil? || base.equal?(a)
    return a.nets(prop(1))
  end
  bn = sv_p(base).nets(prop(1))
  sv_w(bn.data.and(a.data, RBA::Region::NoPropertyConstraint))
end

def sv_has_props(l)
  return false unless sv_kind(l) == :poly
  l.data.each { |p| return p.properties.size > 0 }
  false
end

def sv_netids(l)
  ids = {}
  d = l.data
  d.each { |p| v = p.property(1); ids[v] = true unless v.nil? }
  ids
end

# Subset: "NET AREA RATIO A B > 0" -> polygons of A on nets which have B
def sv_net_area_ratio(layers, expr, cons, opts = {})
  sv_setup_connect
  bases = opts[:bases] || []
  a = sv_p(layers[0])
  b = sv_p(layers[1])
  if expr.nil? && cons.size == 1 && cons[0][0] == ">" && cons[0][1] == 0.0
    an = sv_has_props(a) ? a : sv_nets(a, bases[0])
    bn = sv_has_props(b) ? b : sv_nets(b, bases[1])
    ids = sv_netids(bn)
    r = RBA::Region::new
    an.data.each { |p| r.insert(p) if ids[p.property(1)] }
    return sv_w(r)
  end
  # general form: [AREA(L2)/const] or [AREA(L2)/AREA(L1)] evaluated per net
  if expr
    e = expr.gsub(" ", "")
    m = e.match(/^AREA\((\w+)\)\/(AREA\((\w+)\)|[0-9.eE+-]+)$/i)
    raise "SVRF: NET AREA RATIO expression not supported: #{expr}" unless m
    an = sv_has_props(a) ? a : sv_nets(a, bases[0])
    bn = sv_has_props(b) ? b : sv_nets(b, bases[1])
    u2 = dbu * dbu
    area_b = Hash.new(0.0)
    bn.data.each { |p| area_b[p.property(1)] += p.area * u2 }
    area_a = Hash.new(0.0)
    an.data.each { |p| area_a[p.property(1)] += p.area * u2 }
    r = RBA::Region::new
    an.data.each do |p|
      id = p.property(1)
      den = m[3] ? area_a[id] : m[2].to_f
      next if den == 0
      r.insert(p) if sv_cons_ok(cons, area_b[id] / den)
    end
    return sv_w(r)
  end
  raise "SVRF: NET AREA RATIO form not supported"
end

# ---------------------------------------------------------------------------
# DRC INCREMENTAL CONNECT YES (antenna decks): a NET AREA RATIO check only sees
# the CONNECT statements above it. "stage" is their number; the connectivity of
# a stage is set up on demand (clear_connections + the first <stage> connects).
# ---------------------------------------------------------------------------
$sv_incremental = false
$sv_stage_cur = nil

def sv_stage(stage)
  conns = $sv_connects[0...stage]
  # evaluate the layers first: they may need another stage themselves
  conns.each { |layers, via| (layers + [via]).compact.each { |n| sv_p($sv_G[n]) } }
  return if $sv_stage_cur == stage
  clear_connections
  conns.each do |layers, via|
    ls = layers.collect { |n| sv_p($sv_G[n]) }
    if via
      v = sv_p($sv_G[via])
      ls.each { |l| connect(l, v) }
    else
      (1...ls.size).each { |i| connect(ls[0], ls[i]) }
    end
  end
  $sv_stage_cur = stage
  $sv_netter_ready = true
end

# NET AREA X constraint: polygons of X on nets whose X area meets the constraint
def sv_net_area(x, cons, stage)
  a = sv_p(x)
  sv_stage(stage)
  an = a.nets(prop(1))
  u2 = dbu * dbu
  area = Hash.new(0.0)
  an.data.each { |p| area[p.property(1)] += p.area * u2 }
  r = RBA::Region::new
  an.data.each { |p| r.insert(p.to_simple_polygon) if sv_cons_ok(cons, area[p.property(1)]) }
  sv_w(r)
end

# NET AREA RATIO L1 ... Ln constraint [expr] [ACCUMULATE [acc]] at a connectivity stage.
#   names: the layer names as used in expr; fn: lambda(area_hash, perimeter_hash) per net
#   (um2 / um); acc: nil (plain), true (start of an accumulation) or the layer of a
#   previous accumulation. Semantics settled against Calibre (tests/antenna):
#   * the value is evaluated per net; nets where it is not finite (no gate) are skipped;
#   * plain: the result are the L1 polygons of the nets meeting the constraint;
#   * ACCUMULATE: per polygon of the last layer (the gate) the value is the net value
#     plus the value the same gate has in <acc>; the result are those gate polygons,
#     and the accumulated values are kept on the result for later ACCUMULATE <it>.
def sv_nar(layers, names, fn, cons, stage, acc = nil, bases = [])
  ls = layers.collect { |l| sv_p(l) }
  bs = bases.collect { |b| b ? sv_p(b) : nil }
  prev = nil
  if acc && acc != true
    al = sv_p(acc)
    prev = al.instance_variable_get(:@sv_acc) || {}
  end
  sv_stage(stage)
  u = dbu
  u2 = u * u
  area = Hash.new { |h, k| h[k] = Hash.new(0.0) }
  perim = Hash.new { |h, k| h[k] = Hash.new(0.0) }
  first = []
  last = []
  ls.each_with_index do |l, i|
    n = names[i]
    begin
      ln = l.nets(prop(1))
    rescue => ex
      # not in the connectivity: nets of the layer it is derived from
      raise ex unless bs[i]
      ln = sv_w(bs[i].nets(prop(1)).data.and(l.data, RBA::Region::NoPropertyConstraint))
    end
    ln.data.each do |p|
      id = p.property(1)
      area[id][n] += p.area * u2
      perim[id][n] += p.perimeter * u
      first << [p, id] if i == 0
      last << [p, id] if i == ls.size - 1
    end
  end
  val = {}
  area.each do |id, a|
    v = fn.call(a, perim[id]).to_f
    val[id] = v if v.finite?
  end
  r = RBA::Region::new
  if acc
    accmap = {}
    last.each do |p, id|
      next unless val.has_key?(id)
      sp = p.to_simple_polygon
      key = sp.to_s
      v = val[id] + (prev ? (prev[key] || 0.0) : 0.0)
      accmap[key] = v
      r.insert(sp) if sv_cons_ok(cons, v)
    end
    out = sv_w(r)
    out.instance_variable_set(:@sv_acc, accmap)
    return out
  end
  first.each { |p, id| r.insert(p.to_simple_polygon) if val.has_key?(id) && sv_cons_ok(cons, val[id]) }
  r.merge   # Calibre reports the merged polygons of the first layer
  sv_w(r)
end

# STAMP A BY B: A polygons get the nets of B
def sv_stamp(a, b, base = nil)
  bn = sv_has_props(b) ? b : sv_nets(b, base)
  sv_w(bn.data.and(sv_p(a).data, RBA::Region::NoPropertyConstraint))
end

# DRAWN SKEW / ANGLED: non-orthogonal edges of all drawn layers
def sv_drawn(kind, layers)
  e = nil
  layers.each do |l|
    x = l.edges.without_angle(0).without_angle(90)
    e = e ? e + x : x
  end
  e ||= polygons.edges
  if kind == "acute" || kind == "offgrid"
    raise "SVRF: DRAWN #{kind} not supported"
  end
  e
end

# ---------------------------------------------------------------------------
# Rule execution and output
# ---------------------------------------------------------------------------

def sv_out_layer(name, desc, l)
  l.output(name, desc)
end

def sv_run_rules
  sel = $sv_select
  unsel = $sv_unselect
  n = 0
  $sv_rules.each do |name, desc, blk|
    next if sel && !(name =~ sel)
    next if unsel && (name =~ unsel)
    t0 = Time.now
    outs = []
    begin
      blk.call(outs)
      # outputs are evaluated after all local layers of the rule are defined
      outs = outs.collect { |o| o.is_a?(Proc) ? o.call : o }
      outs.each_with_index do |o, i|
        if $sv_flat
          d = o.data.dup
          d.flatten
          o = sv_w(d)
        end
        o.output(name, desc)
      end
      n += 1
    rescue => ex
      $sv_failed << [name, ex.to_s]
      log("SVRF rule #{name} FAILED: #{ex}")
      if $sv_strict
        raise ex
      end
    end
    dt = Time.now - t0
    log("SVRF rule #{name}: #{'%.2f' % dt}s") if $sv_verbose
  end
  n
end

# ============================================================================
# SVRF LVS runtime for KLayout (used together with svrf_runtime.rb)
#
# Implements Calibre "DEVICE" statements with a generic device extractor:
# every polygon of the seed layer becomes a device; pins are found from the
# pin layer shapes touching the seed shape (or covering it for well pins).
# ============================================================================

$sv_devices = {}      # key -> spec
$sv_dev_order = []
$sv_attach = []
$sv_filters = []

def sv_filter(type, model, mode)
  $sv_filters << [type, model, mode]
end
$sv_custom_classes = {}   # name -> [kind, nterm]  (for the SPICE reader)

WELL_PIN_RE = /well|^dnw$|pnp_col|bulk|mom_nw|mom_pw|psub/i

def sv_attach(text_specs, target)
  $sv_attach << [text_specs, target]
end

# kind of device class from the Calibre element type
def sv_dev_kind(type, pins)
  t = type.upcase
  names = pins.collect { |l, p| p.to_s.upcase }
  return :mos if t =~ /^M[NPD]?$/
  return :diode if t == "D"
  return :bjt if t == "Q"
  return :res3 if names.include?("SUB") && t =~ /^RE_/
  return :res if t =~ /^RE_/
  return :cap3 if names.size >= 3
  :cap
end

def sv_device(type, model, seed, pins, macro)
  kind = sv_dev_kind(type, pins)
  cname = model || type
  sig = pins.collect { |l, p| (l.upcase == seed.upcase ? "@SEED" : l.upcase) + ":" + p.to_s.upcase }.join(",")
  key = [type.upcase, cname, sig].join("|")
  if $sv_devices[key]
    $sv_devices[key][:seeds] << seed unless $sv_devices[key][:seeds].include?(seed)
  else
    $sv_devices[key] = { :type => type, :name => cname, :kind => kind, :seeds => [seed], :pins => pins,
                         :macro => macro, :seed0 => seed }
    $sv_dev_order << key
  end
  if kind == :res || kind == :res3 || kind == :cap || kind == :cap3
    $sv_custom_classes[cname.upcase] = [kind, pins.size]
  end
end

def sv_make_class(kind, name)
  c = case kind
      when :mos then RBA::DeviceClassMOS4Transistor::new
      when :diode then RBA::DeviceClassDiode::new
      when :bjt then RBA::DeviceClassBJT3Transistor::new
      when :res then RBA::DeviceClassResistor::new
      when :res3 then RBA::DeviceClassResistorWithBulk::new
      when :cap then RBA::DeviceClassCapacitor::new
      when :cap3 then RBA::DeviceClassCapacitorWithBulk::new
      end
  c.name = name
  c
end

# terminal name of the KLayout class for a Calibre pin name
def sv_term_name(kind, pin, index)
  p = pin.to_s.upcase
  case kind
  when :mos
    return p if %w(S D G B).include?(p)
    return %w(G S D B)[index]
  when :diode
    return "A" if p == "POS" || p == "P" || p == "A"
    return "C"
  when :bjt
    return p if %w(C B E).include?(p)
    return %w(C B E)[index]
  when :res, :res3
    return "A" if p == "POS"
    return "B" if p == "NEG"
    return "W"
  when :cap, :cap3
    return "A" if p == "POS" || index == 0
    return "B" if p == "NEG" || index == 1
    return "W"
  end
end

class SvDeviceExtractor < RBA::GenericDeviceExtractor

  # pins: array of [layer_key, pin_name, mode]  mode: :seed, :adjacent, :cover
  def initialize(name, kind, pins, macro)
    @kind = kind
    @pins = pins
    @macro = macro.to_s.upcase
    @lkeys = ["SEED"]
    pins.each { |lk, pn, mode| @lkeys << lk unless mode == :seed || @lkeys.include?(lk) }
    create
    self.name = name
  end

  def layer_keys
    @lkeys
  end

  def setup
    @lkeys.each { |k| define_layer(k, k) }
    c = case @kind
        when :mos then RBA::DeviceClassMOS4Transistor::new
        when :diode then RBA::DeviceClassDiode::new
        when :bjt then RBA::DeviceClassBJT3Transistor::new
        when :res then RBA::DeviceClassResistor::new
        when :res3 then RBA::DeviceClassResistorWithBulk::new
        when :cap then RBA::DeviceClassCapacitor::new
        when :cap3 then RBA::DeviceClassCapacitorWithBulk::new
        end
    c.name = self.name
    register_device_class(c)
  end

  def get_connectivity(layout, layers)
    conn = RBA::Connectivity::new
    conn.connect(layers[0], layers[0])
    @pins.each do |lk, pn, mode|
      next unless mode == :adjacent
      conn.connect(layers[0], layers[@lkeys.index(lk)])
    end
    conn
  end

  def extract_devices(lg)
    seeds = lg[0].merged
    dbu = sdbu
    seeds.each do |sp|
      sr = RBA::Region::new(sp)
      # candidates per adjacent layer
      cands = {}
      @pins.each do |lk, pn, mode|
        next unless mode == :adjacent
        next if cands[lk]
        r = lg[@lkeys.index(lk)].merged.interacting(sr)
        # require edge contact (not only a corner)
        polys = []
        se = sr.edges
        r.each do |p|
          co = (RBA::Region::new(p).edges & se).length
          ov = (RBA::Region::new(p) & sr).area
          polys << [p, co] if co > 0 || ov > 0
        end
        polys.sort_by! { |p, co| [p.bbox.left, p.bbox.bottom] }
        cands[lk] = polys
      end
      used = Hash.new(0)
      terms = []
      ok = true
      @pins.each_with_index do |(lk, pn, mode), i|
        if mode == :seed
          terms << [i, 0, sp]
        elsif mode == :cover
          terms << [i, @lkeys.index(lk), sp]
        else
          c = cands[lk]
          if c.empty?
            ok = false
            break
          end
          k = [used[lk], c.size - 1].min
          used[lk] += 1
          terms << [i, @lkeys.index(lk), c[k][0]]
        end
      end
      next unless ok
      dev = create_device
      area = sp.area * dbu * dbu
      perim = sp.perimeter * dbu
      # coincident perimeter with the first adjacent layer
      pco = 0.0
      first_adj = @pins.find { |lk, pn, mode| mode == :adjacent }
      if first_adj
        pco = cands[first_adj[0]].inject(0) { |s, pc| s + pc[1] } * dbu
      end
      case @kind
      when :mos
        w = (@macro == "MOS_ESD_LVS") ? pco : pco / 2.0
        w = perim / 4.0 if w <= 0
        dev.set_parameter("W", w)
        dev.set_parameter("L", area / w)
      when :diode
        dev.set_parameter("A", area)
        dev.set_parameter("P", perim)
      when :bjt
        dev.set_parameter("AE", area)
        dev.set_parameter("PE", perim)
      when :res, :res3
        w = pco / 2.0
        w = perim / 4.0 if w <= 0
        l = area / w
        dev.set_parameter("W", w)
        dev.set_parameter("L", l)
        dev.set_parameter("R", l / w)
        dev.set_parameter("A", area)
        dev.set_parameter("P", perim)
      when :cap, :cap3
        dev.set_parameter("A", area)
        dev.set_parameter("P", perim)
        dev.set_parameter("C", area)
      end
      cls = dev.device_class
      terms.each do |i, li, poly|
        tn = sv_term_name_local(@pins[i][1], i)
        tid = cls.terminal_id(tn)
        define_terminal(dev, tid, li, poly)
      end
    end
  end

  def sv_term_name_local(pin, index)
    p = pin.to_s.upcase
    case @kind
    when :mos
      return p if %w(S D G B).include?(p)
      return %w(G S D B)[index]
    when :diode
      return (p == "POS" || p == "P" || p == "A") ? "A" : "C"
    when :bjt
      return p if %w(C B E).include?(p)
      return %w(C B E)[index]
    when :res, :res3
      return "A" if p == "POS"
      return "B" if p == "NEG"
      return "W"
    else
      return "A" if p == "POS" || index == 0
      return "B" if p == "NEG" || index == 1
      return "W"
    end
  end
end

# SPICE reader which understands CDL style netlists
class SvSpiceReader < RBA::NetlistSpiceReaderDelegate

  def initialize(custom)
    @custom = custom
  end

  def start(netlist)
    @nl = netlist
  end

  def wants_subcircuit(name)
    @custom.has_key?(name.upcase)
  end

  def control_statement(line)
    false
  end

  def parse_element(s, element)
    # remove CDL "/" separators and $ comments/props
    s = s.gsub(/\s\/\s/, " ").gsub(/\$\S*=\S+/, "").gsub(/\$\[[^\]]*\]/, "").gsub(/\$[A-Za-z_.]+/, "")
    super(s, element)
  end

  def element(circuit, el, name, model, value, nets, params)
    if el == "X" && @custom.has_key?(model.upcase)
      kind, nterm = @custom[model.upcase]
      cls = circuit.netlist.device_class_by_name(model) rescue nil
      if cls.nil?
        cls = case kind
              when :res then RBA::DeviceClassResistor::new
              when :res3 then RBA::DeviceClassResistorWithBulk::new
              when :cap then RBA::DeviceClassCapacitor::new
              else RBA::DeviceClassCapacitorWithBulk::new
              end
        cls.name = model
        circuit.netlist.add(cls)
      end
      dev = circuit.create_device(cls, name)
      tn = (kind == :res || kind == :res3) ? %w(A B W) : %w(A B W)
      nets.each_with_index do |n, i|
        break if i >= tn.size
        next unless cls.has_terminal?(tn[i])
        dev.connect_terminal(tn[i], n)
      end
      w = (params["W"] || 0.0) * 1e6
      l = (params["L"] || 0.0) * 1e6
      if kind == :res || kind == :res3
        dev.set_parameter("W", w)
        dev.set_parameter("L", l)
        dev.set_parameter("R", w > 0 ? l / w : 0.0)
      end
      m = params["M"] || params["MR"]
      return true
    end
    if el == "D"
      # CDL diodes: AREA / PJ
      ok = super(circuit, el, name, model, value, nets, params)
      return ok
    end
    super(circuit, el, name, model, value, nets, params)
  end
end

def sv_lvs_extract
  g = $sv_G
  sv_implicit_nets
  # Evaluate all layers first: derived layers must exist before the first
  # connect statement is issued.
  names = []
  $sv_connects.each { |layers, via| names += layers; names << via if via }
  $sv_attach.each { |specs, target| names << target }
  $sv_devices.each { |k, spec| names += spec[:seeds]; spec[:pins].each { |l, p| names << l } }
  names.uniq.each do |n|
    begin
      sv_p(g[n])
    rescue => ex
    end
  end
  # connectivity
  n_ok = 0
  $sv_connects.each do |layers, via|
    begin
      ls = layers.collect { |n| sv_p(g[n]) }
      if via
        v = sv_p(g[via])
        ls.each { |l| connect(l, v) }
      else
        (1...ls.size).each { |i| connect(ls[0], ls[i]) }
      end
      n_ok += 1
    rescue => ex
      log("SVRF LVS: skipping CONNECT #{layers.join(' ')}#{via ? ' BY ' + via : ''}: #{ex}")
    end
  end
  $sv_netter_ready = true
  # labels
  $sv_attach.each do |specs, target|
    begin
      t = sv_p(g[target])
      specs.each do |l, d|
        connect(t, labels(l, d))
      end
    rescue => ex
      log("SVRF LVS: skipping ATTACH to #{target}: #{ex}")
    end
  end
  # devices
  $sv_dev_order.each do |key|
    spec = $sv_devices[key]
    begin
      seeds = spec[:seeds].collect { |s| sv_p(g[s]) }
      seed = seeds[0]
      if seeds.size > 1
        seeds[1..-1].each { |s| seed = seed | s }
        seeds.each { |s| connect(seed, s) }
      end
      next if seed.is_empty?
      counts = Hash.new(0)
      spec[:pins].each { |l, p| counts[l.upcase] += 1 }
      pins = []
      layers = { "SEED" => seed }
      spec[:pins].each do |l, p|
        lu = l.upcase
        if spec[:seeds].collect { |s| s.upcase }.include?(lu)
          pins << ["SEED", p, :seed]
        else
          mode = (counts[lu] == 1 && lu =~ WELL_PIN_RE) ? :cover : :adjacent
          pins << [lu, p, mode]
          layers[lu] ||= sv_p(g[l])
        end
      end
      ex = SvDeviceExtractor::new(spec[:name], spec[:kind], pins, spec[:macro])
      extract_devices(ex, layers)
    rescue => e
      log("SVRF LVS: skipping DEVICE #{spec[:type]}(#{spec[:name]}): #{e}")
    end
  end
end


# ---------------------------------------------------------------------------
# LVS REDUCE SPLIT GATES: parallel series stacks of MOS devices with the same
# gate nets (in the same order) between the same end nets are merged into a
# single stack (widths are added).
# ---------------------------------------------------------------------------
def sv_reduce_split_gates(nl)
  nmerged = 0
  # net identity: the (expanded) name - cluster ids only exist in extracted netlists
  nk = lambda { |n| n.expanded_name }
  nl.each_circuit do |c|
    changed = true
    while changed
      changed = false
      # internal stack nodes: nets with exactly two MOS S/D terminals
      inner = {}
      c.each_net do |n|
        next unless n.pin_count == 0 && n.subcircuit_pin_count == 0 && n.terminal_count == 2
        ok = true
        n.each_terminal do |t|
          cls = t.device.device_class
          ok = false unless cls.is_a?(RBA::DeviceClassMOS3Transistor)
          tn = cls.terminal_definition(t.terminal_id).name
          ok = false unless tn == "S" || tn == "D"
        end
        inner[nk.call(n)] = n if ok
      end
      next if inner.empty?
      sd = lambda do |d|
        cls = d.device_class
        [d.net_for_terminal(cls.terminal_id("S")), d.net_for_terminal(cls.terminal_id("D"))]
      end
      # build chains starting at devices having one non-inner end
      visited = {}
      chains = {}
      c.each_device do |d0|
        next unless d0.device_class.is_a?(RBA::DeviceClassMOS3Transistor)
        next if visited[d0.id]
        a, b = sd.call(d0)
        next if a.nil? || b.nil?
        ia = inner[nk.call(a)]
        ib = inner[nk.call(b)]
        next if ia && ib          # middle of a chain
        next if !ia && !ib        # no stack
        start = ia ? b : a
        devs = [d0]
        cur = ia ? a : b
        prev = d0
        valid = true
        while inner[nk.call(cur)]
          nxt = nil
          cur.each_terminal { |t| nxt = t.device if t.device.id != prev.id }
          if nxt.nil? || nxt.device_class.id != d0.device_class.id
            valid = false
            break
          end
          x, y = sd.call(nxt)
          devs << nxt
          prev = nxt
          cur = (nk.call(x) == nk.call(cur)) ? y : x
          break if devs.size > 64
        end
        next unless valid
        stop = cur
        devs.each { |d| visited[d.id] = true }
        cls = d0.device_class
        gid = cls.terminal_id("G")
        bid = cls.has_terminal?("B") ? cls.terminal_id("B") : nil
        gates = devs.collect { |d| g = d.net_for_terminal(gid); [g ? nk.call(g) : "", (d.parameter("L") * 1e4).round] }
        if nk.call(start) > nk.call(stop)
          start, stop = stop, start
          devs = devs.reverse
          gates = gates.reverse
        elsif nk.call(start) == nk.call(stop)
          next
        end
        bn = bid ? devs[0].net_for_terminal(bid) : nil
        key = [cls.id, nk.call(start), nk.call(stop), bn ? nk.call(bn) : "", gates]
        (chains[key] ||= []) << devs
      end
      chains.each do |key, list|
        next if list.size < 2
        keep = list[0]
        list[1..-1].each do |other|
          other.each_with_index do |d, i|
            keep[i].set_parameter("W", keep[i].parameter("W") + d.parameter("W"))
            c.remove_device(d)
          end
          nmerged += 1
        end
        changed = true
      end
      c.purge_nets if changed
    end
  end
  nmerged
end


# ---------------------------------------------------------------------------
# Options for library level regression: tapless cells and implicit nets
# ---------------------------------------------------------------------------

def sv_bool_opt(v)
  %w(1 true yes on).include?(v.to_s.downcase)
end

# -rd implicit_nets="VDD VSS CELL:LABEL": nets with the same label are joined
# by name (KLayout connect_implicit), e.g. supply rails which are only
# connected through the ring outside of a standalone IO cell
def sv_implicit_nets
  ($implicit_nets || "").split(/[\s,]+/).reject { |x| x.empty? }.each do |entry|
    cell, label = entry.split(":", 2)
    label ? connect_implicit(cell, label) : connect_implicit(cell)
  end
end

# A labelled net of a cell is a port even if the parent does not connect it
# (Calibre PORT LAYER TEXT)
def sv_expose_labeled_pins(nl, top_name)
  nl.each_circuit_bottom_up do |c|
    next if c.name == top_name
    c.each_net.to_a.each do |n|
      next if n.name.to_s.empty? || n.pin_count > 0
      pin = c.create_pin(n.name)
      c.connect_pin(pin, n)
      c.each_ref { |sc| sc.connect_pin(pin, sc.circuit.create_net) }
    end
  end
end

# -rd tapless=true: cells without taps are compared on their own. Nets which
# only carry MOS bulk terminals (the wells) are joined to the power net
# (p-channel devices) or the ground net (n-channel devices) of the circuit.
def sv_tie_tapless(nl, power, ground)
  n_joined = 0
  nl.each_circuit do |c|
    pwr = c.net_by_name(power)
    gnd = c.net_by_name(ground)
    wells = []
    c.each_net do |n|
      next if n.terminal_count == 0 || n.name == power || n.name == ground
      pol = nil
      ok = true
      n.each_terminal do |t|
        cls = t.device.device_class
        tn = cls.terminal_definition(t.terminal_id).name
        if cls.is_a?(RBA::DeviceClassMOS4Transistor) && tn == "B"
          x = (cls.name =~ /^p/i) ? :p : :n
          ok = false if pol && pol != x
          pol = x
        else
          ok = false
        end
      end
      wells << [n, pol] if ok && pol
    end
    wells.each do |n, pol|
      target = (pol == :p) ? pwr : gnd
      next unless target
      c.join_nets(target, n)
      n_joined += 1
    end
  end
  n_joined
end

# After nets have been joined inside a cell, several pins can sit on one net.
# Keep one pin and short the nets of the others in every parent.
def sv_merge_pins_on_same_net(nl)
  nl.each_circuit_bottom_up do |c|
    bynet = {}
    c.each_pin do |pin|
      n = c.net_for_pin(pin.id)
      next unless n
      (bynet[n.cluster_id] ||= []) << pin
    end
    bynet.each_value do |pins|
      next if pins.size < 2
      pins = pins.sort_by { |x| x.name.to_s.empty? ? 1 : 0 }
      keep = pins[0]
      pins[1..-1].each do |other|
        c.each_ref.to_a.each do |sc|
          a = sc.net_for_pin(keep.id)
          b = sc.net_for_pin(other.id)
          sc.disconnect_pin(other.id)
          if a && b
            sc.circuit.join_nets(a, b) if a.cluster_id != b.cluster_id
          elsif b
            sc.connect_pin(keep.id, b)
          end
        end
        c.disconnect_pin(other.id)
        c.remove_pin(other.id)
      end
    end
  end
end

# Two pins of a cell that are on the same net in every instance are shorted
# outside of the cell: join them into one pin (applied to both netlists).
def sv_join_shorted_pins(nl)
  nl.each_circuit_top_down do |c|
    refs = c.each_ref.to_a
    next if refs.empty?
    net_index = {}
    refs.collect { |r| r.circuit }.uniq { |x| x.name }.each do |parent|
      parent.each_net.each_with_index do |n, i|
        n.each_subcircuit_pin { |ref| net_index[[parent.name, ref.subcircuit.id, ref.pin_id]] = i }
      end
    end
    groups = c.each_pin.to_a.group_by do |pin|
      ids = refs.collect { |sc| net_index[[sc.circuit.name, sc.id, pin.id]] }
      ids.any? { |x| x.nil? } ? [:open, pin.id] : refs.collect { |sc| sc.circuit.name }.zip(ids)
    end
    groups.each_value do |pins|
      next if pins.size < 2
      keep = c.net_for_pin(pins[0].id)
      pins[1..-1].each do |pin|
        other = c.net_for_pin(pin.id)
        refs.each { |sc| sc.disconnect_pin(pin.id) }
        c.disconnect_pin(pin.id)
        c.join_nets(keep, other) if other && keep && other.cluster_id != keep.cluster_id
        c.remove_pin(pin.id)
      end
    end
  end
end

