$sv_G.define("ppoGate") { sv_sel_any("inside", $sv_G["poGate"], $sv_G["PP"], [], false, {}) }
$sv_G.define("ngpoly") { sv_sel_any("inside", sv_bool("NOT", $sv_G["gpoly"], $sv_G["poGate"]), $sv_G["NP"], [], false, {}) }
$sv_G.define("pgpoly") { sv_sel_any("inside", sv_bool("NOT", $sv_G["gpoly"], $sv_G["poGate"]), $sv_G["PP"], [], false, {}) }
