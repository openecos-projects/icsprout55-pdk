$sv_G.define("mom_gt") { sv_sel_any("interact", $sv_G["PO"], sv_with_text($sv_G["MOMLVS1"], sv_text([]), "mom_wips", false), [], false, {}) }
$sv_G.define("mom_nw") { sv_sel_any("enclose", $sv_G["nWell"], $sv_G["MOMLVS1"], [], false, {}) }
$sv_G.define("mom_pw") { sv_bool("NOT", $sv_G["pWell"], sv_sel_any("inside", $sv_G["pWell"], $sv_G["MOMLVS1"], [], false, {})) }
$sv_G.define("mom_wims") { sv_with_text($sv_G["MOMLVS1"], sv_text([]), "mom_wims", false) }
$sv_G.define("mom_terminal1") { sv_bool("AND", $sv_G["M1s"], $sv_G["mom_wims"]) }
if sv_ifdef("TOTALMETAL", "4")
  if sv_ifdef("TOP_METAL_NUM", "SINGLE")
    $sv_G.define("mom_metal1") { sv_bool("AND", $sv_G["M1s"], $sv_G["MOMLVS1"]) }
    $sv_G.define("mom_V1") { sv_bool("AND", $sv_G["VIA1"], $sv_G["MOMLVS1"]) }
    $sv_G.define("metal1b") { $sv_G["M1s"] }
    $sv_G.define("mom_metal2") { sv_bool("AND", $sv_G["M2s"], $sv_G["MOMLVS1"]) }
    $sv_G.define("mom_V2") { sv_bool("AND", $sv_G["VIA2"], $sv_G["MOMLVS1"]) }
    $sv_G.define("metal2b") { $sv_G["M2s"] }
    $sv_G.define("mom_metal3") { sv_bool("AND", $sv_G["M3s"], $sv_G["MOMLVS1"]) }
    $sv_G.define("metal3b") { $sv_G["M3s"] }
    $sv_G.define("mom_m1_m3_VA") { sv_bool("AND", $sv_G["mom_V1"], $sv_G["mom_V2"]) }
    $sv_G.define("mom_text") { sv_nary("OR", $sv_G["mom12reg_1"], $sv_G["mom13reg_1"], $sv_G["mom23reg_1"]) }
    $sv_G.define("mom12reg_1") { sv_with_text($sv_G["MOMLVS1"], sv_text([]), "momcap12", false) }
    $sv_G.define("mom12tt1") { sv_bool("AND", $sv_G["mom_metal1"], $sv_G["mom_metal2"]) }
    $sv_G.define("mom12f1") { sv_sel_any("interact", $sv_G["mom12tt1"], $sv_G["mom_V1"], [], true, {}) }
    $sv_G.define("mom12reg1") { sv_extents(sv_size(sv_bool("AND", $sv_G["mom12f1"], $sv_G["mom12reg_1"]), 0.1, {:inside_of => $sv_G["MOMLVS1"]})) }
    $sv_G.define("mom12tt2") { sv_sel_any("interact", sv_bool("AND", $sv_G["mom_metal1"], $sv_G["mom_metal2"]), $sv_G["mom_metal3"], [], true, {}) }
    $sv_G.define("mom12f2") { sv_sel_any("interact", $sv_G["mom12tt2"], $sv_G["mom_V1"], [], true, {}) }
    $sv_G.define("mom12reg2") { sv_sel_any("interact", sv_extents(sv_size($sv_G["mom12f2"], 0.1, {:inside_of => $sv_G["MOMLVS1"]})), $sv_G["mom_text"], [], true, {}) }
    $sv_G.define("mom12reg") { sv_bool("OR", $sv_G["mom12reg1"], $sv_G["mom12reg2"]) }
    $sv_G.define("mom12f") { sv_bool("OR", $sv_G["mom12f1"], $sv_G["mom12f2"]) }
    $sv_G.define("momcap12") { sv_bool("NOT", sv_bool("AND", sv_bool("NOT", sv_bool("NOT", $sv_G["mom12reg"], $sv_G["RFALL"]), $sv_G["RFTER"]), $sv_G["MOMLVS1"]), $sv_G["MOMLVS2"]) }
    $sv_G.define("momcap12_3t") { sv_bool("NOT", sv_bool("AND", sv_bool("AND", sv_bool("NOT", $sv_G["mom12reg"], $sv_G["RFALL"]), $sv_G["RFTER"]), $sv_G["MOMLVS1"]), $sv_G["MOMLVS2"]) }
