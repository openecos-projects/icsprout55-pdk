$sv_G.define("bulk") { sv_size(sv_extent(), 0.1, {}) }
$sv_G.define("PO") { sv_nary("OR", $sv_G["POLY"], $sv_G["POLYdm"]) }
$sv_G.define("AA") { sv_nary("OR", $sv_G["ACT"], $sv_G["ACTdm"]) }
$sv_G.define("AA_eff_reg") { sv_bool("OR", sv_sel_any("interact", $sv_G["AA"], $sv_G["CTs"], [], false, {}), sv_sel_any("interact", $sv_G["AA"], sv_sel_any("interact", $sv_G["PO"], $sv_G["CTs"], [], false, {}), [], false, {})) }
