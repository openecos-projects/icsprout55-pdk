+bjt12_p1      = 1.0            
+bjt12_p2      = 1.0            
+bjt12_par0    = 'bjt12_rnd0*bjt12_p0'      
+bjt12_par1    = 'bjt12_rnd1*bjt12_p1'      
+bjt12_par2    = 'bjt12_rnd2*bjt12_p2'      
.PARAM
+sigma_mis_bjt12_a= agauss(0,1,1)
+sigma_mis_bjt12_b= agauss(0,1,1)
