****************************
* mos varactor corner model
****************************
.LIB var_tt
.PARAM
+sigma_mis_var= agauss(0,1,1)
+ac0_var1p2_npd_nw_lp= 1.18E-14 bc0_var1p2_npd_nw_lp= 4.9E-9   cc0_var1p2_npd_nw_lp= 0       
+dcgg_var1p2_npd_nw_lp= 0        dtox_var1p2_npd_nw_lp= 0        
+sigma_mis_cgmin_area= agauss(0,3,3)
+sigma_mis_dcg_area= agauss(0,3,3)
+sigma_mis_xl= agauss(0,3,3)
+sigma_mis_xw= agauss(0,3,3)
+dcgmin_var2p5_npd_nw_lp= 1.0      dcg_var2p5_npd_nw_lp= 1.0      dxl_var2p5_npd_nw_lp= 0       
+dxw_var2p5_npd_nw_lp= 0       
.INC './var/varactor.ckt'
.ENDL var_tt

.LIB var_ss
.PARAM
+sigma_mis_var= agauss(0,1,1)
+ac0_var1p2_npd_nw_lp= 1.18E-14 bc0_var1p2_npd_nw_lp= 4.9E-9   cc0_var1p2_npd_nw_lp= 0       
+dcgg_var1p2_npd_nw_lp= -0.03    dtox_var1p2_npd_nw_lp= 4.8E-11  
+sigma_mis_cgmin_area= agauss(0,3,3)
+sigma_mis_dcg_area= agauss(0,3,3)
+sigma_mis_xl= agauss(0,3,3)
+sigma_mis_xw= agauss(0,3,3)
+dcgmin_var2p5_npd_nw_lp= 0.9      dcg_var2p5_npd_nw_lp= 0.965    dxl_var2p5_npd_nw_lp= 6.67E-9 
+dxw_var2p5_npd_nw_lp= -6.67E-9
.INC './var/varactor.ckt'
.ENDL var_ss

.LIB var_ff
.PARAM
+sigma_mis_var= agauss(0,1,1)
+ac0_var1p2_npd_nw_lp= 1.18E-14 bc0_var1p2_npd_nw_lp= 4.9E-9   cc0_var1p2_npd_nw_lp= 0       
+dcgg_var1p2_npd_nw_lp= 0.03     dtox_var1p2_npd_nw_lp= -4.8E-11 
+sigma_mis_cgmin_area= agauss(0,3,3)
+sigma_mis_dcg_area= agauss(0,3,3)
+sigma_mis_xl= agauss(0,3,3)
+sigma_mis_xw= agauss(0,3,3)
