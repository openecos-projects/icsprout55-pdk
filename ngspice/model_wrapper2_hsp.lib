******************************
*  bjt monte carlo model
****************************** 
.LIB bjt_core12_mc
.PARAM
+bjt12_rnd0    = agauss(0,1,3)  
+bjt12_rnd1    = agauss(0,1,3)  
+bjt12_rnd2    = agauss(0,1,3)  
