+dxw_var2p5_npd_nw_lp= 6.67E-9 
.INC './var/varactor.ckt'
.ENDL var_ff

.LIB var_mc
.PARAM
+var_rnd0    = agauss(0,1,3)  
+var_rnd1    = agauss(0,1,3)  
+var_rnd2    = agauss(0,1,3)  
+var_p0      = 1.0             
+var_p1      = 1.0             
+var_p2      = 1.0            
+var_par0    = 'var_rnd0*var_p0'      
+var_par1    = 'var_rnd1*var_p1'      
+var_par2    = 'var_rnd2*var_p2'      
.PARAM
+sigma_mis_var= agauss(0,1,1)
+ac0_var1var_p2_npd_nw_lp= '1.18E-14+(0)*var_par0+(0)*var_par1+(0)*var_par2'
+bc0_var1var_p2_npd_nw_lp= '4.9E-9+(0)*var_par0+(0)*var_par1+(0)*var_par2'
+cc0_var1var_p2_npd_nw_lp= '0+(0)*var_par0+(0)*var_par1+(0)*var_par2'
+dcgg_var1var_p2_npd_nw_lp= '0+(0.03)*var_par0+(-8.4814e-12)*var_par1+(-7.4300e-11)*var_par2'
+dtox_var1var_p2_npd_nw_lp= '0+(-4.8E-11)*var_par0+(1.3570e-20)*var_par1+(1.1888e-19)*var_par2'
+sigma_mis_cgmin_area= agauss(0,3,3)
+sigma_mis_dcg_area= agauss(0,3,3)
+sigma_mis_xl= agauss(0,3,3)
+sigma_mis_xw= agauss(0,3,3)
+dcgmin_var2p5_npd_nw_lp= '1.0+(0.10000)*var_par0+(-9.0364e-10)*var_par1+(2.5561e-10)*var_par2'
+dcg_var2p5_npd_nw_lp= '1.0+(0.035000)*var_par0+(-1.1202e-10)*var_par1+(-2.7968e-11)*var_par2'
+dxl_var2p5_npd_nw_lp= '0+(-6.67E-9)*var_par0+(-4.1873e-17)*var_par1+(-4.6340e-17)*var_par2'
+dxw_var2p5_npd_nw_lp= '0+(6.67E-9)*var_par0+(4.3519e-17)*var_par1+(-2.5020e-17)*var_par2'
.INC './var/varactor.ckt'
.ENDL var_mc


********************
* mom corner model *
********************
.LIB mom_tt
.PARAM
+sigma_mis_mom= agauss(0,1,1)
+dmom_mnx= 0              
.INC './mom/mom.ckt'
.ENDL mom_tt

.LIB mom_ff
.PARAM
+sigma_mis_mom= agauss(0,1,1)
+dmom_mnx= -0.1           
.INC './mom/mom.ckt'
.ENDL mom_ff

.LIB mom_ss
.PARAM
+sigma_mis_mom= agauss(0,1,1)
+dmom_mnx= 0.1            
.INC './mom/mom.ckt'
.ENDL mom_ss

.LIB mom_mc
.PARAM
+sigma_mom= agauss(0,1,3) 
+sigma_mis_mom= agauss(0,1,1)
+dmom_mnx= '-0.1*sigma_mom'
+var_rnd0    = agauss(0,1,3)  
+var_rnd1    = agauss(0,1,3)  
+var_rnd2    = agauss(0,1,3)  
+var_p0      = 1.0            
+var_p1      = 1.0            
+var_p2      = 1.0            
+var_par0    = 'var_rnd0*var_p0'      
+var_par1    = 'var_rnd1*var_p1'      
+var_par2    = 'var_rnd2*var_p2'      
.PARAM
+sigma_mis_mom= agauss(0,1,1)
+dmom_mnx= '0+(0.1)*var_par0+(0)*var_par1+(0)*var_par2'
.INC './mom/mom.ckt'
.ENDL mom_mc

