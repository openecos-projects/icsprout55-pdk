

* this file contains 1.2v and 2.5v corner model parameters.
* three corners are supported: tt_passive, ff_passive, ss_passive.
* this file should be used with the model parameter files 'pnp12_lp.mdl', 'npn12_lp.mdl', 'pnp25_lp.mdl', 'npn25_lp.mdl'.
* 'dio_core.mdl', 'dio_io25.mdl', 'dio_well.mdl'.
* 'resistor.ckt', 'varactor.ckt', 'mom.ckt'. 



**********************
* bjt corner model
**********************
.LIB bjt_core12_tt
.PARAM
+sigma_mis_bjt12_a= agauss(0,1,1)
+sigma_mis_bjt12_b= agauss(0,1,1)
+dbf_vpnp1p2_10x_lp= 0        dis_vpnp1p2_10x_lp= 0        dnf_vpnp1p2_10x_lp= 0       
+dbf_vpnp1p2_5x_lp= 0        dis_vpnp1p2_5x_lp= 0        dnf_vpnp1p2_5x_lp= 0       
+dbf_vpnp1p2_2x_lp= 0        dis_vpnp1p2_2x_lp= 0        dnf_vpnp1p2_2x_lp= 0       
+dcje_vpnp1p2_10x_lp= 0        dcje_vpnp1p2_5x_lp= 0        dcje_vpnp1p2_2x_lp= 0       
+dcjc_vpnp1p2_10x_lp= 0        dcjc_vpnp1p2_5x_lp= 0        dcjc_vpnp1p2_2x_lp= 0       
+dbf_vnpn1p2_10x_lp= 0        dis_vnpn1p2_10x_lp= 0        dnf_vnpn1p2_10x_lp= 0       
+dbf_vnpn1p2_5x_lp= 0        dis_vnpn1p2_5x_lp= 0        dnf_vnpn1p2_5x_lp= 0       
+dbf_vnpn1p2_2x_lp= 0        dis_vnpn1p2_2x_lp= 0        dnf_vnpn1p2_2x_lp= 0       
+dcje_vnpn1p2_10x_lp= 0        dcje_vnpn1p2_5x_lp= 0        dcje_vnpn1p2_2x_lp= 0       
+dcjc_vnpn1p2_10x_lp= 0        dcjc_vnpn1p2_5x_lp= 0        dcjc_vnpn1p2_2x_lp= 0       
.INC './bjt/pnp12_lp.mdl'
.INC './bjt/npn12_lp.mdl'
.ENDL bjt_core12_tt

.LIB bjt_core12_ff
.PARAM
+sigma_mis_bjt12_a= agauss(0,1,1)
+sigma_mis_bjt12_b= agauss(0,1,1)
