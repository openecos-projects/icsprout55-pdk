****************************************************************** 
*                 Top Metal for wmin=0.4um(standard option)     *  
******************************************************************
.subckt re_tm2_2t n2 n1  l=lr w=wr mr=1 
.param  
+rsh       = '2.39E-02+drsh_re_tm2_2t'      rtc1  = 3.635E-03           rtc2  = -3.27E-07   
+dw        = '-2.21E-09+ddw_re_tm2_2t'     scale_r=0.9
*+vc1      = 0                        vc2  = 7.98e-03
+jc1a      = 0                       jc1b  = 0
+jc2a      = 6.83e-05                jc2b  = 2.25e-10
+rvc1      = 'jc1a+jc1b/(l*0.9)'           rvc2  = '(jc2a+jc2b/(l*0.9))/(l*0.9)'          
+weff      = 'w*0.9-2*dw'              
+tcoef     = '1.0+(temper-25.0)*(rtc1+rtc2*(temper-25.0))' 
    
r1 n2 n1 'rsh/mr*l*0.9/weff*tcoef*min(1.0+rvc1*abs(v(n2,n1))+rvc2*v(n2,n1)*v(n2,n1), 1.1)'

.ends re_tm2_2t

****************************************************************** 
*                 Top Metal for wmin=0.4um(standard option)(three terminal)     *  
******************************************************************
.subckt re_tm2_3t n2 n1 sub l=lr w=wr mr=1   flag_cc=1
.param  
+rsh       = '2.39E-02+drsh_re_tm2_2t'      rtc1  = 3.635E-03           rtc2  = -3.27E-07   
+dw        = '-2.21E-09+ddw_re_tm2_2t'     scale_r=0.9
*+vc1      = 0                        vc2  = 7.98e-03
+jc1a      = 0                       jc1b  = 0
+jc2a      = 6.83e-05                jc2b  = 2.25e-10
+rvc1      = 'jc1a+jc1b/(l*0.9)'           rvc2  = '(jc2a+jc2b/(l*0.9))/(l*0.9)'          
+weff      = 'w*0.9-2*dw'              
+tcoef     = '1.0+(temper-25.0)*(rtc1+rtc2*(temper-25.0))' 
+cox       = '7.667e-06+dcox_re_tm2_2t'             capsw  = '(1.310e-10+dcapsw_re_tm2_2t)*flag_cc'

c1 n2 sub '(cox*weff*l*0.9/2+capsw*weff+capsw*l*0.9)*mr'    
r1 n2 n1 'rsh/mr*l*0.9/weff*tcoef*min(1.0+rvc1*abs(v(n2,n1))+rvc2*v(n2,n1)*v(n2,n1), 1.1)'
c2 n1 sub '(cox*weff*l*0.9/2+capsw*weff+capsw*l*0.9)*mr'  
.ends re_tm2_3t

