.PARAM
+evalbin(p1,p2,p3,p4)= '(p1/lbin/dbin-p2/lbin/ubin+p3/rbin/ubin-p4/rbin/dbin + ((p2-p1)/lbin+(p4-p3)/rbin)/lum + ((p4-p1)/dbin+(p2-p3)/ubin)/wum + (p1-p2+p3-p4)/lum/wum)/(1/lbin-1/rbin)/(1/dbin-1/ubin)'

.PARAM
+select6(v,v1,v2,v3,v4,v5,v6)= 'v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : v<v6?5 : 5'

.PARAM
+select7(v,v1,v2,v3,v4,v5,v6,v7)= 'v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : v<v6?5 : v<v7?6 : 6'

.PARAM
+selectp6(p,p1,p2,p3,p4,p5,p6)= 'p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : p==6?p6 : 1e4'

.PARAM
+selectp7(p,p1,p2,p3,p4,p5,p6,p7)= 'p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : p==6?p6 : p==7?p7 : 1e4'

.PARAM
+xbin    = select6(wum,0.12,0.15,0.3,0.5,1,10)

.PARAM
+lbin    = selectp6(xbin,0.12,0.15,0.3,0.5,1,10)

.PARAM
+rbin    = selectp6(xbin+1,0.12,0.15,0.3,0.5,1,10)

.PARAM
+ybin    = select7(lum,0.06,0.08,0.2,0.5,0.7,1,10)

.PARAM
+dbin    = selectp7(ybin,0.06,0.08,0.2,0.5,0.7,1,10)

.PARAM
+ubin    = selectp7(ybin+1,0.06,0.08,0.2,0.5,0.7,1,10)

.PARAM
+vth0_w0p12(y)= 'selectp7(y,vth0_w0p12_1,vth0_w0p12_2,vth0_w0p12_3,vth0_w0p12_4,vth0_w0p12_5,vth0_w0p12_6,vth0_w0p12_7)'

.PARAM
+vth0_w0p15(y)= 'selectp7(y,vth0_w0p15_1,vth0_w0p15_2,vth0_w0p15_3,vth0_w0p15_4,vth0_w0p15_5,vth0_w0p15_6,vth0_w0p15_7)'

.PARAM
+vth0_w0p3(y)= 'selectp7(y,vth0_w0p3_1,vth0_w0p3_2,vth0_w0p3_3,vth0_w0p3_4,vth0_w0p3_5,vth0_w0p3_6,vth0_w0p3_7)'

.PARAM
