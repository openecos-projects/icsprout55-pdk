.PARAM
+u0_c(x,y)= 'selectp6(x, u0_w0p12(y), u0_w0p15(y), u0_w0p3(y), u0_w0p5(y), u0_w1(y), u0_w10(y))'

.PARAM
+u0_q    = 'evalbin(u0_c(xbin+1,ybin+1), u0_c(xbin+1,ybin), u0_c(xbin,ybin), u0_c(xbin,ybin+1))'

.PARAM
+ags_w0p12(y)= 'selectp7(y,ags_w0p12_1,ags_w0p12_2,ags_w0p12_3,ags_w0p12_4,ags_w0p12_5,ags_w0p12_6,ags_w0p12_7)'

.PARAM
+ags_w0p15(y)= 'selectp7(y,ags_w0p15_1,ags_w0p15_2,ags_w0p15_3,ags_w0p15_4,ags_w0p15_5,ags_w0p15_6,ags_w0p15_7)'

.PARAM
+ags_w0p3(y)= 'selectp7(y,ags_w0p3_1,ags_w0p3_2,ags_w0p3_3,ags_w0p3_4,ags_w0p3_5,ags_w0p3_6,ags_w0p3_7)'

.PARAM
+ags_w0p5(y)= 'selectp7(y,ags_w0p5_1,ags_w0p5_2,ags_w0p5_3,ags_w0p5_4,ags_w0p5_5,ags_w0p5_6,ags_w0p5_7)'

.PARAM
+ags_w1(y)= 'selectp7(y,ags_w1_1,ags_w1_2,ags_w1_3,ags_w1_4,ags_w1_5,ags_w1_6,ags_w1_7)'

.PARAM
+ags_w10(y)= 'selectp7(y,ags_w10_1,ags_w10_2,ags_w10_3,ags_w10_4,ags_w10_5,ags_w10_6,ags_w10_7)'

.PARAM
+ags_c(x,y)= 'selectp6(x, ags_w0p12(y), ags_w0p15(y), ags_w0p3(y), ags_w0p5(y), ags_w1(y), ags_w10(y))'

.PARAM
+ags_qq  = 'evalbin(ags_c(xbin+1,ybin+1), ags_c(xbin+1,ybin), ags_c(xbin,ybin), ags_c(xbin,ybin+1))'

.PARAM
+vsat_w0p12(y)= 'selectp7(y,vsat_w0p12_1,vsat_w0p12_2,vsat_w0p12_3,vsat_w0p12_4,vsat_w0p12_5,vsat_w0p12_6,vsat_w0p12_7)'

.PARAM
+vsat_w0p15(y)= 'selectp7(y,vsat_w0p15_1,vsat_w0p15_2,vsat_w0p15_3,vsat_w0p15_4,vsat_w0p15_5,vsat_w0p15_6,vsat_w0p15_7)'

.PARAM
+vsat_w0p3(y)= 'selectp7(y,vsat_w0p3_1,vsat_w0p3_2,vsat_w0p3_3,vsat_w0p3_4,vsat_w0p3_5,vsat_w0p3_6,vsat_w0p3_7)'

.PARAM
+vsat_w0p5(y)= 'selectp7(y,vsat_w0p5_1,vsat_w0p5_2,vsat_w0p5_3,vsat_w0p5_4,vsat_w0p5_5,vsat_w0p5_6,vsat_w0p5_7)'

.PARAM
+vsat_w1(y)= 'selectp7(y,vsat_w1_1,vsat_w1_2,vsat_w1_3,vsat_w1_4,vsat_w1_5,vsat_w1_6,vsat_w1_7)'

.PARAM
+vsat_w10(y)= 'selectp7(y,vsat_w10_1,vsat_w10_2,vsat_w10_3,vsat_w10_4,vsat_w10_5,vsat_w10_6,vsat_w10_7)'

.PARAM
+vsat_c(x,y)= 'selectp6(x, vsat_w0p12(y), vsat_w0p15(y), vsat_w0p3(y), vsat_w0p5(y), vsat_w1(y), vsat_w10(y))'

.PARAM
+vsat_qq = 'evalbin(vsat_c(xbin+1,ybin+1), vsat_c(xbin+1,ybin), vsat_c(xbin,ybin), vsat_c(xbin,ybin+1))'

.PARAM
+du0a    = 0.001          

.PARAM
+du0b    = 1.2            

.PARAM
+du0c    = -0.4           

.PARAM
+du0d    = -0.05          

.PARAM
+du0e    = 0.5            

.PARAM
+du0     = 'du0a/cosh((du0b)*(w/nf*1e6+du0c))*(1+du0d/pwr(L*1e6,du0e))'


***********************************************************************************
*                              1.2v core svt pmos model                               *
***********************************************************************************
.MODEL pm1p2_svt_lp_core pmos
****************************************************************
*                        Model selector
****************************************************************
+level   = 54.0            version = 4.5             binunit = 2.0            
+paramchk= 1.0             mobmod  = 0               capmod  = 2.0            
+rdsmod  = 0               igcmod  = 2.0             igbmod  = 1.0            
+rbodymod= 0               trnqsmod= 0               acnqsmod= 0              
+diomod  = 2.0             tempmod = 0               permod  = 1.0            
+geomod  = 0               rgeomod = 1.0             rgatemod= 0              
+wpemod  = 1.0             fnoimod = 1.0             tnoimod = 0              
+xpart   = 1.0            

****************************************************************
*                       Process Parameter
****************************************************************
+epsrox  = 3.9             toxe    = '2.66e-009+dtoxe_pm1p2_svt_lp + dtoxe_pm1p2_svt_lp_mis' dtox    = 4.2E-10        
+toxref  = 2.66E-9         xj      = 1.45E-7         ndep    = 7.5E17         
+ngate   = 1.8E20          nsd     = 1.0E20          rsh     = 12.15          

****************************************************************
*                      dW and dL Parameter
****************************************************************
+wint    = -3.0E-8         wl      = 0               wln     = 1.0            
+ww      = 1.8E-15         wwn     = 1.0             wwl     = 0              
+lint    = -2.01E-8        ll      = 0               lln     = 1.0            
+lw      = 0               lwn     = 1.0             lwl     = 3.0E-23        
+llc     = 0               lwc     = 0               lwlc    = 0              
+wlc     = 0               wwc     = 0               wwlc    = 0              
+dwg     = 0               dwb     = 0               xl      = '-2e-009+dxl_pm1p2_svt_lp'
+xw      = '8e-009+dxw_pm1p2_svt_lp' dlc     = 1.12E-8         dwc     = -1.2E-8        
+lmin    = 5.39946e-08          lmax    = 1.0E-4          wmin    = 1.07989e-07        
+wmax    = 1.0E-4          dlcig   = 1.0E-9         

****************************************************************
*                    Basic Model Parameters
****************************************************************
+vth0    = '(-0.328)+dvth0_pm1p2_svt_lp + dvth0_pm1p2_svt_lp_mis + vth0_q' lvth0   = '1.6E-8+dlvth0_pm1p2_svt_lp' wvth0   = '5.9E-9+dwvth0_pm1p2_svt_lp'
+pvth0   = '(1.0E-16)+dpvth0_pm1p2_svt_lp' phin    = 0.12            k1      = 0.285          
+k2      = -0.006          lk2     = -5.0E-9         wk2     = -2.0E-9        
+pk2     = -2.5E-16        k3      = -9.0            k3b     = 3.2            
+w0      = 2.5E-6          lpe0    = 1.2E-7          lpeb    = 1.0E-10        
+vbm     = -3.0            dvtp0   = 5.4E-7          dvtp1   = 0.7            
+dvt0    = -0.57           dvt1    = 0.14            dvt2    = 0              
+dvt0w   = 2.5             dvt1w   = 5300000.0       dvt2w   = 0              
