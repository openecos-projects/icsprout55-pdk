.param evalbin(p1,p2,p3,p4) = '(p1/lbin/dbin-p2/lbin/ubin+p3/rbin/ubin-p4/rbin/dbin + ((p2-p1)/lbin+(p4-p3)/rbin)/lum + ((p4-p1)/dbin+(p2-p3)/ubin)/wum + (p1-p2+p3-p4)/lum/wum)/(1/lbin-1/rbin)/(1/dbin-1/ubin)'
.param select3(v,v1,v2,v3) = 'v<v1?1 : v<v2?1 : v<v3?2 : 2'
.param select5(v,v1,v2,v3,v4,v5) = 'v<v1?1 : v<v2?1 : v<v3?2 : v<v4?3 : v<v5?4 : 4'
.param selectp3(p,p1,p2,p3) = 'p==1?p1 : p==2?p2 : p==3?p3 : 1e4'
.param selectp5(p,p1,p2,p3,p4,p5) = 'p==1?p1 : p==2?p2 : p==3?p3 : p==4?p4 : p==5?p5 : 1e4'

.param xbin = select3(wum,0.5,1,10)
.param lbin = selectp3(xbin,0.5,1,10)
.param rbin = selectp3(xbin+1,0.5,1,10)
.param ybin = select5(lum,0.2,0.5,0.7,1,10)
.param dbin = selectp5(ybin,0.2,0.5,0.7,1,10)
.param ubin = selectp5(ybin+1,0.2,0.5,0.7,1,10)


.param vth0_w0p5(y) = 'selectp5(y,vth0_w0p5_1,vth0_w0p5_2,vth0_w0p5_3,vth0_w0p5_4,vth0_w0p5_5)'
.param vth0_w1(y) = 'selectp5(y,vth0_w1_1,vth0_w1_2,vth0_w1_3,vth0_w1_4,vth0_w1_5)'
.param vth0_w10(y) = 'selectp5(y,vth0_w10_1,vth0_w10_2,vth0_w10_3,vth0_w10_4,vth0_w10_5)'
.param vth0_c(x,y) = 'selectp3(x, vth0_w0p5(y), vth0_w1(y), vth0_w10(y))'
.param vth0_q = 'evalbin(vth0_c(xbin+1,ybin+1), vth0_c(xbin+1,ybin), vth0_c(xbin,ybin), vth0_c(xbin,ybin+1))'

.param u0_w0p5(y) = 'selectp5(y,u0_w0p5_1,u0_w0p5_2,u0_w0p5_3,u0_w0p5_4,u0_w0p5_5)'
.param u0_w1(y) = 'selectp5(y,u0_w1_1,u0_w1_2,u0_w1_3,u0_w1_4,u0_w1_5)'
.param u0_w10(y) = 'selectp5(y,u0_w10_1,u0_w10_2,u0_w10_3,u0_w10_4,u0_w10_5)'
.param u0_c(x,y) = 'selectp3(x,  u0_w0p5(y),  u0_w1(y), u0_w10(y))'
.param u0_q = 'evalbin(u0_c(xbin+1,ybin+1), u0_c(xbin+1,ybin), u0_c(xbin,ybin), u0_c(xbin,ybin+1))'

.param voff_w0p5(y) = 'selectp5(y,voff_w0p5_1,voff_w0p5_2,voff_w0p5_3,voff_w0p5_4,voff_w0p5_5)'
.param voff_w1(y) = 'selectp5(y,voff_w1_1,voff_w1_2,voff_w1_3,voff_w1_4,voff_w1_5)'
.param voff_w10(y) = 'selectp5(y,voff_w10_1,voff_w10_2,voff_w10_3,voff_w10_4,voff_w10_5)'
.param voff_c(x,y) = 'selectp3(x,  voff_w0p5(y),  voff_w1(y), voff_w10(y))'
.param voff_qq = 'evalbin(voff_c(xbin+1,ybin+1), voff_c(xbin+1,ybin), voff_c(xbin,ybin), voff_c(xbin,ybin+1))'

.param vsat_w0p5(y) = 'selectp5(y,vsat_w0p5_1,vsat_w0p5_2,vsat_w0p5_3,vsat_w0p5_4,vsat_w0p5_5)'
.param vsat_w1(y) = 'selectp5(y,vsat_w1_1,vsat_w1_2,vsat_w1_3,vsat_w1_4,vsat_w1_5)'
.param vsat_w10(y) = 'selectp5(y,vsat_w10_1,vsat_w10_2,vsat_w10_3,vsat_w10_4,vsat_w10_5)'
.param vsat_c(x,y) = 'selectp3(x,  vsat_w0p5(y),  vsat_w1(y), vsat_w10(y))'
.param vsat_qq = 'evalbin(vsat_c(xbin+1,ybin+1), vsat_c(xbin+1,ybin), vsat_c(xbin,ybin), vsat_c(xbin,ybin+1))' 

.param eta0_w0p5(y) = 'selectp5(y,eta0_w0p5_1,eta0_w0p5_2,eta0_w0p5_3,eta0_w0p5_4,eta0_w0p5_5)'
.param eta0_w1(y) = 'selectp5(y,eta0_w1_1,eta0_w1_2,eta0_w1_3,eta0_w1_4,eta0_w1_5)'
.param eta0_w10(y) = 'selectp5(y,eta0_w10_1,eta0_w10_2,eta0_w10_3,eta0_w10_4,eta0_w10_5)'
.param eta0_c(x,y) = 'selectp3(x, eta0_w0p5(y), eta0_w1(y), eta0_w10(y))'
.param eta0_q = 'evalbin(eta0_c(xbin+1,ybin+1), eta0_c(xbin+1,ybin), eta0_c(xbin,ybin), eta0_c(xbin,ybin+1))'

