.PARAM
+vth0_c(x,y)= 'selectp6(x, vth0_w0p12(y), vth0_w0p15(y), vth0_w0p3(y), vth0_w0p5(y), vth0_w1(y), vth0_w10(y))'

.PARAM
+vth0_q  = 'evalbin(vth0_c(xbin+1,ybin+1), vth0_c(xbin+1,ybin), vth0_c(xbin,ybin), vth0_c(xbin,ybin+1))'

.PARAM
+u0_w0p12(y)= 'selectp7(y,u0_w0p12_1,u0_w0p12_2,u0_w0p12_3,u0_w0p12_4,u0_w0p12_5,u0_w0p12_6,u0_w0p12_7)'

.PARAM
