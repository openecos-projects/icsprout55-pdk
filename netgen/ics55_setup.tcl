#------------------------------------------------------------------------------
# Netgen setup for ICsprout 55LLULP (icsprout55)
#
# GENERATED by hacking/magic/gen_magic_tech.py together with the Magic tech file
# (same device list). Do not edit; change the generator.
#
# Circuit 1 is the Magic extracted layout, circuit 2 the reference netlist (the
# libs.ref/<lib>/spice/<lib>_lvs.spice views, see hacking/magic/lvs_netlist.py).
# Property tolerances are the TRACE PROPERTY ones of the Calibre LVS deck
# (mos_err 0.1 %, dio_err 0.1 %, res_err 0.1 %).
#------------------------------------------------------------------------------

permute default
property default
property parallel none

catch {format $env(NETGEN_COLUMNS)}

set cells1 [cells list -all -circuit1]
set cells2 [cells list -all -circuit2]

proc ics55_each {devices body} {
    upvar cells1 cells1 cells2 cells2
    foreach dev $devices {
        foreach c {1 2} {
            if {[lsearch [set cells$c] $dev] >= 0} {
                set circ "-circuit$c $dev"
                uplevel 1 [list set circ $circ]
                uplevel 1 $body
            }
        }
    }
}

# MOS (d g s b): source / drain swap, parallel devices merge by width
ics55_each {nm1p2_hvt_lp nm1p2_lvt_lp nm1p2_svt_lp nm3p3_lp nnat1p2_lp nnat3p3_lp pm1p2_hvt_lp pm1p2_lvt_lp pm1p2_svt_lp pm3p3_lp} {
    permute $circ 1 3
    property $circ parallel enable
    property $circ parallel {l critical}
    property $circ parallel {w add}
    property $circ tolerance {w 0.001} {l 0.001}
    property $circ delete as ad ps pd mult mr nf sa sb sd nrd nrs sca scb scc
}

# junction diodes (.MODEL d): parallel devices merge by area / perimeter
ics55_each {dio_1p2_np_pw_hvt_lp dio_1p2_np_pw_lp dio_1p2_np_pw_lvt_lp dio_1p2_pp_nw_hvt_lp dio_1p2_pp_nw_lp dio_1p2_pp_nw_lvt_lp dio_3p3_np_pw_lp dio_3p3_pp_nw_lp} {
    property $circ parallel enable
    property $circ parallel {area add}
    property $circ parallel {pj add}
    property $circ tolerance {area 0.001} {pj 0.001}
    property $circ delete perim w l mult
}

# poly resistors (n2 n1)
ics55_each {re_hrpo_2t re_npo_2t re_npo_sab_2t re_ppo_2t re_ppo_sab_2t} {
    permute $circ 1 2
    property $circ series enable
    property $circ series {w critical}
    property $circ series {l add}
    property $circ parallel enable
    property $circ parallel {l critical}
    property $circ parallel {w add}
    property $circ tolerance {l 0.001} {w 0.001}
    property $circ delete mult mr
}

# physical-only cells: present in the layout, absent from the LVS netlist
foreach cell $cells1 {
    if {[regexp {^FILLER[0-9A-Z]*H7[RHL]$} $cell]} {ignore class "-circuit1 $cell"}
    if {[regexp {^FILLTAPH7[RHL]$} $cell]} {ignore class "-circuit1 $cell"}
    if {[regexp {^FILL[0-9]+_9T[SHL]VT$} $cell]} {ignore class "-circuit1 $cell"}
    if {[regexp {^TAPX1_9T[SHL]VT$} $cell]} {ignore class "-circuit1 $cell"}
}
foreach cell $cells2 {
    if {[regexp {^FILLER[0-9A-Z]*H7[RHL]$} $cell]} {ignore class "-circuit2 $cell"}
    if {[regexp {^FILLTAPH7[RHL]$} $cell]} {ignore class "-circuit2 $cell"}
    if {[regexp {^FILL[0-9]+_9T[SHL]VT$} $cell]} {ignore class "-circuit2 $cell"}
    if {[regexp {^TAPX1_9T[SHL]VT$} $cell]} {ignore class "-circuit2 $cell"}
}
