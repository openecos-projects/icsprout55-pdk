RDV = OR RV CB


M1  = MET1i NOT MET1sloti
M2  = MET2i NOT MET2sloti
M3  = MET3i NOT MET3sloti
M4  = MET4i NOT MET4sloti
M5  = MET5i NOT MET5sloti
M6  = MET6i NOT MET6sloti
M7  = MET7i NOT MET7sloti
M8  = MET8i NOT MET8sloti

T4M1 = T4M1i NOT T4M1sloti
T4M2 = T4M2i NOT T4M2sloti
T2M1 = T2M1i NOT T2M1sloti
T2M2 = T2M2i NOT T2M2sloti
T8M1 = T8M1i NOT T8M1sloti
T8M2 = T8M2i NOT T8M2sloti


CT1  = OR CT CTbar
VIA1  = OR VIA1i VIA1bar
VIA2  = OR VIA2i VIA2bar
VIA3  = OR VIA3i VIA3bar
VIA4  = OR VIA4i VIA4bar
VIA5  = OR VIA5i VIA5bar
VIA6  = OR VIA6i VIA6bar
VIA7  = OR VIA7i VIA7bar
T2V1 = OR T2V1i T2V1bar
T2V2 = OR T2V2i T2V2bar
T4V1 = OR T4V1i T4V1bar
T4V2 = OR T4V2i T4V2bar
T8V1 = OR T8V1i T8V1bar
T8V2 = OR T8V2i T8V2bar


AA  = COPY ACTi
PO  = COPY POLYi

//GATE = PO AND AA
GATE = (PO AND AA) INTERACT SD_1 == 2
SD_1 = AA NOT PO

SD = ((NPi OR PPi) AND AA) NOT PO

GATE18 = GATE AND DGOX
GATE1825 = GATE AND (DGOX OR TGOX)

DRC INCREMENTAL CONNECT YES


}

#//*******************************************
#//    LAYER DERIVATIONS AND OPERATIONS
#//*******************************************

#//=================
#//    PO Layer 
#//=================

CONNECT PO GATE
CONNECT PO GATE18
CONNECT PO GATE1825

RULECHECK AR_1 {
@ Max. (Poly area / gate area) is 250

 OUTLAYER  NET AREA RATIO PO GATE > 250
 OUTLAYER      \[ AREA(PO) / AREA(GATE) \]
 OUTLAYER  RDB AR_1.rep PO GATE
}

RULECHECK AR_2 { 
@ Max. (Poly perim*thickness / gate area) is 500

 OUTLAYER   NET AREA RATIO PO GATE > 500
 OUTLAYER      \[ PERIMETER(PO) * 0.10 / AREA(GATE) \] 
 OUTLAYER   RDB AR_2.rep PO GATE
}    

#//=================
#//    CT Layer
#//=================

CONNECT CT1 PO

RULECHECK AR_3 { 
@ Max. (contact area / gate area) is 10

 OUTLAYER  NET AREA RATIO CT1 GATE > 10
 OUTLAYER      \[ AREA(CT1) / AREA(GATE) \] 
 OUTLAYER  RDB AR_3.rep CT1 GATE} 

#//=================
#//    M1 Layer 
#//=================

CONNECT M1 PO SD BY CT1

# minimum effective diode >0 um2
SETLAYER M1_DIO = NET AREA SD  >0 
CONNECT M1 M1_DIO BY CT1

RULECHECK AR_5_10_M1 { 
@ Max. (M1 area / gate area) is 5000 (without effective diode)
@ Max. (M1 area / gate area) is Ratio Equation (with effective diode)
  
 SETLAYER A1 = NET AREA RATIO PO M1 M1_DIO  GATE > 5000 ACCUMULATE   \[ AREA(M1)/AREA(GATE) -(AREA(M1_DIO)*500 + !!AREA(M1_DIO)*38000) \] 
 OUTLAYER  RDB AR_5_10_M1.rep PO M1 M1_DIO GATE     
 OUTLAYER COPY A1
 OUTLAYER NET AREA RATIO PRINT A1 "M1.rpt"
}

RULECHECK AR18_5_10_M1 {
@ Max. (M1 area / 1.8v gate area) is 1000 (without effective diode)
@ Max. (M1 area / 1.8v gate area) is Ratio Equation (with effective diode)
 
 SETLAYER A1_18 = NET AREA RATIO PO M1 M1_DIO  GATE18 > 1000 ACCUMULATE   \[ AREA(M1)/AREA(GATE18) -(AREA(M1_DIO)*500 + !!AREA(M1_DIO)*42000) \]
 OUTLAYER  RDB AR18_5_10_M1.rep PO M1 M1_DIO GATE18
 OUTLAYER COPY A1_18
 OUTLAYER NET AREA RATIO PRINT A1_18 "M1_18.rpt"
}


#//=================
#//   VIA1 Layer
#//=================

CONNECT VIA1 M1

RULECHECK AR_4_VIA1 {
@ (VIA1 area / gate area) > 20 (without effective diode)
@ (VIA1 area / gate area) > Ratio Equation (with effective diode)
@ single layer Via area to the active poly gate area, no accumulate

 SETLAYER AVIA1_no_accumulate = NET AREA RATIO PO M1 VIA1 M1_DIO  GATE > 20   \[ AREA(VIA1)/AREA(GATE)-(AREA(M1_DIO)*150 + !!AREA(M1_DIO)*980)  \]
 OUTLAYER RDB AR_4_VIA1.rep PO M1 VIA1 M1_DIO  GATE
 OUTLAYER COPY AVIA1_no_accumulate
}

RULECHECK AR_6_9_VIA1 {
@ (VIA1 area / gate area) > 50 (without effective diode)
@ (VIA1 area / gate area) > Ratio Equation (with effective diode)

 SETLAYER AVIA1 = NET AREA RATIO PO M1 VIA1 M1_DIO  GATE > 50 ACCUMULATE  \[ AREA(VIA1)/AREA(GATE) -(AREA(M1_DIO)*250 + !!AREA(M1_DIO)*850)  \]
 OUTLAYER RDB AR_6_VIA1.rep PO M1 VIA1 M1_DIO  GATE
 OUTLAYER COPY AVIA1
}

#//=================
#//    M2 Layer 
#//=================

 SETLAYER AC1 = NET AREA RATIO  M1 GATE >=0 ACCUMULATE
 SETLAYER AC1_18 = NET AREA RATIO  M1 GATE18 >=0 ACCUMULATE
 SETLAYER AC1_V = NET AREA RATIO VIA1 GATE >=0 ACCUMULATE

CONNECT M2 M1 BY VIA1

# minimum effective diode >0um2
 SETLAYER M2_DIO = NET AREA SD  >0 
CONNECT M1 M2_DIO BY CT1

RULECHECK AR_5_10_M2 { 
@ Max. (M2 area / gate area) is 5000 (without effective diode)
@ Max. (M2 area / gate area) is Ratio Equation (with effective diode)

 SETLAYER A2 = NET AREA RATIO PO M1 M2  M2_DIO  GATE > 5000  ACCUMULATE AC1  \[ AREA(M2)/AREA(GATE) -(AREA(M2_DIO)*500 + !!AREA(M2_DIO)*38000) \]   
 OUTLAYER RDB AR_5_10_M2.rep PO M1 M2 M2_DIO  GATE  
 OUTLAYER COPY A2
 OUTLAYER NET AREA RATIO PRINT A2 "M2.rpt"
}

RULECHECK AR18_5_10_M2 {
@ Max. (M2 area / 1.8v gate area) is 1000 (without effective diode)
@ Max. (M2 area / 1.8v gate area) is Ratio Equation (with effective diode)

 SETLAYER A2_18 = NET AREA RATIO PO M1 M2  M2_DIO  GATE18 > 1000  ACCUMULATE AC1_18  \[ AREA(M2)/AREA(GATE18) -(AREA(M2_DIO)*500 + !!AREA(M2_DIO)*42000) \]
 OUTLAYER RDB AR18_5_10_M2.rep PO M1 M2 M2_DIO  GATE18
 OUTLAYER COPY A2_18
 OUTLAYER NET AREA RATIO PRINT A2_18 "M2_18.rpt"
}

if { $T == 1 } {

set l [expr $M - 2]

for { set i 2 } { $i <= $l } { incr i } {

#//=================
#//   VIA$i Layer
#//=================

CONNECT M$i VIA$i

set v_list PO
for { set j 1 } { $j <= $i } { incr j } {
lappend v_list M$j
}
lappend v_list VIA$i
lappend v_list M${i}_DIO

RULECHECK AR_4_VIA$i {
@ (VIA$i area / gate area) > 20 (without effective diode)
@ (VIA$i area / gate area) > Ratio Equation (with effective diode)
@ single layer Via area to the active poly gate area, no accumulate

 SETLAYER AV${i}_no_accumulate = NET AREA RATIO $v_list GATE > 20    \[ AREA(VIA$i)/AREA(GATE) - (AREA(M${i}_DIO)*150 + !!AREA(M${i}_DIO)*980) \]
 OUTLAYER RDB AR_4_V${i}.rep $v_list GATE
 OUTLAYER COPY AV${i}_no_accumulate
}

RULECHECK AR_6_9_VIA$i {
@ (VIA$i area / gate area) > 50 (without effective diode)
@ (VIA$i area / gate area) > Ratio Equation (with effective diode)

 SETLAYER AVIA$i = NET AREA RATIO $v_list GATE > 50 ACCUMULATE AC[expr $i - 1]_V   \[ AREA(VIA$i)/AREA(GATE) - (AREA(M${i}_DIO)*250 + !!AREA(M${i}_DIO)*850) \]
 OUTLAYER RDB AR_6_9_VIA$i.rep $v_list GATE
 OUTLAYER COPY AVIA$i
}

#//========================
#//    M[expr $i + 1] Layer 
#//========================

 SETLAYER AC$i = NET AREA RATIO M$i GATE >=0 ACCUMULATE AC[expr $i - 1]
 SETLAYER AC${i}_18 = NET AREA RATIO M$i GATE18 >=0 ACCUMULATE AC[expr $i - 1]_18
 SETLAYER AC${i}_V = NET AREA RATIO VIA$i GATE >=0 ACCUMULATE AC[expr $i - 1]_V

CONNECT M[expr $i + 1] M$i BY VIA$i

 SETLAYER M[expr $i + 1]_DIO = NET AREA SD  >0 
# minimum effective diode >0
CONNECT M1 M[expr $i + 1]_DIO BY CT1

set k [expr $i + 1]

set m_list PO
for { set j 1 } { $j <= $k } { incr j } {
lappend m_list M$j
}
lappend m_list M[expr $i + 1]_DIO

RULECHECK AR_5_10_M[expr $i + 1 ] { 
@ Max. (M[expr $i + 1 ] area / gate area) is 5000 (without effective diode)
@ Max. (M[expr $i + 1 ] area / gate area) is Ratio Equation (with effective diode)

 SETLAYER A[expr $i + 1] = NET AREA RATIO $m_list GATE > 5000 ACCUMULATE AC$i  \[ AREA(M[expr $i + 1])/AREA(GATE) - (AREA(M[expr $i + 1]_DIO)*500 + !!AREA(M[expr $i + 1]_DIO)*38000)\]    
 OUTLAYER RDB AR_5_10_M[expr $i + 1].rep $m_list GATE  
 OUTLAYER COPY A[expr $i + 1]
 OUTLAYER NET AREA RATIO PRINT A[expr $i + 1] "M[expr $i + 1].rpt"
}

RULECHECK AR18_5_10_M[expr $i + 1] {
@ Max. (M[expr $i + 1] area / 1.8v gate area) is 1000 (without effective diode)
@ Max. (M[expr $i + 1] area / 1.8v gate area) is Ratio Equation (with effective diode)

 SETLAYER A[expr $i + 1]_18 = NET AREA RATIO $m_list  GATE18 > 1000 ACCUMULATE AC${i}_18  \[ AREA(M[expr $i + 1])/AREA(GATE18) -(AREA(M[expr $i + 1]_DIO)*500 + !!AREA(M[expr $i + 1]_DIO)*42000) \]
 OUTLAYER RDB AR18_5_10_M[expr $i + 1].rep $m_list  GATE18
 OUTLAYER COPY A[expr $i + 1]_18
 OUTLAYER NET AREA RATIO PRINT A[expr $i + 1]_18 "M[expr $i + 1]_18.rpt"
}
}

#//=================
#//   $TV_NAME Layer
#//=================

CONNECT $TV_NAME M$i

set tv_list PO
for { set j 1 } { $j <= $i } { incr j } {
lappend tv_list M$j
}
lappend tv_list $TV_NAME
lappend tv_list M${i}_DIO

RULECHECK AR_4_$TV_NAME {
@ ($TV_NAME area / gate area) > 20 (without effective diode)
@ ($TV_NAME area / gate area) > Ratio Equation (with effective diode)
@ single layer Via area to the active poly gate area, no accumulate

 SETLAYER AV${i}_no_accumulate = NET AREA RATIO $tv_list  GATE > 20   \[ AREA($TV_NAME)/AREA(GATE)-(AREA(M${i}_DIO)*150 + !!AREA(M${i}_DIO)*980) \]
 OUTLAYER RDB AR_4_${TV_NAME}.rep $tv_list GATE
 OUTLAYER COPY AV${i}_no_accumulate
}

RULECHECK AR_6_9_$TV_NAME {
@ ($TV_NAME area / gate area) > 50 (without effective diode)
@ ($TV_NAME area / gate area) > Ratio Equation (with effective diode)

 SETLAYER AVIA$i = NET AREA RATIO $tv_list  GATE > 50 ACCUMULATE AC[expr $i - 1]_V  \[ AREA($TV_NAME)/AREA(GATE) -(AREA(M${i}_DIO)*250 + !!AREA(M${i}_DIO)*850)\]
 OUTLAYER  RDB AR_6_9_${TV_NAME}.rep $tv_list GATE
 OUTLAYER COPY AVIA$i
}

#//=================
