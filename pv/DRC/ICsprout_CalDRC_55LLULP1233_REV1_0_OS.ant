#//=================

 SETLAYER AC$i = NET AREA RATIO M$i GATE >=0 ACCUMULATE AC[expr $i - 1]
 SETLAYER AC${i}_18 = NET AREA RATIO M$i GATE18 >=0 ACCUMULATE AC[expr $i - 1]_18

CONNECT $TM_NAME M$i BY $TV_NAME

SETLAYER ${TM_NAME}_DIO = NET AREA SD  >0
#minimum effective diode >0um2
CONNECT M1 ${TM_NAME}_DIO BY CT1

set tm_list PO
for { set j 1 } { $j <= $i } { incr j } {
lappend tm_list M$j
}
lappend tm_list $TM_NAME

RULECHECK AR_5_10_$TM_NAME { 
@ Max. ($TM_NAME area / gate area) is 5000 (without effective diode)
@ Max. ($TM_NAME area / gate area) is Ratio Equation (with effective diode)

 SETLAYER A[expr $i + 1] = NET AREA RATIO $tm_list ${TM_NAME}_DIO GATE > 5000 ACCUMULATE AC$i  \[ AREA($TM_NAME)/AREA(GATE) - (AREA(${TM_NAME}_DIO)*8000 + !!AREA(${TM_NAME}_DIO)*45000)\] 
 OUTLAYER RDB AR_5_10_${TM_NAME}.rep $tm_list ${TM_NAME}_DIO GATE     
 OUTLAYER COPY A[expr $i + 1]
}

RULECHECK AR18_5_10_$TM_NAME {
@ Max. ($TM_NAME area / 1.8v gate area) is 1000 (without effective diode)
@ Max. ($TM_NAME area / 1.8v gate area) is Ratio Equation (with effective diode)

 SETLAYER A[expr $i + 1]_18 = NET AREA RATIO $tm_list ${TM_NAME}_DIO GATE18 > 1000 ACCUMULATE AC${i}_18  \[ AREA($TM_NAME)/AREA(GATE18) - (AREA(${TM_NAME}_DIO)*8000 + !!AREA(${TM_NAME}_DIO)*49000)\]
 OUTLAYER  RDB AR18_5_10_${TM_NAME}.rep $tm_list ${TM_NAME}_DIO GATE18
 OUTLAYER COPY A[expr $i + 1]_18
} 

