 SETLAYER A[expr $i + 1]_18 = NET AREA RATIO $m_list  GATE18 > 1000 ACCUMULATE AC${i}_18  \[ AREA(M[expr $i + 1])/AREA(GATE18) -(AREA(M[expr $i + 1]_DIO)*500 + !!AREA(M[expr $i + 1]_DIO)*42000) \]
