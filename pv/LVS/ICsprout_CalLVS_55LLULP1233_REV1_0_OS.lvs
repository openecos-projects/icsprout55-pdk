//-----device setup-----
//-----Define DEVICE Marcro----------------//
DMACRO MOS_LVS seed_layer SD_layer {
         [PROPERTY W,L
         W = PERIM_CO(seed_layer,SD_layer)/2
         L = AREA(seed_layer)/W
         ]
}

DMACRO MOS_ESD_LVS seed_layer SD_layer {
         [PROPERTY W,L
         W = PERIM_CO(seed_layer,SD_layer)
         L = AREA(seed_layer)/W
         ]
}

DMACRO MOS_PRO seed_layer SD_layer prolayer1 prolayer2 proclayer3 proclayer4 {
[ PROPERTY W, L, AS, AD, PS, PD, SA, SB, MR, NF, MULTI, NRS, NRD, SCA, SCB, SCC, SD, mismod,prelayout
 W = PERIM_CO(seed_layer, SD_layer)/2
 L = AREA(seed_layer)/W
 S = ENCLOSURE_VECTOR(prolayer2, 5)
 PER_S = perimeter_inside(S, prolayer1)
 PER_D = perimeter_inside(D, prolayer1)
 IF(PER_S==0) {
 AD = AREA(D)*W/PER_D
 PD = perimeter(D)*W/PER_D
 AS = AD
 PS = PD
 }ELSE IF(PER_D==0){
 AS=AREA(S)*W/PER_S
 PS =perimeter(S)*W/PER_S
 AD =AS
 PD =PS
 }ELSE{
 AD=AREA(D)*W/PER_D
 PD = perimeter(D)*W/PER_D
 AS = AREA(S)*W/PER_S
 PS = perimeter(S)*W/PER_S
 }
// SA = W/sum(S::w/(S::a+0.5*L)) - 0.5*L
// SB = W/sum(S::w/(S::b+0.5*L)) - 0.5*L
 MR = 1
 NF = 1
 SD = 0
 prelayout = 0
 MULTI = 1
 NRS = AS/(W*W)
 NRD = AD/(W*W)
 #IFDEF MOS_MIS_MODE 0
 mismod = 0
 #ELSE
 #IFDEF MOS_MIS_MODE 1
 mismod = 1
 #ENDIF
 #ENDIF 
 SCALE = scale_value
//LOD effective value
 LODX_1 = DFM_VEC_VAL( proclayer4, "PER_1" )
 LODX_2 = DFM_VEC_VAL( proclayer4, "PER_2" )
 SA = TVF_NUM_FUN( "calc_lod_sasb", "device_function", LODX_1, W, L, UNIT_LENGTH(), SCALE )
 SB = TVF_NUM_FUN( "calc_lod_sasb", "device_function", LODX_2, W, L, UNIT_LENGTH(), SCALE )
// Well proximity.
 SCH_1 = DFM_VEC_VAL( proclayer3, "PER_1" )
 SCH_2 = DFM_VEC_VAL( proclayer3, "PER_2" )
 SCV_1 = DFM_VEC_VAL( proclayer3, "PAR_1" )
 SCV_2 = DFM_VEC_VAL( proclayer3, "PAR_2" )
 SCA = TVF_NUM_FUN( "calc_sca_dfm", "device_function", SCH_1, SCH_2, SCV_1, SCV_2, W, L, UNIT_LENGTH(), SCALE )
 SCB = TVF_NUM_FUN( "calc_scb_dfm", "device_function", SCH_1, SCH_2, SCV_1, SCV_2, W, L, UNIT_LENGTH(), SCALE )
 SCC = TVF_NUM_FUN( "calc_scc_dfm", "device_function", SCH_1, SCH_2, SCV_1, SCV_2, W, L, UNIT_LENGTH(), SCALE )
 ]
}


//SRAM
DMACRO SRAM_PRO seed_layer SD_layer proclayer1 proclayer2 {
       [ PROPERTY W,L,AS,AD,PS,PD,SA,SB,NRS,NRD,SCA,SCB,SCC
         W = PERIM_CO(seed_layer,SD_layer)/2
         L = AREA(seed_layer)/W
         S = ENCLOSURE_VECTOR(proclayer2,5)
         A = 5E-06
         PER_S = perimeter_inside(S,proclayer1)
         PER_D = perimeter_inside(D,proclayer1)
         IF(PER_S==0) {
           AD = AREA(D)*W/PER_D
           PD = perimeter(D)*W/PER_D
           AS = AD
           PS = PD
         }ELSE IF(PER_D==0){
            AS=AREA(S)*W/PER_S
            PS =perimeter(S)*W/PER_S
            AD =AS
            PD =PS
         }ELSE{
            AD=AREA(D)*W/PER_D
            PD = perimeter(D)*W/PER_D
            AS = AREA(S)*W/PER_S
            PS = perimeter(S)*W/PER_S
         }
         SA = 0
         SB = 0
         SCA = 0
         SCB = 0
         SCC = 0

         NRD = 0
         NRS = 0
         ]
}


//BJT
DMACRO BJT_PRO seedlayer {
 [ PROPERTY A, M, MULTI
 A = area(seedlayer)
 M = 1
 MULTI = 1
 #IFDEF BJT_MIS_MODE 0
 mismod = 0
 #ELSE
 #IFDEF BJT_MIS_MODE 1
 mismod = 1
 #ENDIF
 #ENDIF 
 ]
}

//DIODE
DMACRO DIODE_PRO seedlayer {
 [ PROPERTY A, P, M
 A = area(seedlayer)
 P = perimeter(seedlayer)
 M = 1 ]
}

//Resistor
DMACRO RES_AA_PRO seedlayer terminallayer rsh_value dl_value dw_value {
 #IFDEF BACK_ANNOTATION_FLOW 1
 [PROPERTY W,L,MR,SR,MULTI
 #ENDIF
 #IFDEF BACK_ANNOTATION_FLOW 2
 [PROPERTY W,L,MR,MULTI
 #ENDIF
 W = PERIM_CO(seedlayer, terminallayer)/2
 L = AREA(seedlayer)/W
 RS = rsh_value
 DW = dw_value
 DL = dl_value
 SR = (L*scale_value-2*DL)*RS/(W*scale_value-2*DW)
 MR = 1
 MULTI = 1 
 #IFDEF RES_MIS_MODE 0
 mismod = 0
 #ELSE
 #IFDEF RES_MIS_MODE 1
 mismod = 1
 #ENDIF 
 #ENDIF 
 ]
}

DMACRO RES_AA_SAB_PRO seedlayer terminallayer prolayer1 prolayer2 rsh_value dl_value dw_value {
 #IFDEF BACK_ANNOTATION_FLOW 1
 [PROPERTY W,L,MR,SR,MULTI 
 #ENDIF
 #IFDEF BACK_ANNOTATION_FLOW 2
 [PROPERTY W,L,MR,MULTI
 #ENDIF
 W = PERIM_CO(prolayer2,terminallayer)/2
 L = AREA(prolayer1)/W
 RS = rsh_value
 DW = dw_value
 DL = dl_value
 SR = (L*scale_value-2*DL)*RS/(W*scale_value-2*DW)
 MR = 1
 MULTI = 1
 #IFDEF RES_MIS_MODE 0
 mismod = 0
 #ELSE
 #IFDEF RES_MIS_MODE 1
 mismod = 1
 #ENDIF 
 #ENDIF 
 ]
}

