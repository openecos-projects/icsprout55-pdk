//////////////////////////////////////////////
// Loigc Operation       //
//////////////////////////////////////////////
bulk = SIZE (EXTENT) BY 0.1

PO = OR POLY POLYdm 
AA = OR ACT ACTdm 
AA_eff_reg = (AA INTERACT CTs) OR (AA INTERACT (PO INTERACT CTs)) 

resPOLY = PO AND (OR (POLYres NOT INTERACT SAB) (POLYres AND SAB) HRPBLK)
non_resPOLY = PO NOT resPOLY

gpoly = non_resPOLY AND AA
poGate = (gpoly AND AA_eff_reg) NOT POLYdm
connpoly = non_resPOLY NOT gpoly
npoly = connpoly AND NP
ppoly = connpoly NOT npoly
npoGate = poGate INSIDE NP
ppoGate = poGate INSIDE PP
ngpoly = (gpoly NOT poGate) INSIDE NP 
pgpoly = (gpoly NOT poGate) INSIDE PP 
MOM_poly = (connpoly NOT POLYdm) AND MOMLVS1
 
nDif = AA AND NP
nresDiff = (nDif NOT PO) AND ((ACTres NOT INTERACT SAB) OR (ACTres AND SAB))
nDiff = (nDif NOT PO) NOT nresDiff 
pDif = AA AND PP
presDiff = (pDif NOT PO) AND ((ACTres NOT INTERACT SAB) OR (ACTres AND SAB))
pDiff = (pDif NOT PO) NOT presDiff

resNW = NW AND NW1res
non_resNW = NW NOT NW1res

nWell = bulk AND non_resNW

nWell_wpe_core = ((nWell NOT DGOX) NOT TGOX) NOT SUBCKTLVS
nWell_wpe_io1 = ((nWell AND DGOX) NOT TGOX) NOT SUBCKTLVS
nWell_wpe_io2 = ((nWell AND TGOX) NOT DGOX) NOT SUBCKTLVS

nTap = (nDiff AND NW) INTERACT CT
nJunc = nDiff NOT NW
pJunc = pDiff AND NW
pTap = (pDiff NOT NW) INTERACT CT
nresJunc = nresDiff NOT NW
presJunc = presDiff AND NW

sub2  = SIZE SUBCKTLVS BY 0.005
sub2Ring = sub2 NOT SUBCKTLVS
non_pWell = sub2Ring OR NW 
pWellSub = ((bulk NOT DNW) NOT non_pWell) NOT sub2Ring
pWell  = bulk NOT non_pWell
bpWell1 = ((NW HOLES) AND DNW) NOT nWell
bpWell  = bpWell1 NOT sub2Ring
pWell1 = pWell AND bpWell
bpWell_wpe_core = (((bpWell NOT NW ) NOT DGOX) NOT TGOX) NOT SUBCKTLVS
bpWell_wpe_io1 = (((bpWell NOT NW ) AND DGOX) NOT TGOX) NOT SUBCKTLVS
bpWell_wpe_io2 = (((bpWell NOT NW) AND TGOX) NOT DGOX) NOT SUBCKTLVS

dnwdio_psub = pWell NOT pWell1
nWellRing = DONUT nWell
pWell_nWell = (pWell OR nWellRing) NOT DNW
bulk_all  = BULK NOT sub2Ring

pWell_wpe_core = (((bulk NOT NW) NOT DGOX) NOT TGOX) NOT SUBCKTLVS
pWell_wpe_io1 = (((bulk NOT NW) AND DGOX) NOT TGOX) NOT SUBCKTLVS
pWell_wpe_io2 = (((bulk NOT NW) AND DGOX) NOT TGOX) NOT SUBCKTLVS

psub_wpe_core = (SUBCKTLVS NOT DGOX) NOT TGOX
psub_wpe_io1 = (SUBCKTLVS AND DGOX) NOT TGOX
psub_wpe_io2 = (SUBCKTLVS AND TGOX) NOT DGOX

poCT = CTs AND connpoly
npoCT = poCT AND NP
ppoCT = poCT NOT npoCT
dfCT = CTs NOT poCT
ndfCT = dfCT AND NP
pdfCT = dfCT NOT ndfCT

OD1 = COPY OD
UD1 = COPY UD
//*****************************************
// SUBCONNECT plug
nTap_nWell_subcon = nTap AND nWell
pTap_pWell_subcon = pTap AND pWellSub
pTap_bpWell_subcon = pTap AND bpWell
nTap_dnw_subcon = nTap AND DNW 
//*****************************************
ngate = npoGate NOT nWell
pgate = ppoGate AND nWell
gate_all = OR ngate pgate
ngate_core = (ngate NOT DGOX) NOT TGOX
pgate_core = (pgate NOT DGOX) NOT TGOX

ngate_wpe = copy ngate 
pgate_wpe = copy pgate 
//-------Define MOS--------------
npnEmit = nJunc AND BJT
nDioDiff = ((nJunc NOT BJT) NOT ACTres) AND DIODE
nSD = ((nJunc NOT BJT) NOT DIODE) NOT LDMOS
pnpEmit = pJunc AND BJT
pDioDiff = ((pJunc NOT BJT) NOT ACTres) AND DIODE
pSD = ((pJunc NOT BJT) NOT DIODE) NOT LDMOS
all_sd = OR nSD pSD
//-------Define NRD/NRS-----------

Diff_r1 = (((((AA AND (NP OR PP)) NOT PO) NOT BJT) NOT DIODE) NOT LDMOS) NOT CTs
Diff_r2 = Diff_r1 COIN EDGE poGate
Diff_r3 = Diff_r1 COIN EDGE CTs
Diff_r  = ((INT Diff_r2 Diff_r3 < 5 PARALLEL OPPOSITE REGION) NOT CTs) INTERACT poGate
Diff_r_edge = Diff_r COINCIDENT OUTSIDE EDGE poGate
Diff_r_PO = EXPAND EDGE Diff_r_edge OUTSIDE BY 0.01


nonSVT = ((((((((NVT1 OR PVT1) OR NVT3) OR PVT3) OR SRAMALL) OR BJT) OR ACTres) OR VARAM) OR ULLD) OR ESDIOE
nonSVT_esd = (((((((NVT1 OR PVT1) OR NVT3) OR PVT3) OR SRAMALL) OR BJT) OR ACTres) OR VARAM) OR ULLD
ncore_svt_gate = (((ngate_core NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT
pcore_svt_gate = (((pgate_core NOT PSUB) NOT OD1) NOT UD) NOT nonSVT
ncore_hvt_gate = (((((ngate_core NOT PSUB) NOT SRAMALL)  AND NVT3) NOT OD1) NOT UD) NOT ULLD
pcore_hvt_gate = (((((pgate_core NOT PSUB) NOT SRAMALL) AND PVT3) NOT OD1) NOT UD) NOT ULLD
ncore_ulvt_gate = (((((ngate_core NOT PSUB) NOT SRAMALL)  AND NVT3) AND ULLD) NOT OD1) NOT UD
pcore_ulvt_gate = (((((pgate_core NOT PSUB) NOT SRAMALL) AND PVT3) AND ULLD) NOT OD1) NOT UD
ncore_lvt_gate = ((((ngate_core NOT PSUB) NOT SRAMALL)  AND NVT1) NOT OD1) NOT UD
pcore_lvt_gate = ((((pgate_core NOT PSUB) NOT SRAMALL) AND PVT1) NOT OD1) NOT UD
ncore_nt_gate = (((ngate_core AND PSUB) NOT SRAMALL) NOT OD1) NOT UD
nio1_gate = (((((ngate AND DGOX) NOT TGOX)  NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT     
nio1_gate_lv = (((((ngate AND DGOX) NOT TGOX)  NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT     
nio1_gate_ulv = (((((ngate AND DGOX) NOT TGOX)   NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT    
nio1_gate_rs = (((((ngate AND DGOX) NOT TGOX)   NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT    
nio1_gate_tg = (((((ngate AND DGOX) NOT TGOX)   NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT    
nio1_gate_sf = (((((ngate AND DGOX) NOT TGOX)   NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT    
pio1_gate = (((((pgate AND DGOX) NOT TGOX) NOT PSUB) NOT OD1) NOT UD) NOT nonSVT    
nio1_nt_gate = ((((ngate AND DGOX) NOT TGOX) AND PSUB) NOT OD1) NOT UD
nio1_ud_gate = (((((ngate AND DGOX) NOT TGOX) NOT PSUB)  NOT OD1) AND UD) NOT nonSVT
pio1_ud_gate = (((((pgate AND DGOX) NOT TGOX) NOT PSUB) NOT OD1) AND UD) NOT nonSVT
nio1_ud_nt_gate = ((((ngate AND DGOX) NOT TGOX) AND PSUB) NOT OD1) AND UD
nio1_od_gate = (((((ngate AND DGOX) NOT TGOX) NOT PSUB)  AND OD1) NOT UD) NOT nonSVT
pio1_od_gate = (((((pgate AND DGOX) NOT TGOX) NOT PSUB) AND OD1) NOT UD) NOT nonSVT
nio1_od_nt_gate = ((((ngate AND DGOX) NOT TGOX) AND PSUB) AND OD1) NOT UD
nio2_gate = (((((ngate AND TGOX) NOT DGOX)  NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT_esd    
nio2_gate_lv = (((((ngate AND TGOX) NOT DGOX)  NOT PSUB)  NOT OD1) NOT UD) NOT nonSVT    

pio2_gate = (((((pgate AND TGOX) NOT DGOX) NOT PSUB) NOT OD1) NOT UD) NOT nonSVT_esd    
nio2_nt_gate = ((((ngate AND TGOX) NOT DGOX) AND PSUB) NOT OD1) NOT UD
nio2_ud_gate = (((((ngate AND TGOX) NOT DGOX) NOT PSUB)  NOT OD1) AND UD) NOT nonSVT
pio2_ud_gate = (((((pgate AND TGOX) NOT DGOX) NOT PSUB) NOT OD1) AND UD) NOT nonSVT
nio2_ud_nt_gate = ((((ngate AND TGOX) NOT DGOX) AND PSUB) NOT OD1) AND UD
nio2_od_gate = (((((ngate AND TGOX) NOT DGOX) NOT PSUB)  AND OD1) NOT UD) NOT nonSVT_esd
pio2_od_gate = (((((pgate AND TGOX) NOT DGOX) NOT PSUB) AND OD1) NOT UD) NOT nonSVT_esd
nio2_od_nt_gate = ((((ngate AND TGOX) NOT DGOX) AND PSUB) AND OD1) NOT UD
ncore_dnw_svt_gate = ((((ngate_core NOT PSUB)  AND DNW) NOT OD1) NOT UD) NOT nonSVT
ncore_dnw_hvt_gate = ((((ngate_core NOT PSUB)  AND DNW) NOT OD1) NOT UD) AND NVT3
ncore_dnw_lvt_gate = ((((ngate_core NOT PSUB)  AND DNW) AND NVT1) NOT OD1) NOT UD 
nio1_dnw_gate = ((((((ngate AND DGOX) NOT TGOX) NOT PSUB)  AND DNW)  NOT OD1) NOT UD) NOT nonSVT
nio1_ud_dnw_gate = ((((((ngate AND DGOX) NOT TGOX) NOT PSUB)  AND DNW) NOT OD1) AND UD) NOT nonSVT
nio1_od_dnw_gate = ((((((ngate AND DGOX) NOT TGOX) NOT PSUB)  AND DNW) AND OD1) NOT UD) NOT nonSVT
nio2_dnw_gate = ((((((ngate AND TGOX) NOT DGOX) NOT PSUB)  AND DNW)  NOT OD1) NOT UD) NOT nonSVT
nio2_ud_dnw_gate = ((((((ngate AND TGOX) NOT DGOX) NOT PSUB)  AND DNW) NOT OD1) AND UD) NOT nonSVT
nio2_od_dnw_gate = ((((((ngate AND TGOX) NOT DGOX) NOT PSUB)  AND DNW) AND OD1) NOT UD) NOT nonSVT
ncore_hdsram_gate = (((ngate_core AND NVT3) NOT PSUB) AND SRAMALL) AND SRAM6THD
npd_hdsram_gate = ncore_hdsram_gate NOT SRAMPG
npg_hdsram_gate = ncore_hdsram_gate AND SRAMPG
pcore_hdsram_gate = ((((pgate_core AND PVT3) NOT INTERACT CT) NOT PSUB) AND SRAMALL) AND SRAM6THD
ncore_dphdsram_gate = ((((ngate_core AND NVT3)NOT INTERACT CT) NOT PSUB) AND SRAMALL) AND SRAM8THD
npd_dphdsram_gate = ncore_dphdsram_gate NOT SRAMPG
npg_dphdsram_gate = ncore_dphdsram_gate AND SRAMPG
pcore_dphdsram_gate = ((((pgate_core AND PVT3) NOT INTERACT CT) NOT PSUB) AND SRAMALL) AND SRAM8THD


//ncore_esd_gate = (((ngate_core AND ESDIOE) NOT PSUB)  NOT OD1) NOT UD
//nio1_esd_gate = (((((ngate AND DGOX) NOT TGOX) AND ESDIOE) NOT PSUB)  NOT OD1) NOT UD
//nio2_esd_gate = (((((ngate AND TGOX) NOT DGOX) AND ESDIOE) NOT PSUB)  NOT OD1) NOT UD
//ncore_hdtap_gate = ((ngate_core NOT PSUB)  AND SRAM6THD) AND SRAMALL
// END MOS

//-------Define BJT----------------- 
pnp_base = nWell ENCLOSE pnpEmit
pnp_col = (pWell INTERACT pnp_base) OR pnp_base
//shrink BJT
core_npnEmit = (npnEmit NOT (DGOX OR TGOX)) NOT NOSHRINK
core_pnpEmit = (pnpEmit NOT (DGOX OR TGOX)) NOT NOSHRINK
core_npnEmitA4 = Area core_npnEmit >= 3.99 <= 4.01
core_npnEmitA25 = Area core_npnEmit >= 24.99 <= 25.01
core_npnEmitA100 = Area core_npnEmit >= 99.99 <= 101.01
core_pnpEmitA4 = Area core_pnpEmit >= 3.99 <= 4.01
core_pnpEmitA25 = Area core_pnpEmit >= 24.99 <= 25.01
core_pnpEmitA100 = Area core_pnpEmit >= 99.99 <= 101.01

io1_npnEmit = ((npnEmit AND DGOX) NOT TGOX) NOT NOSHRINK
io1_pnpEmit = ((pnpEmit AND DGOX) NOT TGOX) NOT NOSHRINK
io1_npnEmitA4 = Area io1_npnEmit >= 3.99 <= 4.01
io1_npnEmitA25 = Area io1_npnEmit >= 24.99 <= 25.01
io1_npnEmitA100 = Area io1_npnEmit >= 99.99 <= 101.01
io1_pnpEmitA4 = Area io1_pnpEmit >= 3.99 <= 4.01
io1_pnpEmitA25 = Area io1_pnpEmit >= 24.99 <= 25.01
io1_pnpEmitA100 = Area io1_pnpEmit >= 99.99 <= 101.01

io2_npnEmit = ((npnEmit AND TGOX) NOT DGOX) NOT NOSHRINK
io2_pnpEmit = ((pnpEmit AND TGOX) NOT DGOX) NOT NOSHRINK
io2_npnEmitA4 = Area io2_npnEmit >= 3.99 <= 4.01
io2_npnEmitA25 = Area io2_npnEmit >= 24.99 <= 25.01
io2_npnEmitA100 = Area io2_npnEmit >= 99.99 <= 101.01
io2_pnpEmitA4 = Area io2_pnpEmit >= 3.99 <= 4.01
io2_pnpEmitA25 = Area io2_pnpEmit >= 24.99 <= 25.01
io2_pnpEmitA100 = Area io2_pnpEmit >= 99.99 <= 101.01

//---------Define Diode------------------
nDioJunc = (nJunc NOT ACTres) AND DIODE
pDioJunc = (pJunc NOT ACTres) AND DIODE
ndiocore_svt_diode = (((nDioJunc NOT (DGOX OR TGOX)) NOT PSUB) NOT nonSVT) NOT INTERACT DNW
pdiocore_svt_diode = ((pDioJunc NOT (DGOX OR TGOX)) NOT PSUB) NOT nonSVT
ndiocore_hvt_diode = ((nDioJunc NOT (DGOX OR TGOX)) NOT PSUB) AND NVT3
pdiocore_hvt_diode = ((pDioJunc NOT (DGOX OR TGOX)) NOT PSUB) AND PVT3
ndiocore_lvt_diode = ((nDioJunc NOT (DGOX OR TGOX)) NOT PSUB) AND NVT1
pdiocore_lvt_diode = ((pDioJunc NOT (DGOX OR TGOX)) NOT PSUB) AND PVT1
ndiocore_ull_diode = (((nDioJunc NOT (DGOX OR TGOX)) NOT PSUB) AND NVT3) AND ULLD
pdiocore_ull_diode = (((pDioJunc NOT (DGOX OR TGOX)) NOT PSUB) AND PVT3) AND ULLD
ndiocore_nt_diode = (nDioJunc NOT (DGOX OR TGOX)) AND PSUB
ndioio1_diode = (((nDioJunc AND DGOX) NOT TGOX)  NOT PSUB) NOT nonSVT
pdioio1_diode = (((pDioJunc AND DGOX) NOT TGOX) NOT PSUB) NOT nonSVT
ndioio1_nt_diode = ((nDioJunc AND DGOX) NOT TGOX) AND PSUB
ndioio2_diode = (((nDioJunc AND TGOX) NOT DGOX)  NOT PSUB) NOT nonSVT_esd
pdioio2_diode = (((pDioJunc AND TGOX) NOT DGOX) NOT PSUB) NOT nonSVT_esd
ndioio2_nt_diode = ((nDioJunc AND TGOX) NOT DGOX) AND PSUB
nwdio_diode1 = (((((nWell INSIDE DIODE) NOT INTERACT DNW) NOT INTERACT dpnLay) NOT INTERACT dnpLay) NOT INTERACT pDioJunc) NOT INTERACT nDioJunc
nwdio_diode = nwdio_diode1 NOT ((((((PSUB OR NVT3) OR PVT3) OR NVT1) OR PVT1) OR DGOX) OR TGOX)
nwdio_diode_io1 = (nwdio_diode1 AND DGOX)  NOT (((((PSUB OR NVT3) OR PVT3) OR NVT1) OR PVT1) OR DGOX)
nwdio_diode_io2 = (nwdio_diode1 AND TGOX)  NOT (((((PSUB OR NVT3) OR PVT3) OR NVT1) OR PVT1) OR DGOX)
dnwdio_diode1 = (NW INTERACT (DNW INSIDE DIODE)) INTERACT dnwdio_psub
dnwdio_diode = dnwdio_diode1 NOT ((((PSUB OR NVT3) OR PVT3) OR NVT1) OR PVT1)
bpwdio_diode1 = ((bpWell AND (DIODE INSIDE DNW)) NOT INTERACT dnpLay) INTERACT pTap
bpwdio_diode = bpwdio_diode1 NOT ((((PSUB OR NVT3) OR PVT3) OR NVT1) OR PVT1)
dnwdio_para_diode = ((DNW NOT INTERACT dnwdio_diode) NOT INTERACT bpwdio_diode) NOT INTERACT ndiodnw12_diode

ndiodnw12_diode = (((nDioJunc INSIDE bpWell) NOT (DGOX OR TGOX)) NOT PSUB) NOT nonSVT


dpnLay = (((pSD INSIDE DIODE) NOT NP) NOT NVT1) NOT NVT3
dnpLay = (((nSD INSIDE DIODE) NOT PP) NOT PVT1) NOT PVT3
pnoDev = (non_resPOLY AND pDif) AND nWell
nw_para_diode1 = nWell ENCLOSE (OR pgate nwvarcore_var nwvario1_var nwvario2_var)
nw_para_diode2 = nw_para_diode1 NOT INTERACT DNW
nw_para_diode3 = (nWell INTERACT DIODE) INTERACT pDioJunc
nw_para_diode_all = (OR nw_para_diode2 nw_para_diode3) interact dnwdio_psub == 1
nw_para_diode = COPY nw_para_diode_all 
nw_para_diode_io1 = (nw_para_diode_all AND DGOX) NOT TGOX
nw_para_diode_io2 = (nw_para_diode_all AND TGOX) NOT DGOX
bpw_para_diode = (((bpWell NOT INTERACT BJT) NOT INTERACT bpwdio_diode) NOT INTERACT dnwdio_diode) NOT INTERACT ndiodnw12_diode

//----Define VARMOS--------------------------
nwvarcore_var = ((((npoGate AND NW) AND VARAM) NOT DGOX) NOT TGOX)  NOT INTERACT SAB
nwvario1_var = ((((npoGate AND NW) AND VARAM) AND DGOX) NOT TGOX)  NOT INTERACT SAB
nwvario2_var = ((((npoGate AND NW) AND VARAM) AND TGOX) NOT DGOX)  NOT INTERACT SAB
nwvarcore_var_seed = non_resPOLY ENCLOSE nwvarcore_var
nwvario1_var_seed = non_resPOLY ENCLOSE nwvario1_var
nwvario2_var_seed = non_resPOLY ENCLOSE nwvario2_var

//-----Define Resistor------------------------
rndif_3T = (nresJunc NOT INTERACT SAB) AND RESCKTLVS
rndif_2T = (nresJunc NOT INTERACT SAB) NOT RESCKTLVS
rpdif_3T = (presJunc NOT INTERACT SAB) AND RESCKTLVS
rpdif_2T = (presJunc NOT INTERACT SAB) NOT RESCKTLVS
rndifsab_3T_dev = (nresJunc AND SAB) AND RESCKTLVS
rndifsab_3T_seed = (nresJunc INTERACT SAB) AND RESCKTLVS
rndifsab_2T_dev = (nresJunc AND SAB) NOT RESCKTLVS
rndifsab_2T_seed = (nresJunc INTERACT SAB) NOT RESCKTLVS
rpdifsab_3T_dev = (presJunc AND SAB) AND RESCKTLVS
rpdifsab_3T_seed = (presJunc INTERACT SAB) AND RESCKTLVS
rpdifsab_2T_dev = (presJunc AND SAB) NOT RESCKTLVS
rpdifsab_2T_seed = (presJunc INTERACT SAB) NOT RESCKTLVS
rnwsti_3T = (resNW NOT (AA AND SAB)) AND RESCKTLVS
rnwsti_2T = (resNW NOT (AA AND SAB)) NOT RESCKTLVS
rnwaa_3T = (resNW AND (AA AND SAB)) AND RESCKTLVS
rnwaa_2T = (resNW AND (AA AND SAB)) NOT RESCKTLVS
rnpo_2T = ((resPOLY AND NP) NOT SAB) NOT RES3TPOLY
rppo_2T = ((resPOLY AND PP) NOT SAB) NOT RES3TPOLY
rnposab_2T = ((resPOLY AND NP) AND SAB) NOT RES3TPOLY
rpposab_2T = (((resPOLY AND PP) AND SAB) NOT RES3TPOLY) NOT HRP
rhrpo_2T = (PO AND HRPBLK) NOT RES3TPOLY
rnpo_3T_nw = (((resPOLY AND NP) NOT SAB) AND RES3TPOLY) AND nWell
rppo_3T_nw = (((resPOLY AND PP) NOT SAB) AND RES3TPOLY) AND nWell
rnposab_3T_nw = (((resPOLY AND NP) AND SAB) AND RES3TPOLY) AND nWell
rpposab_3T_nw = ((((resPOLY AND PP) AND SAB) AND RES3TPOLY) NOT HRP) AND nWell
rhrpo_3T_nw = ((PO AND HRPBLK) AND RES3TPOLY) AND nWell
rnpo_3T_pw = (((resPOLY AND NP) NOT SAB) AND RES3TPOLY) AND pWell
rppo_3T_pw = (((resPOLY AND PP) NOT SAB) AND RES3TPOLY) AND pWell
rnposab_3T_pw = (((resPOLY AND NP) AND SAB) AND RES3TPOLY) AND pWell
rpposab_3T_pw = ((((resPOLY AND PP) AND SAB) AND RES3TPOLY) NOT HRP) AND pWell
rhrpo_3T_pw = ((PO AND HRPBLK) AND RES3TPOLY) AND pWell


