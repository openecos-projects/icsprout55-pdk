DMACRO MOM_PRO_2T  mom_finger TMM BMM {
        [PROPERTY LF,NF,mismod_mom,tm,bm,mr
        NF= count(mom_finger)
        A = AREA(mom_finger)/NF
        LF= A/1.0E-07+1.0E-07
        tm=TMM 
        bm=BMM
        mr=1
        #IFDEF MOM_MIS_MODE 0
         mismod_mom = 0
        #ELSE
         #IFDEF MOM_MIS_MODE 1
         mismod_mom = 1
         #ENDIF
        #ENDIF
        ]
}

DMACRO MOM_MIS_PRO  mom_finger TMM BMM SHD {
        [PROPERTY LF,NF,mismod_mom,tm,bm,mr,shielding
        NF= count(mom_finger)
        A = AREA(mom_finger)/NF
        LF= A/1.0E-07+1.0E-07
        tm=TMM 
        bm=BMM
        shielding=SHD
        mr=1
        #IFDEF MOM_MIS_MODE 0
         mismod_mom = 0
        #ELSE
         #IFDEF MOM_MIS_MODE 1
         mismod_mom = 1
         #ENDIF
        #ENDIF
        ]
}

DMACRO VAR_PRO seedlayer terminallayer1 terminallayer2 { 
 [ PROPERTY LR, WR, NF, MR, MULTI
 NF = COUNT(terminallayer1)
 WR = PERIM_CO(terminallayer1, terminallayer2)/(2*NF)
 LR = AREA(terminallayer1)/(WR*NF)
 MR = 1
 MULTI = 1
 #IFDEF VAR_MIS_MODE 0
 mismod = 0
 #ELSE
 #IFDEF VAR_MIS_MODE 1
 mismod = 1
 #ENDIF 
 #ENDIF 
 ]
}

//-------reduce procedure------
DMACRO MOS_REDUCE device_name {
 LVS REDUCE device_name PARALLEL YES
 [TOLERANCE L 0
 effective L,W
 P = sum( W*L )
 Q = sum( W/L )
 W = sqrt( P*Q )
 L = sqrt ( P/Q )
 ]
}

DMACRO BJT_REDUCE device_name {
 LVS REDUCE device_name PARALLEL YES
 [effective "A"
 "A" = sum ( "A" )
 ]
}

DMACRO RES_REDUCE device_name {
 LVS REDUCE device_name SERIES pos neg YES
 [TOLERANCE W 0 
 effective L,W
 P = sum ( W * L ) 
 Q = sum ( L / W ) 
 L = sqrt( P * Q )
 W = sqrt( P / Q )
 ]
 LVS REDUCE device_name PARALLEL YES
 [TOLERANCE L 0
 effective L,W
 P = sum ( W * L ) 
 Q = sum ( W / L )
 L = sqrt( P / Q )
 W = sqrt( P * Q )
 ]
}

DMACRO VAR_REDUCE device_name {
 LVS REDUCE device_name PARALLEL YES
 [TOLERANCE LR 0 WR 0
 effective LR,WR,NF
 LR = sum ( LR*NF )/sum ( NF )
 WR = sum ( WR*NF )/sum ( NF )
 NF = sum ( NF ) ]
}
/*
LVS REDUCE mom_2t PARALLEL YES
[ tolerance LF 0 BM 0 TM 0
      effective LF,NF,BM,TM
      LF = SUM(LF)/COUNT()
      NF = SUM(NF)
      BM = SUM(BM)/COUNT()
      TM = SUM(TM)/COUNT()
    ]

LVS REDUCE mom_3t PARALLEL YES
[ tolerance LF 0 BM 0 TM 0
      effective LF,NF,BM,TM
      LF = SUM(LF)/COUNT()
      NF = SUM(NF)
      BM = SUM(BM)/COUNT()
      TM = SUM(TM)/COUNT()
    ]
*/

