//mom setup-----

mom_gt = PO INTERACT (MOMLVS1 with text "mom_wips")
//mom_gt = (PO ENCLOSE MOMLVS1) OR (PO INTERACT (MOMLVS1 with text "mom_wips"))
//mom_gt = PO INTERACT MOMLVS1
mom_nw = nWell ENCLOSE MOMLVS1
mom_pw = pWell NOT (pWell INSIDE MOMLVS1)
mom_wims = MOMLVS1 with text "mom_wims"
mom_terminal1 = M1s AND mom_wims
//*Define MOM DEVICE

#IFDEF TOTALMETAL 4
#IFDEF TOP_METAL_NUM SINGLE
mom_metal1         = M1s AND MOMLVS1
mom_V1             = VIA1 AND MOMLVS1
metal1b            = copy M1s 
mom_metal2         = M2s AND MOMLVS1
mom_V2             = VIA2 AND MOMLVS1
metal2b            = copy M2s
mom_metal3         = M3s AND MOMLVS1
metal3b            = copy M3s 

mom_m1_m3_VA = mom_V1 AND mom_V2

mom_text = OR mom12reg_1 mom13reg_1 mom23reg_1 

mom12reg_1    = MOMLVS1 with text "momcap12"
mom12tt1       = mom_metal1 AND mom_metal2
mom12f1        = mom12tt1 NOT INTERACT mom_V1
mom12reg1      = EXTENTS (SIZE (mom12f1 AND mom12reg_1) BY 0.1 INSIDE OF MOMLVS1)
mom12tt2       = (mom_metal1 AND mom_metal2) NOT INTERACT mom_metal3
mom12f2        = mom12tt2 NOT INTERACT mom_V1
mom12reg2      = (EXTENTS (SIZE mom12f2 BY 0.1 INSIDE OF MOMLVS1)) not INTERACT mom_text
mom12reg       = mom12reg1 OR mom12reg2
mom12f         = mom12f1 OR mom12f2
momcap12      = (((mom12reg NOT RFALL) NOT RFTER) AND MOMLVS1) NOT MOMLVS2
momcap12_3t   = (((mom12reg NOT RFALL) AND RFTER) AND MOMLVS1) NOT MOMLVS2
mom_terminal12 = ((mom_metal1 AND mom_metal2) INTERACT mom12reg) ENCLOSE mom_V1

momcap12_3t_wips   = (momcap12_3t AND mom_gt) NOT INTERACT mom_wims
momcap12_3t_wops   = (momcap12_3t NOT mom_gt) NOT INTERACT mom_wims
momcap12_3t_wims   = (momcap12_3t NOT mom_gt) INTERACT mom_wims

mom23reg_1     = MOMLVS1 with text "momcap23"
mom23tt1       = mom_metal2 AND mom_metal3
mom23f1        = mom23tt1 NOT INTERACT mom_V2
mom23reg1      = EXTENTS (SIZE (mom23f1 AND mom23reg_1) BY 0.1 INSIDE OF MOMLVS1)
mom23tt2       = (mom_metal2 AND mom_metal3) NOT INTERACT mom_metal1
mom23f2        = mom23tt2 NOT INTERACT mom_V2
mom23reg2      = (EXTENTS (SIZE mom23f2 BY 0.1 INSIDE OF MOMLVS1)) not INTERACT mom_text
mom23reg       = mom23reg1 OR mom23reg2
mom23f         = mom23f1 OR mom23f2
momcap23      = (((mom23reg NOT RFALL) NOT RFTER) AND MOMLVS1) NOT MOMLVS2
momcap23_3t   = (((mom23reg NOT RFALL) AND RFTER) AND MOMLVS1) NOT MOMLVS2
mom_terminal23= (mom_metal2 AND mom_metal3) ENCLOSE mom_V2

momcap23_3t_wips   = (momcap23_3t AND mom_gt) NOT INTERACT mom_wims
momcap23_3t_wops   = (momcap23_3t NOT mom_gt) NOT INTERACT mom_wims
momcap23_3t_wims   = (momcap23_3t NOT mom_gt) INTERACT mom_wims

mom13reg_1    = MOMLVS1 with text "momcap13"
mom13tt       = (mom_metal1 AND mom_metal2) AND mom_metal3
mom13f        = mom13tt NOT INTERACT (mom_V1 OR mom_V2)
mom13reg1      = EXTENTS (SIZE (mom13f AND mom13reg_1) BY 0.1 INSIDE OF MOMLVS1)
mom13reg2      = (EXTENTS (SIZE mom13f BY 0.1 INSIDE OF MOMLVS1)) not INTERACT mom_text
mom13reg       = mom13reg1 OR mom13reg2
momcap13      = (((mom13reg NOT RFALL) NOT RFTER) AND MOMLVS1) NOT MOMLVS2
momcap13_3t   = (((mom13reg NOT RFALL) AND RFTER) AND MOMLVS1) NOT MOMLVS2

mom_terminal13= (((mom_metal1 AND mom_metal2) AND mom_metal3) INTERACT mom13reg) ENCLOSE mom_m1_m3_VA

momcap13_3t_wips   = (momcap13_3t AND mom_gt) NOT INTERACT mom_wims
momcap13_3t_wops   = (momcap13_3t NOT mom_gt) NOT INTERACT mom_wims
momcap13_3t_wims   = (momcap13_3t NOT mom_gt) INTERACT mom_wims



DEVICE mom_2t momcap12 mom_terminal12(PLUS) mom_terminal12(MINUS) <mom12f> CMACRO MOM_PRO_2T mom12f 2 1
DEVICE mom_2t momcap23 mom_terminal23(PLUS) mom_terminal23(MINUS) <mom23f> CMACRO MOM_PRO_2T mom23f 3 2
DEVICE mom_3t momcap12_3t_wips mom_terminal12(PLUS) mom_terminal12(MINUS) ppoly(B) <mom12f> CMACRO MOM_MIS_PRO mom12f 2 1 1
DEVICE mom_3t momcap23_3t_wips mom_terminal23(PLUS) mom_terminal23(MINUS) ppoly(B) <mom23f> CMACRO MOM_MIS_PRO mom23f 3 2 1
DEVICE mom_3t momcap23_3t_wims mom_terminal23(PLUS) mom_terminal23(MINUS) mom_terminal1(B) <mom23f> CMACRO MOM_MIS_PRO mom23f 3 2 2
DEVICE mom_3t momcap12_3t_wops mom_terminal12(PLUS) mom_terminal12(MINUS) mom_nw(B) <mom12f> CMACRO MOM_MIS_PRO mom12f 2 1 0
DEVICE mom_3t momcap12_3t_wops mom_terminal12(PLUS) mom_terminal12(MINUS) mom_pw(B) <mom12f> CMACRO MOM_MIS_PRO mom12f 2 1 0
DEVICE mom_3t momcap23_3t_wops mom_terminal23(PLUS) mom_terminal23(MINUS) mom_nw(B) <mom23f> CMACRO MOM_MIS_PRO mom23f 3 2 0
DEVICE mom_3t momcap23_3t_wops mom_terminal23(PLUS) mom_terminal23(MINUS) mom_pw(B) <mom23f> CMACRO MOM_MIS_PRO mom23f 3 2 0

DEVICE mom_2t momcap13 mom_terminal13(PLUS) mom_terminal13(MINUS) <mom13f> CMACRO MOM_PRO_2T mom13f 3 1 

DEVICE mom_3t momcap13_3t_wops mom_terminal13(PLUS) mom_terminal13(MINUS) mom_nw(B) <mom13f> CMACRO MOM_MIS_PRO mom13f 3 1 0
DEVICE mom_3t momcap13_3t_wops mom_terminal13(PLUS) mom_terminal13(MINUS) mom_pw(B) <mom13f> CMACRO MOM_MIS_PRO mom13f 3 1 0

DEVICE mom_3t momcap13_3t_wips mom_terminal13(PLUS) mom_terminal13(MINUS) ppoly(B) <mom13f> CMACRO MOM_MIS_PRO mom13f 3 1 1
#ENDIF
