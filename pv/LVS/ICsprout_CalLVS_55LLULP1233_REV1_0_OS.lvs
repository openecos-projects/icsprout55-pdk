//***********************************************************************************

SOURCE PATH "TOPCELL.cdl"
SOURCE PRIMARY "TOPCELL"
SOURCE SYSTEM SPICE

PRECISION 	1000

LAYOUT PATH "TOPCELL.gds"
LAYOUT PRIMARY "TOPCELL"
LAYOUT SYSTEM GDSII
//LAYOUT SYSTEM OASIS



LVS REPORT "lvs.rep"
LVS REPORT OPTION A B C D E S P V
LVS REPORT MAXIMUM 1000

PORT DEPTH 0
TEXT DEPTH 0
//LVS PRESERVE FLOATING TOP NETS YES

LAYOUT INPUT EXCEPTION SEVERITY POLYGON_DEGENERATE 1

#IFDEF CASE_SENSITIVITY TRUE
SOURCE CASE YES
LAYOUT CASE YES
LVS COMPARE CASE YES
#ENDIF

UNIT CAPACITANCE FF
UNIT RESISTANCE OHM
UNIT LENGTH U

LVS FILTER UNUSED OPTION AB RC RE RG SOURCE
LVS FILTER UNUSED OPTION AB RC RE RG LAYOUT

LVS POWER NAME "?VDD?" "?POWER?" 
LVS GROUND NAME "?VSS?" "?GND?"
VARIABLE LVS_HV_POWER_NAME "?VDDH?"

LVS RECOGNIZE GATES NONE
 
VIRTUAL CONNECT COLON YES
VIRTUAL CONNECT REPORT YES
//VIRTUAL CONNECT NAME "?"

//DRC RESULTS DATABASE "out.db"

#IFDEF RC_EXTRACT TRUE
PEX NETLIST LUMPED "lumped.dist" HSPICE LAYOUT GROUND VSS MASK
PEX REPORT LUMPED none
PEX REPORT DISTRIBUTED none
PEX NETLIST DISTRIBUTED "distributed.dist" HSPICE LAYOUT GROUND VSS MASK
#IFDEF RC_EXTRACT_FLOW XRC
MASK SVDB DIRECTORY "svdb" XRC QUERY // For XRC flow
#ENDIF
#IFDEF RC_EXTRACT_FLOW CCI
MASK SVDB DIRECTORY "svdb" CCI QUERY //For CCI StarRC/QRC flow
#ENDIF
#ELSE
MASK SVDB DIRECTORY "svdb" QUERY
#ENDIF

#IFDEF ERC_CHECK TRUE
LVS EXECUTE ERC YES
ERC RESULTS DATABASE "erc.results"
ERC SUMMARY REPORT "erc.summary" REPLACE HIER
ERC CELL NAME YES CELL SPACE XFORM
ERC MAXIMUM RESULTS 1000
ERC MAXIMUM VERTEX 4096
#ENDIF

//DRC ICSTATION YES

LVS ISOLATE SHORTS YES

LVS ABORT ON SUPPLY ERROR NO
LVS ALL CAPACITOR PINS SWAPPABLE NO 

LVS IGNORE PORTS NO
LVS CHECK PORT NAMES YES

LVS SPICE PREFER PINS YES
LVS SPICE Strict WL YES
LVS SPICE REPLICATE DEVICES YES
LVS SPICE MULTIPLIER NAME "M" "MR" //special multipler factor name

LVS REDUCE PARALLEL BIPOLAR YES
LVS REDUCE PARALLEL MOS YES
LVS REDUCE PARALLEL DIODES YES
LVS REDUCE PARALLEL CAPACITORS NO
LVS REDUCE PARALLEL RESISTORS YES
LVS REDUCE SERIES RESISTORS YES
LVS REDUCE SERIES CAPACITORS NO
LVS REDUCE SPLIT GATES YES 
//LVS INJECT LOGIC NO

#IFDEF RC_EXTRACT TRUE
#IFDEF RC_EXTRACT_FLOW XRC
PEX IDEAL XCELL YES
LAYOUT CELL LIST pcells "var1p2_npd_nw_lp*" "var2p5_npd_nw_lp*" "var3p3_npd_nw_lp*" "mom_2t*" "mom_3t*"
LAYOUT PRESERVE CELL LIST pcells
#ENDIF
#ENDIF

