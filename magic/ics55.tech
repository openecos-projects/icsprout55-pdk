  calma met4_slot 84 8
  calma met4_slotblk 84 9
  calma met4_mom 84 10
  calma met5 85 1
  calma met5_dm 85 2
  calma met5_dmblk 85 3
  calma met5_res 85 4
  calma met5_opcblk 85 5
  calma met5_text 85 6
  calma met5_slot 85 8
  calma met5_slotblk 85 9
  calma met5_mom 85 10
  calma via1 91 1
  calma via1_bar 91 7
  calma via2 92 1
  calma via2_bar 92 7
  calma via3 93 1
  calma via3_bar 93 7
  calma via4 94 1
  calma via4_bar 94 7
  calma t4m2 103 1
  calma t4m2_dm 103 2
  calma t4m2_dmblk 103 3
  calma t4m2_res 103 4
  calma t4m2_opcblk 103 5
  calma t4m2_text 103 6
  calma t4m2_slot 103 8
  calma t4m2_slotblk 103 9
  calma t4v2 113 1
  calma t4v2_bar 113 7
  calma rv 120 1
  calma cb 121 1
  calma cb_text 121 6
  calma alpad 122 1
  calma alpad_res 122 4
  calma alpad_text 122 6
  calma alpad_slot 122 8
  calma alpad_slotblk 122 9
  calma rdl 123 1
  calma rdl_text 123 6
  calma cover 124 1
  calma bmim 140 1
  calma tmim 141 1
  calma io_mark 150 12
  calma core_mark 151 12
  calma ulld_mark 152 12
  calma ud_mark 153 12
  calma od_mark 154 12
  calma sramall_mark 171 12
  calma srampg_mark 172 12
  calma sram6thd_mark 173 12
  calma sram6ths_mark 174 12
  calma sram8thd_mark 176 12
  calma sram8ths_mark 177 12
  calma diode_mark 191 12
  calma vara_mark 192 12
  calma varam_mark 193 12
  calma varaj_mark 194 12
  calma bjt_mark 195 12
  calma ldmos_mark 211 12
  calma esdiot_mark 231 12
  calma esdioe_mark 232 12
  calma rfall_mark 241 12
  calma rfd_mark 242 12
  calma rfter_mark 243 12

  # FIXME: Once magic supports anything more than 255
  # for the calma layers, this will remain to be the
  # boundary definition
  templayer allbound act
  or nw
  or pp
  or np
  or met1
  or met2
  or met3
  or met4
  or met5
  or t4m2
  or rdl
    boundary
end

drc
  style drc variants (fast),(full),(routing)
  scalefactor 10
  
  variants (fast),(full)
  
  width act 100 "dummy act width"
  width poly 100 "dummy poly width"
  width m1 100 "dummy metal1 width"
  width m2 100 "dummy metal2 width"
  width m3 100 "dummy metal3 width"
  width m4 100 "dummy metal4 width"
  width m5 100 "dummy metal5 width"
  width t4m2 100 "dummy t4m2 width"
  width rdl 100 "dummy rdl width"
end

extract
  style default
  planeorder pact 0
  planeorder pmet1 1
  planeorder pmet2 2
  planeorder pmet3 3
  planeorder pmet4 4
  planeorder pmet5 5
  planeorder pmet6 6
  planeorder pmet7 7
  planeorder ppoly 8
  planeorder pzzlast 9
end

lef
  masterslice lact ACT
  masterslice poly POLY
  routing m1 MET1
  routing m2 MET2
  routing m3 MET3
  routing m4 MET4
  routing m5 MET5
  routing m7 RDL
  routing m6 T4M2
  cut ct CT
  cut via6 RV
  cut via5 T4V2
  cut via1 VIA1
  cut via2 VIA2
  cut via3 VIA3
  cut via4 VIA4
  obs m1 MET1
  obs m2 MET2
  obs m3 MET3
  obs m4 MET4
  obs m5 MET5
  obs m7 RDL
  obs m6 T4M2
  obs poly,ct CT
  obs m6,m7 RV
  obs m5,m6 T4V2
  obs m1,m2 VIA1
  obs m2,m3 VIA2
  obs m3,m4 VIA3
  obs m4,m5 VIA4
end

