mzrouter
end

drc
 style drc variants (fast),(full),(routing)
 scalefactor 10

 # ---- LEF minimum width / spacing of the routing and cut layers (technology LEF)
 variants *
 width allm1 90 "MET1 width < %d (technology LEF)"
 spacing allm1 allm1 90 touching_ok "MET1 spacing < %d (technology LEF)"
 width allm2 100 "MET2 width < %d (technology LEF)"
 spacing allm2 allm2 100 touching_ok "MET2 spacing < %d (technology LEF)"
 width allm3 100 "MET3 width < %d (technology LEF)"
 spacing allm3 allm3 100 touching_ok "MET3 spacing < %d (technology LEF)"
 width allm4 100 "MET4 width < %d (technology LEF)"
 spacing allm4 allm4 100 touching_ok "MET4 spacing < %d (technology LEF)"
 width allm5 100 "MET5 width < %d (technology LEF)"
 spacing allm5 allm5 100 touching_ok "MET5 spacing < %d (technology LEF)"
 width allm6 400 "T4M2 width < %d (technology LEF)"
 spacing allm6 allm6 400 touching_ok "T4M2 spacing < %d (technology LEF)"
 width allm7 3000 "RDL width < %d (technology LEF)"
 spacing allm7 allm7 2000 touching_ok "RDL spacing < %d (technology LEF)"
 width via1 90 "VIA1 width < %d (technology LEF)"
 spacing via1 via1 110 touching_ok "VIA1 spacing < %d (technology LEF)"
 width via2 90 "VIA2 width < %d (technology LEF)"
 spacing via2 via2 110 touching_ok "VIA2 spacing < %d (technology LEF)"
 width via3 90 "VIA3 width < %d (technology LEF)"
 spacing via3 via3 110 touching_ok "VIA3 spacing < %d (technology LEF)"
 width via4 90 "VIA4 width < %d (technology LEF)"
 spacing via4 via4 110 touching_ok "VIA4 spacing < %d (technology LEF)"
 width via5 360 "T4V2 width < %d (technology LEF)"
 spacing via5 via5 340 touching_ok "T4V2 spacing < %d (technology LEF)"
 width via6 3000 "RV width < %d (technology LEF)"
