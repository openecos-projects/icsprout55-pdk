cifoutput
style gdsii
 scalefactor 10 nanometers
 options calma-permissive-labels
 gridlimit 1

 layer DNW dnwell
  calma 7 1

 layer NW nwell,rnwell
  calma 9 1

 layer NW1res rnwell
  calma 9 4

 layer ACT allactive,alldiffcont
  calma 2 1

 layer POLY allpoly,pc
  calma 41 1

 layer CT allcont
  squares 0 90 110
  calma 72 1

 layer NP nimp
  calma 52 1

 layer PP pimp
  calma 53 1

 layer NVT1 nvt1
  calma 17 1

 layer PVT1 pvt1
  calma 18 1

 layer NVT3 nvt3
  calma 21 1

 layer PVT3 pvt3
  calma 22 1

 layer DGOX dgox
  calma 27 1

 layer TGOX tgox
  calma 28 1

 layer SAB sab
  calma 71 1

 layer HRP hrp
  calma 54 1

 layer ESD esd
  calma 55 1

 layer NPD npd
  calma 43 1

 layer DIODE diodemk
  calma 191 12

 layer POLYres polyres
  calma 41 4

 layer ACTres actres
  calma 2 4

 layer OD odmk
  calma 154 12

 layer UD udmk
  calma 153 12

 layer ULLD ulldmk
  calma 152 12

 layer SRAMALL sramall
  calma 171 12

 layer BJT bjtmk
  calma 195 12

 layer LDMOS ldmosmk
  calma 211 12

 layer VARAM varammk
  calma 193 12

 layer ESDIOE esdioe
  calma 232 12

 layer ESDIOT esdiot
  calma 231 12

 layer IO ioarea
  calma 150 12

 layer CORE corearea
  calma 151 12

 layer MET1 allm1
  labels allm1
  calma 81 1

 layer MET1res rm1
  calma 81 4

 layer MET1dm m1fill
  calma 81 2

 layer MET1text
  labels allm1 port
  calma 81 6

 layer MET2 allm2
  labels allm2
  calma 82 1

 layer MET2res rm2
  calma 82 4

 layer MET2dm m2fill
  calma 82 2

 layer MET2text
  labels allm2 port
  calma 82 6

 layer MET3 allm3
  labels allm3
  calma 83 1

 layer MET3res rm3
  calma 83 4

 layer MET3dm m3fill
  calma 83 2

 layer MET3text
  labels allm3 port
  calma 83 6

 layer MET4 allm4
  labels allm4
  calma 84 1

 layer MET4res rm4
  calma 84 4

 layer MET4dm m4fill
  calma 84 2

 layer MET4text
  labels allm4 port
  calma 84 6

 layer MET5 allm5
  labels allm5
  calma 85 1

 layer MET5res rm5
  calma 85 4

 layer MET5dm m5fill
  calma 85 2

 layer MET5text
  labels allm5 port
  calma 85 6

 layer T4M2 allm6
  labels allm6
  calma 103 1

 layer T4M2res rm6
  calma 103 4

 layer T4M2dm m6fill
  calma 103 2

 layer T4M2text
  labels allm6 port
  calma 103 6

 layer RDL allm7
  labels allm7
  calma 123 1

 layer RDLtext
  labels allm7 port
  calma 123 6

 layer VIA1 via1
  calma 91 1

 layer VIA2 via2
  calma 92 1

 layer VIA3 via3
  calma 93 1

 layer VIA4 via4
  calma 94 1

 layer T4V2 via5
  calma 113 1

 layer RV via6
  calma 120 1

 layer CB glass
  calma 121 1


#------------------------------------------------------------------------------
# derived layers of the translated Calibre DRC rules (svrf2magic_drc.py)
#------------------------------------------------------------------------------
style drc
 scalefactor 10 nanometers
 gridlimit 1

 templayer c0 ulldmk
  close 1000000000000
  and-not ulldmk
 templayer c1
  bloat-all sab allcont
  and allcont
 templayer c2 allm1
 templayer c3 allm2
 templayer c4 allm3
 templayer c5 allm4
 templayer c6 allm5
 templayer c7 via5
  grow 20
  and-not allm6
 templayer c8 allm6
