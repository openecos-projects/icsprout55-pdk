cifoutput
  style gdsii
  scalefactor 1 nanometers

  layer act act
    calma 2 1
  layer nw nw
    calma 9 1
  layer poly poly
    calma 41 1
  layer ct ct
    calma 72 1
  layer np np
    calma 52 1
  layer pp pp
    calma 53 1
  layer met1 met1
    calma 81 1
  layer met1_pin met1_pin
    calma 81 6
  layer via1 via1
    calma 91 1
  layer met2 met2
    calma 82 1
  layer met2_pin met2_pin
    calma 82 6
  layer via2 via2
    calma 92 1
  layer met3 met3
    calma 83 1
  layer met3_pin met3_pin
    calma 83 6
  layer via3 via3
    calma 93 1
  layer met4 met4
    calma 84 1
  layer met4_pin met4_pin
    calma 84 6
  layer via4 via4
    calma 94 1
  layer met5 met5
    calma 85 1
  layer met5_pin met5_pin
    calma 85 6
  layer t4v2 t4v2
    calma 113 1
  layer t4m2 t4m2
    calma 103 1
  layer t4m2_pin t4m2_pin
    calma 103 6
  layer rv rv
    calma 120 1
  layer rdl rdl
    calma 123 1
  layer rdl_pin rdl_pin
    calma 123 6
  layer ap ap
    calma 121 1
  layer rpoly rpoly
    calma 41 4
  layer unk_17_1 unk_17_1
    calma 17 1
  layer unk_18_1 unk_18_1
    calma 18 1
  layer unk_55_1 unk_55_1
    calma 55 1
  layer unk_71_1 unk_71_1
    calma 71 1
  layer unk_191_12 unk_191_12
    calma 191 12
  layer bound bound
    calma 351 12

style drc
 scalefactor 1 nanometers
 options calma-permissive-labels

style density
 scalefactor 1 nanometers
 options calma-permissive-labels
 gridlimit 5

style patternfill
 scalefactor 1 nanometers
 options calma-permissive-labels
 gridlimit 5
end

cifinput
  style gdsii
  scalefactor 1 nanometers

  layer l1 act
  layer l2 nw
  layer poly poly
  layer l4 ct
  layer l5 np
  layer l6 pp
  layer m1 met1
  layer l8 met1_pin
  layer via1 via1
  layer m2 met2
  layer l11 met2_pin
  layer via2 via2
  layer m3 met3
  layer l14 met3_pin
  layer via3 via3
  layer m4 met4
  layer l17 met4_pin
  layer via4 via4
  layer m5 met5
  layer l20 met5_pin
  layer via5 t4v2
  layer m6 t4m2
  layer l23 t4m2_pin
  layer via6 rv
  layer m7 rdl
  layer l26 rdl_pin
  layer l27 ap
  layer l28 rpoly
  layer l29 unk_17_1
  layer l30 unk_18_1
  layer l31 unk_55_1
  layer l32 unk_71_1
  layer l33 unk_191_12
  layer l34 unk_81_2
  layer l35 bound

  calma act 2 1
  calma nw 9 1
  calma poly 41 1
  calma ct 72 1
  calma np 52 1
  calma pp 53 1
  calma met1 81 1
  calma met1_pin 81 6
  calma via1 91 1
  calma met2 82 1
  calma met2_pin 82 6
  calma via2 92 1
  calma met3 83 1
  calma met3_pin 83 6
  calma via3 93 1
  calma met4 84 1
  calma met4_pin 84 6
  calma via4 94 1
  calma met5 85 1
  calma met5_pin 85 6
  calma t4v2 113 1
  calma t4m2 103 1
  calma t4m2_pin 103 6
  calma rv 120 1
  calma rdl 123 1
  calma rdl_pin 123 6
  calma ap 121 1
  calma rpoly 41 4
  calma unk_17_1 17 1
  calma unk_18_1 18 1
  calma unk_55_1 55 1
  calma unk_71_1 71 1
  calma unk_191_12 191 12
  calma unk_81_2 81 2
  calma bound 351 12

  # FIXME: Once magic supports anything more than 255
  # for the calma layers, this will remain to be the
  # boundary definition
  templayer allbound act
  or nw
  or pp
  or np
  or met1
  or met2
  or met3
  or met4
  or met5
  or t4m2
  or rdl
    boundary
end

drc
  style drc variants (fast),(full),(routing)
  scalefactor 10
  cifstyle drc

  variants (fast),(full)

  width act 100 "dummy act width"
  width poly 100 "dummy poly width"
  width m1 100 "dummy m1 width"
  width m2 100 "dummy m2 width"
  width m3 100 "dummy m3 width"
  width m4 100 "dummy m4 width"
  width m5 100 "dummy m5 width"
  width m6 100 "dummy m6 width"
  width m7 100 "dummy m7 width"

end

extract
  style default
  planeorder p1 0
  planeorder p10 1
  planeorder p11 2
  planeorder p12 3
  planeorder p13 4
  planeorder p14 5
  planeorder p15 6
  planeorder p16 7
  planeorder p17 8
  planeorder p18 9
  planeorder p19 10
  planeorder p2 11
  planeorder p20 12
  planeorder p21 13
  planeorder p22 14
  planeorder p23 15
  planeorder p24 16
  planeorder p25 17
  planeorder p26 18
  planeorder p27 19
  planeorder p28 20
  planeorder p29 21
  planeorder p3 22
  planeorder p30 23
  planeorder p31 24
  planeorder p32 25
  planeorder p33 26
  planeorder p4 27
  planeorder p5 28
  planeorder p6 29
  planeorder p7 30
  planeorder p8 31
  planeorder p9 32
  planeorder p34 33
  planeorder p35 34
end
lef
  masterslice l1 ACT
  masterslice poly POLY
  routing m1 MET1
  routing m2 MET2
  routing m3 MET3
  routing m4 MET4
  routing m5 MET5
  routing m7 RDL
  routing m6 T4M2
  cut ct CT
  cut via6 RV
  cut via5 T4V2
  cut via1 VIA1
  cut via2 VIA2
  cut via3 VIA3
  cut via4 VIA4
  obs m1 MET1
  obs m2 MET2
  obs m3 MET3
  obs m4 MET4
  obs m5 MET5
  obs m7 RDL
  obs m6 T4M2
  obs poly,ct CT
  obs m6,m7 RV
  obs m5,m6 T4V2
  obs m1,m2 VIA1
  obs m2,m3 VIA2
  obs m3,m4 VIA3
  obs m4,m5 VIA4
end
