  and ACT
  and PP
  and NW
  and TGOX
  and DIODE
  and-not POLY
  and-not PSUB

 layer pc CT
  and POLY
  and-not ACT

 # ---- metals and vias
 layer m1 MET1
  and-not MET1res
  labels MET1 port
  labels MET1text port

 layer rm1 MET1
  and MET1res

 layer m1fill MET1dm

 layer m2 MET2
  and-not MET2res
  labels MET2 port
  labels MET2text port

 layer rm2 MET2
  and MET2res

