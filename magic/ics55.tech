# This part is HEAVILY modified
# Basically, we just match the layer name with the via in the same plane, so we can form a cut
# BUT we put the mX in a different plane, to avoid mistakenly identified as cut
types
  p1 l1
  p2 nw,l2
  p3 poly
  p4 ct,l4,act
  p5 np,l5
  p6 pp,l6
  p7 met1,via1
  p8 met1_pin,l8
  p9 m1
  p10 met2,via2
  p11 met2_pin,l11
  p12 m2
  p13 met3,via3
  p14 met3_pin,l14
  p15 m3
  p16 met4,via4
  p17 met4_pin,l17
  p18 m4
  p19 met5,t4v2,via5
  p20 met5_pin,l20
  p21 m5
  p22 t4m2,rv,via6
  p23 t4m2_pin,l23
  p24 m6
  p25 rdl,m7
  p26 rdl_pin,l26
  p27 ap,l27
  p28 rpoly,l28
  p29 unk_17_1,l29
  p30 unk_18_1,l30
  p31 unk_55_1,l31
  p32 unk_71_1,l32
  p33 unk_191_12,l33
  p34 unk_81_2,l34
  p35 bound,l35
end

# The cuts are also modified
contact
  ct act met1
  via1 met1 met2
  via2 met2 met3
  via3 met3 met4
  via4 met4 met5
  t4v2 met5 t4m2
  rv   t4m2 rdl

  stackable
end

