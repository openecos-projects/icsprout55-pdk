	"AAres_S_1_NP: Space between non-silicide AA resistors area and other implant region >= 0.18um"
 cifspacing c248 c246 180 touching_illegal \
	"AAres_S_1_PP: Space between non-silicide AA resistors area and other implant region >= 0.18um"
 variants *
end

lef
  masterslice poly POLY
  routing m1 MET1
  obs obsm1 MET1
  routing m2 MET2
  obs obsm2 MET2
  routing m3 MET3
  obs obsm3 MET3
  routing m4 MET4
  obs obsm4 MET4
  routing m5 MET5
  obs obsm5 MET5
  routing m6 T4M2
  obs obsm6 T4M2
  routing m7 RDL
  obs obsm7 RDL
  cut via1 VIA1
  cut via2 VIA2
  cut via3 VIA3
  cut via4 VIA4
  cut via5 T4V2
  cut via6 RV
end

