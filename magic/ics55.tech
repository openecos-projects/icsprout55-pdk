cifinput
style import
 scalefactor 10 nanometers
 gridlimit 1
 options ignore-unknown-layer-labels no-reconnect-labels

 layer dnwell DNW

 layer rnwell NW
  and NW1res

 # labels drawn on NW (VNW of the 7-track cells) name the well, they are not pins;
 # WELTXT (well pin of the 9-track cells) is
 layer nwell NW
  and-not NW1res
  labels NW
  labels WELTXT port

 # Calibre cuts the substrate around SUBCKTLVS (sub2Ring): isolated substrate inside
 layer isosub SUBCKTLVS

 # pwell: substrate under the cell boundary (CHIPBLK) and inside SUBCKTLVS, the shape
 # that carries the substrate pin label SUBTXT (9-track VPW)
 layer pwell CHIPBLK,SUBCKTLVS
  and-not NW
  labels SUBTXT port

 # ---- poly (ACT / POLY derived device layers follow Calibre: gate = POLY AND ACT)
 # resistor bodies: POLYres inside SAB, or POLYres away from SAB (silicided)
 templayer sabhalo SAB
  grow 5000

 templayer ressab POLY
  and POLYres
  and SAB

 templayer ressil POLY
  and POLYres
  and-not sabhalo

 layer poly POLY
  and-not ACT
  and-not ressab
  and-not ressil
  and-not HRPBLK

 layer polyfill POLYdm

 layer difffill ACTdm

 # re_npo_2t (rnpo_2T)
 layer rnpo POLY
  and POLYres
  and NP
  and-not ACT
  and-not sabhalo
  and-not HRPBLK

 # re_ppo_2t (rppo_2T)
 layer rppo POLY
  and POLYres
  and PP
  and-not ACT
  and-not sabhalo
  and-not HRPBLK

 # re_npo_sab_2t (rnposab_2T)
 layer rnposab POLY
  and POLYres
  and NP
  and SAB
  and-not ACT
  and-not HRPBLK

 # re_ppo_sab_2t (rpposab_2T)
 layer rpposab POLY
  and POLYres
  and PP
  and SAB
  and-not ACT
  and-not HRP
  and-not HRPBLK

 # re_hrpo_2t (rhrpo_2T)
 layer rhrpo POLY
  and HRPBLK
  and-not ACT

 # sd (Calibre nSD)
 layer ndiff ACT
  and NP
  and-not POLY
  and-not NW
  and-not TGOX
  and-not DIODE

 # sd (Calibre pSD)
 layer pdiff ACT
  and PP
  and NW
  and-not POLY
  and-not TGOX
  and-not DIODE

 # sd (Calibre nSD)
 layer mvndiff ACT
  and NP
  and TGOX
  and-not POLY
  and-not NW
  and-not DIODE

 # sd (Calibre pSD)
 layer mvpdiff ACT
  and PP
  and NW
  and TGOX
  and-not POLY
  and-not DIODE

 # ntap (Calibre nTap)
 layer nsd ACT
  and NP
  and NW
  and-not POLY
  and-not TGOX

 # ptap (Calibre pTap)
 layer psd ACT
  and PP
  and-not POLY
  and-not NW
  and-not TGOX

 # ntap (Calibre nTap)
 layer mvnsd ACT
  and NP
  and NW
  and TGOX
  and-not POLY

 # ptap (Calibre pTap)
 layer mvpsd ACT
  and PP
  and TGOX
  and-not POLY
  and-not NW

 # dio_1p2_np_pw_lp (Calibre ndiocore_svt_diode)
 layer ndiode ACT
  and NP
  and DIODE
  and-not POLY
  and-not NW
  and-not TGOX
  and-not NVT1
  and-not NVT3
  and-not PSUB

 # dio_1p2_np_pw_lvt_lp (Calibre ndiocore_lvt_diode)
 layer ndiodelvt ACT
  and NP
  and DIODE
  and NVT1
  and-not POLY
  and-not NW
  and-not TGOX
  and-not PSUB

 # dio_1p2_np_pw_hvt_lp (Calibre ndiocore_hvt_diode)
 layer ndiodehvt ACT
  and NP
  and DIODE
  and NVT3
  and-not POLY
  and-not NW
  and-not TGOX
  and-not PSUB
  and-not NVT1

 # dio_1p2_pp_nw_lp (Calibre pdiocore_svt_diode)
 layer pdiode ACT
  and PP
  and NW
  and DIODE
  and-not POLY
  and-not TGOX
  and-not PVT1
  and-not PVT3
  and-not PSUB

 # dio_1p2_pp_nw_lvt_lp (Calibre pdiocore_lvt_diode)
 layer pdiodelvt ACT
  and PP
  and NW
  and DIODE
  and PVT1
  and-not POLY
  and-not TGOX
  and-not PSUB

 # dio_1p2_pp_nw_hvt_lp (Calibre pdiocore_hvt_diode)
 layer pdiodehvt ACT
  and PP
  and NW
  and DIODE
  and PVT3
  and-not POLY
  and-not TGOX
  and-not PSUB
  and-not PVT1

 # dio_3p3_np_pw_lp (Calibre ndioio2_diode)
 layer mvndiode ACT
  and NP
  and TGOX
  and DIODE
  and-not POLY
  and-not NW
  and-not PSUB

 # dio_3p3_pp_nw_lp (Calibre pdioio2_diode)
 layer mvpdiode ACT
  and PP
  and NW
  and TGOX
  and DIODE
  and-not POLY
  and-not PSUB

 # nm1p2_svt_lp (Calibre ncore_svt_gate)
 layer nfet ACT
  and POLY
  and NP
  and-not POLYres
  and-not HRPBLK
  and-not NW
  and-not TGOX
  and-not PSUB
  and-not NVT1
  and-not NVT3

 # nm1p2_lvt_lp (Calibre ncore_lvt_gate)
 layer nfetlvt ACT
  and POLY
  and NP
  and NVT1
  and-not POLYres
  and-not HRPBLK
  and-not NW
  and-not TGOX
  and-not PSUB

 # nm1p2_hvt_lp (Calibre ncore_hvt_gate)
 layer nfethvt ACT
  and POLY
  and NP
  and NVT3
  and-not POLYres
  and-not HRPBLK
  and-not NW
  and-not TGOX
  and-not PSUB
  and-not NVT1

 # nnat1p2_lp (Calibre ncore_nt_gate)
 layer nfetnat ACT
  and POLY
  and NP
  and PSUB
  and-not POLYres
  and-not HRPBLK
  and-not NW
  and-not TGOX

 # pm1p2_svt_lp (Calibre pcore_svt_gate)
 layer pfet ACT
  and POLY
  and PP
  and NW
  and-not POLYres
  and-not HRPBLK
  and-not TGOX
  and-not PVT1
  and-not PVT3

 # pm1p2_lvt_lp (Calibre pcore_lvt_gate)
 layer pfetlvt ACT
  and POLY
  and PP
  and NW
  and PVT1
  and-not POLYres
  and-not HRPBLK
  and-not TGOX

 # pm1p2_hvt_lp (Calibre pcore_hvt_gate)
 layer pfethvt ACT
  and POLY
  and PP
  and NW
  and PVT3
  and-not POLYres
  and-not HRPBLK
  and-not TGOX
  and-not PVT1

 # nm3p3_lp (Calibre nio2_gate)
 layer mvnfet ACT
  and POLY
  and NP
  and TGOX
  and-not POLYres
  and-not HRPBLK
  and-not NW
  and-not PSUB

 # nnat3p3_lp (Calibre nio2_nt_gate)
 layer mvnfetnat ACT
  and POLY
  and NP
  and TGOX
  and PSUB
  and-not POLYres
  and-not HRPBLK
  and-not NW

 # pm3p3_lp (Calibre pio2_gate)
 layer mvpfet ACT
  and POLY
  and PP
  and NW
  and TGOX
  and-not POLYres
  and-not HRPBLK

 # ---- contacts (exact cuts)
 layer ndc CT
  and ACT
  and NP
  and-not POLY
  and-not NW
  and-not TGOX
  and-not DIODE

 layer pdc CT
  and ACT
  and PP
  and NW
  and-not POLY
  and-not TGOX
  and-not DIODE

 layer mvndc CT
  and ACT
  and NP
  and TGOX
  and-not POLY
  and-not NW
  and-not DIODE

 layer mvpdc CT
  and ACT
  and PP
  and NW
  and TGOX
  and-not POLY
  and-not DIODE

 layer nsc CT
  and ACT
  and NP
  and NW
  and-not POLY
  and-not TGOX

 layer psc CT
  and ACT
  and PP
  and-not POLY
  and-not NW
  and-not TGOX

 layer mvnsc CT
  and ACT
  and NP
  and NW
  and TGOX
  and-not POLY

 layer mvpsc CT
  and ACT
  and PP
  and TGOX
  and-not POLY
  and-not NW

 layer ndic CT
  and ACT
  and NP
  and DIODE
  and-not POLY
  and-not NW
  and-not TGOX
  and-not NVT1
  and-not NVT3
  and-not PSUB

 layer ndiclvt CT
  and ACT
  and NP
  and DIODE
  and NVT1
  and-not POLY
  and-not NW
  and-not TGOX
  and-not PSUB

 layer ndichvt CT
  and ACT
  and NP
  and DIODE
  and NVT3
  and-not POLY
  and-not NW
  and-not TGOX
  and-not PSUB
  and-not NVT1

 layer pdic CT
  and ACT
  and PP
  and NW
  and DIODE
  and-not POLY
  and-not TGOX
  and-not PVT1
  and-not PVT3
  and-not PSUB

 layer pdiclvt CT
  and ACT
  and PP
  and NW
  and DIODE
  and PVT1
  and-not POLY
  and-not TGOX
  and-not PSUB

 layer pdichvt CT
  and ACT
  and PP
  and NW
  and DIODE
  and PVT3
  and-not POLY
  and-not TGOX
  and-not PSUB
  and-not PVT1

 layer mvndic CT
  and ACT
  and NP
  and TGOX
  and DIODE
  and-not POLY
  and-not NW
  and-not PSUB

